{"type":"standard","title":"Raymond Smith Jr.","displaytitle":"<span lang=\"en\" dir=\"ltr\"><span class=\"mw-page-title-main\">Raymond Smith Jr.</span></span>","namespace":{"id":0,"text":""},"wikibase_item":"Q58494746","titles":{"canonical":"Raymond_Smith_Jr.","normalized":"Raymond Smith Jr.","display":"<span lang=\"en\" dir=\"ltr\"><span class=\"mw-page-title-main\">Raymond Smith Jr.</span></span>"},"pageid":59015397,"thumbnail":{"source":"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/71/Rep._Raymond_E._Smith_Jr.jpg/330px-Rep._Raymond_E._Smith_Jr.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail","width":330,"height":495},"originalimage":{"source":"https://upload.wikimedia.org/wikipedia/commons/7/71/Rep._Raymond_E._Smith_Jr.jpg?utm_source=en.wikipedia.org&utm_campaign=api&utm_content=thumbnail_unscaled","width":1200,"height":1800},"lang":"en","dir":"ltr","revision":"1376028113","tid":"825ca6d0-b5d4-11f1-b2ae-7b8d258e4400","timestamp":"2026-09-21T15:52:55Z","description":"American politician from North Carolina","description_source":"local","content_urls":{"desktop":{"page":"https://en.wikipedia.org/wiki/Raymond_Smith_Jr.","revisions":"https://en.wikipedia.org/wiki/Raymond_Smith_Jr.?action=history","edit":"https://en.wikipedia.org/wiki/Raymond_Smith_Jr.?action=edit","talk":"https://en.wikipedia.org/wiki/Talk:Raymond_Smith_Jr."},"mobile":{"page":"https://en.wikipedia.org/wiki/Raymond_Smith_Jr.","revisions":"https://en.wikipedia.org/wiki/Special:History/Raymond_Smith_Jr.","edit":"https://en.wikipedia.org/wiki/Raymond_Smith_Jr.?action=edit","talk":"https://en.wikipedia.org/wiki/Talk:Raymond_Smith_Jr."}},"extract":"Raymond Edward Smith Jr. is an American politician and Army veteran who served in the North Carolina House of Representatives for the 21st district from 2019 to 2023. He is the Democratic nominee for North Carolina's 3rd congressional district in the 2026 election.","extract_html":"<p><b>Raymond Edward Smith Jr.</b> is an American politician and Army veteran who served in the North Carolina House of Representatives for the 21st district from 2019 to 2023. He is the Democratic nominee for North Carolina's 3rd congressional district in the 2026 election.</p>"}