19:42:10.126+00","createdAt":"2024-02-06T19:42:10.132Z","updatedAt":"2026-04-17T20:37:36.506311Z"},{"id":"104025","label":"Minnesota Midterm","slug":"minnesota-midterm","createdAt":"2026-03-02T20:05:15.066723Z","updatedAt":"2026-04-17T20:42:53.493195Z"}],"cyom":false,"showAllOutcomes":true,"showMarketImages":true,"enableNegRisk":true,"automaticallyActive":false,"gmpChartMode":"default","negRiskAugmented":true,"countryName":"U.S.","electionType":"Senate","estimateValue":false,"cumulativeMarkets":false,"pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-09-10T18:14:44.19631Z","eventMetadata":{"context_requires_regen":false},"version":"v1"},{"id":"1000190","ticker":"which-party-will-win-the-arizona-state-senate-in-2026","slug":"which-party-will-win-the-arizona-state-senate-in-2026","title":"Which party will win the Arizona State Senate in 2026?","description":"This market will resolve according to the party that wins control of the Arizona State Senate in the 2026 Arizona midterm election.\n\nA party wins control of the Arizona Senate if it wins a majority of the chamber’s voting seats. If no party wins a majority of voting seats, the chamber will be deemed controlled by the party with which the first selected President of the State Senate that convenes after the specified election is affiliated. If no such President of the State Senate is chosen by March 31, 2027, 11:59 PM ET, this market will resolve to \"Other\".\n\nThe following rules govern the counting of seats for determining which party wins control of the chamber.\n\nAll regular and special Senate elections that determine representation in the following State Senate and are scheduled to take place in November 2026 as of October 31, 2026 are included. Runoffs for qualifying elections will determine attribution of the relevant seat, even if they take place after November 2026. Vacant seats for which no election or special election to fill the seat is scheduled to take place in November 2026 as of October 31, 2026 will be treated as held by the party affiliation of the most recent member to hold that seat.\n\nFor seats contested in the specified election, seats are attributed to the party under which the member was elected. If a member-elect changes party affiliation, or vacates their seat, between election day and the formal organization of the Chamber, the seat is attributed to the party under which the member was elected.\n\nFor seats not contested in the specified election, seats are attributed to the party that holds the seat as of the date of the election. If a current sitting member of the Chamber who is not up for election changes party affiliation or vacates their seat after the date of the election, the seat is attributed to the party under which the member was affiliated at the time of the election.\n\nMembers elected as independents who formally caucus with, or, for newly elected members, who announce their intent to caucus with, a party are included in that party’s count. If the caucus decisions of members elected as independents cannot be determined on the date of the election, this market may remain open until the earlier of (i) an announcement from the relevant members of their intents to caucus, or (ii) January 4th, 11:59 PM ET of the following calendar year. If no such announcement is made by January 4th, 11:59 PM ET of the following calendar year, the member will not count towards the seat count of any party.\n\nThe resolution sources for this market will be official information from relevant state electoral authorities, the Arizona State Senate, and a consensus of credible reporting.","resolutionSource":"","startDate":"2026-09-10T18:28:06Z","creationDate":"2026-09-10T18:30:35.543761Z","endDate":"2026-11-04T04:59:00Z","image":"https://polymarket-upload.s3.us-east-2.amazonaws.com/which-party-will-win-the-arizona-state-senate-in-2026-elEWbpCtaPZs.jpg","icon":"https://polymarket-upload.s3.us-east-2.amazonaws.com/which-party-will-win-the-arizona-state-senate-in-2026-elEWbpCtaPZs.jpg","active":true,"closed":false,"archived":false,"new":false,"featured":false,"restricted":true,"liquidity":48251.5449,"volume":7640.722610000001,"openInterest":1357.968739,"sortBy":"price","createdAt":"2026-09-10T18:27:13.719651Z","updatedAt":"2026-10-04T23:37:09.435528Z","competitive":0.9997750506136119,"volume24hr":965.927682,"volume1wk":3271.594418,"volume1mo":7640.722610000001,"volume1yr":7640.722610000001,"enableOrderBook":true,"liquidityClob":48251.5449,"negRisk":true,"negRiskMarketID":"0x2931bb079f461470a2665b8da45623513fd859ae3407d2a2e12ce5e70eb06900","commentCount":0,"markets":[{"id":"4443405","question":"Will the Democratic Party control the Arizona Senate after the 2026 Midterm elections?","conditionId":"0xf3436254c41fbc25f4dc11cbbf3239092ebf412dbe115fd3f6483a252b2471aa","slug":"will-the-democratic-party-control-the-arizona-senate-after-the-2026-midterm-elections","resolutionSource":"","endDate":"2026-11-04T04:59:00Z","liquidity":"27443.239","startDate":"2026-09-10T18:28:06Z","image":"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections-JJ9h02JGR09z.png","icon":"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-democratic-party-control-the-senate-after-the-2026-midterm-elections-JJ9h02JGR09z.png","description":"This market will resolve according to the party that wins control of the Arizona State Senate in the 2026 Arizona midterm election.\n\nA party wins control of the Arizona Senate if it wins a majority of the chamber’s voting seats. If no party wins a majority of voting seats, the chamber will be deemed controlled by the party with which the first selected President of the State Senate that convenes after the specified election is affiliated. If no such President of the State Senate is chosen by March 31, 2027, 11:59 PM ET, this market will resolve to \"Other\".\n\nThe following rules govern the counting of seats for determining which party wins control of the chamber.\n\nAll regular and special Senate elections that determine representation in the following State Senate and are scheduled to take place in November 2026 as of October 31, 2026 are included. Runoffs for qualifying elections will determine attribution of the relevant seat, even if they take place after November 2026. Vacant seats for which no election or special election to fill the seat is scheduled to take place in November 2026 as of October 31, 2026 will be treated as held by the party affiliation of the most recent member to hold that seat.\n\nFor seats contested in the specified election, seats are attributed to the party under which the member was elected. If a member-elect changes party affiliation, or vacates their seat, between election day and the formal organization of the Chamber, the seat is attributed to the party under which the member was elected.\n\nFor seats not contested in the specified election, seats are attributed to the party that holds the seat as of the date of the election. If a current sitting member of the Chamber who is not up for election changes party affiliation or vacates their seat after the date of the election, the seat is attributed to the party under which the member was affiliated at the time of the election.\n\nMembers elected as independents who formally caucus with, or, for newly elected members, who announce their intent to caucus with, a party are included in that party’s count. If the caucus decisions of members elected as independents cannot be determined on the date of the election, this market may remain open until the earlier of (i) an announcement from the relevant members of their intents to caucus, or (ii) January 4th, 11:59 PM ET of the following calendar year. If no such announcement is made by January 4th, 11:59 PM ET of the following calendar year, the member will not count towards the seat count of any party.\n\nThe resolution sources for this market will be official information from relevant state electoral authorities, the Arizona State Senate, and a consensus of credible reporting.","outcomes":"[\"Yes\", \"No\"]","outcomePrices":"[\"0.515\", \"0.485\"]","volume":"4050.2249930000003","active":true,"closed":false,"marketMakerAddress":"","createdAt":"2026-09-10T18:27:17.249006Z","updatedAt":"2026-10-04T23:36:59.67284Z","new":false,"featured":false,"archived":false,"resolvedBy":"0x69c47De9D4D3Dad79590d61b9e05918E03775f24","restricted":true,"groupItemTitle":"Democratic Party","groupItemThreshold":"0","questionID":"0x2931bb079f461470a2665b8da45623513fd859ae3407d2a2e12ce5e70eb06900","enableOrderBook":true,"orderPriceMinTickSize":0.01,"orderMinSize":5,"volumeNum":4050.2249930000003,"liquidityNum":27443.239,"endDateIso":"2026-11-04","startDateIso":"2026-09-10","hasReviewedDates":true,"volume24hr":374.590205,"volume1wk":1993.253539,"volume1mo":4050.2249930000003,"volume1yr":4050.2249930000003,"clobTokenIds":"[\"8330947470967427771669107116351634663558077701167425112930221820680859992246\", \"78599542731084601657713101780975254551833655155488809479612916442884857853093\"]","comboStatus":"disabled","umaBond":"500","umaReward":"3.5","volume24hrClob":374.590205,"volume1wkClob":1993.253539,"volume1moClob":4050.2249930000003,"volume1yrClob":4050.2249930000003,"volumeClob":4050.2249930000003,"liquidityClob":27443.239,"makerBaseFee":1000,"takerBaseFee":1000,"customLiveness":0,"acceptingOrders":true,"negRisk":true,"negRiskMarketID":"0x2931bb079f461470a2665b8da45623513fd859ae3407d2a2e12ce5e70eb06900","negRiskRequestID":"0x36917e19cc15aad942779fbce94daa7ea716eeb23bada17f722ccd775f6dbce5","ready":false,"funded":false,"acceptingOrdersTimestamp":"2026-09-10T18:28:06Z","cyom":false,"competitive":0.9997750506136119,"approved":true,"clobRewards":[{"id":"1966227","conditionId":"0xf3436254c41fbc25f4dc11cbbf3239092ebf412dbe115fd3f6483a252b2471aa","assetAddress":"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174","rewardsAmount":0,"rewardsDailyRate":2,"startDate":"2026-10-04","endDate":"2500-12-31"}],"rewardsMinSize":20,"rewardsMaxSpread":4.5,"spread":0.01,"oneDayPriceChange":0.03,"oneWeekPriceChange":0.12,"lastTradePrice":0.49,"bestBid":0.51,"bestAsk":0.52,"automaticallyActive":true,"clearBookOnStart":true,"seriesColor":"blue","showGmpSeries":false,"showGmpOutcome":false,"manualActivation":false,"negRiskOther":false,"umaResolutionStatuses":"[]","pendingDeployment":false,"deploying":false,"deployingTimestamp":"2026-09-10T18:27:50.384258Z","rfqEnabled":false,"holdingRewardsEnabled":true,"feesEnabled":true,"feeType":"politics_fees","feeSchedule":{"exponent":1,"rate":0.04,"takerOnly":true,"rebateRate":0.25},"version":"v1"},{"id":"4443406","question":"Will the Republican Party control the Arizona Senate after the 2026 Midterm elections?","conditionId":"0xf0fd53cf34409f79feae1abaaf890f2b3fb6c782c8b7f8be4b61d081fef1e8a8","slug":"will-the-republican-party-control-the-arizona-senate-after-the-2026-midterm-elections","resolutionSource":"","endDate":"2026-11-04T04:59:00Z","liquidity":"20892.8059","startDate":"2026-09-10T18:28:06Z","image":"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-republican-party-control-the-senate-after-the-2026-midterm-elections-JSsqogfn0U0u.png","icon":"https://polymarket-upload.s3.us-east-2.amazonaws.com/will-the-republican-party-control-the-senate-after-the-2026-midterm-elections-JSsqogfn0U0u.png","description":"This market will resolve according to the party that wins control of the Arizona State Senate in the 2026 Arizona midterm election.\n\nA party wins control of the Arizona Senate if it wins a majority of the chamber’s voting seats. If no party wins a majority of voting seats, the chamber will be deemed controlled by the party with which the first selected President of the State Senate that convenes after the specified election is affiliated. If no such President of the State Senate is chosen by March 31, 2027, 11:59 PM ET, this market will resolve to \"Other\".\n\nThe following rules govern the counting of seats for determining which party wins control of the chamber.\n\nAll regular and special Senate elections that determine representation in the following State Senate and are scheduled to take place in November 2026 as of October 31, 2026 are included. Runoffs for qualifying elections will determine attribution of the relevant seat, even if they take place after November 2026. Vacant seats for which no election or special election to fill the seat is scheduled to take place in November 2026 as of October 31, 2026 will be treated as held by the party affiliation of the most recent member to hold that seat.\n\nFor seats contested in the specified election, seats are attributed to the party under which the member was elected. If a member-elect changes party affiliation, or vacates their seat, between election day and the formal organization of the Chamber, the seat is attributed to the party under which the member was elected.\n\nFor seats not contested in the specified election, seats are attributed to the party that holds the seat as of the date of the election. If a current sitting member of the Chamber who is not up for election changes party affiliation or vacates their seat after the date of the election, the seat is attributed to the party under which the member was affiliated at the time of the election.\n\nMembers elected as independents who formally caucus with, or, for newly elected members, who announce their intent to caucus with, a party are included in that party’s count. If the caucus decisions of members elected as independents cannot be determined on the date of the election, this market may remain open until the earlier of (i) an announcement from the relevant members of their intents to caucus, or (ii) January 4th, 11:59 PM ET of the following calendar year. If no such announcement is made by January 4th, 11:59 PM ET of the following calendar year, the member will not count towards the seat count of any party.\n\nThe resolution sources for this market will be official information from relevant state electoral authorities, the Arizona State Senate, and a consensus of credible reporting.","outcomes":"[\"Yes\", \"No\"]","outcomePrices":"[\"0.485\", \"0.515\"]","volume":"3590.4976170000004","active":true,"closed":false,"marketMakerAddress":"","createdAt":"2026-09-10T18:27:17.560621Z","updatedAt":"2026-10-04T23:36:59.67284Z","new":false,"featured":false,"archived":false,"resolvedBy":"0x69c47De9D4D3Dad79590d61b9e05918E03775f24","restricted":true,"groupItemTitle":"Republican Party","groupItemThreshold":"1","questionID":"0x2931bb079f461470a2665b8da45623513fd859ae3407d2a2e12ce5e70eb06901","enableOrderBook":true,"orderPriceMinTickSize":0.01,"orderMinSize":5,"volumeNum":3590.4976170000004,"liquidityNum":20892.8059,"endDateIso":"2026-11-04","startDateIso":"2026-09-10","hasReviewedDates":true,"volume24hr":591.337477,"volume1wk":1278.340879,"volume1mo":3590.497617,"volume1yr":3590.497617,"clobTokenIds":"[\"97416473123789085219725064625530083221092397891152616542690512395030639594263\", \"115347905931665408556191423733789296105798975990543321191846406434079836237196\"]","comboStatus":"disabled","umaBond":"500","umaReward":"3.5","volume24hrClob":591.337477,"volume1wkClob":1278.340879,"volume1moClob":3590.497617,"volume1yrClob":3590.497617,"volumeClob":3590.4976170000004,"liquidityClob":20892.8059,"makerBaseFee":1000,"takerBaseFee":1000,"customLiveness":0,"acceptingOrders":true,"negRisk":true,"negRiskMarketID":"0x2931bb079f461470a2665b8da45623513fd859ae3407d2a2e12ce5e70eb06900","negRiskRequestID":"0xb755e82778f257fb91593e3c21bc7b8fa65895a36542a40b1329ba0a7fc7f7de","ready":false,"funded":false,"acceptingOrdersTimestamp":"2026-09-10T18:28:06Z","cyom":false,"competitive":0.9997750506136119,"approved":true,"clobRewards":[{"id":"1966231","conditionId":"0xf0fd53cf34409f79feae1abaaf890f2b3fb6c782c8b7f8be4b61d081fef1e8a8","assetAddress":"0x2791Bca1f2de4661ED88A30C99A7a9449Aa84174","rewardsAmount":0,"rewa