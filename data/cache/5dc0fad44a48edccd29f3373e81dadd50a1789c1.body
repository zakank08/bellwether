rg/wiki/File:Jeff_Merkley,_115th_official_photo_(cropped2).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg/120px-Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg/250px-Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2779\" data-file-height=\"3741\" data-file-type=\"bitmap\" height=\"136\" width=\"101\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:David_Brock_Smith.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:David_Brock_Smith.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/81/David_Brock_Smith.jpg/120px-David_Brock_Smith.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//upload.wikimedia.org/wikipedia/commons/8/81/David_Brock_Smith.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\" data-file-width=\"184\" data-file-height=\"252\" data-file-type=\"bitmap\" height=\"136\" width=\"99\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jeff_Merkley\" title=\"Jeff Merkley\">Jeff Merkley</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/David_Brock_Smith\" title=\"David Brock Smith\">David Brock Smith</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Oregon\" title=\"List of United States senators from Oregon\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jeff_Merkley\" title=\"Jeff Merkley\">Jeff Merkley</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3594\" typeof=\"mw:Transclusion\" id=\"mwFb0\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Oregon\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3595\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3594\" id=\"mwFb4\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Oregon\" title=\"2026 United States Senate election in Oregon\">2026 United States Senate election in Oregon</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3596\" typeof=\"mw:Transclusion\" id=\"mwFb8\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Oregon\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3597\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3596\" id=\"mwFcA\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Oregon\" title=\"List of United States senators from Oregon\">List of United States senators from Oregon</a></div>\n<p id=\"mwFcE\">Three-term Democrat <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jeff_Merkley\" title=\"Jeff Merkley\" id=\"mwFcI\">Jeff Merkley</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Oregon\" title=\"2020 United States Senate election in Oregon\" id=\"mwFcM\">reelected in 2020</a> with 56.9% of the vote. On July 20, 2025, he announced his candidacy for reelection.<sup about=\"#mwt3600\" class=\"mw-ref reference\" id=\"cite_ref-291\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-291\"}}'><a href=\"#cite_note-291\" id=\"mwFcQ\"><span class=\"mw-reflink-text\" id=\"mwFcU\"><span class=\"cite-bracket\" id=\"mwFcY\">[</span>267<span class=\"cite-bracket\" id=\"mwFcc\">]</span></span></a></sup> He defeated retired electrical engineer Paul D. Wells<sup about=\"#mwt3603\" class=\"mw-ref reference\" id=\"cite_ref-rc_292-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"rc\"},\"body\":{\"id\":\"mw-reference-text-cite_note-rc-292\"}}'><a href=\"#cite_note-rc-292\" id=\"mwFcg\"><span class=\"mw-reflink-text\" id=\"mwFck\"><span class=\"cite-bracket\" id=\"mwFco\">[</span>268<span class=\"cite-bracket\" id=\"mwFcs\">]</span></span></a></sup> in the Democratic primary on May 19, 2026.<sup about=\"#mwt3606\" class=\"mw-ref reference\" id=\"cite_ref-293\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-293\"}}'><a href=\"#cite_note-293\" id=\"mwFcw\"><span class=\"mw-reflink-text\" id=\"mwFc0\"><span class=\"cite-bracket\" id=\"mwFc4\">[</span>269<span class=\"cite-bracket\" id=\"mwFc8\">]</span></span></a></sup></p>\n\n<p id=\"mwFdA\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Oregon_State_Senate\" title=\"Oregon State Senate\" id=\"mwFdE\">State Senator</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/David_Brock_Smith\" title=\"David Brock Smith\" id=\"mwFdI\">David Brock Smith</a>,<sup about=\"#mwt3609\" class=\"mw-ref reference\" id=\"cite_ref-294\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-294\"}}'><a href=\"#cite_note-294\" id=\"mwFdM\"><span class=\"mw-reflink-text\" id=\"mwFdQ\"><span class=\"cite-bracket\" id=\"mwFdU\">[</span>270<span class=\"cite-bracket\" id=\"mwFdY\">]</span></span></a></sup> won the Republican primary that was held on May 19, 2026, defeating a crowded field of candidates, with former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Linn_County,_Oregon\" title=\"Linn County, Oregon\" id=\"mwFdc\">Linn County</a> Republican Party chair <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jo_Rae_Perkins\" title=\"Jo Rae Perkins\" id=\"mwFdg\">Jo Rae Perkins</a><sup about=\"#mwt3610\" class=\"mw-ref reference\" id=\"cite_ref-rc_292-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"rc\"}}'><a href=\"#cite_note-rc-292\" id=\"mwFdk\"><span class=\"mw-reflink-text\" id=\"mwFdo\"><span class=\"cite-bracket\" id=\"mwFds\">[</span>268<span class=\"cite-bracket\" id=\"mwFdw\">]</span></span></a></sup> finishing second.<sup about=\"#mwt3613\" class=\"mw-ref reference\" id=\"cite_ref-295\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-295\"}}'><a href=\"#cite_note-295\" id=\"mwFd0\"><span class=\"mw-reflink-text\" id=\"mwFd4\"><span class=\"cite-bracket\" id=\"mwFd8\">[</span>271<span class=\"cite-bracket\" id=\"mwFeA\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3614\" typeof=\"mw:Transclusion\" id=\"mwFeE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"48\" id=\"mwFeI\" aria-labelledby=\"Rhode_Island\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Rhode_Island\">Rhode Island</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=48\" title=\"Edit section: Rhode Island\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3615\" typeof=\"mw:Transclusion\" id=\"mwFeM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Rhode Island election\"},\"country\":{\"wt\":\"Rhode Island\"},\"type\":{