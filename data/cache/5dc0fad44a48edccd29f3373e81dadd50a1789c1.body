.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"485\" data-file-height=\"647\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #fed000;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:3x4.svg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:3x4.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" data-file-type=\"drawing\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Roger_Marshall\" title=\"Roger Marshall\">Roger Marshall</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Adam_Hamilton_(pastor)\" title=\"Adam Hamilton (pastor)\">Adam Hamilton</a></td>\n<td style=\"width:75px;text-align:center\">David Graham</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Kansas\" title=\"List of United States senators from Kansas\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Roger_Marshall\" title=\"Roger Marshall\">Roger Marshall</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3110\" typeof=\"mw:Transclusion\" id=\"mwEoE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Kansas\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3111\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3110\" id=\"mwEoI\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Kansas\" title=\"2026 United States Senate election in Kansas\">2026 United States Senate election in Kansas</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3112\" typeof=\"mw:Transclusion\" id=\"mwEoM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Kansas\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3113\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3112\" id=\"mwEoQ\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Kansas\" title=\"List of United States senators from Kansas\">List of United States senators from Kansas</a></div>\n<p id=\"mwEoU\">One-term Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Roger_Marshall\" title=\"Roger Marshall\" id=\"mwEoY\">Roger Marshall</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Kansas\" title=\"2020 United States Senate election in Kansas\" id=\"mwEoc\">elected in 2020</a> with 53.2% of the vote and is running for reelection.<sup about=\"#mwt3116\" class=\"mw-ref reference\" id=\"cite_ref-MarshallKS_193-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"MarshallKS\"},\"body\":{\"id\":\"mw-reference-text-cite_note-MarshallKS-193\"}}'><a href=\"#cite_note-MarshallKS-193\" id=\"mwEog\"><span class=\"mw-reflink-text\" id=\"mwEok\"><span class=\"cite-bracket\" id=\"mwEoo\">[</span>169<span class=\"cite-bracket\" id=\"mwEos\">]</span></span></a></sup></p> \n\n<p id=\"mwEow\">Founder of the Church of the Resurrection and pastor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Adam_Hamilton_(pastor)\" title=\"Adam Hamilton (pastor)\" id=\"mwEo0\">Adam Hamilton</a>,<sup about=\"#mwt3119\" class=\"mw-ref reference\" id=\"cite_ref-194\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-194\"}}'><a href=\"#cite_note-194\" id=\"mwEo4\"><span class=\"mw-reflink-text\" id=\"mwEo8\"><span class=\"cite-bracket\" id=\"mwEpA\">[</span>170<span class=\"cite-bracket\" id=\"mwEpE\">]</span></span></a></sup> who initially considered running as an independent,<sup about=\"#mwt3122\" class=\"mw-ref reference\" id=\"cite_ref-195\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-195\"}}'><a href=\"#cite_note-195\" id=\"mwEpI\"><span class=\"mw-reflink-text\" id=\"mwEpM\"><span class=\"cite-bracket\" id=\"mwEpQ\">[</span>171<span class=\"cite-bracket\" id=\"mwEpU\">]</span></span></a></sup> won the Democratic nomination with 35% of the vote. He defeated a field that included former state <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/USDA\" title=\"USDA\" class=\"mw-redirect\" id=\"mwEpY\">USDA</a> Director Christy Davis,<sup about=\"#mwt3125\" class=\"mw-ref reference\" id=\"cite_ref-DavisKS_196-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"DavisKS\"},\"body\":{\"id\":\"mw-reference-text-cite_note-DavisKS-196\"}}'><a href=\"#cite_note-DavisKS-196\" id=\"mwEpc\"><span class=\"mw-reflink-text\" id=\"mwEpg\"><span class=\"cite-bracket\" id=\"mwEpk\">[</span>172<span class=\"cite-bracket\" id=\"mwEpo\">]</span></span></a></sup> former federal prosecutor Jason Hart,<sup about=\"#mwt3128\" class=\"mw-ref reference\" id=\"cite_ref-197\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-197\"}}'><a href=\"#cite_note-197\" id=\"mwEps\"><span class=\"mw-reflink-text\" id=\"mwEpw\"><span class=\"cite-bracket\" id=\"mwEp0\">[</span>173<span class=\"cite-bracket\" id=\"mwEp4\">]</span></span></a></sup> commercial real estate developer Erik Murray,<sup about=\"#mwt3131\" class=\"mw-ref reference\" id=\"cite_ref-198\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-198\"}}'><a href=\"#cite_note-198\" id=\"mwEp8\"><span class=\"mw-reflink-text\" id=\"mwEqA\"><span class=\"cite-bracket\" id=\"mwEqE\">[</span>174<span class=\"cite-bracket\" id=\"mwEqI\">]</span></span></a></sup> attorney Anne Parelkar,<sup about=\"#mwt3132\" class=\"mw-ref reference\" id=\"cite_ref-Parelkar_199-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Parelkar\"}}'><a href=\"#cite_note-Parelkar-199\" id=\"mwEqM\"><span class=\"mw-reflink-text\" id=\"mwEqQ\"><span class=\"cite-bracket\" id=\"mwEqU\">[</span>175<span class=\"cite-bracket\" id=\"mwEqY\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kansas_Senate\" title=\"Kansas Senate\" id=\"mwEqc\">state senator</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Patrick_Schmidt_(politician)\" title=\"Patrick Schmidt (politician)\" id=\"mwEqg\">Patrick Schmidt</a>,<sup about=\"#mwt3135\" class=\"mw-ref reference\" id=\"cite_ref-200\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-200\"}}'><a href=\"#cite_note-200\" id=\"mwEqk\"><span class=\"mw-reflink-text\" id=\"mwEqo\"><span class=\"cite-bracket\" id=\"mwEqs\">[</span>176<span class=\"cite-bracket\" id=\"mwEqw\">]</span></span></a></sup> art gallery owner Mike Soetaertare,<sup about=\"#mwt3138\" class=\"mw-ref reference\" id=\"cite_ref-Parelkar_199-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Parelkar\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Parelkar-199\"}}'><a href=\"#cite_note-Parelkar-199\" id=\"mwEq0\"><span class=\"mw-reflink-text\" id=\"mwEq4\"><span class=\"cite-bracket\" id=\"mwEq8\">[</span>175<span class=\"cite-bracket\" id=\"mwErA\">]</span></span></a></sup> former financial services executive Sandy Spidel Neumann,<sup about=\"#mwt3141\" class=\"mw-ref reference\" id=\"cite_ref-201\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-201\"}}'><a href=\"#cite_note-201\" id=\"mwErE\"><span class=\"mw-reflink-text\" id=\"mwErI\"><span class=\"cite-bracket\" id=\"mwErM\">[</span>177<span class=\"cite-bracket\" id=\"mwErQ\">]</span></span></a></sup> and counterintelligence specialist Noah Tyler.<sup about=\"#mwt3144\" class=\"mw-ref reference\" id=\"cite_ref-202\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-202\"}}'><a href=\"#cite_note-202\" id=\"mwErU\"><span class=\"mw-reflink-text\" id=\"mwErY\"><span class=\"cite-bracket\" id=\"mwErc\">[</span>178<span class=\"cite-bracket\" id=\"mwErg\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3145\" typeof=\"mw:Transclusion\" id=\"mwErk\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"32\" id=\"mwEro\" aria-labelledby=\"Kentucky\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Kentucky\">Kentucky</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=32\" title=\"Edit section: Kentucky\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3146\" typeof=\"mw:Transclusion\" id=\"mwErs\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Kentucky election\"},\"country\":{\"wt\":\"Kentucky\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Kentucky\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Kentucky\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"election_date\":{\"wt\":\"&lt;!--Don&apos;t need election date in section infoboxes when the date is the same as in the article&apos;s main infobox.-->\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Andy Barr 116th Congress.jpg\"},\"nominee1\":{\"wt\":\"[[Andy Barr]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Charles solar panels (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Charles Booker (American politician)|Charles Booker]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Mitch McConnell]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3147\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3148\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles: