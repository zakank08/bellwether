\"#mwt394\" typeof=\"mw:Transclusion\" id=\"mwApw\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"53\"}},\"i\":0}}]}'>53</sub><br id=\"mwAp0\"/><span style=\"font-size: 85%;\" about=\"#mwt395\" typeof=\"mw:Transclusion\" id=\"mwAp4\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Small\",\"href\":\"./Template:Small\"},\"params\":{\"1\":{\"wt\":\"[[#Wyoming|{{abbr|Wyo.|Wyoming}}]]\"}},\"i\":0}}]}'><a rel=\"mw:WikiLink\" href=\"#Wyoming\" class=\"mw-selflink-fragment\"><abbr title=\"Wyoming\" about=\"#mwt396\" typeof=\"mw:ExpandedAttrs\" data-mw='{\"attribs\":[[{\"txt\":\"title\"},{\"html\":\"&lt;span typeof=\\\"mw:Nowiki\\\" id=\\\"mwAp8\\\">Wyoming&lt;/span>\"}]]}'>Wyo.</abbr></a></span><br id=\"mwAqA\"/><span style=\"font-size: 85%;\" about=\"#mwt397\" typeof=\"mw:Transclusion\" id=\"mwAqE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Small\",\"href\":\"./Template:Small\"},\"params\":{\"1\":{\"wt\":\"Retiring\"}},\"i\":0}}]}'>Retiring</span></td>\n<td style=\"background:#FFB6B6; border:2px solid gray; text-align:center; font-weight:bold;\" about=\"#mwt415\" typeof=\"mw:ExpandedAttrs\" id=\"mwAqM\" data-mw='{\"attribs\":[[{\"txt\":\"style\",\"html\":\"&lt;span about=\\\"#mwt414\\\" typeof=\\\"mw:Transclusion\\\" id=\\\"mwAqI\\\" data-mw=&apos;{\\\"parts\\\":[{\\\"template\\\":{\\\"target\\\":{\\\"wt\\\":\\\"Party shading/Republican/active\\\",\\\"href\\\":\\\"./Template:Party_shading/Republican/active\\\"},\\\"params\\\":{},\\\"i\\\":0}}]}&apos;>style=\\\"background:#FFB6B6; border:2px solid gray; text-align:center; font-weight:bold;\\\"&lt;/span>\"},{\"html\":\"\"}]]}'>R<sub about=\"#mwt400\" typeof=\"mw:Transclusion\" id=\"mwAqQ\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"52\"}},\"i\":0}}]}'>52</sub><br id=\"mwAqU\"/><span style=\"font-size: 85%;\" about=\"#mwt401\" typeof=\"mw:Transclusion\" id=\"mwAqY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Small\",\"href\":\"./Template:Small\"},\"params\":{\"1\":{\"wt\":\"[[#Oklahoma|{{abbr|Okla.|Oklahoma}}]]\"}},\"i\":0}}]}'><a rel=\"mw:WikiLink\" href=\"#Oklahoma\" class=\"mw-selflink-fragment\"><abbr title=\"Oklahoma\" about=\"#mwt402\" typeof=\"mw:ExpandedAttrs\" data-mw='{\"attribs\":[[{\"txt\":\"title\"},{\"html\":\"&lt;span typeof=\\\"mw:Nowiki\\\" id=\\\"mwAqc\\\">Oklahoma&lt;/span>\"}]]}'>Okla.</abbr></a></span><br id=\"mwAqg\"/><span style=\"font-size: 85%;\" about=\"#mwt403\" typeof=\"mw:Transclusion\" id=\"mwAqk\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Small\",\"href\":\"./Template:Small\"},\"params\":{\"1\":{\"wt\":\"Retiring\"}},\"i\":0}}]}'>Retiring</span><sup about=\"#mwt404\" class=\"mw-ref reference\" id=\"cite_ref-OK_4-1\" rel=\"dc:references\" typeof=\"mw:Transclusion mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"OK\",\"group\":\"lower-alpha\"},\"body\":{\"id\":\"mw-reference-text-cite_note-OK-4\"},\"parts\":[{\"template\":{\"target\":{\"wt\":\"efn\",\"href\":\"./Template:Efn\"},\"params\":{\"name\":{\"wt\":\"OK\"},\"1\":{\"wt\":\"[[Markwayne Mullin]] won a [[2022 United States Senate special election in Oklahoma|special election in 2022]] to fill [[Jim Inhofe]]&apos;s [[List of United States senators from Oklahoma|Oklahoma Senate]] seat after Inhofe resigned for health reasons. Mullin resigned on March 23, 2026, to become [[United States Secretary of Homeland Security]]. [[Governor of Oklahoma|Oklahoma Governor]] [[Kevin Stitt]] appointed [[Alan Armstrong]] to the seat, and he was sworn in on March 24, 2026. Oklahoma law requires appointees to affirm they will not seek a full term; Armstrong will not run for election.&lt;ref name=\\\"OK Statutes\\\">{{cite web |title=2025 Oklahoma Statutes Title 51. Officers §51-10. Vacancies - Appointments - Special elections. |url=https://law.justia.com/codes/oklahoma/title-51/section-51-10/ |publisher=Justia US Law |access-date=March 25, 2026 |quote=Prior to an appointment pursuant to paragraph 1 of subsection C of this section, a person who is a prospective appointee shall submit to the Secretary of State an oath affirming that the person will not file as a candidate for the office when it next appears on the ballot. The Secretary of State shall prescribe the oath required by this paragraph, and any oath submitted shall be public record and published on the website of the Office of the Secretary of State.}}&lt;/ref>\"}},\"i\":0}}]}'><a href=\"#cite_note-OK-4\" data-mw-group=\"lower-alpha\" id=\"mwAqo\"><span class=\"mw-reflink-text\" id=\"mwAqs\"><span class=\"cite-bracket\" id=\"mwAqw\">[</span>d<span class=\"cite-bracket\" id=\"mwAq0\">]</span></span></a></sup></td>\n<td style=\"background:#FFB6B6; border:2px solid gray; text-align:center; font-weight:bold;\" about=\"#mwt421\" typeof=\"mw:ExpandedAttrs\" id=\"mwAq8\" data-mw='{\"attribs\":[[{\"txt\":\"style\",\"html\":\"&lt;span about=\\\"#mwt420\\\" typeof=\\\"mw:Transclusion\\\" id=\\\"mwAq4\\\" data-mw=&apos;{\\\"parts\\\":[{\\\"template\\\":{\\\"target\\\":{\\\"wt\\\":\\\"Party shading/Republican/active\\\",\\\"href\\\":\\\"./Template:Party_shading/Republican/active\\\"},\\\"params\\\":{},\\\"i\\\":0}}]}&apos;>style=\\\"background:#FFB6B6; border:2px solid gray; text-align:center; font-weight:bold;\\\"&lt;/span>\"},{\"html\":\"\"}]]}'>R<sub about=\"#mwt416\" typeof=\"mw:Transclusion\" id=\"mwArA\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"51\"}},\"i\":0}}]}'>51</sub><br id=\"mwArE\"/><span style=\"font-size: 85%;\" about=\"#mwt417\" typeof=\"mw:Transclusion\" id=\"mwArI\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Small\",\"href\":\"./Template:Small\"},\"params\":{\"1\":{\"wt\":\"[[#North Carolina|{{abbr|N.C.|North Carolina}}]]\"}},\"i\":0}}]}'><a rel=\"mw:WikiLink\" href=\"#North_Carolina\" class=\"mw-selflink-frag