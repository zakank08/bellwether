of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Official_portrait_of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg/250px-Official_portrait_of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"553\" data-file-height=\"739\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Annie_Andrews_Greenville_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Annie_Andrews_Greenville_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Annie_Andrews_Greenville_%28cropped%29.jpg/120px-Annie_Andrews_Greenville_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Annie_Andrews_Greenville_%28cropped%29.jpg/250px-Annie_Andrews_Greenville_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1020\" data-file-height=\"1279\" data-file-type=\"bitmap\" height=\"136\" width=\"108\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Darline_Graham\" title=\"Darline Graham\">Darline Graham</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Annie_Andrews_(pediatrician)\" title=\"Annie Andrews (pediatrician)\">Annie Andrews</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_South_Carolina\" title=\"List of United States senators from South Carolina\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Darline_Graham\" title=\"Darline Graham\">Darline Graham</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3641\" typeof=\"mw:Transclusion\" id=\"mwFgY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in South Carolina\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3642\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3641\" id=\"mwFgc\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_South_Carolina\" title=\"2026 United States Senate election in South Carolina\">2026 United States Senate election in South Carolina</a></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3643\" typeof=\"mw:Transclusion\" id=\"mwFgg\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from South Carolina\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3644\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3643\" id=\"mwFgk\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_South_Carolina\" title=\"List of United States senators from South Carolina\">List of United States senators from South Carolina</a></div>\n<p id=\"mwFgo\">Four-term Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lindsey_Graham\" title=\"Lindsey Graham\" id=\"mwFgs\">Lindsey Graham</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_South_Carolina\" title=\"2020 United States Senate election in South Carolina\" id=\"mwFgw\">reelected in 2020</a> with 54.4% of the vote and was seeking a fifth term.<sup about=\"#mwt3647\" class=\"mw-ref reference\" id=\"cite_ref-LindseyGraham_300-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"LindseyGraham\"},\"body\":{\"id\":\"mw-reference-text-cite_note-LindseyGraham-300\"}}'><a href=\"#cite_note-LindseyGraham-300\" id=\"mwFg0\"><span class=\"mw-reflink-text\" id=\"mwFg4\"><span class=\"cite-bracket\" id=\"mwFg8\">[</span>276<span class=\"cite-bracket\" id=\"mwFhA\">]</span></span></a></sup> He won the June 9 Republican primary with 57% of the vote,<sup about=\"#mwt3650\" class=\"mw-ref reference\" id=\"cite_ref-301\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-301\"}}'><a href=\"#cite_note-301\" id=\"mwFhE\"><span class=\"mw-reflink-text\" id=\"mwFhI\"><span class=\"cite-bracket\" id=\"mwFhM\">[</span>277<span class=\"cite-bracket\" id=\"mwFhQ\">]</span></span></a></sup> but died in office on July 11.<sup about=\"#mwt3653\" class=\"mw-ref reference\" id=\"cite_ref-302\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-302\"}}'><a href=\"#cite_note-302\" id=\"mwFhU\"><span class=\"mw-reflink-text\" id=\"mwFhY\"><span class=\"cite-bracket\" id=\"mwFhc\">[</span>278<span class=\"cite-bracket\" id=\"mwFhg\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_South_Carolina\" title=\"Governor of South Carolina\" id=\"mwFhk\">Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Henry_McMaster\" title=\"Henry McMaster\" id=\"mwFho\">Henry McMaster</a> appointed Graham's sister, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Darline_Graham\" title=\"Darline Graham\" id=\"mwFhs\">Darline</a>, to serve the remainder of his term. She subsequently sought a full term. In the August 11 special Republican primary, Darline Graham and U.S. Representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ralph_Norman\" title=\"Ralph Norman\" id=\"mwFhw\">Ralph Norman</a> advanced to an August 25 runoff, which Graham won with 52% of the vote to Norman's 48%.<sup about=\"#mwt3656\" class=\"mw-ref reference\" id=\"cite_ref-303\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-303\"}}'><a href=\"#cite_note-303\" id=\"mwFh0\"><span class=\"mw-reflink-text\" id=\"mwFh4\"><span class=\"cite-bracket\" id=\"mwFh8\">[</span>279<span class=\"cite-bracket\" id=\"mwFiA\">]</span></span></a></sup></p>\n\n<p id=\"mwFiE\">Pediatrician <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Annie_Andrews_(pediatrician)\" title=\"Annie Andrews (pediatrician)\" id=\"mwFiI\">Annie Andrews</a><sup about=\"#mwt3659\" class=\"mw-ref reference\" id=\"cite_ref-304\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-304\"}}'><a href=\"#cite_note-304\" id=\"mwFiM\"><span class=\"mw-reflink-text\" id=\"mwFiQ\"><span class=\"cite-bracket\" id=\"mwFiU\">[</span>280<span class=\"cite-bracket\" id=\"mwFiY\">]</span></span></a></sup> won the Democratic primary with 61% of the vote.<sup about=\"#mwt3662\" class=\"mw-ref reference\" id=\"cite_ref-305\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-305\"}}'><a href=\"#cite_note-305\" id=\"mwFic\"><span class=\"mw-reflink-text\" id=\"mwFig\"><span class=\"cite-bracket\" id=\"mwFik\">[</span>281<span class=\"cite-bracket\" id=\"mwFio\">]</span></span></a></sup></p>\n\n<p id=\"mwFis\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/South_Carolina_Libertarian_Party\" title=\"South Carolina Libertarian Party\" class=\"mw-redirect\" id=\"mwFiw\">South Carolina Libertarian Party</a> nominee Kasie Whitener and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_Party_(United_States)\" title=\"Constitution Party (United States)\" id=\"mwFi0\">Constitution Party</a> nominee Mark Hackett were nominated by convention.<sup about=\"#mwt3665\" class=\"mw-ref reference\" id=\"cite_ref-306\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-306\"}}'><a href=\"#cite_note-306\" id=\"mwFi4\"><span class=\"mw-reflink-text\" id=\"mwFi8\"><span class=\"cite-bracket\" id=\"mwFjA\">[</span>282<span class=\"cite-bracket\" id=\"mwFjE\">]</span></span></a></sup> 2022 US Senate candidate <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Catherine_Fleming_Bruce\" title=\"Catherine Fleming Bruce\" id=\"mwFjI\">Catherine Fleming Bruce</a> is running as a write-in candidate.</p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3666\" typeof=\"mw:Transclusion\" id=\"mwFjM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"50\" id=\"mwFjQ\" aria-labelledby=\"South_Dakota\"><div class=\"mw-heading mw-heading3\"><h3 id=\"South_Dakota\">South Dakota</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=50\" title=\"Edit section: South Dakota\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3667\" typeof=\"mw:Transclusion\" id=\"mwFjU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"South Dakota election\"},\"country\":{\"wt\":\"South Dakota\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in South Dakota\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in South Dakota\"},\"next_year\":{\"wt\":\"2032\"},\"image_size\":{\"wt\":\"125x136px\"},\"image1\":{\"wt\":\"Mike Rounds official Senate portrait (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Mike Rounds]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"File:Brian Bengs Air Force (cropped).jpg\"},\"nominee2\":{\"wt\":\"Brian Bengs\"},\"party2\":{\"wt\":\"Independent politician\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. senator\"},\"before_election\":{\"wt\":\"[[Mike Rounds]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3668\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3669\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3670\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3667\" id=\"mwFjY\"><caption class=\"infobox-title summary\">South Dakota election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_South_Dakota.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Flag_of_South_Dakota.svg/60px-Flag_of_South_Dakota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Flag_of_South_Dakota.svg/120px-Flag_of_South_Dakota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"720\" data-file-height=\"450\" data-file-type=\"drawing\" height=\"31\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_South_Dakota\" title=\"2020 United States Senate election in South Dakota\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\">2032<span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Mike_Rounds_official_Senate_portrait_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Mike_Rounds_official_Senate_portrait_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg/120px-Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg/250px-Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1079\" data-file-height=\"1385\" data-file-type=\"bitmap\" height=\"136\" width=\"106\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #DCDCDC;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Brian_Bengs_Air_Force_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Brian_Bengs_Air_Force_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/db/Brian_Bengs_Air_Force_%28cropped%29.jpg/120px-Brian_Bengs_Air_Force_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/db/Brian_Bengs_Air_Force_%28cropped%29.jpg/250px-Brian_Bengs_Air_Force_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1257\" data-file-height=\"1776\" data-file-type=\"bitmap\" height=\"136\" width=\"96\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Rounds\" title=\"Mike Rounds\">Mike Rounds</a></td>\n<td style=\"width:75px;text-align:center\">Brian Bengs</td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Independent_politician\" title=\"Independent politician\">Independent</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_South_Dakota\" title=\"List of United States senators from South Dakota\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Rounds\" title=\"Mike Rounds\">Mike Rounds</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3671\" typeof=\"mw:Transclusion\" id=\"mwFjc\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in South Dakota\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3672\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3671\" id=\"mwFjg\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_South_Dakota\" title=\"2026 United States Senate election in South Dakota\">2026 United States Senate election in South Dakota</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3673\" typeof=\"mw:Transclusion\" id=\"mwFjk\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from South Dakota\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3674\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3673\" id=\"mwFjo\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_South_Dakota\" title=\"List of United States senators from South Dakota\">List of United States senators from South Dakota</a></div>\n<p id=\"mwFjs\">Two-term Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Rounds\" title=\"Mike Rounds\" id=\"mwFjw\">Mike Rounds</a>, who was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_South_Dakota\" title=\"2020 United States Senate election in South Dakota\" id=\"mwFj0\">reelected in 2020</a> with 65.7% of the vote, is running for a third term.<sup about=\"#mwt3677\" class=\"mw-ref reference\" id=\"cite_ref-Rounds_307-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Rounds\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Rounds-307\"}}'><a href=\"#cite_note-Rounds-307\" id=\"mwFj4\"><span class=\"mw-reflink-text\" id=\"mwFj8\"><span class=\"cite-bracket\" id=\"mwFkA\">[</span>283<span class=\"cite-bracket\" id=\"mwFkE\">]</span></span></a></sup> Rounds easily defeated Navy veteran and businessman Justin McNeil in the June 2 primary to win the Republican nomination.<sup about=\"#mwt3680\" class=\"mw-ref reference\" id=\"cite_ref-308\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-308\"}}'><a href=\"#cite_note-308\" id=\"mwFkI\"><span class=\"mw-reflink-text\" id=\"mwFkM\"><span class=\"cite-bracket\" id=\"mwFkQ\">[</span>284<span class=\"cite-bracket\" id=\"mwFkU\">]</span></span></a></sup></p>\n\n<p id=\"mwFkY\">Businessman and former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/South_Dakota_Highway_Patrol\" title=\"South Dakota Highway Patrol\" id=\"mwFkc\">South Dakota state trooper</a> Julian Beaudion was the Democratic nominee,<sup about=\"#mwt3683\" class=\"mw-ref reference\" id=\"cite_ref-Beaudion_309-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Beaudion\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Beaudion-309\"}}'><a href=\"#cite_note-Beaudion-309\" id=\"mwFkg\"><span class=\"mw-reflink-text\" id=\"mwFkk\"><span class=\"cite-bracket\" id=\"mwFko\">[</span>285<span class=\"cite-bracket\" id=\"mwFks\">]</span></span></a></sup> but withdrew on August 4.<sup about=\"#mwt3686\" class=\"mw-ref reference\" id=\"cite_ref-310\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-310\"}}'><a href=\"#cite_note-310\" id=\"mwFkw\"><span class=\"mw-reflink-text\" id=\"mwFk0\"><span class=\"cite-bracket\" id=\"mwFk4\">[</span>286<span class=\"cite-bracket\" id=\"mwFk8\">]</span></span></a></sup></p>\n\n<p id=\"mwFlA\">Brian Bengs, a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Navy\" title=\"U.S. Navy\" class=\"mw-redirect\" id=\"mwFlE\">U.S. Navy</a> and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Air_Force_Specialty_Code\" title=\"Air Force Specialty Code\" id=\"mwFlI\">Air Force</a> veteran, former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Northern_State_University\" title=\"Northern State University\" id=\"mwFlM\">Northern State University</a> political science professor, and the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\" id=\"mwFlQ\">Democratic</a> nominee for U.S. Senate in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_United_States_Senate_election_in_South_Dakota\" title=\"2022 United States Senate election in South Dakota\" id=\"mwFlU\">2022</a>, has announced his candidacy as an independent.<sup about=\"#mwt3689\" class=\"mw-ref reference\" id=\"cite_ref-Bengs_143-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Bengs\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Bengs-143\"}}'><a href=\"#cite_note-Bengs-143\" id=\"mwFlY\"><span class=\"mw-reflink-text\" id=\"mwFlc\"><span class=\"cite-bracket\" id=\"mwFlg\">[</span>119<span class=\"cite-bracket\" id=\"mwFlk\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3690\" typeof=\"mw:Transclusion\" id=\"mwFlo\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"51\" id=\"mwFls\" aria-labelledby=\"Tennessee\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Tennessee\">Tennessee</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=51\" title=\"Edit section: Tennessee\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3691\" typeof=\"mw:Transclusion\" id=\"mwFlw\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Tennessee election\"},\"country\":{\"wt\":\"Tennessee\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Tennessee\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Tennessee\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"election_date\":{\"wt\":\"&lt;!--Don&apos;t need election date in section infoboxes when the date is the same as in the article&apos;s main infobox.-->\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Sen. Bill Hagerty official Senate portrait, 117th Congress (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Bill Hagerty]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Marquita Bradshaw at Morristown (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Marquita Bradshaw]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Bill Hagerty]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3692\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3693\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3694\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3691\" id=\"mwFl0\"><caption class=\"infobox-title summary\">Tennessee election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Tennessee.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Tennessee.svg/60px-Flag_of_Tennessee.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Tennessee.svg/120px-Flag_of_Tennessee.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1000\" data-file-height=\"600\" data-file-type=\"drawing\" height=\"30\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Tennessee\" title=\"2020 United States Senate election in Tennessee\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Sen._Bill_Hagerty_official_Senate_portrait,_117th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Sen._Bill_Hagerty_official_Senate_portrait,_117th_Congress_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg/120px-Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg/250px-Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"783\" data-file-height=\"1066\" data-file-type=\"bitmap\" height=\"136\" width=\"100\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Marquita_Bradshaw_at_Morristown_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Marquita_Bradshaw_at_Morristown_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg/120px-Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg/250px-Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"584\" data-file-height=\"793\" data-file-type=\"bitmap\" height=\"136\" width=\"100\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Bill_Hagerty\" title=\"Bill Hagerty\">Bill Hagerty</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Marquita_Bradshaw\" title=\"Marquita Bradshaw\">Marquita Bradshaw</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Tennessee\" title=\"List of United States senators from Tennessee\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Bill_Hagerty\" title=\"Bill Hagerty\">Bill Hagerty</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3695\" typeof=\"mw:Transclusion\" id=\"mwFl4\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Tennessee\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3696\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3695\" id=\"mwFl8\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Tennessee\" title=\"2026 United States Senate election in Tennessee\">2026 United States Senate election in Tennessee</a></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3697\" typeof=\"mw:Transclusion\" id=\"mwFmA\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Tennessee\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3698\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3697\" id=\"mwFmE\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Tennessee\" title=\"List of United States senators from Tennessee\">List of United States senators from Tennessee</a></div>\n<p id=\"mwFmI\">Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Bill_Hagerty\" title=\"Bill Hagerty\" id=\"mwFmM\">Bill Hagerty</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Tennessee\" title=\"2020 United States Senate election in Tennessee\" id=\"mwFmQ\">elected in 2020</a> with 62.2% of the vote and is seeking reelection.<sup about=\"#mwt3701\" class=\"mw-ref reference\" id=\"cite_ref-Hagerty_311-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Hagerty\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Hagerty-311\"}}'><a href=\"#cite_note-Hagerty-311\" id=\"mwFmU\"><span class=\"mw-reflink-text\" id=\"mwFmY\"><span class=\"cite-bracket\" id=\"mwFmc\">[</span>287<span class=\"cite-bracket\" id=\"mwFmg\">]</span></span></a></sup> Hagerty became the Republican nominee unopposed after no other Republicans qualified for the primary ballot.<sup about=\"#mwt3704\" class=\"mw-ref reference\" id=\"cite_ref-ts_312-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"ts\"},\"body\":{\"id\":\"mw-reference-text-cite_note-ts-312\"}}'><a href=\"#cite_note-ts-312\" id=\"mwFmk\"><span class=\"mw-reflink-text\" id=\"mwFmo\"><span class=\"cite-bracket\" id=\"mwFms\">[</span>288<span class=\"cite-bracket\" id=\"mwFmw\">]</span></span></a></sup></p>\n\n<p id=\"mwFm0\">Consultant Marquita Bradshaw<sup about=\"#mwt3705\" class=\"mw-ref reference\" id=\"cite_ref-ts_312-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"ts\"}}'><a href=\"#cite_note-ts-312\" id=\"mwFm4\"><span class=\"mw-reflink-text\" id=\"mwFm8\"><span class=\"cite-bracket\" id=\"mwFnA\">[</span>288<span class=\"cite-bracket\" id=\"mwFnE\">]</span></span></a></sup> won the Democratic nomination on August 6.<sup about=\"#mwt3708\" class=\"mw-ref reference\" id=\"cite_ref-313\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-313\"}}'><a href=\"#cite_note-313\" id=\"mwFnI\"><span class=\"mw-reflink-text\" id=\"mwFnM\"><span class=\"cite-bracket\" id=\"mwFnQ\">[</span>289<span class=\"cite-bracket\" id=\"mwFnU\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3709\" typeof=\"mw:Transclusion\" id=\"mwFnY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"52\" id=\"mwFnc\" aria-labelledby=\"Texas\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Texas\">Texas</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=52\" title=\"Edit section: Texas\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3710\" typeof=\"mw:Transclusion\" id=\"mwFng\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Texas election\"},\"country\":{\"wt\":\"Texas\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Texas\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Texas\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"election_date\":{\"wt\":\"&lt;!--Don&apos;t need election date in section infoboxes when the date is the same as in the article&apos;s main infobox.-->\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Ken Paxton - 55022425595 (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Ken Paxton]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"James Talarico Press Conference (centered).jpg\"},\"nominee2\":{\"wt\":\"[[James Talarico]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[John Cornyn]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3711\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3712\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3713\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3710\" id=\"mwFnk\"><caption class=\"infobox-title summary\">Texas election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Texas.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Texas.svg/60px-Flag_of_Texas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Texas.svg/120px-Flag_of_Texas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"900\" data-file-height=\"600\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Texas\" title=\"2020 United States Senate election in Texas\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Ken_Paxton_-_55022425595_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Ken_Paxton_-_55022425595_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Ken_Paxton_-_55022425595_%28cropped%29.jpg/120px-Ken_Paxton_-_55022425595_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Ken_Paxton_-_55022425595_%28cropped%29.jpg/250px-Ken_Paxton_-_55022425595_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2023\" data-file-height=\"2698\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:James_Talarico_Press_Conference_(centered).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:James_Talarico_Press_Conference_(centered).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/James_Talarico_Press_Conference_%28centered%29.jpg/120px-James_Talarico_Press_Conference_%28centered%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/James_Talarico_Press_Conference_%28centered%29.jpg/250px-James_Talarico_Press_Conference_%28centered%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"486\" data-file-height=\"647\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ken_Paxton\" title=\"Ken Paxton\">Ken Paxton</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/James_Talarico\" title=\"James Talarico\">James Talarico</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Texas\" title=\"List of United States senators from Texas\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/John_Cornyn\" title=\"John Cornyn\">John Cornyn</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3714\" typeof=\"mw:Transclusion\" id=\"mwFno\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Texas\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3715\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3714\" id=\"mwFns\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Texas\" title=\"2026 United States Senate election in Texas\">2026 United States Senate election in Texas</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3716\" typeof=\"mw:Transclusion\" id=\"mwFnw\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Texas\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3717\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3716\" id=\"mwFn0\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Texas\" title=\"List of United States senators from Texas\">List of United States senators from Texas</a></div>\n<p id=\"mwFn4\">Four-term Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/John_Cornyn\" title=\"John Cornyn\" id=\"mwFn8\">John Cornyn</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Texas\" title=\"2020 United States Senate election in Texas\" id=\"mwFoA\">reelected in 2020</a> with 53.5% of the vote, and ran for a fifth term in 2026.<sup about=\"#mwt3720\" class=\"mw-ref reference\" id=\"cite_ref-JC_314-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"JC\"},\"body\":{\"id\":\"mw-reference-text-cite_note-JC-314\"}}'><a href=\"#cite_note-JC-314\" id=\"mwFoE\"><span class=\"mw-reflink-text\" id=\"mwFoI\"><span class=\"cite-bracket\" id=\"mwFoM\">[</span>290<span class=\"cite-bracket\" id=\"mwFoQ\">]</span></span></a></sup></p>\n\n<p id=\"mwFoU\">Cornyn and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Texas_Attorney_General\" title=\"Texas Attorney General\" id=\"mwFoY\">state Attorney General</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ken_Paxton\" title=\"Ken Paxton\" id=\"mwFoc\">Ken Paxton</a> ran in the Republican primary on March 3. Since neither received more than 50% of the vote, they advanced to a runoff election held on May 26.<sup about=\"#mwt3723\" class=\"mw-ref reference\" id=\"cite_ref-315\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-315\"}}'><a href=\"#cite_note-315\" id=\"mwFog\"><span class=\"mw-reflink-text\" id=\"mwFok\"><span class=\"cite-bracket\" id=\"mwFoo\">[</span>291<span class=\"cite-bracket\" id=\"mwFos\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Representative\" title=\"U.S. Representative\" class=\"mw-redirect\" id=\"mwFow\">U.S. Representative</a> for the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Texas's_38th_congressional_district\" title=\"Texas's 38th congressional district\" id=\"mwFo0\">38th congressional district</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Wesley_Hunt\" title=\"Wesley Hunt\" id=\"mwFo4\">Wesley Hunt</a> challenged Paxton and Cornyn, but lost the primary.<sup about=\"#mwt3726\" class=\"mw-ref reference\" id=\"cite_ref-316\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-316\"}}'><a href=\"#cite_note-316\" id=\"mwFo8\"><span class=\"mw-reflink-text\" id=\"mwFpA\"><span class=\"cite-bracket\" id=\"mwFpE\">[</span>292<span class=\"cite-bracket\" id=\"mwFpI\">]</span></span></a></sup> On May 19, both Hunt and President Trump endorsed Paxton.<sup about=\"#mwt3729\" class=\"mw-ref reference\" id=\"cite_ref-317\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-317\"}}'><a href=\"#cite_note-317\" id=\"mwFpM\"><span class=\"mw-reflink-text\" id=\"mwFpQ\"><span class=\"cite-bracket\" id=\"mwFpU\">[</span>293<span class=\"cite-bracket\" id=\"mwFpY\">]</span></span></a></sup> Paxton defeated Cornyn in the runoff by a landslide and became the Republican nominee.</p>\n\n<p id=\"mwFpc\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Texas_House_of_Representatives\" title=\"Texas House of Representatives\" id=\"mwFpg\">State Representative</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/James_Talarico\" title=\"James Talarico\" id=\"mwFpk\">James Talarico</a> is the Democratic nominee, having defeated U.S. Representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jasmine_Crockett\" title=\"Jasmine Crockett\" id=\"mwFpo\">Jasmine Crockett</a> in the primary.<sup about=\"#mwt3732\" class=\"mw-ref reference\" id=\"cite_ref-TalaricoTX_318-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"TalaricoTX\"},\"body\":{\"id\":\"mw-reference-text-cite_note-TalaricoTX-318\"}}'><a href=\"#cite_note-TalaricoTX-318\" id=\"mwFps\"><span class=\"mw-reflink-text\" id=\"mwFpw\"><span class=\"cite-bracket\" id=\"mwFp0\">[</span>294<span class=\"cite-bracket\" id=\"mwFp4\">]</span></span></a></sup><sup about=\"#mwt3735\" class=\"mw-ref reference\" id=\"cite_ref-CrockettTX_319-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"CrockettTX\"},\"body\":{\"id\":\"mw-reference-text-cite_note-CrockettTX-319\"}}'><a href=\"#cite_note-CrockettTX-319\" id=\"mwFp8\"><span class=\"mw-reflink-text\" id=\"mwFqA\"><span class=\"cite-bracket\" id=\"mwFqE\">[</span>295<span class=\"cite-bracket\" id=\"mwFqI\">]</span></span></a></sup></p> \n\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3736\" typeof=\"mw:Transclusion\" id=\"mwFqM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"53\" id=\"mwFqQ\" aria-labelledby=\"Virginia\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Virginia\">Virginia</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=53\" title=\"Edit section: Virginia\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt373