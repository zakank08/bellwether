:{\"wt\":\"35{{efn|33 Class 2 seats, as well as 2 Class 3 seats being determined in special elections}} of the 100 seats in the [[United States Senate]]\"},\"majority_seats\":{\"wt\":\"51{{efn|Majority control in an evenly divided Senate is determined by the [[Vice President of the United States]], who has the power to break tied votes in their constitutional capacity as President of the Senate; accordingly, Senate control requires 51 seats or 50 seats with control of the vice presidency.}}\"},\"image_size\":{\"wt\":\"x180px\"},\"1blank\":{\"wt\":\"Seats up\"},\"2blank\":{\"wt\":\"Races won\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"image1\":{\"wt\":\"John Thune 117th Congress portrait cropped.jpg\"},\"leader1\":{\"wt\":\"[[John Thune]]\"},\"leader_since1\":{\"wt\":\"[[2024 Senate Republican Conference leadership election|January 3, 2025]]\"},\"leaders_seat1\":{\"wt\":\"[[List of United States senators from South Dakota|South Dakota]]\"},\"seats_before1\":{\"wt\":\"53\"},\"seats_needed1\":{\"wt\":\"{{steady}}\"},\"seats1\":{\"wt\":\"\"},\"seats_after1\":{\"wt\":\"\"},\"seat_change1\":{\"wt\":\"\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"swing1\":{\"wt\":\"\"},\"1data1\":{\"wt\":\"22\"},\"2data1\":{\"wt\":\"\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"image2\":{\"wt\":\"File:Chuck Schumer official photo (3x4a).jpg\"},\"leader2\":{\"wt\":\"[[Chuck Schumer]]\"},\"leader_since2\":{\"wt\":\"January 3, 2017\"},\"leaders_seat2\":{\"wt\":\"[[List of United States senators from New York|New York]]\"},\"seats_before2\":{\"wt\":\"45{{efn|name=Independents}}\"},\"seats_needed2\":{\"wt\":\"{{increase}} 4\"},\"seats2\":{\"wt\":\"\"},\"seats_after2\":{\"wt\":\"\"},\"seat_change2\":{\"wt\":\"\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"swing2\":{\"wt\":\"\"},\"1data2\":{\"wt\":\"13\"},\"2data2\":{\"wt\":\"\"},\"seat_change4\":{\"wt\":\"\"},\"seats_after4\":{\"wt\":\"\"},\"1data4\":{\"wt\":\"0\"},\"2