a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>Tharon Chandler (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-1\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>Andrew Gerena (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-2\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #E81B23;\">▌</span><a href=\"/wiki/Bill_Hagerty\" title=\"Bill Hagerty\">Bill Hagerty</a> (Republican)<sup id=\"cite&#95;ref-TN2026&#95;144-3\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>Jeremy Hearn (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-4\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>Robert Jones (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-5\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>James Macon III (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-6\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>Yoshi Matthews (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-7\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>David Sutman Jr. (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-8\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #DDDDBB;\">▌</span>Catherine Whitson (Independent)<sup id=\"cite&#95;ref-TN2026&#95;144-9\" class=\"reference\"><a href=\"#cite_note-TN2026-144\"><span class=\"cite-bracket\">&#91;</span>120<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n</div>\n</td></tr>\n<tr>\n<th><a href=\"/wiki/2026_United_States_Senate_election_in_Texas\" title=\"2026 United States Senate election in Texas\">Texas</a>\n</th>\n<td style=\"color:black; background-color:#FFB6B6\"><span data-sort-value=\"106&#160;!\">R+6</span>\n</td>\n<td><span data-sort-value=\"Cornyn, John\"><span class=\"vcard\"><span class=\"fn\"><a href=\"/wiki/John_Cornyn\" title=\"John Cornyn\">John Cornyn</a></span></span></span>\n</td>\n<td style=\"color:black; background-color:#FFB6B6\">Republican\n</td>\n<td data-sort-value=\"2002\"><a href=\"/wiki/2002_United_States_Senate_election_in_Texas\" title=\"2002 United States Senate election in Texas\">2002</a><br /><a href=\"/wiki/2008_United_States_Senate_election_in_Texas\" title=\"2008 United States Senate election in Texas\">2008</a><br /><a href=\"/wiki/2014_United_States_Senate_election_in_Texas\" title=\"2014 United States Senate election in Texas\">2014</a><br /><a href=\"/wiki/2020_United_States_Senate_election_in_Texas\" title=\"2020 United States Senate election in Texas\">2020</a>\n</td>\n<td style=\"color:black; background-color:#FFB6B6\" data-sort-value=\"53.5\">53.5% R\n</td>\n<td style=\"background:#DDDDDD\" data-sort-value=\"-1\">Incumbent lost renomination in runoff<sup id=\"cite&#95;ref-CornynDefeat&#95;40-1\" class=\"reference\"><a href=\"#cite_note-CornynDefeat-40\"><span class=\"cite-bracket\">&#91;</span>26<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td nowrap=\"\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1126788409\" /><div class=\"plainlist\">\n<ul><li><span style=\"color: #fed000;\">▌</span>Ted Brown (Libertarian)<sup id=\"cite&#95;ref-TX2026&#95;145-0\" class=\"reference\"><a href=\"#cite_note-TX2026-145\"><span class=\"cite-bracket\">&#91;</span>121<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #E81B23;\">▌</span><a href=\"/wiki/Ken_Paxton\" title=\"Ken Paxton\">Ken Paxton</a> (Republican)<sup id=\"cite&#95;ref-TX2026&#95;145-1\" class=\"reference\"><a href=\"#cite_note-TX2026-145\"><span class=\"cite-bracket\">&#91;</span>121<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #0044C9;\">▌</span><a href=\"/wiki/James_Talarico\" title=\"James Talarico\">James Talarico</a> (Democratic)<sup id=\"cite&#95;ref-TX2026&#95;145-2\" class=\"reference\"><a href=\"#cite_note-TX2026-145\"><span class=\"cite-bracket\">&#91;</span>121<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n</div>\n</td></tr>\n<tr>\n<th><a href=\"/wiki/2026_United_States_Senate_election_in_Virginia\" title=\"2026 United States Senate election in Virginia\">Virginia</a>\n</th>\n<td style=\"color:black;background-color:#B0CEFF\"><span data-sort-value=\"97&#160;!\">D+3</span>\n</td>\n<td><span data-sort-value=\"Warner, Mark\"><span class=\"vcard\"><span class=\"fn\"><a href=\"/wiki/Mark_Warner\" title=\"Mark Warner\">Mark Warner</a></span></span></span>\n</td>\n<td style=\"color:black;background-color:#B0CEFF\">Democratic\n</td>\n<td data-sort-value=\"2008\"><a href=\"/wiki/2008_United_States_Senate_election_in_Virginia\" title=\"2008 United States Senate election in Virginia\">2008</a><br /><a href=\"/wiki/2014_United_States_Senate_election_in_Virginia\" title=\"2014 United States Senate election in Virginia\">2014</a><br /><a href=\"/wiki/2020_United_States_Senate_election_in_Virginia\" title=\"2020 United States Senate election in Virginia\">2020</a>\n</td>\n<td style=\"color:black;background-color:#B0CEFF\" data-sort-value=\"-56.0\">56.0% D\n</td>\n<td data-sort-value=\"1\">Incumbent renominated\n</td>\n<td nowrap=\"\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1126788409\" /><div class=\"plainlist\">\n<ul><li><span style=\"color: #E81B23;\">▌</span><a href=\"/wiki/Bert_Mizusawa\" title=\"Bert Mizusawa\">Bert Mizusawa</a> (Republican)<sup id=\"cite&#95;ref-VA2026&#95;146-0\" class=\"reference\"><a href=\"#cite_note-VA2026-146\"><span class=\"cite-bracket\">&#91;</span>122<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #0044C9;\">▌</span><a href=\"/wiki/Mark_Warner\" title=\"Mark Warner\">Mark Warner</a> (Democratic)<sup id=\"cite&#95;ref-WarnerVA&#95;147-0\" class=\"reference\"><a href=\"#cite_note-WarnerVA-147\"><span class=\"cite-bracket\">&#91;</span>123<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n</div>\n</td></tr>\n<tr>\n<th><a href=\"/wiki/2026_United_States_Senate_election_in_West_Virginia\" title=\"2026 United States Senate election in West Virginia\">West Virginia</a>\n</th>\n<td style=\"color:black; background-color:#FFB6B6\"><span data-sort-value=\"121&#160;!\">R+21</span>\n</td>\n<td><span data-sort-value=\"Moore Capito, Shelley\"><span class=\"vcard\"><span class=\"fn\"><a href=\"/wiki/Shelley_Moore_Capito\" title=\"Shelley Moore Capito\">Shelley Moore Capito</a></span></span></span>\n</td>\n<td style=\"color:black; background-color:#FFB6B6\">Republican\n</td>\n<td data-sort-value=\"2014\"><a href=\"/wiki/2014_United_States_Senate_election_in_West_Virginia\" title=\"2014 United States Senate election in West Virginia\">2014</a><br /><a href=\"/wiki/2020_United_States_Senate_election_in_West_Virginia\" title=\"2020 United States Senate election in West Virginia\">2020</a>\n</td>\n<td style=\"color:black; background-color:#FFB6B6\" data-sort-value=\"70.3\">70.3% R\n</td>\n<td data-sort-value=\"0\">Incumbent renominated\n</td>\n<td nowrap=\"\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1126788409\" /><div class=\"plainlist\">\n<ul><li><span style=\"color: #0044C9;\">▌</span>Rachel Fetty Anderson (Democratic)<sup id=\"cite&#95;ref-WV2026&#95;148-0\" class=\"reference\"><a href=\"#cite_note-WV2026-148\"><span class=\"cite-bracket\">&#91;</span>124<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #E81B23;\">▌</span><a href=\"/wiki/Shelley_Moore_Capito\" title=\"Shelley Moore Capito\">Shelley Moore Capito</a> (Republican)<sup id=\"cite&#95;ref-WV2026&#95;148-1\" class=\"reference\"><a href=\"#cite_note-WV2026-148\"><span class=\"cite-bracket\">&#91;</span>124<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #A356DE;\">▌</span><a href=\"/wiki/S._Marshall_Wilson\" title=\"S. Marshall Wilson\">S. Marshall Wilson</a> (Constitution)<sup id=\"cite&#95;ref-WV2026&#95;148-2\" class=\"reference\"><a href=\"#cite_note-WV2026-148\"><span class=\"cite-bracket\">&#91;</span>124<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n</div>\n</td></tr>\n<tr>\n<th><a href=\"/wiki/2026_United_States_Senate_election_in_Wyoming\" title=\"2026 United States Senate election in Wyoming\">Wyoming</a>\n</th>\n<td style=\"color:black; background-color:#FFB6B6\"><span data-sort-value=\"123&#160;!\">R+23</span>\n</td>\n<td><span data-sort-value=\"Lummis, Cynthia\"><span class=\"vcard\"><span class=\"fn\"><a href=\"/wiki/Cynthia_Lummis\" title=\"Cynthia Lummis\">Cynthia Lummis</a></span></span></span>\n</td>\n<td style=\"color:black; background-color:#FFB6B6\">Republican\n</td>\n<td data-sort-value=\"2020\"><a href=\"/wiki/2020_United_States_Senate_election_in_Wyoming\" title=\"2020 United States Senate election in Wyoming\">2020</a>\n</td>\n<td style=\"color:black; background-color:#FFB6B6\" data-sort-value=\"72.9\">72.9% R\n</td>\n<td style=\"background:#DDDDDD\" data-sort-value=\"-1\">Incumbent retiring<sup id=\"cite&#95;ref-Lummis&#95;38-1\" class=\"reference\"><a href=\"#cite_note-Lummis-38\"><span class=\"cite-bracket\">&#91;</span>24<span class=\"cite-bracket\">&#93;</span></a></sup>\n</td>\n<td nowrap=\"\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1126788409\" /><div class=\"plainlist\">\n<ul><li><span style=\"color: #0044C9;\">▌</span><a href=\"/wiki/James_W._Byrd\" title=\"James W. Byrd\">James W. Byrd</a> (Democratic)<sup id=\"cite&#95;ref-WY2026&#95;149-0\" class=\"reference\"><a href=\"#cite_note-WY2026-149\"><span class=\"cite-bracket\">&#91;</span>125<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li><span style=\"color: #E81B23;\">▌</span><a href=\"/wiki/Harriet_Hageman\" title=\"Harriet Hageman\">Harriet Hageman</a> (Republican)<sup id=\"cite&#95;ref-WY2026&#95;149-1\" class=\"reference\"><a href=\"#cite_note-WY2026-149\"><span class=\"cite-bracket\">&#91;</span>125<span class=\"cite-bracket\">&#93;</span></a></sup></li></ul>\n</div>\n</td></tr></tbody></table>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Alabama\">Alabama</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=20\" title=\"Edit section: Alabama\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Alabama election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Flag_of_Alabama.svg/60px-Flag_of_Alabama.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Flag_of_Alabama.svg/120px-Flag_of_Alabama.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"600\" data-file-height=\"400\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Alabama\" title=\"2020 United States Senate election in Alabama\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Rep._Barry_Moore_official_photo.jpg_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Rep._Barry_Moore_official_photo.jpg_%28cropped%29.jpg/120px-Rep._Barry_Moore_official_photo.jpg_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8e/Rep._Barry_Moore_official_photo.jpg_%28cropped%29.jpg/250px-Rep._Barry_Moore_official_photo.jpg_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"979\" data-file-height=\"1219\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Barry_Moore_(American_politician)\" title=\"Barry Moore (American politician)\">Barry Moore</a>\n</td>\n<td style=\"width:75px;text-align:center\">Everett Wess\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Alabama\" title=\"List of United States senators from Alabama\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Tommy_Tuberville\" title=\"Tommy Tuberville\">Tommy Tuberville</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Alabama\" title=\"2026 United States Senate election in Alabama\">2026 United States Senate election in Alabama</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Alabama\" title=\"List of United States senators from Alabama\">List of United States senators from Alabama</a></div>\n<p>Republican <a href=\"/wiki/Tommy_Tuberville\" title=\"Tommy Tuberville\">Tommy Tuberville</a>, who was elected in <a href=\"/wiki/2020_United_States_Senate_election_in_Alabama\" title=\"2020 United States Senate election in Alabama\">2020</a> with 60.1% of the vote, initially planned to seek reelection. But on May 27, 2025, he announced that he would instead run for <a href=\"/wiki/2026_Alabama_gubernatorial_election\" title=\"2026 Alabama gubernatorial election\">governor of Alabama</a><sup id=\"cite&#95;ref-o472&#95;150-0\" class=\"reference\"><a href=\"#cite_note-o472-150\"><span class=\"cite-bracket\">&#91;</span>126<span class=\"cite-bracket\">&#93;</span></a></sup>.\n</p><p>Held on May 19, the Republican primary featured U.S. Representative <a href=\"/wiki/Barry_Moore_(American_politician)\" title=\"Barry Moore (American politician)\">Barry Moore</a>,<sup id=\"cite&#95;ref-151\" class=\"reference\"><a href=\"#cite_note-151\"><span class=\"cite-bracket\">&#91;</span>127<span class=\"cite-bracket\">&#93;</span></a></sup> former <a href=\"/wiki/Navy_SEAL\" class=\"mw-redirect\" title=\"Navy SEAL\">Navy SEAL</a> Jared Hudson,<sup id=\"cite&#95;ref-152\" class=\"reference\"><a href=\"#cite_note-152\"><span class=\"cite-bracket\">&#91;</span>128<span class=\"cite-bracket\">&#93;</span></a></sup> and <a href=\"/wiki/Attorney_general_of_Alabama\" class=\"mw-redirect\" title=\"Attorney general of Alabama\">state attorney general</a> <a href=\"/wiki/Steve_Marshall\" title=\"Steve Marshall\">Steve Marshall</a>.<sup id=\"cite&#95;ref-MarshallAL&#95;153-0\" class=\"reference\"><a href=\"#cite_note-MarshallAL-153\"><span class=\"cite-bracket\">&#91;</span>129<span class=\"cite-bracket\">&#93;</span></a></sup> Since no candidate reached 50%, a runoff was held on June 16 between the top two finishers. Moore won the runoff, becoming the Republican nominee.\n</p><p>In the Democratic primary, no candidate received 50%, so a runoff was held between businessman Dakarai Larriet and attorney Everett Wess.<sup id=\"cite&#95;ref-Larriett&#95;154-0\" class=\"reference\"><a href=\"#cite_note-Larriett-154\"><span class=\"cite-bracket\">&#91;</span>130<span class=\"cite-bracket\">&#93;</span></a></sup> Wess won the runoff with 54.6% of the vote.<sup id=\"cite&#95;ref-:5&#95;155-0\" class=\"reference\"><a href=\"#cite_note-:5-155\"><span class=\"cite-bracket\">&#91;</span>131<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Alaska\">Alaska</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=21\" title=\"Edit section: Alaska\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Alaska election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Flag_of_Alaska.svg/60px-Flag_of_Alaska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Flag_of_Alaska.svg/120px-Flag_of_Alaska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1416\" data-file-height=\"1000\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Alaska\" title=\"2020 United States Senate election in Alaska\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Senator_Sullivan_Memorial_Day_2024_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Senator_Sullivan_Memorial_Day_2024_%28cropped%29.jpg/120px-Senator_Sullivan_Memorial_Day_2024_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/83/Senator_Sullivan_Memorial_Day_2024_%28cropped%29.jpg/250px-Senator_Sullivan_Memorial_Day_2024_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2309\" data-file-height=\"3134\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Mary_Peltola_Congressional_Member_Portrait_(2)_(cropped).jpeg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Mary_Peltola_Congressional_Member_Portrait_%282%29_%28cropped%29.jpeg/120px-Mary_Peltola_Congressional_Member_Portrait_%282%29_%28cropped%29.jpeg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"110\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Mary_Peltola_Congressional_Member_Portrait_%282%29_%28cropped%29.jpeg/250px-Mary_Peltola_Congressional_Member_Portrait_%282%29_%28cropped%29.jpeg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2400\" data-file-height=\"2963\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Candidate\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Dan_Sullivan_(U.S._senator)\" title=\"Dan Sullivan (U.S. senator)\">Dan S. Sullivan</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Mary_Peltola\" title=\"Mary Peltola\">Mary Peltola</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Alaska\" title=\"List of United States senators from Alaska\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Dan_Sullivan_(U.S._senator)\" title=\"Dan Sullivan (U.S. senator)\">Dan S. Sullivan</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Alaska\" title=\"2026 United States Senate election in Alaska\">2026 United States Senate election in Alaska</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Alaska\" title=\"List of United States senators from Alaska\">List of United States senators from Alaska</a></div>\n<p>Two-term Republican <a href=\"/wiki/Dan_Sullivan_(U.S._senator)\" title=\"Dan Sullivan (U.S. senator)\">Dan S. Sullivan</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Alaska\" title=\"2020 United States Senate election in Alaska\">reelected in 2020</a> with 53.9% of the vote. He is running for reelection to a third term.<sup id=\"cite&#95;ref-156\" class=\"reference\"><a href=\"#cite_note-156\"><span class=\"cite-bracket\">&#91;</span>132<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>A <a href=\"/wiki/Nonpartisan_primary\" title=\"Nonpartisan primary\">nonpartisan primary</a> was held on August 18, 2026, with the top four candidates advancing to the general election, which will be conducted using <a href=\"/wiki/Ranked-choice_voting_in_the_United_States\" title=\"Ranked-choice voting in the United States\">ranked-choice voting</a>. The advancing candidates are incumbent Republican senator Dan S. Sullivan, perennial Republican candidate Gerald Heikes,<sup id=\"cite&#95;ref-:6&#95;157-0\" class=\"reference\"><a href=\"#cite_note-:6-157\"><span class=\"cite-bracket\">&#91;</span>133<span class=\"cite-bracket\">&#93;</span></a></sup> former Democratic U.S. representative <a href=\"/wiki/Mary_Peltola\" title=\"Mary Peltola\">Mary Peltola</a>, and former <a href=\"/wiki/United_States_Forest_Service\" title=\"United States Forest Service\">U.S. Forest Service</a> employee Dan J. Sullivan, despite efforts to disqualify him.<sup id=\"cite&#95;ref-158\" class=\"reference\"><a href=\"#cite_note-158\"><span class=\"cite-bracket\">&#91;</span>134<span class=\"cite-bracket\">&#93;</span></a></sup> Some Republicans have alleged that Dan J. Sullivan's candidacy is intended to confuse voters seeking to support the incumbent senator, who shares his first and last names.<sup id=\"cite&#95;ref-159\" class=\"reference\"><a href=\"#cite_note-159\"><span class=\"cite-bracket\">&#91;</span>135<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Arkansas\">Arkansas</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=22\" title=\"Edit section: Arkansas\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Arkansas election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Flag_of_Arkansas.svg/60px-Flag_of_Arkansas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Flag_of_Arkansas.svg/120px-Flag_of_Arkansas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"450\" data-file-height=\"300\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Arkansas\" title=\"2020 United States Senate election in Arkansas\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Tom_Cotton_official_Senate_photo_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Tom_Cotton_official_Senate_photo_%28cropped%29.jpg/120px-Tom_Cotton_official_Senate_photo_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Tom_Cotton_official_Senate_photo_%28cropped%29.jpg/250px-Tom_Cotton_official_Senate_photo_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"796\" data-file-height=\"1061\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Hallie_Shoffner_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7c/Hallie_Shoffner_%28cropped_2%29.jpg/120px-Hallie_Shoffner_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7c/Hallie_Shoffner_%28cropped_2%29.jpg/250px-Hallie_Shoffner_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"472\" data-file-height=\"629\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Tom_Cotton\" title=\"Tom Cotton\">Tom Cotton</a>\n</td>\n<td style=\"width:75px;text-align:center\">Hallie Shoffner\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Arkansas\" title=\"List of United States senators from Arkansas\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Tom_Cotton\" title=\"Tom Cotton\">Tom Cotton</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Arkansas\" title=\"2026 United States Senate election in Arkansas\">2026 United States Senate election in Arkansas</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Arkansas\" title=\"List of United States senators from Arkansas\">List of United States senators from Arkansas</a></div>\n<p>Two-term Republican <a href=\"/wiki/Tom_Cotton\" title=\"Tom Cotton\">Tom Cotton</a> was reelected in <a href=\"/wiki/2020_United_States_Senate_election_in_Arkansas\" title=\"2020 United States Senate election in Arkansas\">2020</a> with 66.5% of the vote. Cotton is running for reelection,<sup id=\"cite&#95;ref-Cotton&#95;160-0\" class=\"reference\"><a href=\"#cite_note-Cotton-160\"><span class=\"cite-bracket\">&#91;</span>136<span class=\"cite-bracket\">&#93;</span></a></sup> having secured the Republican nomination on March 3, 2026.\n</p><p>Rice farmer Hallie Shoffner defeated Ethan Dunbar in the March 3 Democratic primary.<sup id=\"cite&#95;ref-161\" class=\"reference\"><a href=\"#cite_note-161\"><span class=\"cite-bracket\">&#91;</span>137<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Colorado\">Colorado</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=23\" title=\"Edit section: Colorado\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Colorado election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Flag_of_Colorado.svg/60px-Flag_of_Colorado.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Flag_of_Colorado.svg/120px-Flag_of_Colorado.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1800\" data-file-height=\"1200\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Colorado\" title=\"2020 United States Senate election in Colorado\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:John_Hickenlooper,_official_portrait,_117th_Congress_(cropped).jpeg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/db/John_Hickenlooper%2C_official_portrait%2C_117th_Congress_%28cropped%29.jpeg/120px-John_Hickenlooper%2C_official_portrait%2C_117th_Congress_%28cropped%29.jpeg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/db/John_Hickenlooper%2C_official_portrait%2C_117th_Congress_%28cropped%29.jpeg/250px-John_Hickenlooper%2C_official_portrait%2C_117th_Congress_%28cropped%29.jpeg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2160\" data-file-height=\"2700\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Mark_Baisley_in_2024_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Mark_Baisley_in_2024_%28cropped%29.jpg/120px-Mark_Baisley_in_2024_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Mark_Baisley_in_2024_%28cropped%29.jpg/250px-Mark_Baisley_in_2024_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"914\" data-file-height=\"1220\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/John_Hickenlooper\" title=\"John Hickenlooper\">John Hickenlooper</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Mark_Baisley\" title=\"Mark Baisley\">Mark Baisley</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Colorado\" title=\"List of United States senators from Colorado\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/John_Hickenlooper\" title=\"John Hickenlooper\">John Hickenlooper</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Colorado\" title=\"2026 United States Senate election in Colorado\">2026 United States Senate election in Colorado</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Colorado\" title=\"List of United States senators from Colorado\">List of United States senators from Colorado</a></div>\n<p>One-term <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democrat</a> <a href=\"/wiki/John_Hickenlooper\" title=\"John Hickenlooper\">John Hickenlooper</a>, elected with 53.5% of the vote in <a href=\"/wiki/2020_United_States_Senate_election_in_Colorado\" title=\"2020 United States Senate election in Colorado\">2020</a>, is running for reelection for a second term, and has said it will be his last term.<sup id=\"cite&#95;ref-Denver&#95;Gazette&#95;162-0\" class=\"reference\"><a href=\"#cite_note-Denver_Gazette-162\"><span class=\"cite-bracket\">&#91;</span>138<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-163\" class=\"reference\"><a href=\"#cite_note-163\"><span class=\"cite-bracket\">&#91;</span>139<span class=\"cite-bracket\">&#93;</span></a></sup> Hickenlooper defeated <a href=\"/wiki/Progressivism_in_the_United_States\" title=\"Progressivism in the United States\">progressive</a> state Senator <a href=\"/wiki/Julie_Gonzales\" title=\"Julie Gonzales\">Julie Gonzales</a> in the Democratic primary, 53% to 47%.<sup id=\"cite&#95;ref-GonzalesCO&#95;164-0\" class=\"reference\"><a href=\"#cite_note-GonzalesCO-164\"><span class=\"cite-bracket\">&#91;</span>140<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-BreslinCO&#95;165-0\" class=\"reference\"><a href=\"#cite_note-BreslinCO-165\"><span class=\"cite-bracket\">&#91;</span>141<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/Colorado_Senate\" title=\"Colorado Senate\">State Senator</a> <a href=\"/wiki/Mark_Baisley\" title=\"Mark Baisley\">Mark Baisley</a> is the Republican nominee following the <a href=\"/wiki/Colorado_Republican_Party\" title=\"Colorado Republican Party\">Colorado Republican</a> Assembly on April 11, as no other candidates surpassed the 30% threshold.<sup id=\"cite&#95;ref-166\" class=\"reference\"><a href=\"#cite_note-166\"><span class=\"cite-bracket\">&#91;</span>142<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-Baisley&#95;167-0\" class=\"reference\"><a href=\"#cite_note-Baisley-167\"><span class=\"cite-bracket\">&#91;</span>143<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Delaware\">Delaware</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=24\" title=\"Edit section: Delaware\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Delaware election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Flag_of_Delaware.svg/60px-Flag_of_Delaware.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Flag_of_Delaware.svg/120px-Flag_of_Delaware.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"600\" data-file-height=\"400\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Delaware\" title=\"2020 United States Senate election in Delaware\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Chris_Coons_2024.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Chris_Coons_2024.jpg/120px-Chris_Coons_2024.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"103\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/20/Chris_Coons_2024.jpg/250px-Chris_Coons_2024.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1159\" data-file-height=\"1529\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Chris_Coons\" title=\"Chris Coons\">Chris Coons</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Michael_Katz_(politician)\" title=\"Michael Katz (politician)\">Michael Katz</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Delaware\" title=\"List of United States senators from Delaware\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Chris_Coons\" title=\"Chris Coons\">Chris Coons</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Delaware\" title=\"2026 United States Senate election in Delaware\">2026 United States Senate election in Delaware</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Delaware\" title=\"List of United States senators from Delaware\">List of United States senators from Delaware</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Chris_Coons\" title=\"Chris Coons\">Chris Coons</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Delaware\" title=\"2020 United States Senate election in Delaware\">reelected in 2020</a> with 59.4% of the vote and is running for reelection.<sup id=\"cite&#95;ref-:02&#95;168-0\" class=\"reference\"><a href=\"#cite_note-:02-168\"><span class=\"cite-bracket\">&#91;</span>144<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>Coons faced three challengers in the Democratic primary: philosopher and educator Jeff Appelhans, E. No-Trump Hansen, and domestic violence advocate Mary Louve.<sup id=\"cite&#95;ref-:02&#95;168-1\" class=\"reference\"><a href=\"#cite_note-:02-168\"><span class=\"cite-bracket\">&#91;</span>144<span class=\"cite-bracket\">&#93;</span></a></sup> Coons won the nomination with approximately 78% of the vote.<sup id=\"cite&#95;ref-:11&#95;169-0\" class=\"reference\"><a href=\"#cite_note-:11-169\"><span class=\"cite-bracket\">&#91;</span>145<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former Democratic <a href=\"/wiki/Delaware_Senate\" title=\"Delaware Senate\">state Senator</a> and <a href=\"/wiki/Independent_Party_of_Delaware\" title=\"Independent Party of Delaware\">Independent Party of Delaware</a> nominee for U.S. Senate in <a href=\"/wiki/2024_United_States_Senate_election_in_Delaware\" title=\"2024 United States Senate election in Delaware\">2024</a> <a href=\"/wiki/Michael_Katz_(politician)\" title=\"Michael Katz (politician)\">Michael Katz</a> defeated <a href=\"/wiki/U.S._Army_War_College\" class=\"mw-redirect\" title=\"U.S. Army War College\">U.S. Army War College</a> instructor John Shulli in the Republican primary.<sup id=\"cite&#95;ref-:11&#95;169-1\" class=\"reference\"><a href=\"#cite_note-:11-169\"><span class=\"cite-bracket\">&#91;</span>145<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Florida_(special)\"><span id=\"Florida_.28special.29\"></span>Florida (special)</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=25\" title=\"Edit section: Florida (special)\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Florida special election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Florida.svg/60px-Flag_of_Florida.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Florida.svg/120px-Flag_of_Florida.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"4500\" data-file-height=\"3000\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2022_United_States_Senate_election_in_Florida\" title=\"2022 United States Senate election in Florida\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2028_United_States_Senate_election_in_Florida\" class=\"mw-redirect\" title=\"2028 United States Senate election in Florida\"><i>2028</i></a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Official_Portrait_of_Senator_Ashley_Moody_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Official_Portrait_of_Senator_Ashley_Moody_%28cropped_2%29.jpg/120px-Official_Portrait_of_Senator_Ashley_Moody_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0f/Official_Portrait_of_Senator_Ashley_Moody_%28cropped_2%29.jpg/250px-Official_Portrait_of_Senator_Ashley_Moody_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1313\" data-file-height=\"1750\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Angie_Nixon_official_portrait_2022_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Angie_Nixon_official_portrait_2022_%28cropped%29.jpg/120px-Angie_Nixon_official_portrait_2022_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Angie_Nixon_official_portrait_2022_%28cropped%29.jpg/250px-Angie_Nixon_official_portrait_2022_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"662\" data-file-height=\"883\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Ashley_Moody\" title=\"Ashley Moody\">Ashley Moody</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Angie_Nixon\" title=\"Angie Nixon\">Angie Nixon</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Florida\" title=\"List of United States senators from Florida\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Ashley_Moody\" title=\"Ashley Moody\">Ashley Moody</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_special_election_in_Florida\" title=\"2026 United States Senate special election in Florida\">2026 United States Senate special election in Florida</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Florida\" title=\"List of United States senators from Florida\">List of United States senators from Florida</a></div>\n<p>Three-term Republican <a href=\"/wiki/Marco_Rubio\" title=\"Marco Rubio\">Marco Rubio</a> was <a href=\"/wiki/2022_United_States_Senate_election_in_Florida\" title=\"2022 United States Senate election in Florida\">reelected in 2022</a> with 57.68% of the vote. He resigned on January 20, 2025, following his confirmation as <a href=\"/wiki/United_States_Secretary_of_State\" title=\"United States Secretary of State\">U.S. Secretary of State</a>. <a href=\"/wiki/Governor_of_Florida\" title=\"Governor of Florida\">Governor</a> <a href=\"/wiki/Ron_DeSantis\" title=\"Ron DeSantis\">Ron DeSantis</a> subsequently appointed <a href=\"/wiki/Attorney_General_of_Florida\" class=\"mw-redirect\" title=\"Attorney General of Florida\">Florida Attorney General</a> <a href=\"/wiki/Ashley_Moody\" title=\"Ashley Moody\">Ashley Moody</a> to serve as interim senator until the <a href=\"/wiki/2026_United_States_Senate_special_election_in_Florida\" title=\"2026 United States Senate special election in Florida\">2026 special election</a>.<sup id=\"cite&#95;ref-170\" class=\"reference\"><a href=\"#cite_note-170\"><span class=\"cite-bracket\">&#91;</span>146<span class=\"cite-bracket\">&#93;</span></a></sup> Moody ran to serve the remainder of Rubio's term and won the Republican nomination in the August 18 primary.<sup id=\"cite&#95;ref-moody50&#95;171-0\" class=\"reference\"><a href=\"#cite_note-moody50-171\"><span class=\"cite-bracket\">&#91;</span>147<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/Florida_House_of_Representatives\" title=\"Florida House of Representatives\">State Representative</a> <a href=\"/wiki/Angie_Nixon\" title=\"Angie Nixon\">Angie Nixon</a><sup id=\"cite&#95;ref-172\" class=\"reference\"><a href=\"#cite_note-172\"><span class=\"cite-bracket\">&#91;</span>148<span class=\"cite-bracket\">&#93;</span></a></sup> defeated <a href=\"/wiki/Alex_Vindman\" title=\"Alex Vindman\">Alex Vindman</a>, former director for European affairs at the <a href=\"/wiki/United_States_National_Security_Council\" title=\"United States National Security Council\">U.S. National Security Council</a>, a <a href=\"/wiki/Whistleblowing\" title=\"Whistleblowing\">whistleblower</a> in the <a href=\"/wiki/2019_Trump%E2%80%93Ukraine_scandal\" title=\"2019 Trump–Ukraine scandal\">2019 Trump–Ukraine scandal</a>, and the twin brother of <a href=\"/wiki/Virginia\" title=\"Virginia\">Virginia</a> <a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Eugene_Vindman\" title=\"Eugene Vindman\">Eugene Vindman</a><sup id=\"cite&#95;ref-173\" class=\"reference\"><a href=\"#cite_note-173\"><span class=\"cite-bracket\">&#91;</span>149<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-174\" class=\"reference\"><a href=\"#cite_note-174\"><span class=\"cite-bracket\">&#91;</span>150<span class=\"cite-bracket\">&#93;</span></a></sup> in the August 18 Democratic primary.\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Georgia\">Georgia</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=26\" title=\"Edit section: Georgia\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Georgia election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Flag_of_the_State_of_Georgia.svg/60px-Flag_of_the_State_of_Georgia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"31\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Flag_of_the_State_of_Georgia.svg/120px-Flag_of_the_State_of_Georgia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"960\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020%E2%80%9321_United_States_Senate_election_in_Georgia\" title=\"2020–21 United States Senate election in Georgia\">2020–21</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Jon_Ossoff_Senate_Portrait_2021_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Jon_Ossoff_Senate_Portrait_2021_%28cropped%29.jpg/120px-Jon_Ossoff_Senate_Portrait_2021_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"103\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1f/Jon_Ossoff_Senate_Portrait_2021_%28cropped%29.jpg/250px-Jon_Ossoff_Senate_Portrait_2021_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2447\" data-file-height=\"3238\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Rep._Mike_Collins_official_photo,_118th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Rep._Mike_Collins_official_photo%2C_118th_Congress_%28cropped%29.jpg/120px-Rep._Mike_Collins_official_photo%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"103\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/Rep._Mike_Collins_official_photo%2C_118th_Congress_%28cropped%29.jpg/250px-Rep._Mike_Collins_official_photo%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"312\" data-file-height=\"412\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Jon_Ossoff\" title=\"Jon Ossoff\">Jon Ossoff</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Mike_Collins_(politician)\" title=\"Mike Collins (politician)\">Mike Collins</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Georgia\" title=\"List of United States senators from Georgia\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Jon_Ossoff\" title=\"Jon Ossoff\">Jon Ossoff</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Georgia\" title=\"2026 United States Senate election in Georgia\">2026 United States Senate election in Georgia</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Georgia\" title=\"List of United States senators from Georgia\">List of United States senators from Georgia</a></div>\n<p>One-term Democrat <a href=\"/wiki/Jon_Ossoff\" title=\"Jon Ossoff\">Jon Ossoff</a> is running for a second term.<sup id=\"cite&#95;ref-Ossoff&#95;175-0\" class=\"reference\"><a href=\"#cite_note-Ossoff-175\"><span class=\"cite-bracket\">&#91;</span>151<span class=\"cite-bracket\">&#93;</span></a></sup> He was narrowly elected in a <a href=\"/wiki/2020%E2%80%9321_United_States_Senate_election_in_Georgia\" title=\"2020–21 United States Senate election in Georgia\">2021 runoff</a> with 50.6% of the vote. Ossoff won the Democratic nomination unopposed, as he was the only candidate to submit the required number of signatures to appear on the primary ballot.<sup id=\"cite&#95;ref-176\" class=\"reference\"><a href=\"#cite_note-176\"><span class=\"cite-bracket\">&#91;</span>152<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>The Republican primary took place on May 19. U.S. Representative <a href=\"/wiki/Mike_Collins_(politician)\" title=\"Mike Collins (politician)\">Mike Collins</a><sup id=\"cite&#95;ref-177\" class=\"reference\"><a href=\"#cite_note-177\"><span class=\"cite-bracket\">&#91;</span>153<span class=\"cite-bracket\">&#93;</span></a></sup> and former <a href=\"/wiki/University_of_Tennessee_football\" class=\"mw-redirect\" title=\"University of Tennessee football\">University of Tennessee football</a> coach <a href=\"/wiki/Derek_Dooley_(American_football)\" title=\"Derek Dooley (American football)\">Derek Dooley</a><sup id=\"cite&#95;ref-178\" class=\"reference\"><a href=\"#cite_note-178\"><span class=\"cite-bracket\">&#91;</span>154<span class=\"cite-bracket\">&#93;</span></a></sup> advanced to a June 16 runoff, which Collins won with 56% of the vote.<sup id=\"cite&#95;ref-179\" class=\"reference\"><a href=\"#cite_note-179\"><span class=\"cite-bracket\">&#91;</span>155<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Idaho\">Idaho</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=27\" title=\"Edit section: Idaho\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Idaho election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Flag_of_Idaho.svg/60px-Flag_of_Idaho.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"39\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a4/Flag_of_Idaho.svg/120px-Flag_of_Idaho.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3168\" data-file-height=\"2496\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Idaho\" title=\"2020 United States Senate election in Idaho\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Jim_Risch_2021_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Jim_Risch_2021_%28cropped%29.jpg/120px-Jim_Risch_2021_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e2/Jim_Risch_2021_%28cropped%29.jpg/250px-Jim_Risch_2021_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"482\" data-file-height=\"639\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #DDDDBB;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Todd_Achilles_2026_(cropped2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Todd_Achilles_2026_%28cropped2%29.jpg/120px-Todd_Achilles_2026_%28cropped2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Todd_Achilles_2026_%28cropped2%29.jpg/250px-Todd_Achilles_2026_%28cropped2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"545\" data-file-height=\"749\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Jim_Risch\" title=\"Jim Risch\">Jim Risch</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Todd_Achilles\" title=\"Todd Achilles\">Todd Achilles</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Independent_(US)\" class=\"mw-redirect\" title=\"Independent (US)\">Independent</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Idaho\" title=\"List of United States senators from Idaho\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Jim_Risch\" title=\"Jim Risch\">Jim Risch</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Idaho\" title=\"2026 United States Senate election in Idaho\">2026 United States Senate election in Idaho</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Idaho\" title=\"List of United States senators from Idaho\">List of United States senators from Idaho</a></div>\n<p>Three-term Republican <a href=\"/wiki/Jim_Risch\" title=\"Jim Risch\">Jim Risch</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Idaho\" title=\"2020 United States Senate election in Idaho\">reelected in 2020</a> with 62.6% of the vote and is running for a fourth term.<sup id=\"cite&#95;ref-Risch2&#95;180-0\" class=\"reference\"><a href=\"#cite_note-Risch2-180\"><span class=\"cite-bracket\">&#91;</span>156<span class=\"cite-bracket\">&#93;</span></a></sup> He won the Republican nomination on May 19, defeating data engineer and <a href=\"/wiki/2020_United_States_House_of_Representatives_elections_in_Idaho#District_1\" title=\"2020 United States House of Representatives elections in Idaho\">2020</a> <a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a> nominee for <a href=\"/wiki/Idaho%27s_1st_congressional_district\" title=\"Idaho&#39;s 1st congressional district\">Idaho's 1st congressional district</a> Joe Evans, entrepreneur Denny LaVe, and engineer Josh Roy.<sup id=\"cite&#95;ref-wr&#95;181-0\" class=\"reference\"><a href=\"#cite_note-wr-181\"><span class=\"cite-bracket\">&#91;</span>157<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>David Roth, a realtor and the Democratic nominee for U.S. Senate in <a href=\"/wiki/2022_United_States_Senate_election_in_Idaho\" title=\"2022 United States Senate election in Idaho\">2022</a>,<sup id=\"cite&#95;ref-182\" class=\"reference\"><a href=\"#cite_note-182\"><span class=\"cite-bracket\">&#91;</span>158<span class=\"cite-bracket\">&#93;</span></a></sup> defeated Nickolas Bonds and Brad Moore<sup id=\"cite&#95;ref-wr&#95;181-1\" class=\"reference\"><a href=\"#cite_note-wr-181\"><span class=\"cite-bracket\">&#91;</span>157<span class=\"cite-bracket\">&#93;</span></a></sup> in the May 19 Democratic primary,<sup id=\"cite&#95;ref-183\" class=\"reference\"><a href=\"#cite_note-183\"><span class=\"cite-bracket\">&#91;</span>159<span class=\"cite-bracket\">&#93;</span></a></sup> but withdrew from the race on July 28.<sup id=\"cite&#95;ref-184\" class=\"reference\"><a href=\"#cite_note-184\"><span class=\"cite-bracket\">&#91;</span>160<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Matt Loesby, the nominee for Idaho's 1st congressional district in <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Idaho#District_1\" title=\"2024 United States House of Representatives elections in Idaho\">2024</a>,<sup id=\"cite&#95;ref-185\" class=\"reference\"><a href=\"#cite_note-185\"><span class=\"cite-bracket\">&#91;</span>161<span class=\"cite-bracket\">&#93;</span></a></sup> is running as a Libertarian. Former Democratic <a href=\"/wiki/Idaho_House_of_Representatives\" title=\"Idaho House of Representatives\">state representative</a> <a href=\"/wiki/Todd_Achilles\" title=\"Todd Achilles\">Todd Achilles</a><sup id=\"cite&#95;ref-AchillesID2&#95;186-0\" class=\"reference\"><a href=\"#cite_note-AchillesID2-186\"><span class=\"cite-bracket\">&#91;</span>162<span class=\"cite-bracket\">&#93;</span></a></sup> and software developer Natalie Fleming<sup id=\"cite&#95;ref-wr&#95;181-2\" class=\"reference\"><a href=\"#cite_note-wr-181\"><span class=\"cite-bracket\">&#91;</span>157<span class=\"cite-bracket\">&#93;</span></a></sup> are running as <a href=\"/wiki/Independent_politician\" title=\"Independent politician\">independents</a>.\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Illinois\">Illinois</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=28\" title=\"Edit section: Illinois\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Illinois election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Flag_of_Illinois.svg/60px-Flag_of_Illinois.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Flag_of_Illinois.svg/120px-Flag_of_Illinois.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"500\" data-file-height=\"300\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Illinois\" title=\"2020 United States Senate election in Illinois\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Juliana_Stratton_2023_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Juliana_Stratton_2023_%28cropped%29.jpg/120px-Juliana_Stratton_2023_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a8/Juliana_Stratton_2023_%28cropped%29.jpg/250px-Juliana_Stratton_2023_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1413\" data-file-height=\"1886\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Juliana_Stratton\" title=\"Juliana Stratton\">Juliana Stratton</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Don_Tracy\" title=\"Don Tracy\">Don Tracy</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Illinois\" title=\"List of United States senators from Illinois\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Dick_Durbin\" title=\"Dick Durbin\">Dick Durbin</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Illinois\" title=\"2026 United States Senate election in Illinois\">2026 United States Senate election in Illinois</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Illinois\" title=\"List of United States senators from Illinois\">List of United States senators from Illinois</a></div>\n<p>Five-term Democrat and <a href=\"/wiki/Senate_Democratic_Whip\" class=\"mw-redirect\" title=\"Senate Democratic Whip\">Senate Democratic Whip</a> <a href=\"/wiki/Dick_Durbin\" title=\"Dick Durbin\">Dick Durbin</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Illinois\" title=\"2020 United States Senate election in Illinois\">reelected in 2020</a> with 54.9% of the vote. On April 23, 2025, he announced he would not run for reelection.<sup id=\"cite&#95;ref-Durbin&#95;28-2\" class=\"reference\"><a href=\"#cite_note-Durbin-28\"><span class=\"cite-bracket\">&#91;</span>16<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>On March 17, 2026, incumbent <a href=\"/wiki/Lieutenant_Governor_of_Illinois\" title=\"Lieutenant Governor of Illinois\">Lieutenant Governor</a> <a href=\"/wiki/Juliana_Stratton\" title=\"Juliana Stratton\">Juliana Stratton</a> won the Democratic primary, defeating a crowded field, including <a href=\"/wiki/United_States_House_of_Representatives\" title=\"United States House of Representatives\">U.S. Representatives</a> <a href=\"/wiki/Raja_Krishnamoorthi\" title=\"Raja Krishnamoorthi\">Raja Krishnamoorthi</a> and <a href=\"/wiki/Robin_Kelly\" title=\"Robin Kelly\">Robin Kelly</a>.<sup id=\"cite&#95;ref-lr&#95;187-0\" class=\"reference\"><a href=\"#cite_note-lr-187\"><span class=\"cite-bracket\">&#91;</span>163<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Illinois_Republican_Party\" title=\"Illinois Republican Party\">Illinois Republican Party</a> Chairman <a href=\"/wiki/Don_Tracy\" title=\"Don Tracy\">Don Tracy</a> easily won the Republican primary the same day, defeating attorney Jeannie Evans and <a href=\"/wiki/Polish_American_Congress\" title=\"Polish American Congress\">Polish American Congress</a> PAC national director Casey Chlebek.<sup id=\"cite&#95;ref-lr&#95;187-1\" class=\"reference\"><a href=\"#cite_note-lr-187\"><span class=\"cite-bracket\">&#91;</span>163<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Iowa\">Iowa</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=29\" title=\"Edit section: Iowa\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Iowa election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Flag_of_Iowa.svg/60px-Flag_of_Iowa.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Flag_of_Iowa.svg/120px-Flag_of_Iowa.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"714\" data-file-height=\"477\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Iowa\" title=\"2020 United States Senate election in Iowa\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Congresswoman_Ashley_Hinson_Official_portrait_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Congresswoman_Ashley_Hinson_Official_portrait_%28cropped%29.jpg/120px-Congresswoman_Ashley_Hinson_Official_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/36/Congresswoman_Ashley_Hinson_Official_portrait_%28cropped%29.jpg/250px-Congresswoman_Ashley_Hinson_Official_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"909\" data-file-height=\"1211\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Joshua_Turek_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Joshua_Turek_%28cropped%29.jpg/120px-Joshua_Turek_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/93/Joshua_Turek_%28cropped%29.jpg/250px-Joshua_Turek_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1200\" data-file-height=\"1599\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Ashley_Hinson\" title=\"Ashley Hinson\">Ashley Hinson</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Josh_Turek\" title=\"Josh Turek\">Josh Turek</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Iowa\" title=\"List of United States senators from Iowa\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Joni_Ernst\" title=\"Joni Ernst\">Joni Ernst</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Iowa\" title=\"2026 United States Senate election in Iowa\">2026 United States Senate election in Iowa</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Iowa\" title=\"List of United States senators from Iowa\">List of United States senators from Iowa</a></div>\n<p>Two-term Republican <a href=\"/wiki/Joni_Ernst\" title=\"Joni Ernst\">Joni Ernst</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Iowa\" title=\"2020 United States Senate election in Iowa\">reelected in 2020</a> with 51.7% of the vote.<sup id=\"cite&#95;ref-generalcanvass&#95;188-0\" class=\"reference\"><a href=\"#cite_note-generalcanvass-188\"><span class=\"cite-bracket\">&#91;</span>164<span class=\"cite-bracket\">&#93;</span></a></sup> On September 2, 2025, she announced that she would not seek reelection to a third term, after being criticized for comments about reductions in Medicaid.<sup id=\"cite&#95;ref-189\" class=\"reference\"><a href=\"#cite_note-189\"><span class=\"cite-bracket\">&#91;</span>165<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Ashley_Hinson\" title=\"Ashley Hinson\">Ashley Hinson</a> easily defeated former <a href=\"/wiki/Iowa_Senate\" title=\"Iowa Senate\">state Senator</a> <a href=\"/wiki/Jim_Carlin_(politician)\" title=\"Jim Carlin (politician)\">Jim Carlin</a> in the June 2, 2026, Republican primary to succeed Ernst.<sup id=\"cite&#95;ref-190\" class=\"reference\"><a href=\"#cite_note-190\"><span class=\"cite-bracket\">&#91;</span>166<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>In the Democratic primary, <a href=\"/wiki/Iowa_House_of_Representatives\" title=\"Iowa House of Representatives\">state Representative</a> <a href=\"/wiki/Josh_Turek\" title=\"Josh Turek\">Josh Turek</a> defeated <a href=\"/wiki/Iowa_Senate\" title=\"Iowa Senate\">state Senator</a> <a href=\"/wiki/Zach_Wahls\" title=\"Zach Wahls\">Zach Wahls</a> by a comfortable margin.<sup id=\"cite&#95;ref-191\" class=\"reference\"><a href=\"#cite_note-191\"><span class=\"cite-bracket\">&#91;</span>167<span class=\"cite-bracket\">&#93;</span></a></sup> Both candidates had cited Ernst's remarks about Medicare as a factor in their decisions to run.<sup class=\"noprint Inline-Template Template-Fact\" style=\"white-space:nowrap;\">&#91;<i><a href=\"/wiki/Wikipedia:Citation_needed\" title=\"Wikipedia:Citation needed\"><span title=\"This claim needs references to reliable sources. (June 2026)\">citation needed</span></a></i>&#93;</sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Kansas\">Kansas</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=30\" title=\"Edit section: Kansas\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Kansas election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Flag_of_Kansas.svg/60px-Flag_of_Kansas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Flag_of_Kansas.svg/120px-Flag_of_Kansas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"500\" data-file-height=\"300\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Kansas\" title=\"2020 United States Senate election in Kansas\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Roger_Marshall_117th_Congress_portrait_(cropped_center).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Roger_Marshall_117th_Congress_portrait_%28cropped_center%29.jpg/120px-Roger_Marshall_117th_Congress_portrait_%28cropped_center%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Roger_Marshall_117th_Congress_portrait_%28cropped_center%29.jpg/250px-Roger_Marshall_117th_Congress_portrait_%28cropped_center%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1687\" data-file-height=\"2250\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Adam_Hamilton_at_podium_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Adam_Hamilton_at_podium_%28cropped_2%29.jpg/120px-Adam_Hamilton_at_podium_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Adam_Hamilton_at_podium_%28cropped_2%29.jpg/250px-Adam_Hamilton_at_podium_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"485\" data-file-height=\"647\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Roger_Marshall\" title=\"Roger Marshall\">Roger Marshall</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Adam_Hamilton_(pastor)\" title=\"Adam Hamilton (pastor)\">Adam Hamilton</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Kansas\" title=\"List of United States senators from Kansas\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Roger_Marshall\" title=\"Roger Marshall\">Roger Marshall</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Kansas\" title=\"2026 United States Senate election in Kansas\">2026 United States Senate election in Kansas</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Kansas\" title=\"List of United States senators from Kansas\">List of United States senators from Kansas</a></div>\n<p>One-term Republican <a href=\"/wiki/Roger_Marshall\" title=\"Roger Marshall\">Roger Marshall</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Kansas\" title=\"2020 United States Senate election in Kansas\">elected in 2020</a> with 53.2% of the vote and is running for reelection.<sup id=\"cite&#95;ref-MarshallKS&#95;192-0\" class=\"reference\"><a href=\"#cite_note-MarshallKS-192\"><span class=\"cite-bracket\">&#91;</span>168<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>Founder of the Church of the Resurrection and pastor <a href=\"/wiki/Adam_Hamilton_(pastor)\" title=\"Adam Hamilton (pastor)\">Adam Hamilton</a>,<sup id=\"cite&#95;ref-193\" class=\"reference\"><a href=\"#cite_note-193\"><span class=\"cite-bracket\">&#91;</span>169<span class=\"cite-bracket\">&#93;</span></a></sup> who initially considered running as an independent,<sup id=\"cite&#95;ref-194\" class=\"reference\"><a href=\"#cite_note-194\"><span class=\"cite-bracket\">&#91;</span>170<span class=\"cite-bracket\">&#93;</span></a></sup> won the Democratic nomination with 35% of the vote. He defeated a field that included former state <a href=\"/wiki/USDA\" class=\"mw-redirect\" title=\"USDA\">USDA</a> Director Christy Davis,<sup id=\"cite&#95;ref-DavisKS&#95;195-0\" class=\"reference\"><a href=\"#cite_note-DavisKS-195\"><span class=\"cite-bracket\">&#91;</span>171<span class=\"cite-bracket\">&#93;</span></a></sup> former federal prosecutor Jason Hart,<sup id=\"cite&#95;ref-196\" class=\"reference\"><a href=\"#cite_note-196\"><span class=\"cite-bracket\">&#91;</span>172<span class=\"cite-bracket\">&#93;</span></a></sup> commercial real estate developer Erik Murray,<sup id=\"cite&#95;ref-197\" class=\"reference\"><a href=\"#cite_note-197\"><span class=\"cite-bracket\">&#91;</span>173<span class=\"cite-bracket\">&#93;</span></a></sup> attorney Anne Parelkar,<sup id=\"cite&#95;ref-Parelkar&#95;198-0\" class=\"reference\"><a href=\"#cite_note-Parelkar-198\"><span class=\"cite-bracket\">&#91;</span>174<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Kansas_Senate\" title=\"Kansas Senate\">state senator</a> <a href=\"/wiki/Patrick_Schmidt_(politician)\" title=\"Patrick Schmidt (politician)\">Patrick Schmidt</a>,<sup id=\"cite&#95;ref-199\" class=\"reference\"><a href=\"#cite_note-199\"><span class=\"cite-bracket\">&#91;</span>175<span class=\"cite-bracket\">&#93;</span></a></sup> art gallery owner Mike Soetaertare,<sup id=\"cite&#95;ref-Parelkar&#95;198-1\" class=\"reference\"><a href=\"#cite_note-Parelkar-198\"><span class=\"cite-bracket\">&#91;</span>174<span class=\"cite-bracket\">&#93;</span></a></sup> former financial services executive Sandy Spidel Neumann,<sup id=\"cite&#95;ref-200\" class=\"reference\"><a href=\"#cite_note-200\"><span class=\"cite-bracket\">&#91;</span>176<span class=\"cite-bracket\">&#93;</span></a></sup> and counterintelligence specialist Noah Tyler.<sup id=\"cite&#95;ref-201\" class=\"reference\"><a href=\"#cite_note-201\"><span class=\"cite-bracket\">&#91;</span>177<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Kentucky\">Kentucky</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=31\" title=\"Edit section: Kentucky\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Kentucky election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Flag_of_Kentucky.svg/60px-Flag_of_Kentucky.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"26\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/8d/Flag_of_Kentucky.svg/120px-Flag_of_Kentucky.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"950\" data-file-height=\"500\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Kentucky\" title=\"2020 United States Senate election in Kentucky\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Andy_Barr_116th_Congress.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Andy_Barr_116th_Congress.jpg/120px-Andy_Barr_116th_Congress.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"111\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Andy_Barr_116th_Congress.jpg/250px-Andy_Barr_116th_Congress.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"335\" data-file-height=\"410\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Charles_solar_panels_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Charles_solar_panels_%28cropped%29.jpg/120px-Charles_solar_panels_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Charles_solar_panels_%28cropped%29.jpg/250px-Charles_solar_panels_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1492\" data-file-height=\"1865\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Andy_Barr\" title=\"Andy Barr\">Andy Barr</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Charles_Booker_(American_politician)\" title=\"Charles Booker (American politician)\">Charles Booker</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Kentucky\" title=\"List of United States senators from Kentucky\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Mitch_McConnell\" title=\"Mitch McConnell\">Mitch McConnell</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Kentucky\" title=\"2026 United States Senate election in Kentucky\">2026 United States Senate election in Kentucky</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Kentucky\" title=\"List of United States senators from Kentucky\">List of United States senators from Kentucky</a></div>\n<p>Seven-term Republican and former <a href=\"/wiki/Party_leaders_of_the_United_States_Senate\" title=\"Party leaders of the United States Senate\">Senate Republican Leader</a> <a href=\"/wiki/Mitch_McConnell\" title=\"Mitch McConnell\">Mitch McConnell</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Kentucky\" title=\"2020 United States Senate election in Kentucky\">reelected in 2020</a> with 57.8% of the vote. McConnell retired as leader after the 2024 elections with plans to serve out the remainder of his term.<sup id=\"cite&#95;ref-202\" class=\"reference\"><a href=\"#cite_note-202\"><span class=\"cite-bracket\">&#91;</span>178<span class=\"cite-bracket\">&#93;</span></a></sup> On February 20, 2025, McConnell announced he would not seek reelection.<sup id=\"cite&#95;ref-McConnell&#95;30-2\" class=\"reference\"><a href=\"#cite_note-McConnell-30\"><span class=\"cite-bracket\">&#91;</span>18<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>On May 19, U.S. Representative <a href=\"/wiki/Andy_Barr\" title=\"Andy Barr\">Andy Barr</a> of <a href=\"/wiki/Kentucky%27s_6th_congressional_district\" title=\"Kentucky&#39;s 6th congressional district\">Kentucky's 6th congressional district</a><sup id=\"cite&#95;ref-Barr&#95;203-0\" class=\"reference\"><a href=\"#cite_note-Barr-203\"><span class=\"cite-bracket\">&#91;</span>179<span class=\"cite-bracket\">&#93;</span></a></sup> defeated a crowded field that included former <a href=\"/wiki/Kentucky_Attorney_General\" title=\"Kentucky Attorney General\">Kentucky Attorney General</a> and <a href=\"/wiki/2023_Kentucky_gubernatorial_election\" title=\"2023 Kentucky gubernatorial election\">2023 Republican gubernatorial nominee</a> <a href=\"/wiki/Daniel_Cameron_(American_politician)\" title=\"Daniel Cameron (American politician)\">Daniel Cameron</a><sup id=\"cite&#95;ref-DanielCameron&#95;204-0\" class=\"reference\"><a href=\"#cite_note-DanielCameron-204\"><span class=\"cite-bracket\">&#91;</span>180<span class=\"cite-bracket\">&#93;</span></a></sup> for the Republican nomination.<sup id=\"cite&#95;ref-:4&#95;205-0\" class=\"reference\"><a href=\"#cite_note-:4-205\"><span class=\"cite-bracket\">&#91;</span>181<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Kentucky_House_of_Representatives\" title=\"Kentucky House of Representatives\">state Representative</a> <a href=\"/wiki/Charles_Booker_(American_politician)\" title=\"Charles Booker (American politician)\">Charles Booker</a>, the <a href=\"/wiki/2022_United_States_Senate_election_in_Kentucky\" title=\"2022 United States Senate election in Kentucky\">2022 Senate</a> nominee and a former staffer for Governor <a href=\"/wiki/Andy_Beshear\" title=\"Andy Beshear\">Andy Beshear</a>, won the May 19 Democratic primary.<sup id=\"cite&#95;ref-kentuckylantern.com&#95;206-0\" class=\"reference\"><a href=\"#cite_note-kentuckylantern.com-206\"><span class=\"cite-bracket\">&#91;</span>182<span class=\"cite-bracket\">&#93;</span></a></sup> The seven-candidate field included <a href=\"/wiki/2020_United_States_Senate_election_in_Kentucky\" title=\"2020 United States Senate election in Kentucky\">2020 nominee</a> and former <a href=\"/wiki/United_States_Marine_Corps\" title=\"United States Marine Corps\">Marine</a> fighter pilot <a href=\"/wiki/Amy_McGrath\" title=\"Amy McGrath\">Amy McGrath</a>.<sup id=\"cite&#95;ref-kentuckylantern.com&#95;206-1\" class=\"reference\"><a href=\"#cite_note-kentuckylantern.com-206\"><span class=\"cite-bracket\">&#91;</span>182<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-:4&#95;205-1\" class=\"reference\"><a href=\"#cite_note-:4-205\"><span class=\"cite-bracket\">&#91;</span>181<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Louisiana\">Louisiana</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=32\" title=\"Edit section: Louisiana\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Louisiana election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Flag_of_Louisiana.svg/60px-Flag_of_Louisiana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"32\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Flag_of_Louisiana.svg/120px-Flag_of_Louisiana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"7040\" data-file-height=\"4556\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Louisiana\" title=\"2020 United States Senate election in Louisiana\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Julia_Letlow_117th_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Julia_Letlow_117th_%28cropped_2%29.jpg/120px-Julia_Letlow_117th_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Julia_Letlow_117th_%28cropped_2%29.jpg/250px-Julia_Letlow_117th_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1688\" data-file-height=\"2251\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Julia_Letlow\" title=\"Julia Letlow\">Julia Letlow</a>\n</td>\n<td style=\"width:75px;text-align:center\">Jamie Davis\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Louisiana\" title=\"List of United States senators from Louisiana\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Bill_Cassidy\" title=\"Bill Cassidy\">Bill Cassidy</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Louisiana\" title=\"2026 United States Senate election in Louisiana\">2026 United States Senate election in Louisiana</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Louisiana\" title=\"List of United States senators from Louisiana\">List of United States senators from Louisiana</a></div>\n<p>Two-term Republican <a href=\"/wiki/Bill_Cassidy\" title=\"Bill Cassidy\">Bill Cassidy</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Louisiana\" title=\"2020 United States Senate election in Louisiana\">reelected in 2020</a> with 59.3% of the vote in the first round of the \"<a href=\"/wiki/Louisiana_primary\" class=\"mw-redirect\" title=\"Louisiana primary\">Louisiana primary</a>\" and ran for reelection to a third term, but placed a distant third in the jungle primary.<sup id=\"cite&#95;ref-207\" class=\"reference\"><a href=\"#cite_note-207\"><span class=\"cite-bracket\">&#91;</span>183<span class=\"cite-bracket\">&#93;</span></a></sup> The Louisiana primary system had since been eliminated in favor of partisan primaries, which were closed to members of other parties but open to unaffiliated voters.<sup id=\"cite&#95;ref-li&#95;208-0\" class=\"reference\"><a href=\"#cite_note-li-208\"><span class=\"cite-bracket\">&#91;</span>184<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>U.S. Representative <a href=\"/wiki/Julia_Letlow\" title=\"Julia Letlow\">Julia Letlow</a> and <a href=\"/wiki/Louisiana_State_Treasurer\" title=\"Louisiana State Treasurer\">state Treasurer</a> and former U.S. representative <a href=\"/wiki/John_Fleming_(Louisiana_politician)\" title=\"John Fleming (Louisiana politician)\">John Fleming</a> advanced to the Republican runoff, defeating Cassidy in the primary.<sup id=\"cite&#95;ref-209\" class=\"reference\"><a href=\"#cite_note-209\"><span class=\"cite-bracket\">&#91;</span>185<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-BC&#95;210-0\" class=\"reference\"><a href=\"#cite_note-BC-210\"><span class=\"cite-bracket\">&#91;</span>186<span class=\"cite-bracket\">&#93;</span></a></sup> Letlow, who was endorsed by President <a href=\"/wiki/Donald_Trump\" title=\"Donald Trump\">Donald Trump</a>, defeated Fleming in the runoff.<sup id=\"cite&#95;ref-211\" class=\"reference\"><a href=\"#cite_note-211\"><span class=\"cite-bracket\">&#91;</span>187<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Sorghum farmer Jamie Davis and data scientist and political consultant Gary Crockett advanced to the Democratic primary runoff, while nonprofit executive Nick Albares placed third.<sup id=\"cite&#95;ref-212\" class=\"reference\"><a href=\"#cite_note-212\"><span class=\"cite-bracket\">&#91;</span>188<span class=\"cite-bracket\">&#93;</span></a></sup> Davis defeated Crockett in the runoff.<sup id=\"cite&#95;ref-Primary&#95;213-0\" class=\"reference\"><a href=\"#cite_note-Primary-213\"><span class=\"cite-bracket\">&#91;</span>189<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Maine\">Maine</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=33\" title=\"Edit section: Maine\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Maine election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Flag_of_Maine.svg/60px-Flag_of_Maine.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"39\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Flag_of_Maine.svg/120px-Flag_of_Maine.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"6336\" data-file-height=\"4992\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Maine\" title=\"2020 United States Senate election in Maine\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg/120px-Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg/250px-Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1316\" data-file-height=\"1755\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Senate_President_Troy_Jackson_(cropped).png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Senate_President_Troy_Jackson_%28cropped%29.png/120px-Senate_President_Troy_Jackson_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Senate_President_Troy_Jackson_%28cropped%29.png/250px-Senate_President_Troy_Jackson_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"956\" data-file-height=\"1275\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Susan_Collins\" title=\"Susan Collins\">Susan Collins</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Troy_Jackson\" title=\"Troy Jackson\">Troy Jackson</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Maine\" title=\"List of United States senators from Maine\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Susan_Collins\" title=\"Susan Collins\">Susan Collins</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Maine\" title=\"2026 United States Senate election in Maine\">2026 United States Senate election in Maine</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Maine\" title=\"List of United States senators from Maine\">List of United States senators from Maine</a></div>\n<p>Incumbent Republican Senator <a href=\"/wiki/Susan_Collins\" title=\"Susan Collins\">Susan Collins</a> was reelected with 51% of the vote to 42% for her Democratic opponent in <a href=\"/wiki/2020_United_States_Senate_election_in_Maine\" title=\"2020 United States Senate election in Maine\">2020</a>. She formally announced her reelection campaign in February 2026.<sup id=\"cite&#95;ref-Collins&#95;214-0\" class=\"reference\"><a href=\"#cite_note-Collins-214\"><span class=\"cite-bracket\">&#91;</span>190<span class=\"cite-bracket\">&#93;</span></a></sup> As the only person to submit the necessary number of signatures to appear on the primary ballot, Collins is the Republican nominee.<sup id=\"cite&#95;ref-215\" class=\"reference\"><a href=\"#cite_note-215\"><span class=\"cite-bracket\">&#91;</span>191<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Throughout 2025, <a href=\"/wiki/Governor_of_Maine\" title=\"Governor of Maine\">Governor</a> <a href=\"/wiki/Janet_Mills\" title=\"Janet Mills\">Janet Mills</a> was seen as a potential Democratic challenger to Collins. She announced her Senate candidacy in October<sup id=\"cite&#95;ref-MillsME&#95;216-0\" class=\"reference\"><a href=\"#cite_note-MillsME-216\"><span class=\"cite-bracket\">&#91;</span>192<span class=\"cite-bracket\">&#93;</span></a></sup> and pledged to serve only one term if elected.<sup id=\"cite&#95;ref-217\" class=\"reference\"><a href=\"#cite_note-217\"><span class=\"cite-bracket\">&#91;</span>193<span class=\"cite-bracket\">&#93;</span></a></sup> She suspended her campaign on April 30, 2026, due to a lack of financial resources and poor polling numbers.<sup id=\"cite&#95;ref-218\" class=\"reference\"><a href=\"#cite_note-218\"><span class=\"cite-bracket\">&#91;</span>194<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>On June 9, <a href=\"/wiki/Sullivan,_Maine\" title=\"Sullivan, Maine\">Sullivan</a> <a href=\"/wiki/Harbor_master\" class=\"mw-redirect\" title=\"Harbor master\">harbor master</a> and <a href=\"/wiki/United_States_Marine_Corps\" title=\"United States Marine Corps\">Marine</a> veteran <a href=\"/wiki/Graham_Platner\" title=\"Graham Platner\">Graham Platner</a><sup id=\"cite&#95;ref-Platner&#95;219-0\" class=\"reference\"><a href=\"#cite_note-Platner-219\"><span class=\"cite-bracket\">&#91;</span>195<span class=\"cite-bracket\">&#93;</span></a></sup> defeated former deputy secretary of the <a href=\"/wiki/Maryland_Department_of_the_Environment\" title=\"Maryland Department of the Environment\">Maryland Department of the Environment</a> David Costello<sup id=\"cite&#95;ref-CostelloME&#95;220-0\" class=\"reference\"><a href=\"#cite_note-CostelloME-220\"><span class=\"cite-bracket\">&#91;</span>196<span class=\"cite-bracket\">&#93;</span></a></sup> for the Democratic nomination with 72% of the vote.<sup id=\"cite&#95;ref-221\" class=\"reference\"><a href=\"#cite_note-221\"><span class=\"cite-bracket\">&#91;</span>197<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>On July 8, Platner announced his withdrawal from the race following allegations of sexual assault, which he denied. The same day, Maine Democrats voted to hold a state convention to select a replacement nominee.<sup id=\"cite&#95;ref-222\" class=\"reference\"><a href=\"#cite_note-222\"><span class=\"cite-bracket\">&#91;</span>198<span class=\"cite-bracket\">&#93;</span></a></sup> Candidates seeking the nomination were required to collect at least 500 signatures, including 50 from each of eight counties.<sup id=\"cite&#95;ref-223\" class=\"reference\"><a href=\"#cite_note-223\"><span class=\"cite-bracket\">&#91;</span>199<span class=\"cite-bracket\">&#93;</span></a></sup> During county meetings to select convention delegates, approximately 456 delegates pledged their support to former state Senator <a href=\"/wiki/Troy_Jackson\" title=\"Troy Jackson\">Troy Jackson</a>.<sup id=\"cite&#95;ref-BangorDelegateResults&#95;224-0\" class=\"reference\"><a href=\"#cite_note-BangorDelegateResults-224\"><span class=\"cite-bracket\">&#91;</span>200<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-225\" class=\"reference\"><a href=\"#cite_note-225\"><span class=\"cite-bracket\">&#91;</span>201<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-Pellish&#95;&amp;&#95;Howard&#95;2026&#95;226-0\" class=\"reference\"><a href=\"#cite_note-Pellish_&amp;_Howard_2026-226\"><span class=\"cite-bracket\">&#91;</span>202<span class=\"cite-bracket\">&#93;</span></a></sup> Jackson subsequently defeated Saundra Pelletier at the convention by a vote of 566–5.<sup id=\"cite&#95;ref-ConvResultUsaToday&#95;112-1\" class=\"reference\"><a href=\"#cite_note-ConvResultUsaToday-112\"><span class=\"cite-bracket\">&#91;</span>89<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Massachusetts\">Massachusetts</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=34\" title=\"Edit section: Massachusetts\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Massachusetts election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Flag_of_Massachusetts.svg/60px-Flag_of_Massachusetts.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Flag_of_Massachusetts.svg/120px-Flag_of_Massachusetts.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1500\" data-file-height=\"900\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Massachusetts\" title=\"2020 United States Senate election in Massachusetts\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Ed_Markey_in_Edgartown_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Ed_Markey_in_Edgartown_%28cropped%29.jpg/120px-Ed_Markey_in_Edgartown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Ed_Markey_in_Edgartown_%28cropped%29.jpg/250px-Ed_Markey_in_Edgartown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1744\" data-file-height=\"2324\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:John_Deaton,_2024.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/John_Deaton%2C_2024.jpg/120px-John_Deaton%2C_2024.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/John_Deaton%2C_2024.jpg/250px-John_Deaton%2C_2024.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"657\" data-file-height=\"876\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Ed_Markey\" title=\"Ed Markey\">Ed Markey</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/John_Deaton\" title=\"John Deaton\">John Deaton</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Massachusetts\" title=\"List of United States senators from Massachusetts\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Ed_Markey\" title=\"Ed Markey\">Ed Markey</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Massachusetts\" title=\"2026 United States Senate election in Massachusetts\">2026 United States Senate election in Massachusetts</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Massachusetts\" title=\"List of United States senators from Massachusetts\">List of United States senators from Massachusetts</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Ed_Markey\" title=\"Ed Markey\">Ed Markey</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Massachusetts\" title=\"2020 United States Senate election in Massachusetts\">reelected in 2020</a> with 66.2% of the vote and is seeking a third full term.<sup id=\"cite&#95;ref-Markey&#95;115-1\" class=\"reference\"><a href=\"#cite_note-Markey-115\"><span class=\"cite-bracket\">&#91;</span>92<span class=\"cite-bracket\">&#93;</span></a></sup> The longest-serving Democrat in <a href=\"/wiki/United_States_Congress\" title=\"United States Congress\">Congress</a>, Markey will be 80 on <a href=\"/wiki/Election_day\" title=\"Election day\">Election Day</a> and has faced calls to retire. This also happened during the <a href=\"/wiki/2020_United_States_Senate_election_in_Massachusetts\" title=\"2020 United States Senate election in Massachusetts\">2020 Democratic primary</a>.<sup id=\"cite&#95;ref-227\" class=\"reference\"><a href=\"#cite_note-227\"><span class=\"cite-bracket\">&#91;</span>203<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-228\" class=\"reference\"><a href=\"#cite_note-228\"><span class=\"cite-bracket\">&#91;</span>204<span class=\"cite-bracket\">&#93;</span></a></sup> Markey defeated <a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Seth_Moulton\" title=\"Seth Moulton\">Seth Moulton</a> in the September 1 Democratic primary.<sup id=\"cite&#95;ref-Moulton&#95;229-0\" class=\"reference\"><a href=\"#cite_note-Moulton-229\"><span class=\"cite-bracket\">&#91;</span>205<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Attorney John Deaton, who was the Republican nominee against U.S. Senator <a href=\"/wiki/Elizabeth_Warren\" title=\"Elizabeth Warren\">Elizabeth Warren</a> in <a href=\"/wiki/2024_United_States_Senate_election_in_Massachusetts\" title=\"2024 United States Senate election in Massachusetts\">2024</a>, is again the Republican nominee.<sup id=\"cite&#95;ref-Deaton&#95;114-1\" class=\"reference\"><a href=\"#cite_note-Deaton-114\"><span class=\"cite-bracket\">&#91;</span>91<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Michigan\">Michigan</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=35\" title=\"Edit section: Michigan\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Michigan election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Flag_of_Michigan.svg/60px-Flag_of_Michigan.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Flag_of_Michigan.svg/120px-Flag_of_Michigan.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"512\" data-file-height=\"342\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Michigan\" title=\"2020 United States Senate election in Michigan\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg/120px-Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg/250px-Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"585\" data-file-height=\"780\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Mike_Rogers_in_November_2019_(3x4_cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg/120px-Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg/250px-Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"822\" data-file-height=\"1099\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Abdul_El-Sayed\" title=\"Abdul El-Sayed\">Abdul El-Sayed</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Mike_Rogers_(Michigan_politician)\" title=\"Mike Rogers (Michigan politician)\">Mike Rogers</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Michigan\" title=\"List of United States senators from Michigan\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Gary_Peters\" title=\"Gary Peters\">Gary Peters</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Michigan\" title=\"2026 United States Senate election in Michigan\">2026 United States Senate election in Michigan</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Michigan\" title=\"List of United States senators from Michigan\">List of United States senators from Michigan</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Gary_Peters_(politician)\" class=\"mw-redirect\" title=\"Gary Peters (politician)\">Gary Peters</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Michigan\" title=\"2020 United States Senate election in Michigan\">narrowly reelected in 2020</a> with 49.9% of the vote. On January 28, 2025, he announced that he would not seek reelection.<sup id=\"cite&#95;ref-GaryPeters&#95;31-2\" class=\"reference\"><a href=\"#cite_note-GaryPeters-31\"><span class=\"cite-bracket\">&#91;</span>19<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Wayne_County,_Michigan\" title=\"Wayne County, Michigan\">Wayne County</a> Health, Human, and Veterans Services Department Director <a href=\"/wiki/Abdul_El-Sayed\" title=\"Abdul El-Sayed\">Abdul El-Sayed</a>,<sup id=\"cite&#95;ref-El&#95;Sayed&#95;77-1\" class=\"reference\"><a href=\"#cite_note-El_Sayed-77\"><span class=\"cite-bracket\">&#91;</span>54<span class=\"cite-bracket\">&#93;</span></a></sup> U.S. Representative <a href=\"/wiki/Haley_Stevens\" title=\"Haley Stevens\">Haley Stevens</a> of the <a href=\"/wiki/Michigan%27s_11th_congressional_district\" title=\"Michigan&#39;s 11th congressional district\">11th congressional district</a><sup id=\"cite&#95;ref-:hstevens&#95;230-0\" class=\"reference\"><a href=\"#cite_note-:hstevens-230\"><span class=\"cite-bracket\">&#91;</span>206<span class=\"cite-bracket\">&#93;</span></a></sup>, and <a href=\"/wiki/Michigan_Senate\" title=\"Michigan Senate\">State Sentor</a> <a href=\"/wiki/Mallory_McMorrow\" title=\"Mallory McMorrow\">Mallory McMorrow</a> ran in the Democratic primary. El-Sayed narrowly defeated Stevens and is the Democratic nominee.\n</p><p>Former U.S. Representative for the <a href=\"/wiki/Michigan%27s_8th_congressional_district\" title=\"Michigan&#39;s 8th congressional district\">8th congressional district</a> and <a href=\"/wiki/2024_United_States_Senate_election_in_Michigan\" title=\"2024 United States Senate election in Michigan\">2024</a> U.S. Senate nominee <a href=\"/wiki/Mike_Rogers_(Michigan_politician)\" title=\"Mike Rogers (Michigan politician)\">Mike Rogers</a><sup id=\"cite&#95;ref-MRogers&#95;76-1\" class=\"reference\"><a href=\"#cite_note-MRogers-76\"><span class=\"cite-bracket\">&#91;</span>53<span class=\"cite-bracket\">&#93;</span></a></sup> is the Republican nominee.\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Minnesota\">Minnesota</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=36\" title=\"Edit section: Minnesota\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Minnesota election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Flag_of_Minnesota.svg/60px-Flag_of_Minnesota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Flag_of_Minnesota.svg/120px-Flag_of_Minnesota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1000\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Minnesota\" title=\"2020 United States Senate election in Minnesota\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0055AA;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Peggy_Flanagan_and_Premier_Kinew_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg/120px-Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg/250px-Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1422\" data-file-height=\"1897\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:MicheleTafoya2023.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/68/MicheleTafoya2023.jpg/120px-MicheleTafoya2023.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/68/MicheleTafoya2023.jpg/250px-MicheleTafoya2023.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2686\" data-file-height=\"3584\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Peggy_Flanagan\" title=\"Peggy Flanagan\">Peggy Flanagan</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Michele_Tafoya\" title=\"Michele Tafoya\">Michele Tafoya</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Minnesota_Democratic%E2%80%93Farmer%E2%80%93Labor_Party\" title=\"Minnesota Democratic–Farmer–Labor Party\">Democratic (DFL)</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Minnesota\" title=\"List of United States senators from Minnesota\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Tina_Smith\" title=\"Tina Smith\">Tina Smith</a><br />\n<a href=\"/wiki/Minnesota_Democratic%E2%80%93Farmer%E2%80%93Labor_Party\" title=\"Minnesota Democratic–Farmer–Labor Party\">Democratic (DFL)</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Minnesota\" title=\"2026 United States Senate election in Minnesota\">2026 United States Senate election in Minnesota</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Minnesota\" title=\"List of United States senators from Minnesota\">List of United States senators from Minnesota</a></div>\n<p>One-term Democrat <a href=\"/wiki/Tina_Smith\" title=\"Tina Smith\">Tina Smith</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Minnesota\" title=\"2020 United States Senate election in Minnesota\">reelected in 2020</a> with 48.7% of the vote after being appointed by Governor <a href=\"/wiki/Mark_Dayton\" title=\"Mark Dayton\">Mark Dayton</a> in 2018 following <a href=\"/wiki/Al_Franken\" title=\"Al Franken\">Al Franken</a>'s resignation and then winning a <a href=\"/wiki/2018_United_States_Senate_special_election_in_Minnesota\" title=\"2018 United States Senate special election in Minnesota\">special election</a> that year. On February 13, 2025, she announced she would not seek a second full term in 2026.<sup id=\"cite&#95;ref-tinasmith&#95;33-2\" class=\"reference\"><a href=\"#cite_note-tinasmith-33\"><span class=\"cite-bracket\">&#91;</span>20<span class=\"cite-bracket\">&#93;</span></a></sup> Incumbent <a href=\"/wiki/Lieutenant_Governor_of_Minnesota\" title=\"Lieutenant Governor of Minnesota\">Lieutenant Governor</a> <a href=\"/wiki/Peggy_Flanagan\" title=\"Peggy Flanagan\">Peggy Flanagan</a> announced her candidacy the same day.<sup id=\"cite&#95;ref-FlanaganMN&#95;231-0\" class=\"reference\"><a href=\"#cite_note-FlanaganMN-231\"><span class=\"cite-bracket\">&#91;</span>207<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Angie_Craig\" title=\"Angie Craig\">Angie Craig</a> announced her candidacy on April 29.<sup id=\"cite&#95;ref-CraigMN&#95;232-0\" class=\"reference\"><a href=\"#cite_note-CraigMN-232\"><span class=\"cite-bracket\">&#91;</span>208<span class=\"cite-bracket\">&#93;</span></a></sup> Flanagan won the nomination with 59% of the vote.\n</p><p>Republicans running included <a href=\"/wiki/Sportscaster\" class=\"mw-redirect\" title=\"Sportscaster\">sportscaster</a> <a href=\"/wiki/Michele_Tafoya\" title=\"Michele Tafoya\">Michele Tafoya</a>,<sup id=\"cite&#95;ref-Tafoya&#95;233-0\" class=\"reference\"><a href=\"#cite_note-Tafoya-233\"><span class=\"cite-bracket\">&#91;</span>209<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/2024_United_States_Senate_election_in_Minnesota\" title=\"2024 United States Senate election in Minnesota\">2024</a> Republican U.S. Senate nominee and former professional basketball player <a href=\"/wiki/Royce_White\" title=\"Royce White\">Royce White</a>,<sup id=\"cite&#95;ref-RoyceWhiteMN&#95;234-0\" class=\"reference\"><a href=\"#cite_note-RoyceWhiteMN-234\"><span class=\"cite-bracket\">&#91;</span>210<span class=\"cite-bracket\">&#93;</span></a></sup> retired <a href=\"/wiki/U.S._Navy\" class=\"mw-redirect\" title=\"U.S. Navy\">U.S. Navy</a> officer Tom Weiler,<sup id=\"cite&#95;ref-rn&#95;235-0\" class=\"reference\"><a href=\"#cite_note-rn-235\"><span class=\"cite-bracket\">&#91;</span>211<span class=\"cite-bracket\">&#93;</span></a></sup> and former <a href=\"/wiki/Navy_SEAL\" class=\"mw-redirect\" title=\"Navy SEAL\">Navy SEAL</a> Adam Schwarze.<sup id=\"cite&#95;ref-Schwarze&#95;236-0\" class=\"reference\"><a href=\"#cite_note-Schwarze-236\"><span class=\"cite-bracket\">&#91;</span>212<span class=\"cite-bracket\">&#93;</span></a></sup> Tafoya ultimately won the nomination with 52% of the vote.\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Mississippi\">Mississippi</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=37\" title=\"Edit section: Mississippi\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Mississippi election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Flag_of_Mississippi.svg/60px-Flag_of_Mississippi.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Flag_of_Mississippi.svg/120px-Flag_of_Mississippi.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1200\" data-file-height=\"720\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Mississippi\" title=\"2020 United States Senate election in Mississippi\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Official_headshot_of_US_Senator_Cindy_Hyde-Smith_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Official_headshot_of_US_Senator_Cindy_Hyde-Smith_%28cropped%29.jpg/120px-Official_headshot_of_US_Senator_Cindy_Hyde-Smith_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"110\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Official_headshot_of_US_Senator_Cindy_Hyde-Smith_%28cropped%29.jpg/250px-Official_headshot_of_US_Senator_Cindy_Hyde-Smith_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"798\" data-file-height=\"990\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Cindy_Hyde-Smith\" title=\"Cindy Hyde-Smith\">Cindy Hyde-Smith</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Scott_Colom\" title=\"Scott Colom\">Scott Colom</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Mississippi\" title=\"List of United States senators from Mississippi\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Cindy_Hyde-Smith\" title=\"Cindy Hyde-Smith\">Cindy Hyde-Smith</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Mississippi\" title=\"2026 United States Senate election in Mississippi\">2026 United States Senate election in Mississippi</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Mississippi\" title=\"List of United States senators from Mississippi\">List of United States senators from Mississippi</a></div>\n<p>One-term Republican <a href=\"/wiki/Cindy_Hyde-Smith\" title=\"Cindy Hyde-Smith\">Cindy Hyde-Smith</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Mississippi\" title=\"2020 United States Senate election in Mississippi\">reelected in 2020</a> with 54.1% of the vote after being appointed in 2018 and winning a <a href=\"/wiki/2018_United_States_Senate_special_election_in_Mississippi\" title=\"2018 United States Senate special election in Mississippi\">special election</a> later that year. She is running for a second full term in office.<sup id=\"cite&#95;ref-HydeSmith&#95;237-0\" class=\"reference\"><a href=\"#cite_note-HydeSmith-237\"><span class=\"cite-bracket\">&#91;</span>213<span class=\"cite-bracket\">&#93;</span></a></sup> She defeated <a href=\"/wiki/Medical_doctor\" title=\"Medical doctor\">physician</a> Sarah Adlakha in the Republican primary on March 10, 2026.<sup id=\"cite&#95;ref-Adlakha&#95;238-0\" class=\"reference\"><a href=\"#cite_note-Adlakha-238\"><span class=\"cite-bracket\">&#91;</span>214<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/Lowndes_County,_Mississippi\" title=\"Lowndes County, Mississippi\">Lowndes County</a> <a href=\"/wiki/District_Attorney\" class=\"mw-redirect\" title=\"District Attorney\">District Attorney</a> <a href=\"/wiki/Scott_Colom\" title=\"Scott Colom\">Scott Colom</a> defeated <a href=\"/wiki/U.S._Marine_Corps\" class=\"mw-redirect\" title=\"U.S. Marine Corps\">U.S. Marine Corps</a> veteran Albert Littell, and Priscilla Williams-Till, a cousin of <a href=\"/wiki/Emmett_Till\" title=\"Emmett Till\">Emmett Till</a>, in the Democratic primary on March 10, 2026.<sup id=\"cite&#95;ref-Colom&#95;239-0\" class=\"reference\"><a href=\"#cite_note-Colom-239\"><span class=\"cite-bracket\">&#91;</span>215<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-WilliamsTill&#95;240-0\" class=\"reference\"><a href=\"#cite_note-WilliamsTill-240\"><span class=\"cite-bracket\">&#91;</span>216<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-241\" class=\"reference\"><a href=\"#cite_note-241\"><span class=\"cite-bracket\">&#91;</span>217<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Ty Pinkins, the Democratic nominee for <a href=\"/wiki/Secretary_of_State_of_Mississippi\" title=\"Secretary of State of Mississippi\">Secretary of State</a> in <a href=\"/wiki/2023_Mississippi_elections#Secretary_of_state\" title=\"2023 Mississippi elections\">2023</a> and for <a href=\"/wiki/United_States_Senate\" title=\"United States Senate\">U.S. Senate</a> in <a href=\"/wiki/2024_United_States_Senate_election_in_Mississippi\" title=\"2024 United States Senate election in Mississippi\">2024</a>, is running as an independent.<sup id=\"cite&#95;ref-Pinkins&#95;242-0\" class=\"reference\"><a href=\"#cite_note-Pinkins-242\"><span class=\"cite-bracket\">&#91;</span>218<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Montana\">Montana</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=38\" title=\"Edit section: Montana\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Montana election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Flag_of_Montana.svg/60px-Flag_of_Montana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Flag_of_Montana.svg/120px-Flag_of_Montana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"768\" data-file-height=\"512\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Montana\" title=\"2020 United States Senate election in Montana\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Kurt_G._Alme_official_photo.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Kurt_G._Alme_official_photo.jpg/120px-Kurt_G._Alme_official_photo.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Kurt_G._Alme_official_photo.jpg/250px-Kurt_G._Alme_official_photo.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"614\" data-file-height=\"768\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Alani_Bankhead_USAF_2021.png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Alani_Bankhead_USAF_2021.png/120px-Alani_Bankhead_USAF_2021.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Alani_Bankhead_USAF_2021.png/250px-Alani_Bankhead_USAF_2021.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"540\" data-file-height=\"719\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #DDDDBB;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Seth_Bodnar_-_President_at_University_of_Montana_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Seth_Bodnar_-_President_at_University_of_Montana_%28cropped%29.jpg/120px-Seth_Bodnar_-_President_at_University_of_Montana_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Seth_Bodnar_-_President_at_University_of_Montana_%28cropped%29.jpg/250px-Seth_Bodnar_-_President_at_University_of_Montana_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1651\" data-file-height=\"2233\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Kurt_Alme\" title=\"Kurt Alme\">Kurt Alme</a>\n</td>\n<td style=\"width:75px;text-align:center\">Alani Bankhead\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Seth_Bodnar\" title=\"Seth Bodnar\">Seth Bodnar</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Independent_(US)\" class=\"mw-redirect\" title=\"Independent (US)\">Independent</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Montana\" title=\"List of United States senators from Montana\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Steve_Daines\" title=\"Steve Daines\">Steve Daines</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Montana\" title=\"2026 United States Senate election in Montana\">2026 United States Senate election in Montana</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Montana\" title=\"List of United States senators from Montana\">List of United States senators from Montana</a></div>\n<p>Two-term Republican <a href=\"/wiki/Steve_Daines\" title=\"Steve Daines\">Steve Daines</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Montana\" title=\"2020 United States Senate election in Montana\">reelected in 2020</a> with 55% of the vote. On March 4, 2026, Daines announced he would not seek reelection. The same day, <a href=\"/wiki/United_States_Attorney\" title=\"United States Attorney\">U.S. Attorney</a> <a href=\"/wiki/Kurt_Alme\" title=\"Kurt Alme\">Kurt Alme</a> announced his candidacy and immediately won Daines's endorsement.<sup id=\"cite&#95;ref-243\" class=\"reference\"><a href=\"#cite_note-243\"><span class=\"cite-bracket\">&#91;</span>219<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Montana_House_of_Representatives\" title=\"Montana House of Representatives\">state Representative</a> <a href=\"/wiki/Reilly_Neill\" title=\"Reilly Neill\">Reilly Neill</a> ran for the Democratic nomination,<sup id=\"cite&#95;ref-Neill&#95;244-0\" class=\"reference\"><a href=\"#cite_note-Neill-244\"><span class=\"cite-bracket\">&#91;</span>220<span class=\"cite-bracket\">&#93;</span></a></sup> but was defeated in the Democratic primary by former <a href=\"/wiki/U.S._Air_Force\" class=\"mw-redirect\" title=\"U.S. Air Force\">U.S. Air Force</a> <a href=\"/wiki/Lieutenant_Colonel\" class=\"mw-redirect\" title=\"Lieutenant Colonel\">Lieutenant Colonel</a> Alani Bankhead in a major <a href=\"/wiki/Upset_(competition)\" title=\"Upset (competition)\">upset</a>.<sup id=\"cite&#95;ref-245\" class=\"reference\"><a href=\"#cite_note-245\"><span class=\"cite-bracket\">&#91;</span>221<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/Seth_Bodnar\" title=\"Seth Bodnar\">Seth Bodnar</a>, the president of the <a href=\"/wiki/University_of_Montana\" title=\"University of Montana\">University of Montana</a> until January 2026, is running as an independent candidate.<sup id=\"cite&#95;ref-246\" class=\"reference\"><a href=\"#cite_note-246\"><span class=\"cite-bracket\">&#91;</span>222<span class=\"cite-bracket\">&#93;</span></a></sup> Former U.S. Senator <a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a> endorsed Bodnar, surprising many and angering many Democrats.<sup id=\"cite&#95;ref-247\" class=\"reference\"><a href=\"#cite_note-247\"><span class=\"cite-bracket\">&#91;</span>223<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Nebraska\">Nebraska</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=39\" title=\"Edit section: Nebraska\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Nebraska election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Flag_of_Nebraska.svg/60px-Flag_of_Nebraska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Flag_of_Nebraska.svg/120px-Flag_of_Nebraska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"750\" data-file-height=\"450\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2024_United_States_Senate_special_election_in_Nebraska\" title=\"2024 United States Senate special election in Nebraska\">2024</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Pete_Ricketts_official_portrait,_118th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg/120px-Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg/250px-Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1173\" data-file-height=\"1614\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #DDDDBB;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Osborn_Headshot_2_(cropped)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Osborn_Headshot_2_%28cropped%29_%28cropped%29.jpg/120px-Osborn_Headshot_2_%28cropped%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Osborn_Headshot_2_%28cropped%29_%28cropped%29.jpg/250px-Osborn_Headshot_2_%28cropped%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1481\" data-file-height=\"1974\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Dan_Osborn\" title=\"Dan Osborn\">Dan Osborn</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Independent_(US)\" class=\"mw-redirect\" title=\"Independent (US)\">Independent</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Nebraska\" title=\"List of United States senators from Nebraska\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Nebraska\" title=\"2026 United States Senate election in Nebraska\">2026 United States Senate election in Nebraska</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Nebraska\" title=\"List of United States senators from Nebraska\">List of United States senators from Nebraska</a></div>\n<p>Two-term Republican <a href=\"/wiki/Ben_Sasse\" title=\"Ben Sasse\">Ben Sasse</a> resigned early in the <a href=\"/wiki/118th_United_States_Congress\" title=\"118th United States Congress\">118th Congress</a> to become president of the <a href=\"/wiki/University_of_Florida\" title=\"University of Florida\">University of Florida</a>.<sup id=\"cite&#95;ref-248\" class=\"reference\"><a href=\"#cite_note-248\"><span class=\"cite-bracket\">&#91;</span>224<span class=\"cite-bracket\">&#93;</span></a></sup> On January 12, 2023, Governor <a href=\"/wiki/Jim_Pillen\" title=\"Jim Pillen\">Jim Pillen</a> appointed former governor <a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a> as senator.<sup id=\"cite&#95;ref-249\" class=\"reference\"><a href=\"#cite_note-249\"><span class=\"cite-bracket\">&#91;</span>225<span class=\"cite-bracket\">&#93;</span></a></sup> Ricketts won the <a href=\"/wiki/2024_United_States_Senate_special_election_in_Nebraska\" title=\"2024 United States Senate special election in Nebraska\">2024 special election</a> to complete Sasse's term, defeating college professor <a href=\"/wiki/Preston_Love_Jr.\" title=\"Preston Love Jr.\">Preston Love Jr.</a>,<sup id=\"cite&#95;ref-250\" class=\"reference\"><a href=\"#cite_note-250\"><span class=\"cite-bracket\">&#91;</span>226<span class=\"cite-bracket\">&#93;</span></a></sup> and is now running for reelection to his first full term.<sup id=\"cite&#95;ref-251\" class=\"reference\"><a href=\"#cite_note-251\"><span class=\"cite-bracket\">&#91;</span>227<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former labor union leader <a href=\"/wiki/Dan_Osborn\" title=\"Dan Osborn\">Dan Osborn</a>, who challenged Republican <a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a> for <a href=\"/wiki/2024_United_States_Senate_election_in_Nebraska\" title=\"2024 United States Senate election in Nebraska\">Nebraska's Class I Senate seat</a>, has announced an independent bid.<sup id=\"cite&#95;ref-Osborn&#95;126-1\" class=\"reference\"><a href=\"#cite_note-Osborn-126\"><span class=\"cite-bracket\">&#91;</span>103<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>The <a href=\"/wiki/Nebraska_Democratic_Party\" title=\"Nebraska Democratic Party\">Nebraska Democratic Party</a> has declined to recruit a Democratic challenger to Ricketts,<sup id=\"cite&#95;ref-252\" class=\"reference\"><a href=\"#cite_note-252\"><span class=\"cite-bracket\">&#91;</span>228<span class=\"cite-bracket\">&#93;</span></a></sup> and the <a href=\"/wiki/Jane_Kleeb\" title=\"Jane Kleeb\">party's chair</a> has endorsed Osborn.<sup id=\"cite&#95;ref-253\" class=\"reference\"><a href=\"#cite_note-253\"><span class=\"cite-bracket\">&#91;</span>229<span class=\"cite-bracket\">&#93;</span></a></sup> Other candidates filed for the Democratic primary, raising concern that their campaigns could split the vote and weaken Osborn's support in the general election,<sup id=\"cite&#95;ref-:1&#95;254-0\" class=\"reference\"><a href=\"#cite_note-:1-254\"><span class=\"cite-bracket\">&#91;</span>230<span class=\"cite-bracket\">&#93;</span></a></sup> but retired pharmacy technician Cindy Burbank won the Democratic primary and said she intended to withdraw from the general election if she sees no clear path to victory.<sup id=\"cite&#95;ref-255\" class=\"reference\"><a href=\"#cite_note-255\"><span class=\"cite-bracket\">&#91;</span>231<span class=\"cite-bracket\">&#93;</span></a></sup> She officially withdrew from the race on July 17.<sup id=\"cite&#95;ref-256\" class=\"reference\"><a href=\"#cite_note-256\"><span class=\"cite-bracket\">&#91;</span>232<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"New_Hampshire\">New Hampshire</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=40\" title=\"Edit section: New Hampshire\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">New Hampshire election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Flag_of_New_Hampshire.svg/60px-Flag_of_New_Hampshire.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/28/Flag_of_New_Hampshire.svg/120px-Flag_of_New_Hampshire.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"660\" data-file-height=\"440\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_New_Hampshire\" title=\"2020 United States Senate election in New Hampshire\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Chris_Pappas,_official_portrait_-_2022_(cropped_2).png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Chris_Pappas%2C_official_portrait_-_2022_%28cropped_2%29.png/120px-Chris_Pappas%2C_official_portrait_-_2022_%28cropped_2%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/50/Chris_Pappas%2C_official_portrait_-_2022_%28cropped_2%29.png/250px-Chris_Pappas%2C_official_portrait_-_2022_%28cropped_2%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"271\" data-file-height=\"361\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:John_E._Sununu_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/John_E._Sununu_%28cropped_2%29.jpg/120px-John_E._Sununu_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/John_E._Sununu_%28cropped_2%29.jpg/250px-John_E._Sununu_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1538\" data-file-height=\"2051\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Chris_Pappas_(American_politician)\" title=\"Chris Pappas (American politician)\">Chris Pappas</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/John_E._Sununu\" title=\"John E. Sununu\">John E. Sununu</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_New_Hampshire\" title=\"List of United States senators from New Hampshire\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Jeanne_Shaheen\" title=\"Jeanne Shaheen\">Jeanne Shaheen</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_New_Hampshire\" title=\"2026 United States Senate election in New Hampshire\">2026 United States Senate election in New Hampshire</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_New_Hampshire\" title=\"List of United States senators from New Hampshire\">List of United States senators from New Hampshire</a></div>\n<p>Three-term <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democrat</a> <a href=\"/wiki/Jeanne_Shaheen\" title=\"Jeanne Shaheen\">Jeanne Shaheen</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_New_Hampshire\" title=\"2020 United States Senate election in New Hampshire\">reelected in 2020</a> with 56.6% of the vote. On March 12, 2025, Shaheen announced that she would not seek reelection to a fourth term.<sup id=\"cite&#95;ref-Shaheen&#95;35-2\" class=\"reference\"><a href=\"#cite_note-Shaheen-35\"><span class=\"cite-bracket\">&#91;</span>22<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Chris_Pappas_(American_politician)\" title=\"Chris Pappas (American politician)\">Chris Pappas</a><sup id=\"cite&#95;ref-Pappas&#95;128-1\" class=\"reference\"><a href=\"#cite_note-Pappas-128\"><span class=\"cite-bracket\">&#91;</span>105<span class=\"cite-bracket\">&#93;</span></a></sup> defeated <a href=\"/wiki/New_Hampshire_Democratic_Party\" title=\"New Hampshire Democratic Party\">New Hampshire Democratic Party</a> rules committee member Karishma Manzur<sup id=\"cite&#95;ref-Manzur&#95;257-0\" class=\"reference\"><a href=\"#cite_note-Manzur-257\"><span class=\"cite-bracket\">&#91;</span>233<span class=\"cite-bracket\">&#93;</span></a></sup> to win the Democratic nomination on September 8.<sup id=\"cite&#95;ref-:9&#95;258-0\" class=\"reference\"><a href=\"#cite_note-:9-258\"><span class=\"cite-bracket\">&#91;</span>234<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former U.S. Senator <a href=\"/wiki/John_E._Sununu\" title=\"John E. Sununu\">John E. Sununu</a> won the Republican nomination on September 8, defeating former <a href=\"/wiki/Massachusetts\" title=\"Massachusetts\">Massachusetts</a> U.S. Senator and <a href=\"/wiki/U.S._Ambassador_to_New_Zealand_and_Samoa\" class=\"mw-redirect\" title=\"U.S. Ambassador to New Zealand and Samoa\">U.S. Ambassador to New Zealand and Samoa</a> <a href=\"/wiki/Scott_Brown_(politician)\" title=\"Scott Brown (politician)\">Scott Brown.</a><sup id=\"cite&#95;ref-:9&#95;258-1\" class=\"reference\"><a href=\"#cite_note-:9-258\"><span class=\"cite-bracket\">&#91;</span>234<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-nh&#95;259-0\" class=\"reference\"><a href=\"#cite_note-nh-259\"><span class=\"cite-bracket\">&#91;</span>235<span class=\"cite-bracket\">&#93;</span></a></sup> Both have previously lost Senate races to Shaheen: Sununu in <a href=\"/wiki/2008_United_States_Senate_election_in_New_Hampshire\" title=\"2008 United States Senate election in New Hampshire\">2008</a> and Brown in <a href=\"/wiki/2014_United_States_Senate_election_in_New_Hampshire\" title=\"2014 United States Senate election in New Hampshire\">2014</a>.<sup id=\"cite&#95;ref-JohnSununu&#95;78-2\" class=\"reference\"><a href=\"#cite_note-JohnSununu-78\"><span class=\"cite-bracket\">&#91;</span>55<span class=\"cite-bracket\">&#93;</span></a></sup> Sununu's brother, former <a href=\"/wiki/Governor_of_New_Hampshire\" title=\"Governor of New Hampshire\">Governor</a> <a href=\"/wiki/Chris_Sununu\" title=\"Chris Sununu\">Chris Sununu</a>, declined to run.<sup id=\"cite&#95;ref-260\" class=\"reference\"><a href=\"#cite_note-260\"><span class=\"cite-bracket\">&#91;</span>236<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"New_Jersey\">New Jersey</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=41\" title=\"Edit section: New Jersey\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">New Jersey election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Flag_of_New_Jersey.svg/60px-Flag_of_New_Jersey.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/92/Flag_of_New_Jersey.svg/120px-Flag_of_New_Jersey.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1000\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_New_Jersey\" title=\"2020 United States Senate election in New Jersey\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Cory_Booker,_official_portrait_(119th_Congress)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Cory_Booker%2C_official_portrait_%28119th_Congress%29_%28cropped%29.jpg/120px-Cory_Booker%2C_official_portrait_%28119th_Congress%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/00/Cory_Booker%2C_official_portrait_%28119th_Congress%29_%28cropped%29.jpg/250px-Cory_Booker%2C_official_portrait_%28119th_Congress%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2853\" data-file-height=\"3804\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Cory_Booker\" title=\"Cory Booker\">Cory Booker</a>\n</td>\n<td style=\"width:75px;text-align:center\">Justin Murphy\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_New_Jersey\" title=\"List of United States senators from New Jersey\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Cory_Booker\" title=\"Cory Booker\">Cory Booker</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_New_Jersey\" title=\"2026 United States Senate election in New Jersey\">2026 United States Senate election in New Jersey</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_New_Jersey\" title=\"List of United States senators from New Jersey\">List of United States senators from New Jersey</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Cory_Booker\" title=\"Cory Booker\">Cory Booker</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_New_Jersey\" title=\"2020 United States Senate election in New Jersey\">reelected in 2020</a> with 57.2% of the vote and is running for reelection to a third full term.<sup id=\"cite&#95;ref-BookerRunning&#95;261-0\" class=\"reference\"><a href=\"#cite_note-BookerRunning-261\"><span class=\"cite-bracket\">&#91;</span>237<span class=\"cite-bracket\">&#93;</span></a></sup> Booker won the Democratic nomination unopposed, as he was the only candidate to submit the required number of signatures to appear on the primary ballot.<sup id=\"cite&#95;ref-262\" class=\"reference\"><a href=\"#cite_note-262\"><span class=\"cite-bracket\">&#91;</span>238<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>\nOn June 2, 2026, former <a href=\"/wiki/Tabernacle_Township,_New_Jersey\" title=\"Tabernacle Township, New Jersey\">Tabernacle</a> Mayor Justin Murphy, a Navy veteran and attorney, won the Republican nomination<sup id=\"cite&#95;ref-263\" class=\"reference\"><a href=\"#cite_note-263\"><span class=\"cite-bracket\">&#91;</span>239<span class=\"cite-bracket\">&#93;</span></a></sup> with 33% of the vote, defeating physician Robert Lebovics, U.S. Army combat veteran Richard Tabor, and former <a href=\"/wiki/News_12_Networks\" title=\"News 12 Networks\">News 12</a> reporter Alex Zdan.<sup id=\"cite&#95;ref-264\" class=\"reference\"><a href=\"#cite_note-264\"><span class=\"cite-bracket\">&#91;</span>240<span class=\"cite-bracket\">&#93;</span></a></sup></p><div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"New_Mexico\">New Mexico</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=42\" title=\"Edit section: New Mexico\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">New Mexico election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Flag_of_New_Mexico.svg/60px-Flag_of_New_Mexico.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c3/Flag_of_New_Mexico.svg/120px-Flag_of_New_Mexico.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1800\" data-file-height=\"1200\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_New_Mexico\" title=\"2020 United States Senate election in New Mexico\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Ben_Ray_Luj%C3%A1n,_official_portrait_(119th_Congress)_(cropped)1.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Ben_Ray_Luj%C3%A1n%2C_official_portrait_%28119th_Congress%29_%28cropped%291.jpg/120px-Ben_Ray_Luj%C3%A1n%2C_official_portrait_%28119th_Congress%29_%28cropped%291.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"113\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c2/Ben_Ray_Luj%C3%A1n%2C_official_portrait_%28119th_Congress%29_%28cropped%291.jpg/250px-Ben_Ray_Luj%C3%A1n%2C_official_portrait_%28119th_Congress%29_%28cropped%291.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2850\" data-file-height=\"3414\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Ben_Ray_Luj%C3%A1n\" title=\"Ben Ray Luján\">Ben Ray Luján</a>\n</td>\n<td style=\"width:75px;text-align:center\">Larry Marker\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_New_Mexico\" title=\"List of United States senators from New Mexico\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Ben_Ray_Luj%C3%A1n\" title=\"Ben Ray Luján\">Ben Ray Luján</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_New_Mexico\" title=\"2026 United States Senate election in New Mexico\">2026 United States Senate election in New Mexico</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_New_Mexico\" title=\"List of United States senators from New Mexico\">List of United States senators from New Mexico</a></div>\n<p>One-term Democrat <a href=\"/wiki/Ben_Ray_Luj%C3%A1n\" title=\"Ben Ray Luján\">Ben Ray Luján</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_New_Mexico\" title=\"2020 United States Senate election in New Mexico\">elected in 2020</a> with 51.7% of the vote. On April 23, 2025, Luján announced that he would seek a second term.<sup id=\"cite&#95;ref-BRL&#95;265-0\" class=\"reference\"><a href=\"#cite_note-BRL-265\"><span class=\"cite-bracket\">&#91;</span>241<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Christopher Heuvel, the only Republican to file, was disqualified for failing to meet ballot requirements.<sup id=\"cite&#95;ref-266\" class=\"reference\"><a href=\"#cite_note-266\"><span class=\"cite-bracket\">&#91;</span>242<span class=\"cite-bracket\">&#93;</span></a></sup> Former oil and gas operator Larry Marker subsequently qualified for the Republican primary as a <a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">write-in</a>.<sup id=\"cite&#95;ref-NM2026&#95;131-1\" class=\"reference\"><a href=\"#cite_note-NM2026-131\"><span class=\"cite-bracket\">&#91;</span>108<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"North_Carolina\">North Carolina</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=43\" title=\"Edit section: North Carolina\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">North Carolina election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Flag_of_North_Carolina.svg/60px-Flag_of_North_Carolina.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Flag_of_North_Carolina.svg/120px-Flag_of_North_Carolina.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"750\" data-file-height=\"500\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_North_Carolina\" title=\"2020 United States Senate election in North Carolina\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Michael_Whatley_(55505282618)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Michael_Whatley_%2855505282618%29_%28cropped%29.jpg/120px-Michael_Whatley_%2855505282618%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/31/Michael_Whatley_%2855505282618%29_%28cropped%29.jpg/250px-Michael_Whatley_%2855505282618%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1972\" data-file-height=\"2627\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Roy_Cooper_at_Roy_Cooper_Rally_April_2026-2_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Roy_Cooper_at_Roy_Cooper_Rally_April_2026-2_%28cropped%29.jpg/120px-Roy_Cooper_at_Roy_Cooper_Rally_April_2026-2_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/ce/Roy_Cooper_at_Roy_Cooper_Rally_April_2026-2_%28cropped%29.jpg/250px-Roy_Cooper_at_Roy_Cooper_Rally_April_2026-2_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2177\" data-file-height=\"2899\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Michael_Whatley\" title=\"Michael Whatley\">Michael Whatley</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Roy_Cooper\" title=\"Roy Cooper\">Roy Cooper</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_North_Carolina\" title=\"List of United States senators from North Carolina\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Thom_Tillis\" title=\"Thom Tillis\">Thom Tillis</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_North_Carolina\" title=\"2026 United States Senate election in North Carolina\">2026 United States Senate election in North Carolina</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_North_Carolina\" title=\"List of United States senators from North Carolina\">List of United States senators from North Carolina</a></div>\n<p>Two-term Republican <a href=\"/wiki/Thom_Tillis\" title=\"Thom Tillis\">Thom Tillis</a>, who was <a href=\"/wiki/2020_United_States_Senate_election_in_North_Carolina\" title=\"2020 United States Senate election in North Carolina\">narrowly reelected in 2020</a> with 48.7% of the vote, announced on June 29, 2025, that he would not seek a third term after facing backlash for voting against <a href=\"/wiki/One_Big_Beautiful_Bill_Act\" title=\"One Big Beautiful Bill Act\">One Big Beautiful Bill Act</a>, prompting <a href=\"/wiki/Donald_Trump\" title=\"Donald Trump\">Donald Trump</a> to call for a primary challenger.<sup id=\"cite&#95;ref-Tillis&#95;68-2\" class=\"reference\"><a href=\"#cite_note-Tillis-68\"><span class=\"cite-bracket\">&#91;</span>45<span class=\"cite-bracket\">&#93;</span></a></sup> After Tillis withdrew, Trump endorsed former <a href=\"/wiki/Republican_National_Committee\" title=\"Republican National Committee\">Republican National Committee</a> chair <a href=\"/wiki/Michael_Whatley\" title=\"Michael Whatley\">Michael Whatley</a>,<sup id=\"cite&#95;ref-267\" class=\"reference\"><a href=\"#cite_note-267\"><span class=\"cite-bracket\">&#91;</span>243<span class=\"cite-bracket\">&#93;</span></a></sup> who won the Republican nomination, defeating <a href=\"/wiki/Don_Brown_(author,_born_1960)\" title=\"Don Brown (author, born 1960)\">Don Brown</a> in the March 3 primary.<sup id=\"cite&#95;ref-268\" class=\"reference\"><a href=\"#cite_note-268\"><span class=\"cite-bracket\">&#91;</span>244<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/Lara_Trump\" title=\"Lara Trump\">Lara Trump</a>, former co-chair of the <a href=\"/wiki/Republican_National_Committee\" title=\"Republican National Committee\">Republican National Committee</a> and <a href=\"/wiki/Wilmington,_North_Carolina\" title=\"Wilmington, North Carolina\">Wilmington</a> native, was considered a potential candidate to challenge Tillis, but announced she would not run.<sup id=\"cite&#95;ref-269\" class=\"reference\"><a href=\"#cite_note-269\"><span class=\"cite-bracket\">&#91;</span>245<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>On the Democratic side, former <a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Wiley_Nickel\" title=\"Wiley Nickel\">Wiley Nickel</a> declared his candidacy in April 2025.<sup id=\"cite&#95;ref-270\" class=\"reference\"><a href=\"#cite_note-270\"><span class=\"cite-bracket\">&#91;</span>246<span class=\"cite-bracket\">&#93;</span></a></sup> Former <a href=\"/wiki/North_Carolina_Governor\" class=\"mw-redirect\" title=\"North Carolina Governor\">Governor</a> <a href=\"/wiki/Roy_Cooper\" title=\"Roy Cooper\">Roy Cooper</a> entered the race on July 28, 2025.<sup id=\"cite&#95;ref-nc&#95;67-1\" class=\"reference\"><a href=\"#cite_note-nc-67\"><span class=\"cite-bracket\">&#91;</span>44<span class=\"cite-bracket\">&#93;</span></a></sup> Nickel withdrew the following day and endorsed Cooper,<sup id=\"cite&#95;ref-271\" class=\"reference\"><a href=\"#cite_note-271\"><span class=\"cite-bracket\">&#91;</span>247<span class=\"cite-bracket\">&#93;</span></a></sup> who later won the Democratic nomination.<sup id=\"cite&#95;ref-:0&#95;66-1\" class=\"reference\"><a href=\"#cite_note-:0-66\"><span class=\"cite-bracket\">&#91;</span>43<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Ohio_(special)\"><span id=\"Ohio_.28special.29\"></span>Ohio (special)</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=44\" title=\"Edit section: Ohio (special)\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Ohio special election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Flag_of_Ohio.svg/60px-Flag_of_Ohio.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"31\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Flag_of_Ohio.svg/120px-Flag_of_Ohio.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"520\" data-file-height=\"320\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2022_United_States_Senate_election_in_Ohio\" title=\"2022 United States Senate election in Ohio\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2028_United_States_Senate_election_in_Ohio\" class=\"mw-redirect\" title=\"2028 United States Senate election in Ohio\"><i>2028</i></a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Jon_Husted_official_portrait,_119th_Congress_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/Sen._Jon_Husted_official_portrait%2C_119th_Congress_%28cropped_2%29.jpg/120px-Sen._Jon_Husted_official_portrait%2C_119th_Congress_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e5/Sen._Jon_Husted_official_portrait%2C_119th_Congress_%28cropped_2%29.jpg/250px-Sen._Jon_Husted_official_portrait%2C_119th_Congress_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2633\" data-file-height=\"3511\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sherrod_Brown_117th_Congress_(2)_(3x4_crop).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Sherrod_Brown_117th_Congress_%282%29_%283x4_crop%29.jpg/120px-Sherrod_Brown_117th_Congress_%282%29_%283x4_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/87/Sherrod_Brown_117th_Congress_%282%29_%283x4_crop%29.jpg/250px-Sherrod_Brown_117th_Congress_%282%29_%283x4_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1630\" data-file-height=\"2173\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Jon_Husted\" title=\"Jon Husted\">Jon Husted</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Sherrod_Brown\" title=\"Sherrod Brown\">Sherrod Brown</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Ohio\" title=\"List of United States senators from Ohio\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Jon_Husted\" title=\"Jon Husted\">Jon Husted</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_special_election_in_Ohio\" title=\"2026 United States Senate special election in Ohio\">2026 United States Senate special election in Ohio</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Ohio\" title=\"List of United States senators from Ohio\">List of United States senators from Ohio</a></div>\n<p>One-term Republican <a href=\"/wiki/JD_Vance\" title=\"JD Vance\">JD Vance</a> was <a href=\"/wiki/2022_United_States_Senate_election_in_Ohio\" title=\"2022 United States Senate election in Ohio\">elected in 2022</a> with 53% of the vote.<sup id=\"cite&#95;ref-272\" class=\"reference\"><a href=\"#cite_note-272\"><span class=\"cite-bracket\">&#91;</span>248<span class=\"cite-bracket\">&#93;</span></a></sup> On January 10, 2025, he resigned from the Senate after being elected <a href=\"/wiki/Vice_President_of_the_United_States\" title=\"Vice President of the United States\">Vice President of the United States</a> in <a href=\"/wiki/2024_United_States_presidential_election\" title=\"2024 United States presidential election\">2024</a>. On January 17, <a href=\"/wiki/Ohio_Governor\" class=\"mw-redirect\" title=\"Ohio Governor\">Governor</a> <a href=\"/wiki/Mike_DeWine\" title=\"Mike DeWine\">Mike DeWine</a> announced that then-<a href=\"/wiki/Ohio_Lieutenant_Governor\" class=\"mw-redirect\" title=\"Ohio Lieutenant Governor\">Lieutenant Governor</a> <a href=\"/wiki/Jon_Husted\" title=\"Jon Husted\">Jon Husted</a> would replace Vance in the Senate.<sup id=\"cite&#95;ref-273\" class=\"reference\"><a href=\"#cite_note-273\"><span class=\"cite-bracket\">&#91;</span>249<span class=\"cite-bracket\">&#93;</span></a></sup> Husted is running to serve the remainder of Vance's term.<sup id=\"cite&#95;ref-Husted&#95;274-0\" class=\"reference\"><a href=\"#cite_note-Husted-274\"><span class=\"cite-bracket\">&#91;</span>250<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former U.S. Senator <a href=\"/wiki/Sherrod_Brown\" title=\"Sherrod Brown\">Sherrod Brown</a>, who was unseated <a href=\"/wiki/2024_United_States_Senate_election_in_Ohio\" title=\"2024 United States Senate election in Ohio\">in 2024</a>,<sup id=\"cite&#95;ref-BrownAP&#95;275-0\" class=\"reference\"><a href=\"#cite_note-BrownAP-275\"><span class=\"cite-bracket\">&#91;</span>251<span class=\"cite-bracket\">&#93;</span></a></sup> defeated IT professional Ron Kincaid in the Democratic primary on May 5, 2026.<sup id=\"cite&#95;ref-276\" class=\"reference\"><a href=\"#cite_note-276\"><span class=\"cite-bracket\">&#91;</span>252<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Libertarian_National_Committee\" title=\"Libertarian National Committee\">Libertarian National Committee</a> chair William Redpath is running as a Libertarian.<sup id=\"cite&#95;ref-277\" class=\"reference\"><a href=\"#cite_note-277\"><span class=\"cite-bracket\">&#91;</span>253<span class=\"cite-bracket\">&#93;</span></a></sup> Ohio Libertarians disqualified healthcare consultant Jeffrey Kanter from the Libertarian primary after he submitted hundreds of invalid signatures with his candidate petition.<sup id=\"cite&#95;ref-278\" class=\"reference\"><a href=\"#cite_note-278\"><span class=\"cite-bracket\">&#91;</span>254<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Oklahoma\">Oklahoma</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=45\" title=\"Edit section: Oklahoma\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Oklahoma election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Flag_of_Oklahoma.svg/60px-Flag_of_Oklahoma.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6e/Flag_of_Oklahoma.svg/120px-Flag_of_Oklahoma.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"675\" data-file-height=\"450\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2022_United_States_Senate_special_election_in_Oklahoma\" title=\"2022 United States Senate special election in Oklahoma\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Rep._Kevin_Hern_official_photo,_116th_congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Rep._Kevin_Hern_official_photo%2C_116th_congress_%28cropped%29.jpg/120px-Rep._Kevin_Hern_official_photo%2C_116th_congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"97\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Rep._Kevin_Hern_official_photo%2C_116th_congress_%28cropped%29.jpg/250px-Rep._Kevin_Hern_official_photo%2C_116th_congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2159\" data-file-height=\"3028\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Kevin_Hern\" title=\"Kevin Hern\">Kevin Hern</a>\n</td>\n<td style=\"width:75px;text-align:center\">N'Kiyla Jasmine Thomas\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Oklahoma\" title=\"List of United States senators from Oklahoma\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Alan_Armstrong\" title=\"Alan Armstrong\">Alan Armstrong</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Oklahoma\" title=\"2026 United States Senate election in Oklahoma\">2026 United States Senate election in Oklahoma</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Oklahoma\" title=\"List of United States senators from Oklahoma\">List of United States senators from Oklahoma</a></div>\n<p>Incumbent Republican <a href=\"/wiki/Markwayne_Mullin\" title=\"Markwayne Mullin\">Markwayne Mullin</a> won <a href=\"/wiki/2022_United_States_Senate_special_election_in_Oklahoma\" title=\"2022 United States Senate special election in Oklahoma\">a special election in 2022</a> with 61.8% of the vote to complete the remainder of the term vacated by <a href=\"/wiki/Jim_Inhofe\" title=\"Jim Inhofe\">Jim Inhofe</a>, who resigned on January 3, 2023, due to declining health and died in 2024.<sup id=\"cite&#95;ref-279\" class=\"reference\"><a href=\"#cite_note-279\"><span class=\"cite-bracket\">&#91;</span>255<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>Mullin initially announced plans to seek his first full term in office, but on March 5, 2026, President Trump announced his nomination of Mullin for <a href=\"/wiki/United_States_Secretary_of_Homeland_Security\" title=\"United States Secretary of Homeland Security\">Secretary of Homeland Security</a>; the Senate confirmed Mullin on March 23.<sup id=\"cite&#95;ref-Mullin&#95;280-0\" class=\"reference\"><a href=\"#cite_note-Mullin-280\"><span class=\"cite-bracket\">&#91;</span>256<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Governor_of_Oklahoma\" title=\"Governor of Oklahoma\">Governor</a> <a href=\"/wiki/Kevin_Stitt\" title=\"Kevin Stitt\">Kevin Stitt</a> appointed board member and former CEO of <a href=\"/wiki/Williams_Companies\" title=\"Williams Companies\">Williams Companies</a> <a href=\"/wiki/Alan_Armstrong\" title=\"Alan Armstrong\">Alan Armstrong</a> to replace Mullin in the Senate.<sup id=\"cite&#95;ref-281\" class=\"reference\"><a href=\"#cite_note-281\"><span class=\"cite-bracket\">&#91;</span>257<span class=\"cite-bracket\">&#93;</span></a></sup> Armstrong was sworn in on March 24<sup id=\"cite&#95;ref-282\" class=\"reference\"><a href=\"#cite_note-282\"><span class=\"cite-bracket\">&#91;</span>258<span class=\"cite-bracket\">&#93;</span></a></sup> and was required to sign an oath stating that he would not run in the 2026 election.<sup id=\"cite&#95;ref-283\" class=\"reference\"><a href=\"#cite_note-283\"><span class=\"cite-bracket\">&#91;</span>259<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-OK&#95;Statutes&#95;24-1\" class=\"reference\"><a href=\"#cite_note-OK_Statutes-24\"><span class=\"cite-bracket\">&#91;</span>13<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>U.S. Representative for <span data-sort-value=\"Oklahoma01&#160;!\"><a href=\"/wiki/Oklahoma%27s_1st_congressional_district\" title=\"Oklahoma&#39;s 1st congressional district\">Oklahoma's 1st congressional district</a></span> <a href=\"/wiki/Kevin_Hern\" title=\"Kevin Hern\">Kevin Hern</a><sup id=\"cite&#95;ref-Hern11&#95;284-0\" class=\"reference\"><a href=\"#cite_note-Hern11-284\"><span class=\"cite-bracket\">&#91;</span>260<span class=\"cite-bracket\">&#93;</span></a></sup> won the June 16 Republican primary with 70% of the vote in a crowded field.<sup id=\"cite&#95;ref-:2&#95;285-0\" class=\"reference\"><a href=\"#cite_note-:2-285\"><span class=\"cite-bracket\">&#91;</span>261<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>In the June 16 Democratic primary, mediator Jim Priest<sup id=\"cite&#95;ref-286\" class=\"reference\"><a href=\"#cite_note-286\"><span class=\"cite-bracket\">&#91;</span>262<span class=\"cite-bracket\">&#93;</span></a></sup> and nurse N'Kiyla \"Jasmine\" Thomas<sup id=\"cite&#95;ref-ThomasOK&#95;287-0\" class=\"reference\"><a href=\"#cite_note-ThomasOK-287\"><span class=\"cite-bracket\">&#91;</span>263<span class=\"cite-bracket\">&#93;</span></a></sup> received the most votes and advanced to an August 25 runoff.<sup id=\"cite&#95;ref-288\" class=\"reference\"><a href=\"#cite_note-288\"><span class=\"cite-bracket\">&#91;</span>264<span class=\"cite-bracket\">&#93;</span></a></sup> Thomas, a member of the <a href=\"/wiki/Democratic_Socialists_of_America\" title=\"Democratic Socialists of America\">Democratic Socialists of America</a>, won the runoff with 61% of the vote.\n</p><p>\nEntering Wedge Media executive director Ron Meinhardt and pharmacist Curtis Stinnett are running as independents.<sup id=\"cite&#95;ref-:2&#95;285-1\" class=\"reference\"><a href=\"#cite_note-:2-285\"><span class=\"cite-bracket\">&#91;</span>261<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-289\" class=\"reference\"><a href=\"#cite_note-289\"><span class=\"cite-bracket\">&#91;</span>265<span class=\"cite-bracket\">&#93;</span></a></sup> Sevier White, candidate for <a href=\"/wiki/Oklahoma%27s_4th_congressional_district\" title=\"Oklahoma&#39;s 4th congressional district\">Oklahoma's 4th congressional district</a> in <a href=\"/wiki/2016_United_States_House_of_Representatives_elections_in_Oklahoma#District_4\" title=\"2016 United States House of Representatives elections in Oklahoma\">2016</a>, is running as a <a href=\"/wiki/Libertarian_Party_of_Oklahoma\" title=\"Libertarian Party of Oklahoma\">Libertarian</a>.<sup id=\"cite&#95;ref-:2&#95;285-2\" class=\"reference\"><a href=\"#cite_note-:2-285\"><span class=\"cite-bracket\">&#91;</span>261<span class=\"cite-bracket\">&#93;</span></a></sup></p><div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Oregon\">Oregon</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=46\" title=\"Edit section: Oregon\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Oregon election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Flag_of_Oregon.svg/60px-Flag_of_Oregon.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Flag_of_Oregon.svg/120px-Flag_of_Oregon.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"768\" data-file-height=\"512\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Oregon\" title=\"2020 United States Senate election in Oregon\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Jeff_Merkley,_115th_official_photo_(cropped2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg/120px-Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"101\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c8/Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg/250px-Jeff_Merkley%2C_115th_official_photo_%28cropped2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2779\" data-file-height=\"3741\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:David_Brock_Smith.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/81/David_Brock_Smith.jpg/120px-David_Brock_Smith.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//upload.wikimedia.org/wikipedia/commons/8/81/David_Brock_Smith.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail_unscaled 2x\" data-file-width=\"184\" data-file-height=\"252\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Jeff_Merkley\" title=\"Jeff Merkley\">Jeff Merkley</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/David_Brock_Smith\" title=\"David Brock Smith\">David Brock Smith</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Oregon\" title=\"List of United States senators from Oregon\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Jeff_Merkley\" title=\"Jeff Merkley\">Jeff Merkley</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Oregon\" title=\"2026 United States Senate election in Oregon\">2026 United States Senate election in Oregon</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Oregon\" title=\"List of United States senators from Oregon\">List of United States senators from Oregon</a></div>\n<p>Three-term Democrat <a href=\"/wiki/Jeff_Merkley\" title=\"Jeff Merkley\">Jeff Merkley</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Oregon\" title=\"2020 United States Senate election in Oregon\">reelected in 2020</a> with 56.9% of the vote. On July 20, 2025, he announced his candidacy for reelection.<sup id=\"cite&#95;ref-290\" class=\"reference\"><a href=\"#cite_note-290\"><span class=\"cite-bracket\">&#91;</span>266<span class=\"cite-bracket\">&#93;</span></a></sup> He defeated retired electrical engineer Paul D. Wells<sup id=\"cite&#95;ref-rc&#95;291-0\" class=\"reference\"><a href=\"#cite_note-rc-291\"><span class=\"cite-bracket\">&#91;</span>267<span class=\"cite-bracket\">&#93;</span></a></sup> in the Democratic primary on May 19, 2026.<sup id=\"cite&#95;ref-292\" class=\"reference\"><a href=\"#cite_note-292\"><span class=\"cite-bracket\">&#91;</span>268<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/Oregon_State_Senate\" title=\"Oregon State Senate\">State Senator</a> <a href=\"/wiki/David_Brock_Smith\" title=\"David Brock Smith\">David Brock Smith</a>,<sup id=\"cite&#95;ref-293\" class=\"reference\"><a href=\"#cite_note-293\"><span class=\"cite-bracket\">&#91;</span>269<span class=\"cite-bracket\">&#93;</span></a></sup> won the Republican primary that was held on May 19, 2026, defeating a crowded field of candidates, with former <a href=\"/wiki/Linn_County,_Oregon\" title=\"Linn County, Oregon\">Linn County</a> Republican Party chair <a href=\"/wiki/Jo_Rae_Perkins\" title=\"Jo Rae Perkins\">Jo Rae Perkins</a><sup id=\"cite&#95;ref-rc&#95;291-1\" class=\"reference\"><a href=\"#cite_note-rc-291\"><span class=\"cite-bracket\">&#91;</span>267<span class=\"cite-bracket\">&#93;</span></a></sup> finishing second.<sup id=\"cite&#95;ref-294\" class=\"reference\"><a href=\"#cite_note-294\"><span class=\"cite-bracket\">&#91;</span>270<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Rhode_Island\">Rhode Island</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=47\" title=\"Edit section: Rhode Island\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Rhode Island election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_Rhode_Island.svg/60px-Flag_of_Rhode_Island.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"44\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_Rhode_Island.svg/120px-Flag_of_Rhode_Island.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"660\" data-file-height=\"580\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Rhode_Island\" title=\"2020 United States Senate election in Rhode Island\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\">2032&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Jack_Reed_(D-RI),_Official_Portrait,_119th_Congress_(1)_(head_crop).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Sen._Jack_Reed_%28D-RI%29%2C_Official_Portrait%2C_119th_Congress_%281%29_%28head_crop%29.jpg/120px-Sen._Jack_Reed_%28D-RI%29%2C_Official_Portrait%2C_119th_Congress_%281%29_%28head_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"105\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Sen._Jack_Reed_%28D-RI%29%2C_Official_Portrait%2C_119th_Congress_%281%29_%28head_crop%29.jpg/250px-Sen._Jack_Reed_%28D-RI%29%2C_Official_Portrait%2C_119th_Congress_%281%29_%28head_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"4472\" data-file-height=\"5782\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Jack_Reed_(Rhode_Island_politician)\" title=\"Jack Reed (Rhode Island politician)\">Jack Reed</a>\n</td>\n<td style=\"width:75px;text-align:center\">Raymond McKay\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Rhode_Island\" title=\"List of United States senators from Rhode Island\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Jack_Reed_(Rhode_Island_politician)\" title=\"Jack Reed (Rhode Island politician)\">Jack Reed</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Rhode_Island\" title=\"2026 United States Senate election in Rhode Island\">2026 United States Senate election in Rhode Island</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Rhode_Island\" title=\"List of United States senators from Rhode Island\">List of United States senators from Rhode Island</a></div>\n<p>Five-term Democrat <a href=\"/wiki/Jack_Reed_(Rhode_Island_politician)\" title=\"Jack Reed (Rhode Island politician)\">Jack Reed</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Rhode_Island\" title=\"2020 United States Senate election in Rhode Island\">reelected in 2020</a> with 66.5% of the vote and is running for a sixth term.<sup id=\"cite&#95;ref-JackReed&#95;295-0\" class=\"reference\"><a href=\"#cite_note-JackReed-295\"><span class=\"cite-bracket\">&#91;</span>271<span class=\"cite-bracket\">&#93;</span></a></sup> He won the Democratic primary on September 9,<sup id=\"cite&#95;ref-:10&#95;296-0\" class=\"reference\"><a href=\"#cite_note-:10-296\"><span class=\"cite-bracket\">&#91;</span>272<span class=\"cite-bracket\">&#93;</span></a></sup> defeating elder care worker Connor Burbridge<sup id=\"cite&#95;ref-BurbridgeRI&#95;297-0\" class=\"reference\"><a href=\"#cite_note-BurbridgeRI-297\"><span class=\"cite-bracket\">&#91;</span>273<span class=\"cite-bracket\">&#93;</span></a></sup> and physician Luis Daniel Muñoz.<sup id=\"cite&#95;ref-298\" class=\"reference\"><a href=\"#cite_note-298\"><span class=\"cite-bracket\">&#91;</span>274<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p><p>Former <a href=\"/wiki/Rhode_Island_Republican_Party\" title=\"Rhode Island Republican Party\">Rhode Island Republican Party</a> official Raymond McKay is the Republican nominee.<sup id=\"cite&#95;ref-:10&#95;296-1\" class=\"reference\"><a href=\"#cite_note-:10-296\"><span class=\"cite-bracket\">&#91;</span>272<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"South_Carolina\">South Carolina</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=48\" title=\"Edit section: South Carolina\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">South Carolina election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Flag_of_South_Carolina.svg/60px-Flag_of_South_Carolina.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/69/Flag_of_South_Carolina.svg/120px-Flag_of_South_Carolina.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"750\" data-file-height=\"500\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_South_Carolina\" title=\"2020 United States Senate election in South Carolina\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\">2032&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Official_portrait_of_Darline_Graham,_member_of_the_United_States_Senate_from_South_Carolina_(2026)_(cropped)_2.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Official_portrait_of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg/120px-Official_portrait_of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Official_portrait_of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg/250px-Official_portrait_of_Darline_Graham%2C_member_of_the_United_States_Senate_from_South_Carolina_%282026%29_%28cropped%29_2.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"553\" data-file-height=\"739\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Annie_Andrews_Greenville_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Annie_Andrews_Greenville_%28cropped%29.jpg/120px-Annie_Andrews_Greenville_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"108\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Annie_Andrews_Greenville_%28cropped%29.jpg/250px-Annie_Andrews_Greenville_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1020\" data-file-height=\"1279\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Darline_Graham\" title=\"Darline Graham\">Darline Graham</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Annie_Andrews_(pediatrician)\" title=\"Annie Andrews (pediatrician)\">Annie Andrews</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_South_Carolina\" title=\"List of United States senators from South Carolina\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Darline_Graham\" title=\"Darline Graham\">Darline Graham</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_South_Carolina\" title=\"2026 United States Senate election in South Carolina\">2026 United States Senate election in South Carolina</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_South_Carolina\" title=\"List of United States senators from South Carolina\">List of United States senators from South Carolina</a></div>\n<p>Four-term Republican <a href=\"/wiki/Lindsey_Graham\" title=\"Lindsey Graham\">Lindsey Graham</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_South_Carolina\" title=\"2020 United States Senate election in South Carolina\">reelected in 2020</a> with 54.4% of the vote and was seeking a fifth term.<sup id=\"cite&#95;ref-LindseyGraham&#95;299-0\" class=\"reference\"><a href=\"#cite_note-LindseyGraham-299\"><span class=\"cite-bracket\">&#91;</span>275<span class=\"cite-bracket\">&#93;</span></a></sup> He won the June 9 Republican primary with 57% of the vote,<sup id=\"cite&#95;ref-300\" class=\"reference\"><a href=\"#cite_note-300\"><span class=\"cite-bracket\">&#91;</span>276<span class=\"cite-bracket\">&#93;</span></a></sup> but died in office on July 11.<sup id=\"cite&#95;ref-301\" class=\"reference\"><a href=\"#cite_note-301\"><span class=\"cite-bracket\">&#91;</span>277<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Governor_of_South_Carolina\" title=\"Governor of South Carolina\">Governor</a> <a href=\"/wiki/Henry_McMaster\" title=\"Henry McMaster\">Henry McMaster</a> appointed Graham's sister, <a href=\"/wiki/Darline_Graham\" title=\"Darline Graham\">Darline</a>, to serve the remainder of his term. She subsequently sought a full term. In the August 11 special Republican primary, Darline Graham and U.S. Representative <a href=\"/wiki/Ralph_Norman\" title=\"Ralph Norman\">Ralph Norman</a> advanced to an August 25 runoff, which Graham won with 52% of the vote to Norman's 48%.<sup id=\"cite&#95;ref-302\" class=\"reference\"><a href=\"#cite_note-302\"><span class=\"cite-bracket\">&#91;</span>278<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Pediatrician <a href=\"/wiki/Annie_Andrews_(pediatrician)\" title=\"Annie Andrews (pediatrician)\">Annie Andrews</a><sup id=\"cite&#95;ref-303\" class=\"reference\"><a href=\"#cite_note-303\"><span class=\"cite-bracket\">&#91;</span>279<span class=\"cite-bracket\">&#93;</span></a></sup> won the Democratic primary with 61% of the vote.<sup id=\"cite&#95;ref-304\" class=\"reference\"><a href=\"#cite_note-304\"><span class=\"cite-bracket\">&#91;</span>280<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/South_Carolina_Libertarian_Party\" class=\"mw-redirect\" title=\"South Carolina Libertarian Party\">South Carolina Libertarian Party</a> nominee Kasie Whitener and <a href=\"/wiki/Constitution_Party_(United_States)\" title=\"Constitution Party (United States)\">Constitution Party</a> nominee Mark Hackett were nominated by convention.<sup id=\"cite&#95;ref-305\" class=\"reference\"><a href=\"#cite_note-305\"><span class=\"cite-bracket\">&#91;</span>281<span class=\"cite-bracket\">&#93;</span></a></sup> 2022 US Senate candidate <a href=\"/wiki/Catherine_Fleming_Bruce\" title=\"Catherine Fleming Bruce\">Catherine Fleming Bruce</a> is running as a write-in candidate.\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"South_Dakota\">South Dakota</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=49\" title=\"Edit section: South Dakota\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">South Dakota election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Flag_of_South_Dakota.svg/60px-Flag_of_South_Dakota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"31\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Flag_of_South_Dakota.svg/120px-Flag_of_South_Dakota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"720\" data-file-height=\"450\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_South_Dakota\" title=\"2020 United States Senate election in South Dakota\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\">2032&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Mike_Rounds_official_Senate_portrait_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg/120px-Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"106\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/41/Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg/250px-Mike_Rounds_official_Senate_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1079\" data-file-height=\"1385\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #DDDDBB;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Brian_Bengs_Air_Force_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/db/Brian_Bengs_Air_Force_%28cropped%29.jpg/120px-Brian_Bengs_Air_Force_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"96\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/db/Brian_Bengs_Air_Force_%28cropped%29.jpg/250px-Brian_Bengs_Air_Force_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1257\" data-file-height=\"1776\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Mike_Rounds\" title=\"Mike Rounds\">Mike Rounds</a>\n</td>\n<td style=\"width:75px;text-align:center\">Brian Bengs\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Independent_(US)\" class=\"mw-redirect\" title=\"Independent (US)\">Independent</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_South_Dakota\" title=\"List of United States senators from South Dakota\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Mike_Rounds\" title=\"Mike Rounds\">Mike Rounds</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_South_Dakota\" title=\"2026 United States Senate election in South Dakota\">2026 United States Senate election in South Dakota</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_South_Dakota\" title=\"List of United States senators from South Dakota\">List of United States senators from South Dakota</a></div>\n<p>Two-term Republican <a href=\"/wiki/Mike_Rounds\" title=\"Mike Rounds\">Mike Rounds</a>, who was <a href=\"/wiki/2020_United_States_Senate_election_in_South_Dakota\" title=\"2020 United States Senate election in South Dakota\">reelected in 2020</a> with 65.7% of the vote, is running for a third term.<sup id=\"cite&#95;ref-Rounds&#95;306-0\" class=\"reference\"><a href=\"#cite_note-Rounds-306\"><span class=\"cite-bracket\">&#91;</span>282<span class=\"cite-bracket\">&#93;</span></a></sup> Rounds easily defeated Navy veteran and businessman Justin McNeil in the June 2 primary to win the Republican nomination.<sup id=\"cite&#95;ref-307\" class=\"reference\"><a href=\"#cite_note-307\"><span class=\"cite-bracket\">&#91;</span>283<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Businessman and former <a href=\"/wiki/South_Dakota_Highway_Patrol\" title=\"South Dakota Highway Patrol\">South Dakota state trooper</a> Julian Beaudion was the Democratic nominee,<sup id=\"cite&#95;ref-Beaudion&#95;308-0\" class=\"reference\"><a href=\"#cite_note-Beaudion-308\"><span class=\"cite-bracket\">&#91;</span>284<span class=\"cite-bracket\">&#93;</span></a></sup> but withdrew on August 4.<sup id=\"cite&#95;ref-309\" class=\"reference\"><a href=\"#cite_note-309\"><span class=\"cite-bracket\">&#91;</span>285<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Brian Bengs, a <a href=\"/wiki/U.S._Navy\" class=\"mw-redirect\" title=\"U.S. Navy\">U.S. Navy</a> and <a href=\"/wiki/Air_Force_Specialty_Code\" title=\"Air Force Specialty Code\">Air Force</a> veteran, former <a href=\"/wiki/Northern_State_University\" title=\"Northern State University\">Northern State University</a> political science professor, and the <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> nominee for U.S. Senate in <a href=\"/wiki/2022_United_States_Senate_election_in_South_Dakota\" title=\"2022 United States Senate election in South Dakota\">2022</a>, has announced his candidacy as an independent.<sup id=\"cite&#95;ref-Bengs&#95;142-1\" class=\"reference\"><a href=\"#cite_note-Bengs-142\"><span class=\"cite-bracket\">&#91;</span>118<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tennessee\">Tennessee</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=50\" title=\"Edit section: Tennessee\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Tennessee election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Tennessee.svg/60px-Flag_of_Tennessee.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Tennessee.svg/120px-Flag_of_Tennessee.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1000\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Tennessee\" title=\"2020 United States Senate election in Tennessee\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Bill_Hagerty_official_Senate_portrait,_117th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg/120px-Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3a/Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg/250px-Sen._Bill_Hagerty_official_Senate_portrait%2C_117th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"783\" data-file-height=\"1066\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Marquita_Bradshaw_at_Morristown_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg/120px-Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ab/Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg/250px-Marquita_Bradshaw_at_Morristown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"584\" data-file-height=\"793\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Bill_Hagerty\" title=\"Bill Hagerty\">Bill Hagerty</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Marquita_Bradshaw\" title=\"Marquita Bradshaw\">Marquita Bradshaw</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Tennessee\" title=\"List of United States senators from Tennessee\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Bill_Hagerty\" title=\"Bill Hagerty\">Bill Hagerty</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Tennessee\" title=\"2026 United States Senate election in Tennessee\">2026 United States Senate election in Tennessee</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Tennessee\" title=\"List of United States senators from Tennessee\">List of United States senators from Tennessee</a></div>\n<p>Republican <a href=\"/wiki/Bill_Hagerty\" title=\"Bill Hagerty\">Bill Hagerty</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Tennessee\" title=\"2020 United States Senate election in Tennessee\">elected in 2020</a> with 62.2% of the vote and is seeking reelection.<sup id=\"cite&#95;ref-Hagerty&#95;310-0\" class=\"reference\"><a href=\"#cite_note-Hagerty-310\"><span class=\"cite-bracket\">&#91;</span>286<span class=\"cite-bracket\">&#93;</span></a></sup> Hagerty became the Republican nominee unopposed after no other Republicans qualified for the primary ballot.<sup id=\"cite&#95;ref-ts&#95;311-0\" class=\"reference\"><a href=\"#cite_note-ts-311\"><span class=\"cite-bracket\">&#91;</span>287<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Consultant Marquita Bradshaw<sup id=\"cite&#95;ref-ts&#95;311-1\" class=\"reference\"><a href=\"#cite_note-ts-311\"><span class=\"cite-bracket\">&#91;</span>287<span class=\"cite-bracket\">&#93;</span></a></sup> won the Democratic nomination on August 6.<sup id=\"cite&#95;ref-312\" class=\"reference\"><a href=\"#cite_note-312\"><span class=\"cite-bracket\">&#91;</span>288<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Texas\">Texas</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=51\" title=\"Edit section: Texas\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Texas election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Texas.svg/60px-Flag_of_Texas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Texas.svg/120px-Flag_of_Texas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"900\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Texas\" title=\"2020 United States Senate election in Texas\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Ken_Paxton_-_55022425595_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Ken_Paxton_-_55022425595_%28cropped%29.jpg/120px-Ken_Paxton_-_55022425595_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7f/Ken_Paxton_-_55022425595_%28cropped%29.jpg/250px-Ken_Paxton_-_55022425595_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2023\" data-file-height=\"2698\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:James_Talarico_Press_Conference_(centered).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/James_Talarico_Press_Conference_%28centered%29.jpg/120px-James_Talarico_Press_Conference_%28centered%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/James_Talarico_Press_Conference_%28centered%29.jpg/250px-James_Talarico_Press_Conference_%28centered%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"486\" data-file-height=\"647\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Ken_Paxton\" title=\"Ken Paxton\">Ken Paxton</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/James_Talarico\" title=\"James Talarico\">James Talarico</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Texas\" title=\"List of United States senators from Texas\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/John_Cornyn\" title=\"John Cornyn\">John Cornyn</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Texas\" title=\"2026 United States Senate election in Texas\">2026 United States Senate election in Texas</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Texas\" title=\"List of United States senators from Texas\">List of United States senators from Texas</a></div>\n<p>Four-term Republican <a href=\"/wiki/John_Cornyn\" title=\"John Cornyn\">John Cornyn</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Texas\" title=\"2020 United States Senate election in Texas\">reelected in 2020</a> with 53.5% of the vote, and ran for a fifth term in 2026.<sup id=\"cite&#95;ref-JC&#95;313-0\" class=\"reference\"><a href=\"#cite_note-JC-313\"><span class=\"cite-bracket\">&#91;</span>289<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Cornyn and <a href=\"/wiki/Texas_Attorney_General\" title=\"Texas Attorney General\">state Attorney General</a> <a href=\"/wiki/Ken_Paxton\" title=\"Ken Paxton\">Ken Paxton</a> ran in the Republican primary on March 3. Since neither received more than 50% of the vote, they advanced to a runoff election held on May 26.<sup id=\"cite&#95;ref-314\" class=\"reference\"><a href=\"#cite_note-314\"><span class=\"cite-bracket\">&#91;</span>290<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> for the <a href=\"/wiki/Texas%27s_38th_congressional_district\" title=\"Texas&#39;s 38th congressional district\">38th congressional district</a> <a href=\"/wiki/Wesley_Hunt\" title=\"Wesley Hunt\">Wesley Hunt</a> challenged Paxton and Cornyn, but lost the primary.<sup id=\"cite&#95;ref-315\" class=\"reference\"><a href=\"#cite_note-315\"><span class=\"cite-bracket\">&#91;</span>291<span class=\"cite-bracket\">&#93;</span></a></sup> On May 19, both Hunt and President Trump endorsed Paxton.<sup id=\"cite&#95;ref-316\" class=\"reference\"><a href=\"#cite_note-316\"><span class=\"cite-bracket\">&#91;</span>292<span class=\"cite-bracket\">&#93;</span></a></sup> Paxton defeated Cornyn in the runoff by a landslide and became the Republican nominee.\n</p><p><a href=\"/wiki/Texas_House_of_Representatives\" title=\"Texas House of Representatives\">State Representative</a> <a href=\"/wiki/James_Talarico\" title=\"James Talarico\">James Talarico</a> is the Democratic nominee, having defeated U.S. Representative <a href=\"/wiki/Jasmine_Crockett\" title=\"Jasmine Crockett\">Jasmine Crockett</a> in the primary.<sup id=\"cite&#95;ref-TalaricoTX&#95;317-0\" class=\"reference\"><a href=\"#cite_note-TalaricoTX-317\"><span class=\"cite-bracket\">&#91;</span>293<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-CrockettTX&#95;318-0\" class=\"reference\"><a href=\"#cite_note-CrockettTX-318\"><span class=\"cite-bracket\">&#91;</span>294<span class=\"cite-bracket\">&#93;</span></a></sup> \n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Virginia\">Virginia</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=52\" title=\"Edit section: Virginia\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Virginia election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Flag_of_Virginia.svg/60px-Flag_of_Virginia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/47/Flag_of_Virginia.svg/120px-Flag_of_Virginia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"512\" data-file-height=\"341\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Virginia\" title=\"2020 United States Senate election in Virginia\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Senator_Mark_Warner_Portrait_(cut_cropped).png\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Senator_Mark_Warner_Portrait_%28cut_cropped%29.png/120px-Senator_Mark_Warner_Portrait_%28cut_cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9f/Senator_Mark_Warner_Portrait_%28cut_cropped%29.png/250px-Senator_Mark_Warner_Portrait_%28cut_cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3037\" data-file-height=\"4050\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:110311160930_MG_Mizusawa,_Bert_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/63/110311160930_MG_Mizusawa%2C_Bert_%28cropped%29.jpg/120px-110311160930_MG_Mizusawa%2C_Bert_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/63/110311160930_MG_Mizusawa%2C_Bert_%28cropped%29.jpg/250px-110311160930_MG_Mizusawa%2C_Bert_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1229\" data-file-height=\"1639\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Mark_Warner\" title=\"Mark Warner\">Mark Warner</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Bert_Mizusawa\" title=\"Bert Mizusawa\">Bert Mizusawa</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Virginia\" title=\"List of United States senators from Virginia\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Mark_Warner\" title=\"Mark Warner\">Mark Warner</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Virginia\" title=\"2026 United States Senate election in Virginia\">2026 United States Senate election in Virginia</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Virginia\" title=\"List of United States senators from Virginia\">List of United States senators from Virginia</a></div>\n<p>Three-term Democrat <a href=\"/wiki/Mark_Warner\" title=\"Mark Warner\">Mark Warner</a> was reelected in <a href=\"/wiki/2020_United_States_Senate_election_in_Virginia\" title=\"2020 United States Senate election in Virginia\">2020</a> with 56% of the vote and is running for reelection. As the only person to submit the necessary number of signatures to appear on the primary ballot, Warner is the Democratic nominee.<sup id=\"cite&#95;ref-WarnerVA&#95;147-1\" class=\"reference\"><a href=\"#cite_note-WarnerVA-147\"><span class=\"cite-bracket\">&#91;</span>123<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>\nRetired <a href=\"/wiki/United_States_Army\" title=\"United States Army\">United States Army</a> <a href=\"/wiki/Major_general\" title=\"Major general\">Major General</a> <a href=\"/wiki/Bert_Mizusawa\" title=\"Bert Mizusawa\">Bert Mizusawa</a>, who previously ran for U.S. Senate in <a href=\"/wiki/2018_United_States_Senate_election_in_Virginia\" title=\"2018 United States Senate election in Virginia\">2018</a> and <a href=\"/wiki/Virginia%27s_2nd_congressional_district\" title=\"Virginia&#39;s 2nd congressional district\">Virginia's 2nd congressional district</a> in <a href=\"/wiki/2010_United_States_House_of_Representatives_elections_in_Virginia#District_3\" title=\"2010 United States House of Representatives elections in Virginia\">2010</a>,<sup id=\"cite&#95;ref-319\" class=\"reference\"><a href=\"#cite_note-319\"><span class=\"cite-bracket\">&#91;</span>295<span class=\"cite-bracket\">&#93;</span></a></sup> won the Republican nomination over <a href=\"/wiki/Certified_Public_Accountant\" title=\"Certified Public Accountant\">Certified Public Accountant</a> Kim Farrington<sup id=\"cite&#95;ref-FarringtonVA&#95;320-0\" class=\"reference\"><a href=\"#cite_note-FarringtonVA-320\"><span class=\"cite-bracket\">&#91;</span>296<span class=\"cite-bracket\">&#93;</span></a></sup> and <a href=\"/wiki/United_States_Marine_Corps_Reserve\" title=\"United States Marine Corps Reserve\">U.S. Marine Corps Reserve</a> Colonel David Williams.<sup id=\"cite&#95;ref-321\" class=\"reference\"><a href=\"#cite_note-321\"><span class=\"cite-bracket\">&#91;</span>297<span class=\"cite-bracket\">&#93;</span></a></sup></p><div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"West_Virginia\">West Virginia</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=53\" title=\"Edit section: West Virginia\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">West Virginia election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Flag_of_West_Virginia.svg/60px-Flag_of_West_Virginia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"26\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/22/Flag_of_West_Virginia.svg/120px-Flag_of_West_Virginia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"760\" data-file-height=\"400\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_West_Virginia\" title=\"2020 United States Senate election in West Virginia\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Shelley_Moore_Capito_official_Senate_photo_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Shelley_Moore_Capito_official_Senate_photo_%28cropped_2%29.jpg/120px-Shelley_Moore_Capito_official_Senate_photo_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"101\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/37/Shelley_Moore_Capito_official_Senate_photo_%28cropped_2%29.jpg/250px-Shelley_Moore_Capito_official_Senate_photo_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1625\" data-file-height=\"2189\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Shelley_Moore_Capito\" title=\"Shelley Moore Capito\">Shelley Moore Capito</a>\n</td>\n<td style=\"width:75px;text-align:center\">Rachel Fetty Anderson\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_West_Virginia\" title=\"List of United States senators from West Virginia\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Shelley_Moore_Capito\" title=\"Shelley Moore Capito\">Shelley Moore Capito</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_West_Virginia\" title=\"2026 United States Senate election in West Virginia\">2026 United States Senate election in West Virginia</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_West_Virginia\" title=\"List of United States senators from West Virginia\">List of United States senators from West Virginia</a></div>\n<p>Two-term Republican <a href=\"/wiki/Shelley_Moore_Capito\" title=\"Shelley Moore Capito\">Shelley Moore Capito</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_West_Virginia\" title=\"2020 United States Senate election in West Virginia\">reelected in 2020</a> with 70.3% of the vote and is running for reelection to a third term.<sup id=\"cite&#95;ref-322\" class=\"reference\"><a href=\"#cite_note-322\"><span class=\"cite-bracket\">&#91;</span>298<span class=\"cite-bracket\">&#93;</span></a></sup> She won the Republican primary on May 12.<sup id=\"cite&#95;ref-323\" class=\"reference\"><a href=\"#cite_note-323\"><span class=\"cite-bracket\">&#91;</span>299<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Morgantown,_West_Virginia\" title=\"Morgantown, West Virginia\">Morgantown</a> City Councilwoman Rachel Fetty Anderson<sup id=\"cite&#95;ref-WV&#95;324-0\" class=\"reference\"><a href=\"#cite_note-WV-324\"><span class=\"cite-bracket\">&#91;</span>300<span class=\"cite-bracket\">&#93;</span></a></sup> won the Democratic primary on May 12, 2026.<sup id=\"cite&#95;ref-325\" class=\"reference\"><a href=\"#cite_note-325\"><span class=\"cite-bracket\">&#91;</span>301<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Wyoming\">Wyoming</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=54\" title=\"Edit section: Wyoming\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\"><caption class=\"infobox-title summary\">Wyoming election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Flag_of_Wyoming.svg/60px-Flag_of_Wyoming.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bc/Flag_of_Wyoming.svg/120px-Flag_of_Wyoming.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1000\" data-file-height=\"700\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Wyoming\" title=\"2020 United States Senate election in Wyoming\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Official-harriet-hageman-wy00_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Official-harriet-hageman-wy00_%28cropped%29.jpg/120px-Official-harriet-hageman-wy00_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"107\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/78/Official-harriet-hageman-wy00_%28cropped%29.jpg/250px-Official-harriet-hageman-wy00_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"285\" data-file-height=\"363\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:James_W._Byrd_at_Campbell_County_League_of_Women_Voters%27_General_Election_Candidates%27_Forum_in_Gillette,_Wyoming_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/61/James_W._Byrd_at_Campbell_County_League_of_Women_Voters%27_General_Election_Candidates%27_Forum_in_Gillette%2C_Wyoming_%28cropped%29.jpg/120px-James_W._Byrd_at_Campbell_County_League_of_Women_Voters%27_General_Election_Candidates%27_Forum_in_Gillette%2C_Wyoming_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/61/James_W._Byrd_at_Campbell_County_League_of_Women_Voters%27_General_Election_Candidates%27_Forum_in_Gillette%2C_Wyoming_%28cropped%29.jpg/250px-James_W._Byrd_at_Campbell_County_League_of_Women_Voters%27_General_Election_Candidates%27_Forum_in_Gillette%2C_Wyoming_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1596\" data-file-height=\"2125\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Harriet_Hageman\" title=\"Harriet Hageman\">Harriet Hageman</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/James_W._Byrd\" title=\"James W. Byrd\">James W. Byrd</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b>Incumbent <a href=\"/wiki/List_of_United_States_senators_from_Wyoming\" title=\"List of United States senators from Wyoming\">U.S. senator</a></b><br />\n<p><a href=\"/wiki/Cynthia_Lummis\" title=\"Cynthia Lummis\">Cynthia Lummis</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><br />\n<p><br />\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2026_United_States_Senate_election_in_Wyoming\" title=\"2026 United States Senate election in Wyoming\">2026 United States Senate election in Wyoming</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Wyoming\" title=\"List of United States senators from Wyoming\">List of United States senators from Wyoming</a></div>\n<p>One-term Republican <a href=\"/wiki/Cynthia_Lummis\" title=\"Cynthia Lummis\">Cynthia Lummis</a> was <a href=\"/wiki/2020_United_States_Senate_election_in_Wyoming\" title=\"2020 United States Senate election in Wyoming\">elected in 2020</a> with 72.8% of the vote and is not seeking reelection.<sup id=\"cite&#95;ref-Lummis&#95;38-2\" class=\"reference\"><a href=\"#cite_note-Lummis-38\"><span class=\"cite-bracket\">&#91;</span>24<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. Representative</a> <a href=\"/wiki/Harriet_Hageman\" title=\"Harriet Hageman\">Harriet Hageman</a> defeated <a href=\"/wiki/Wyoming_Army_National_Guard\" title=\"Wyoming Army National Guard\">Wyoming Army National Guard</a> veteran Jimmy Skovgard for the Republican nomination on August 18, 2026.<sup id=\"cite&#95;ref-:8&#95;326-0\" class=\"reference\"><a href=\"#cite_note-:8-326\"><span class=\"cite-bracket\">&#91;</span>302<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Former <a href=\"/wiki/Wyoming_House_of_Representatives\" title=\"Wyoming House of Representatives\">state Representative</a> <a href=\"/wiki/James_W._Byrd\" title=\"James W. Byrd\">James W. Byrd</a> defeated landscaper Billy Benavidez for the Democratic nomination on August 18, 2026.<sup id=\"cite&#95;ref-:8&#95;326-1\" class=\"reference\"><a href=\"#cite_note-:8-326\"><span class=\"cite-bracket\">&#91;</span>302<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"See_also\">See also</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=55\" title=\"Edit section: See also\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<ul><li><a href=\"/wiki/2026_United_States_elections\" title=\"2026 United States elections\">2026 United States elections</a></li>\n<li><a href=\"/wiki/Opinion_polling_on_the_second_Trump_presidency\" title=\"Opinion polling on the second Trump presidency\">Opinion polling on the second Trump presidency</a></li></ul>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Notes\">Notes</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=56\" title=\"Edit section: Notes\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<style data-mw-deduplicate=\"TemplateStyles:r1327269900\">.mw-parser-output .reflist-columns-2{column-width:30em}.mw-parser-output .reflist-columns-3{column-width:25em}body.skin-vector-2022 .mw-parser-output .reflist-columns-2{column-width:27em}body.skin-vector-2022 .mw-parser-output .reflist-columns-3{column-width:22.5em}.mw-parser-output .references[data-mw-group=upper-alpha]{list-style-type:upper-alpha}.mw-parser-output .references[data-mw-group=upper-roman]{list-style-type:upper-roman}.mw-parser-output .references[data-mw-group=lower-alpha]{list-style-type:lower-alpha}.mw-parser-output .references[data-mw-group=lower-greek]{list-style-type:lower-greek}.mw-parser-output .references[data-mw-group=lower-roman]{list-style-type:lower-roman}.mw-parser-output div.reflist-liststyle-upper-alpha .references{list-style-type:upper-alpha}.mw-parser-output div.reflist-liststyle-upper-roman .references{list-style-type:upper-roman}.mw-parser-output div.reflist-liststyle-lower-alpha .references{list-style-type:lower-alpha}.mw-parser-output div.reflist-liststyle-lower-greek .references{list-style-type:lower-greek}.mw-parser-output div.reflist-liststyle-lower-roman .references{list-style-type:lower-roman}</style><div>\n<div class=\"mw-references-wrap mw-references-columns\"><ol class=\"references\" data-mw-group=\"lower-alpha\">\n<li id=\"cite&#95;note-1\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-1\">^</a></b></span> <span class=\"reference-text\">33 Class 2 seats, as well as 2 Class 3 seats being determined in special elections</span>\n</li>\n<li id=\"cite&#95;note-2\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-2\">^</a></b></span> <span class=\"reference-text\">Majority control in an evenly divided Senate is determined by the <a href=\"/wiki/Vice_President_of_the_United_States\" title=\"Vice President of the United States\">Vice President of the United States</a>, who has the power to break tied votes in their constitutional capacity as President of the Senate; accordingly, Senate control requires 51 seats or 50 seats with control of the vice presidency.</span>\n</li>\n<li id=\"cite&#95;note-Independents-3\"><span class=\"mw-cite-backlink\">^ <a href=\"#cite_ref-Independents_3-0\"><sup><i><b>a</b></i></sup></a> <a href=\"#cite_ref-Independents_3-1\"><sup><i><b>b</b></i></sup></a></span> <span class=\"reference-text\">Both independent senators (<a href=\"/wiki/Bernie_Sanders\" title=\"Bernie Sanders\">Bernie Sanders</a> of <a href=\"/wiki/Vermont\" title=\"Vermont\">Vermont</a>, and <a href=\"/wiki/Angus_King\" title=\"Angus King\">Angus King</a> of <a href=\"/wiki/Maine\" title=\"Maine\">Maine</a>) caucus with the Democrats.</span>\n</li>\n<li id=\"cite&#95;note-OK-4\"><span class=\"mw-cite-backlink\">^ <a href=\"#cite_ref-OK_4-0\"><sup><i><b>a</b></i></sup></a> <a href=\"#cite_ref-OK_4-1\"><sup><i><b>b</b></i></sup></a></span> <span class=\"reference-text\"><a href=\"/wiki/Markwayne_Mullin\" title=\"Markwayne Mullin\">Markwayne Mullin</a> won a <a href=\"/wiki/2022_United_States_Senate_special_election_in_Oklahoma\" title=\"2022 United States Senate special election in Oklahoma\">special election in 2022</a> to fill <a href=\"/wiki/Jim_Inhofe\" title=\"Jim Inhofe\">Jim Inhofe</a>'s <a href=\"/wiki/List_of_United_States_senators_from_Oklahoma\" title=\"List of United States senators from Oklahoma\">Oklahoma Senate</a> seat after Inhofe resigned for health reasons. Mullin resigned on March 23, 2026, to become <a href=\"/wiki/United_States_Secretary_of_Homeland_Security\" title=\"United States Secretary of Homeland Security\">United States Secretary of Homeland Security</a>. <a href=\"/wiki/Governor_of_Oklahoma\" title=\"Governor of Oklahoma\">Oklahoma Governor</a> <a href=\"/wiki/Kevin_Stitt\" title=\"Kevin Stitt\">Kevin Stitt</a> appointed <a href=\"/wiki/Alan_Armstrong\" title=\"Alan Armstrong\">Alan Armstrong</a> to the seat, and he was sworn in on March 24, 2026. Oklahoma law requires appointees to affirm they will not seek a full term; Armstrong will not run for election.<sup id=\"cite&#95;ref-OK&#95;Statutes&#95;24-0\" class=\"reference\"><a href=\"#cite_note-OK_Statutes-24\"><span class=\"cite-bracket\">&#91;</span>13<span class=\"cite-bracket\">&#93;</span></a></sup></span>\n</li>\n<li id=\"cite&#95;note-PrimaryLoss-5\"><span class=\"mw-cite-backlink\">^ <a href=\"#cite_ref-PrimaryLoss_5-0\"><sup><i><b>a</b></i></sup></a> <a href=\"#cite_ref-PrimaryLoss_5-1\"><sup><i><b>b</b></i></sup></a></span> <span class=\"reference-text\">Republican senator <a href=\"/wiki/Luther_Strange\" title=\"Luther Strange\">Luther Strange</a> ran to complete the term he was appointed to in <a href=\"/wiki/2017_United_States_Senate_special_election_in_Alabama\" title=\"2017 United States Senate special election in Alabama\">2017</a> but lost the primary to <a href=\"/wiki/Roy_Moore\" title=\"Roy Moore\">Roy Moore</a>, who narrowly lost the general election to Democratic nominee <a href=\"/wiki/Doug_Jones_(politician)\" title=\"Doug Jones (politician)\">Doug Jones</a>.</span>\n</li>\n<li id=\"cite&#95;note-6\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-6\">^</a></b></span> <span class=\"reference-text\">Two elected incumbent senators lost renomination in primaries in 2010: <a href=\"/wiki/Lisa_Murkowski\" title=\"Lisa Murkowski\">Lisa Murkowski</a> in <a href=\"/wiki/2010_United_States_Senate_election_in_Alaska\" title=\"2010 United States Senate election in Alaska\">Alaska</a> and <a href=\"/wiki/Arlen_Specter\" title=\"Arlen Specter\">Arlen Specter</a> in <a href=\"/wiki/2010_United_States_Senate_Democratic_primary_election_in_Pennsylvania\" title=\"2010 United States Senate Democratic primary election in Pennsylvania\">Pennsylvania</a>. After losing her primary, Murkowski ran a write-in campaign during the general election and won. In addition, <a href=\"/wiki/Bob_Bennett_(politician)\" title=\"Bob Bennett (politician)\">Bob Bennett</a> lost renomination at the state convention in <a href=\"/wiki/2010_United_States_Senate_election_in_Utah\" title=\"2010 United States Senate election in Utah\">Utah</a>.</span>\n</li>\n<li id=\"cite&#95;note-8\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-8\">^</a></b></span> <span class=\"reference-text\">Republican senator <a href=\"/wiki/Maurice_J._Murphy_Jr.\" title=\"Maurice J. Murphy Jr.\">Maurice J. Murphy Jr.</a> ran to complete the term he was appointed to in <a href=\"/wiki/1962_United_States_Senate_special_election_in_New_Hampshire\" title=\"1962 United States Senate special election in New Hampshire\">1962</a> but placed third in the primary.<sup id=\"cite&#95;ref-SittingSenatorsPlaceThird&#95;7-1\" class=\"reference\"><a href=\"#cite_note-SittingSenatorsPlaceThird-7\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></span>\n</li>\n<li id=\"cite&#95;note-9\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-9\">^</a></b></span> <span class=\"reference-text\">Two nominees in subsequent election cycles willingly withdrew their nominations after winning their primaries: <a href=\"/wiki/Baron_Hill_(politician)\" title=\"Baron Hill (politician)\">Baron Hill</a> in the <a href=\"/wiki/2016_United_States_Senate_election_in_Indiana\" title=\"2016 United States Senate election in Indiana\">2016 election in Indiana</a> and <a href=\"/wiki/H._Brooke_Paige\" title=\"H. Brooke Paige\">H. Brooke Paige</a> in the <a href=\"/wiki/2018_United_States_Senate_election_in_Vermont\" title=\"2018 United States Senate election in Vermont\">2018 election in Vermont</a>. The replacement nominees were selected by their parties without a convention or special primary; both lost in the general election.</span>\n</li>\n<li id=\"cite&#95;note-Special-21\"><span class=\"mw-cite-backlink\">^ <a href=\"#cite_ref-Special_21-0\"><sup><i><b>a</b></i></sup></a> <a href=\"#cite_ref-Special_21-1\"><sup><i><b>b</b></i></sup></a></span> <span class=\"reference-text\">Includes the interim appointees from Florida (<a href=\"/wiki/Ashley_Moody\" title=\"Ashley Moody\">Ashley Moody</a>) and Ohio (<a href=\"/wiki/Jon_Husted\" title=\"Jon Husted\">Jon Husted</a>) running for election.</span>\n</li>\n<li id=\"cite&#95;note-22\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-22\">^</a></b></span> <span class=\"reference-text\">In <a href=\"#Louisiana\">Louisiana</a>, <a href=\"/wiki/Bill_Cassidy\" title=\"Bill Cassidy\">Bill Cassidy</a> lost renomination for another term in office, <a href=\"/wiki/Julia_Letlow\" title=\"Julia Letlow\">Julia Letlow</a> became the party's new nominee. In <a href=\"#Texas\">Texas</a>, <a href=\"/wiki/John_Cornyn\" title=\"John Cornyn\">John Cornyn</a> also lost renomination for another term in office, <a href=\"/wiki/Ken_Paxton\" title=\"Ken Paxton\">Ken Paxton</a> became the party's new nominee.</span>\n</li>\n<li id=\"cite&#95;note-23\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-23\">^</a></b></span> <span class=\"reference-text\">Includes the interim appointee who is running for election.</span>\n</li>\n<li id=\"cite&#95;note-25\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-25\">^</a></b></span> <span class=\"reference-text\">In the <a href=\"/wiki/2010_United_States_Senate_elections\" title=\"2010 United States Senate elections\">2010 Senate elections</a>, the <a href=\"/wiki/2010_United_States_Senate_special_election_in_Massachusetts\" title=\"2010 United States Senate special election in Massachusetts\">Massachusetts special election</a> was not included in the list and not part in the regular election cycle.</span>\n</li>\n<li id=\"cite&#95;note-32\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-32\">^</a></b></span> <span class=\"reference-text\">Appointed to the seat following the resignation of <a href=\"/wiki/Al_Franken\" title=\"Al Franken\">Al Franken</a>.</span>\n</li>\n<li id=\"cite&#95;note-36\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-36\">^</a></b></span> <span class=\"reference-text\">Appointed to the seat following the resignation of <a href=\"/wiki/Markwayne_Mullin\" title=\"Markwayne Mullin\">Markwayne Mullin</a>.</span>\n</li>\n<li id=\"cite&#95;note-42\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-42\">^</a></b></span> <span class=\"reference-text\">The last elections for this group of senators were in 2020, except for those elected in a <a href=\"/wiki/Special_election\" class=\"mw-redirect\" title=\"Special election\">special election</a> or who were appointed after the resignation or death of a sitting senator, as noted.</span>\n</li>\n<li id=\"cite&#95;note-46\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-46\">^</a></b></span> <span class=\"reference-text\">This forecast uses the terms \"Likely\" and \"Very Likely\" the same way the other forecasts use the terms \"Lean\" and \"Likely\". To avoid confusion, and for the purposes of equivalency, the terms \"Likely\" and \"Very Likely\" will be changed to \"Lean\" and \"Likely\".</span>\n</li>\n<li id=\"cite&#95;note-54\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-54\">^</a></b></span> <span class=\"reference-text\">Republican <a href=\"/wiki/Marco_Rubio\" title=\"Marco Rubio\">Marco Rubio</a> won with 57.68% of the vote in 2022, but resigned on January 20, 2025, after being confirmed to become <a href=\"/wiki/United_States_Secretary_of_State\" title=\"United States Secretary of State\">Secretary of State</a>.</span>\n</li>\n<li id=\"cite&#95;note-Nebraska-55\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-Nebraska_55-0\">^</a></b></span> <span class=\"reference-text\">Republican <a href=\"/wiki/Ben_Sasse\" title=\"Ben Sasse\">Ben Sasse</a> won with 62.74% of the vote in 2020, but resigned on January 8, 2023, to be president of the <a href=\"/wiki/University_of_Florida\" title=\"University of Florida\">University of Florida</a>.</span>\n</li>\n<li id=\"cite&#95;note-56\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-56\">^</a></b></span> <span class=\"reference-text\">Republican <a href=\"/wiki/JD_Vance\" title=\"JD Vance\">JD Vance</a> won with 53.03% of the vote in 2022, but resigned on January 10, 2025, to become Vice President of the United States.</span>\n</li>\n<li id=\"cite&#95;note-Oklahoma-57\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-Oklahoma_57-0\">^</a></b></span> <span class=\"reference-text\">Republican <a href=\"/wiki/Jim_Inhofe\" title=\"Jim Inhofe\">Jim Inhofe</a> won with 62.91% of the vote in 2020, but resigned at the end of the <a href=\"/wiki/117th_United_States_Congress\" title=\"117th United States Congress\">117th United States Congress</a>. In 2022, <a href=\"/wiki/Markwayne_Mullin\" title=\"Markwayne Mullin\">Markwayne Mullin</a> won with 61.77% of the vote. He resigned in 2026 after being sworn in as <a href=\"/wiki/United_States_Department_of_Homeland_Security\" title=\"United States Department of Homeland Security\">United States Department of Homeland Security</a>.</span>\n</li>\n<li id=\"cite&#95;note-South&#95;Carolina-58\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-South_Carolina_58-0\">^</a></b></span> <span class=\"reference-text\">Republican <a href=\"/wiki/Lindsey_Graham\" title=\"Lindsey Graham\">Lindsey Graham</a> won with 54.44% of the vote in 2020, but died in office on July 11, 2026.</span>\n</li>\n<li id=\"cite&#95;note-59\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-59\">^</a></b></span> <span class=\"reference-text\">Democratic total includes Independents who <a href=\"/wiki/Independent_Democrat\" title=\"Independent Democrat\">caucus with the Democrats</a>.</span>\n</li>\n<li id=\"cite&#95;note-60\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-60\">^</a></b></span> <span class=\"reference-text\">Calculated by taking the difference of 100% and all other candidates combined.</span>\n</li>\n<li id=\"cite&#95;note-139\"><span class=\"mw-cite-backlink\"><b><a href=\"#cite_ref-139\">^</a></b></span> <span class=\"reference-text\">Republican incumbent <a href=\"/wiki/Lindsey_Graham\" title=\"Lindsey Graham\">Lindsey Graham</a> was renominated, but died on July 11, 2026.</span>\n</li>\n</ol></div></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"References\">References</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=57\" title=\"Edit section: References\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1327269900\" /><div>\n<div class=\"mw-references-wrap mw-references-columns\"><ol class=\"references\">\n<li id=\"cite&#95;note-SittingSenatorsPlaceThird-7\"><span class=\"mw-cite-backlink\">^ <a href=\"#cite_ref-SittingSenatorsPlaceThird_7-0\"><sup><i><b>a</b></i></sup></a> <a href=\"#cite_ref-SittingSenatorsPlaceThird_7-1\"><sup><i><b>b</b></i></sup></a></span> <span class=\"reference-text\"><style data-mw-deduplicate=\"TemplateStyles:r1333433106\">.mw-parser-output cite.citation{font-style:inherit;word-wrap:break-word}.mw-parser-output .citation q{quotes:\"\\\"\"\"\\\"\"\"'\"\"'\"}.mw-parser-output .citation:target{background-color:rgba(0,127,255,0.133)}.mw-parser-output .id-lock-free.id-lock-free a{background:url(\"//upload.wikimedia.org/wikipedia/commons/6/65/Lock-green.svg\")right 0.1em center/9px no-repeat}.mw-parser-output .id-lock-limited.id-lock-limited a,.mw-parser-output .id-lock-registration.id-lock-registration a{background:url(\"//upload.wikimedia.org/wikipedia/commons/d/d6/Lock-gray-alt-2.svg\")right 0.1em center/9px no-repeat}.mw-parser-output .id-lock-subscription.id-lock-subscription a{background:url(\"//upload.wikimedia.org/wikipedia/commons/a/aa/Lock-red-alt-2.svg\")right 0.1em center/9px no-repeat}.mw-parser-output .cs1-ws-icon a{background:url(\"//upload.wikimedia.org/wikipedia/commons/4/4c/Wikisource-logo.svg\")right 0.1em center/12px no-repeat}body:not(.skin-timeless):not(.skin-minerva) .mw-parser-output .id-lock-free a,body:not(.skin-timeless):not(.skin-minerva) .mw-parser-output .id-lock-limited a,body:not(.skin-timeless):not(.skin-minerva) .mw-parser-output .id-lock-registration a,body:not(.skin-timeless):not(.skin-minerva) .mw-parser-output .id-lock-subscription a,body:not(.skin-timeless):not(.skin-minerva) .mw-parser-output .cs1-ws-icon a{background-size:contain;padding:0 1em 0 0}.mw-parser-output .cs1-code{color:inherit;background:inherit;border:none;padding:inherit}.mw-parser-output .cs1-hidden-error{display:none;color:var(--color-error,#bf3c2c)}.mw-parser-output .cs1-visible-error{color:var(--color