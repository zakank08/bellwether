\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"#\"}},\"i\":0}}]}'>#</sub></td>\n<td id=\"mwBTw\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\" id=\"mwBT0\">Republican</a></td></tr>\n<tr id=\"mwBT4\">\n<td align=\"center\" style=\"background-color:#DCDCDC\" about=\"#mwt1108\" typeof=\"mw:ExpandedAttrs\" id=\"mwBUA\" data-mw='{\"attribs\":[[{\"txt\":\"style\",\"html\":\"&lt;span about=\\\"#mwt1106\\\" typeof=\\\"mw:Transclusion\\\" id=\\\"mwBT8\\\" data-mw=&apos;{\\\"parts\\\":[{\\\"template\\\":{\\\"target\\\":{\\\"wt\\\":\\\"Party shading/Independent\\\",\\\"href\\\":\\\"./Template:Party_shading/Independent\\\"},\\\"params\\\":{},\\\"i\\\":0}}]}&apos;>style=\\\"background-color:&lt;/span>&lt;span typeof=\\\"mw:Entity\\\" about=\\\"#mwt1106\\\">#&lt;/span>&lt;span about=\\\"#mwt1106\\\">DCDCDC\\\"&lt;/span>\"},{\"html\":\"\"}]]}'>I<sub about=\"#mwt1105\" typeof=\"mw:Transclusion\" id=\"mwBUE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"#\"}},\"i\":0}}]}'>#</sub></td>\n<td id=\"mwBUI\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Independent_politician#United_States\" title=\"Independent politician\" id=\"mwBUM\">Independent</a>, caucusing with Democrats</td></tr>\n</tbody></table></td></tr>\n</tbody></table>\n\n</section></section><section data-mw-section-id=\"7\" id=\"mwBUQ\" aria-labelledby=\"Gains_and_holds\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Gains_and_holds\">Gains and holds</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=7\" title=\"Edit section: Gains and holds\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<section data-mw-section-id=\"8\" id=\"mwBUU\" aria-labelledby=\"Retirements\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Retirements\">Retirements</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=8\" title=\"Edit section: Retirements\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p id=\"mwBUY\">Eleven senators—four Democrats and seven Republicans—have announced they will not seek reelection. This is the most in a single election cycle since <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/1996_United_States_Senate_elections\" title=\"1996 United States Senate elections\" id=\"mwBUc\">1996</a>, when thirteen senators chose not to run again.<sup about=\"#mwt1109\" class=\"mw-ref reference\" id=\"cite_ref-26\" rel=\"dc:references\" typeof=\"mw:Transclusion mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"group\":\"lower-alpha\"},\"body\":{\"id\":\"mw-reference-text-cite_note-26\"},\"parts\":[{\"template\":{\"target\":{\"wt\":\"efn\",\"href\":\"./Template:Efn\"},\"params\":{\"1\":{\"wt\":\"In the [[2010 United States Senate elections|2010 Senate elections]], the [[2010 United States Senate special election in Massachusetts|Massachusetts special election]] was not included in the list and not part in the regular election cycle.\"}},\"i\":0}}]}'><a href=\"#cite_note-26\" data-mw-group=\"lower-alpha\" id=\"mwBUg\"><span class=\"mw-reflink-text\" id=\"mwBUk\"><span class=\"cite-bracket\" id=\"mwBUo\">[</span>l<span class=\"cite-bracket\" id=\"mwBUs\">]</span></span></a></sup><sup about=\"#mwt1114\" class=\"mw-ref reference\" id=\"cite_ref-27\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-27\"}}'><a href=\"#cite_note-27\" id=\"mwBUw\"><span class=\"mw-reflink-text\" id=\"mwBU0\"><span class=\"cite-bracket\" id=\"mwBU4\">[</span>15<span class=\"cite-bracke