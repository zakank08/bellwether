mplate\":{\"target\":{\"wt\":\"sdash\",\"href\":\"./Template:Sdash\"},\"params\":{},\"i\":0}}]}'>—</td>\n<th id=\"mwAbQ\">TBD</th></tr>\n<tr id=\"mwAbU\">\n<td colspan=\"6\" id=\"mwAbY\"></td></tr>\n<tr id=\"mwAbc\">\n<th colspan=\"2\" id=\"mwAbg\">Result</th>\n<th id=\"mwAbk\">TBD</th>\n<th id=\"mwAbo\">TBD</th>\n<th id=\"mwAbs\">TBD</th>\n<th id=\"mwAbw\">TBD</th></tr>\n</tbody></table>\n\n</section></section><section data-mw-section-id=\"4\" id=\"mwAb0\" aria-labelledby=\"Change_in_composition\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Change_in_composition\">Change in composition</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=4\" title=\"Edit section: Change in composition\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p id=\"mwAb4\">Each block represents one of the one hundred seats in the U.S. Senate. \"D#\" is a Democratic senator, \"I#\" is an Independent senator, and \"R#\" is a Republican senator. They are arranged so that the parties are separated and a majority is clear by crossing the middle.</p>\n\n<section data-mw-section-id=\"5\" id=\"mwAb8\" aria-labelledby=\"Before_the_elections\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Before_the_elections\">Before the elections</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=5\" title=\"Edit section: Before the elections\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<p id=\"mwAcA\">Each block indicates an incumbent senator's actions going into the election.</p>\n<!--\n\n\"Retiring\": closest to the middle;\n\"Running\": farthest from the middle;\n\"Undeclared\" is between them.\n\nStates sorted in alphabetical order by unabbreviated name.\n\nAbbreviate state names per AP style at [[List of U.S. state abbreviations]].\n\n-->\n<table class=\"wikitable\" style=\"text-align:center\" id=\"mwAcE\">\n\n<tbody id=\"mwAcI\"><tr id=\"mwAcM\">\n<td width=\"10%\" style=\"color:black;background-color:#B0CEFF\" about=\"#mwt176\" typeof=\"mw:ExpandedAttrs\" id=\"mwAcU\" data-mw='{\"attribs\":[[{\"txt\":\"style\",\"html\":\"&lt;span about=\\\"#mwt174\\\" typeof=\\\"mw:Transclusion\\\" id=\\\"mwAcQ\\\" data-mw=&apos;{\\\"parts\\\":[{\\\"template\\\":{\\\"target\\\":{\\\"wt\\\":\\\"Party shading/Democratic\\\",\\\"href\\\":\\\"./Template:Party_shading/Democratic\\\"},\\\"params\\\":{},\\\"i\\\":0}}]}&apos;>style=\\\"color:black;background-color:&lt;/span>&lt;span typeof=\\\"mw:Nowiki\\\" about=\\\"#mwt174\\\">&lt;/span>&lt;span about=\\\"#mwt174\\\">#B0CEFF\\\"&lt;/span>\"},{\"html\":\"\"}]]}'>D<sub about=\"#mwt173\" typeof=\"mw:Transclusion\" id=\"mwAcY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"1\"}},\"i\":0}}]}'>1</sub></td>\n<td width=\"10%\" style=\"color:black;background-color:#B0CEFF\" about=\"#mwt180\" typeof=\"mw:ExpandedAttrs\" id=\"mwAcg\" data-mw='{\"attribs\":[[{\"txt\":\"style\",\"html\":\"&lt;span about=\\\"#mwt179\\\" typeof=\\\"mw:Transclusion\\\" id=\\\"mwAcc\\\" data-mw=&apos;{\\\"parts\\\":[{\\\"template\\\":{\\\"target\\\":{\\\"wt\\\":\\\"Party shading/Democratic\\\",\\\"href\\\":\\\"./Template:Party_shading/Democratic\\\"},\\\"params\\\":{},\\\"i\\\":0}}]}&apos;>style=\\\"color:black;background-color:&lt;/span>&lt;span typeof=\\\"mw:Nowiki\\\" about=\\\"#mwt179\\\">&lt;/span>&lt;span about=\\\"#mwt179\\\">#B0CEFF\\\"&lt;/span>\"},{\"html\":\"\"}]]}'>D<sub about=\"#mwt177\" typeof=\"mw:Transclusion\" id=\"mwAck\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Sub\",\"href\":\"./Template:Sub\"},\"params\":{\"1\":{\"wt\":\"2\"}},\"i\":0}}]}'>2</sub></td>\n<td width=\"10%\" style=\"color:black;background-color:#B0CEFF\" about=\"#mwt184\" typeof=\"