content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1b/Official_headshot_of_US_Senator_Cindy_Hyde-Smith_%28cropped%29.jpg/250px-Official_headshot_of_US_Senator_Cindy_Hyde-Smith_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"798\" data-file-height=\"990\" data-file-type=\"bitmap\" height=\"136\" width=\"110\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:3x4.svg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:3x4.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" data-file-type=\"drawing\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Cindy_Hyde-Smith\" title=\"Cindy Hyde-Smith\">Cindy Hyde-Smith</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Scott_Colom\" title=\"Scott Colom\">Scott Colom</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Mississippi\" title=\"List of United States senators from Mississippi\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Cindy_Hyde-Smith\" title=\"Cindy Hyde-Smith\">Cindy Hyde-Smith</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3335\" typeof=\"mw:Transclusion\" id=\"mwE_U\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Mississippi\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3336\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3335\" id=\"mwE_Y\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Mississippi\" title=\"2026 United States Senate election in Mississippi\">2026 United States Senate election in Mississippi</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3337\" typeof=\"mw:Transclusion\" id=\"mwE_c\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Mississippi\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3338\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3337\" id=\"mwE_g\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Mississippi\" title=\"List of United States senators from Mississippi\">List of United States senators from Mississippi</a></div>\n<p id=\"mwE_k\">One-term Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Cindy_Hyde-Smith\" title=\"Cindy Hyde-Smith\" id=\"mwE_o\">Cindy Hyde-Smith</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Mississippi\" title=\"2020 United States Senate election in Mississippi\" id=\"mwE_s\">reelected in 2020</a> with 54.1% of the vote after being appointed in 2018 and winning a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2018_United_States_Senate_special_election_in_Mississippi\" title=\"2018 United States Senate special election in Mississippi\" id=\"mwE_w\">special election</a> later that year. She is running for a second full term in office.<sup about=\"#mwt3341\" class=\"mw-ref reference\" id=\"cite_ref-HydeSmith_238-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"HydeSmith\"},\"body\":{\"id\":\"mw-reference-text-cite_note-HydeSmith-238\"}}'><a href=\"#cite_note-HydeSmith-238\" id=\"mwE_0\"><span class=\"mw-reflink-text\" id=\"mwE_4\"><span class=\"cite-bracket\" id=\"mwE_8\">[</span>214<span class=\"cite-bracket\" id=\"mwFAA\">]</span></span></a></sup> She defeated <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Medical_doctor\" title=\"Medical doctor\" id=\"mwFAE\">physician</a> Sarah Adlakha in the Republican primary on March 10, 2026.<sup about=\"#mwt3344\" class=\"mw-ref reference\" id=\"cite_ref-Adlakha_239-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Adlakha\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Adlakha-239\"}}'><a href=\"#cite_note-Adlakha-239\" id=\"mwFAI\"><span class=\"mw-reflink-text\" id=\"mwFAM\"><span class=\"cite-bracket\" id=\"mwFAQ\">[</span>215<span class=\"cite-bracket\" id=\"mwFAU\">]</span></span></a></sup></p>\n\n<p id=\"mwFAY\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lowndes_County,_Mississippi\" title=\"Lowndes County, Mississippi\" id=\"mwFAc\">Lowndes County</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/District_Attorney\" title=\"District Attorney\" class=\"mw-redirect\" id=\"mwFAg\">District Attorney</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Scott_Colom\" title=\"Scott Colom\" id=\"mwFAk\">Scott Colom</a> defeated <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Marine_Corps\" title=\"U.S. Marine Corps\" class=\"mw-redirect\" id=\"mwFAo\">U.S. Marine Corps</a> veteran Albert Littell, and Priscilla Williams-Till, a cousin of <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Emmett_Till\" title=\"Emmett Till\" id=\"mwFAs\">Emmett Till</a>, in the Democratic primary on March 10, 2026.<sup about=\"#mwt3347\" class=\"mw-ref reference\" id=\"cite_ref-Colom_240-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Colom\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Colom-240\"}}'><a href=\"#cite_note-Colom-240\" id=\"mwFAw\"><span class=\"mw-reflink-text\" id=\"mwFA0\"><span class=\"cite-bracket\" id=\"mwFA4\">[</span>216<span class=\"cite-bracket\" id=\"mwFA8\">]</span></span></a></sup><sup about=\"#mwt3350\" class=\"mw-ref reference\" id=\"cite_ref-WilliamsTill_241-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"WilliamsTill\"},\"body\":{\"id\":\"mw-reference-text-cite_note-WilliamsTill-241\"}}'><a href=\"#cite_note-WilliamsTill-241\" id=\"mwFBA\"><span class=\"mw-reflink-text\" id=\"mwFBE\"><span class=\"cite-bracket\" id=\"mwFBI\">[</span>217<span class=\"cite-bracket\" id=\"mwFBM\">]</span></span></a></sup><sup about=\"#mwt3353\" class=\"mw-ref reference\" id=\"cite_ref-242\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-242\"}}'><a href=\"#cite_note-242\" id=\"mwFBQ\"><span class=\"mw-reflink-text\" id=\"mwFBU\"><span class=\"cite-bracket\" id=\"mwFBY\">[</span>218<span class=\"cite-bracket\" id=\"mwFBc\">]</span></span></a></sup></p>\n\n<p id=\"mwFBg\">Ty Pinkins, the Democratic nominee for <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Secretary_of_State_of_Mississippi\" title=\"Secretary of State of Mississippi\" id=\"mwFBk\">Secretary of State</a> in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2023_Mississippi_elections#Secretary_of_state\" title=\"2023 Mississippi elections\" id=\"mwFBo\">2023</a> and for <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States_Senate\" title=\"United States Senate\" id=\"mwFBs\">U.S. Senate</a> in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_Senate_election_in_Mississippi\" title=\"2024 United States Senate election in Mississippi\" id=\"mwFBw\">2024</a>, is running as an independent.<sup about=\"#mwt3356\" class=\"mw-ref reference\" id=\"cite_ref-Pinkins_243-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Pinkins\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Pinkins-243\"}}'><a href=\"#cite_note-Pinkins-243\" id=\"mwFB0\"><span class=\"mw-reflink-text\" id=\"mwFB4\"><span class=\"cite-bracket\" id=\"mwFB8\">[</span>219<span class=\"cite-bracket\" id=\"mwFCA\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3357\" typeof=\"mw:Transclusion\" id=\"mwFCE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"39\" id=\"mwFCI\" aria-labelledby=\"Montana\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Montana\">Montana</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=39\" title=\"Edit section: Montana\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3358\" typeof=\"mw:Transclusion\" id=\"mwFCM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Montana election\"},\"country\":{\"wt\":\"Montana\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Montana\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Montana\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Kurt G. Alme official photo.jpg\"},\"nominee1\":{\"wt\":\"[[Kurt Alme]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Alani Bankhead USAF 2021.png\"},\"nominee2\":{\"wt\":\"Alani Bankhead\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"image4\":{\"wt\":\"Seth Bodnar - President at University of Montana (cropped).jpg\"},\"nominee4\":{\"wt\":\"[[Seth Bodnar]]\"},\"party4\":{\"wt\":\"Independent politician\"},\"popular_vote4\":{\"wt\":\"\"},\"percentage4\":{\"wt\":\"\"},\"image5\":{\"wt\":\"3x4.svg\"},\"nominee5\":{\"wt\":\"Kyle Austin\"},\"party5\":{\"wt\":\"Libertarian Party (United States)\"},\"popular_vote5\":{\"wt\":\"\"},\"percentage5\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Steve Daines]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3359\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3360\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3361\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3358\" id=\"mwFCQ\"><caption class=\"infobox-title summary\">Montana election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Montana.svg\" src=\"//thumb.wikimedia.o