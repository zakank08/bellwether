ign:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Andy_Barr_116th_Congress.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Andy_Barr_116th_Congress.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Andy_Barr_116th_Congress.jpg/120px-Andy_Barr_116th_Congress.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/45/Andy_Barr_116th_Congress.jpg/250px-Andy_Barr_116th_Congress.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"335\" data-file-height=\"410\" data-file-type=\"bitmap\" height=\"136\" width=\"111\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Charles_solar_panels_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Charles_solar_panels_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Charles_solar_panels_%28cropped%29.jpg/120px-Charles_solar_panels_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/3d/Charles_solar_panels_%28cropped%29.jpg/250px-Charles_solar_panels_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1492\" data-file-height=\"1865\" data-file-type=\"bitmap\" height=\"136\" width=\"109\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Andy_Barr\" title=\"Andy Barr\">Andy Barr</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Charles_Booker_(American_politician)\" title=\"Charles Booker (American politician)\">Charles Booker</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Kentucky\" title=\"List of United States senators from Kentucky\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mitch_McConnell\" title=\"Mitch McConnell\">Mitch McConnell</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3150\" typeof=\"mw:Transclusion\" id=\"mwEr0\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Kentucky\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3151\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3150\" id=\"mwEr4\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Kentucky\" title=\"2026 United States Senate election in Kentucky\">2026 United States Senate election in Kentucky</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3152\" typeof=\"mw:Transclusion\" id=\"mwEr8\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Kentucky\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3153\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3152\" id=\"mwEsA\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Kentucky\" title=\"List of United States senators from Kentucky\">List of United States senators from Kentucky</a></div>\n<p id=\"mwEsE\">Seven-term Republican and former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Party_leaders_of_the_United_States_Senate\" title=\"Party leaders of the United States Senate\" id=\"mwEsI\">Senate Republican Leader</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mitch_McConnell\" title=\"Mitch McConnell\" id=\"mwEsM\">Mitch McConnell</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Kentucky\" title=\"2020 United States Senate election in Kentucky\" id=\"mwEsQ\">reelected in 2020</a> with 57.8% of the vote. McConnell retired as leader after the 2024 elections with plans to serve out the remainder of his term.<sup about=\"#mwt3156\" class=\"mw-ref reference\" id=\"cite_ref-203\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-203\"}}'><a href=\"#cite_note-203\" id=\"mwEsU\"><span class=\"mw-reflink-text\" id=\"mwEsY\"><span class=\"cite-bracket\" id=\"mwEsc\">[</span>179<span class=\"cite-bracket\" id=\"mwEsg\">]</span></span></a></sup> On February 20, 2025, McConnell announced he would not seek reelection.<sup about=\"#mwt3159\" class=\"mw-ref reference\" id=\"cite_ref-McConnell_31-2\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"McConnell\"},\"body\":{\"id\":\"mw-reference-text-cite_note-McConnell-31\"}}'><a href=\"#cite_note-McConnell-31\" id=\"mwEsk\"><span class=\"mw-reflink-text\" id=\"mwEso\"><span class=\"cite-bracket\" id=\"mwEss\">[</span>19<span class=\"cite-bracket\" id=\"mwEsw\">]</span></span></a></sup></p>\n\n<p id=\"mwEs0\">On May 19, U.S. Representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Andy_Barr\" title=\"Andy Barr\" id=\"mwEs4\">Andy Barr</a> of <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kentucky's_6th_congressional_district\" title=\"Kentucky's 6th congressional district\" id=\"mwEs8\">Kentucky's 6th congressional district</a><sup about=\"#mwt3162\" class=\"mw-ref reference\" id=\"cite_ref-Barr_204-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Barr\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Barr-204\"}}'><a href=\"#cite_note-Barr-204\" id=\"mwEtA\"><span class=\"mw-reflink-text\" id=\"mwEtE\"><span class=\"cite-bracket\" id=\"mwEtI\">[</span>180<span class=\"cite-bracket\" id=\"mwEtM\">]</span></span></a></sup> defeated a crowded field that included former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kentucky_Attorney_General\" title=\"Kentucky Attorney General\" id=\"mwEtQ\">Kentucky Attorney General</a> and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2023_Kentucky_gubernatorial_election\" title=\"2023 Kentucky gubernatorial election\" id=\"mwEtU\">2023 Republican gubernatorial nominee</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Daniel_Cameron_(American_politician)\" title=\"Daniel Cameron (American politician)\" id=\"mwEtY\">Daniel Cameron</a><sup about=\"#mwt3165\" class=\"mw-ref reference\" id=\"cite_ref-DanielCameron_205-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"DanielCameron\"},\"body\":{\"id\":\"mw-reference-text-cite_note-DanielCameron-205\"}}'><a href=\"#cite_note-DanielCameron-205\" id=\"mwEtc\"><span class=\"mw-reflink-text\" id=\"mwEtg\"><span class=\"cite-bracket\" id=\"mwEtk\">[</span>181<span class=\"cite-bracket\" id=\"mwEto\">]</span></span></a></sup> for the Republican nomination.<sup about=\"#mwt3168\" class=\"mw-ref reference\" id=\"cite_ref-:4_206-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\":4\"},\"body\":{\"id\":\"mw-reference-text-cite_note-:4-206\"}}'><a href=\"#cite_note-:4-206\" id=\"mwEts\"><span class=\"mw-reflink-text\" id=\"mwEtw\"><span class=\"cite-bracket\" id=\"mwEt0\">[</span>182<span class=\"cite-bracket\" id=\"mwEt4\">]</span></span></a></sup></p>\n\n<p id=\"mwEt8\">Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kentucky_House_of_Representatives\" title=\"Kentucky House of Representatives\" id=\"mwEuA\">state Representative</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Charles_Booker_(American_politician)\" title=\"Charles Booker (American politician)\" id=\"mwEuE\">Charles Booker</a>, the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_United_States_Senate_election_in_Kentucky\" title=\"2022 United States Senate election in Kentucky\" id=\"mwEuI\">2022 Senate</a> nominee and a former staffer for Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Andy_Beshear\" title=\"Andy Beshear\" id=\"mwEuM\">Andy Beshear</a>, won the May 19 Democratic primary.<sup about=\"#mwt3171\" class=\"mw-ref reference\" id=\"cite_ref-kentuckylantern.com_207-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"kentuckylantern.com\"},\"body\":{\"id\":\"mw-reference-text-cite_note-kentuckylantern.com-207\"}}'><a href=\"#cite_note-kentuckylantern.com-207\" id=\"mwEuQ\"><span class=\"mw-reflink-text\" id=\"mwEuU\"><span class=\"cite-bracket\" id=\"mwEuY\">[</span>183<span class=\"cite-bracket\" id=\"mwEuc\">]</span></span></a></sup> The seven-candidate field included <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Kentucky\" title=\"2020 United States Senate election in Kentucky\" id=\"mwEug\">2020 nominee</a> and former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States_Marine_Corps\" title=\"United States Marine Corps\" id=\"mwEuk\">Marine</a> fighter pilot <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Amy_McGrath\" title=\"Amy McGrath\" id=\"mwEuo\">Amy McGrath</a>.<sup about=\"#mwt3172\" class=\"mw-ref reference\" id=\"cite_ref-kentuckylantern.com_207-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"kentuckylantern.com\"}}'><a href=\"#cite_note-kentuckylantern.com-207\" id=\"mwEus\"><span class=\"mw-reflink-text\" id=\"mwEuw\"><span class=\"cite-bracket\" id=\"mwEu0\">[</span>183<span class=\"cite-bracket\" id=\"mwEu4\">]</span></span></a></sup><sup about=\"#mwt3173\" class=\"mw-ref reference\" id=\"cite_ref-:4_206-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\":4\"}}'><a href=\"#cite_note-:4-206\" id=\"mwEu8\"><span class=\"mw-reflink-text\" id=\"mwEvA\"><span class=\"cite-bracket\" id=\"mwEvE\">[</span>182<span class=\"cite-bracket\" id=\"mwEvI\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3174\" typeof=\"mw:Transclusion\" id=\"mwEvM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"33\" id=\"mwEvQ\" aria-labelledby=\"Louisiana\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Louisiana\">Louisiana</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=33\" title=\"Edit section: Louisiana\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3175\" typeof=\"mw:Transclusion\" id=\"mwEvU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Louisiana election\"},\"country\":{\"wt\":\"Louisiana\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Louisiana\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Louisiana\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"election_date\":{\"wt\":\"&lt;!--Don&apos;t need election date in section infoboxes when the date is the same as in the article&apos;s main infobox.-->\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Julia Letlow 117th (cropped 2).jpg\"},\"nominee1\":{\"wt\":\"[[Julia Letlow]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"3x4.svg\"},\"nominee2\":{\"wt\":\"Jamie Davis\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Bill Cassidy]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3176\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3177\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3178\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3175\" id=\"mwEvY\"><caption class=\"infobox-title summary\">Louisiana election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Louisiana.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Flag_of_Louisiana.svg/60px-Flag_of_Louisiana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e0/Flag_of_Louisiana.svg/120px-Flag_of_Louisiana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"7040\" data-file-height=\"4556\" data-file-type=\"drawing\" height=\"32\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Louisiana\" title=\"2020 United States Senate election in Louisiana\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Julia_Letlow_117th_(cropped_2).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Julia_Letlow_117th_(cropped_2).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Julia_Letlow_117th_%28cropped_2%29.jpg/120px-Julia_Letlow_117th_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Julia_Letlow_117th_%28cropped_2%29.jpg/250px-Julia_Letlow_117th_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1688\" data-file-height=\"2251\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:3x4.svg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:3x4.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" data-file-type=\"drawing\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Julia_Letlow\" title=\"Julia Letlow\">Julia Letlow</a></td>\n<td style=\"width:75px;text-align:center\">Jamie Davis</td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Louisiana\" title=\"List of United States senators from Louisiana\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Bill_Cassidy\" title=\"Bill Cassidy\">Bill Cassidy</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3179\" typeof=\"mw:Transclusion\" id=\"mwEvc\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Louisiana\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3180\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3179\" id=\"mwEvg\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Louisiana\" title=\"2026 United States Senate election in Louisiana\">2026 United States Senate election in Louisiana</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3181\" typeof=\"mw:Transclusion\" id=\"mwEvk\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Louisiana\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3182\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3181\" id=\"mwEvo\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Louisiana\" title=\"List of United States senators from Louisiana\">List of United States senators from Louisiana</a></div>\n<p id=\"mwEvs\">Two-term Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Bill_Cassidy\" title=\"Bill Cassidy\" id=\"mwEvw\">Bill Cassidy</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Louisiana\" title=\"2020 United States Senate election in Louisiana\" id=\"mwEv0\">reelected in 2020</a> with 59.3% of the vote in the first round of the \"<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Louisiana_primary\" title=\"Louisiana primary\" class=\"mw-redirect\" id=\"mwEv4\">Louisiana primary</a>\" and ran for reelection to a third term, but placed a distant third in the jungle primary.<sup about=\"#mwt3185\" class=\"mw-ref reference\" id=\"cite_ref-208\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-208\"}}'><a href=\"#cite_note-208\" id=\"mwEv8\"><span class=\"mw-reflink-text\" id=\"mwEwA\"><span class=\"cite-bracket\" id=\"mwEwE\">[</span>184<span class=\"cite-bracket\" id=\"mwEwI\">]</span></span></a></sup> The Louisiana primary system had since been eliminated in favor of partisan primaries, which were closed to members of other parties but open to unaffiliated voters.<sup about=\"#mwt3188\" class=\"mw-ref reference\" id=\"cite_ref-li_209-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"li\"},\"body\":{\"id\":\"mw-reference-text-cite_note-li-209\"}}'><a href=\"#cite_note-li-209\" id=\"mwEwM\"><span class=\"mw-reflink-text\" id=\"mwEwQ\"><span class=\"cite-bracket\" id=\"mwEwU\">[</span>185<span class=\"cite-bracket\" id=\"mwEwY\">]</span></span></a></sup></p>\n\n<p id=\"mwEwc\">U.S. Representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Julia_Letlow\" title=\"Julia Letlow\" id=\"mwEwg\">Julia Letlow</a> and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Louisiana_State_Treasurer\" title=\"Louisiana State Treasurer\" id=\"mwEwk\">state Treasurer</a> and former U.S. representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/John_Fleming_(Louisiana_politician)\" title=\"John Fleming (Louisiana politician)\" id=\"mwEwo\">John Fleming</a> advanced to the Republican runoff, defeating Cassidy in the primary.<sup about=\"#mwt3191\" class=\"mw-ref reference\" id=\"cite_ref-210\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-210\"}}'><a href=\"#cite_note-210\" id=\"mwEws\"><span class=\"mw-reflink-text\" id=\"mwEww\"><span class=\"cite-bracket\" id=\"mwEw0\">[</span>186<span class=\"cite-bracket\" id=\"mwEw4\">]</span></span></a></sup><sup about=\"#mwt3194\" class=\"mw-ref reference\" id=\"cite_ref-BC_211-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"BC\"},\"body\":{\"id\":\"mw-reference-text-cite_note-BC-211\"}}'><a href=\"#cite_note-BC-211\" id=\"mwEw8\"><span class=\"mw-reflink-text\" id=\"mwExA\"><span class=\"cite-bracket\" id=\"mwExE\">[</span>187<span class=\"cite-bracket\" id=\"mwExI\">]</span></span></a></sup> Letlow, who was endorsed by President <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Donald_Trump\" title=\"Donald Trump\" id=\"mwExM\">Donald Trump</a>, defeated Fleming in the runoff.<sup about=\"#mwt3197\" class=\"mw-ref reference\" id=\"cite_ref-212\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-212\"}}'><a href=\"#cite_note-212\" id=\"mwExQ\"><span class=\"mw-reflink-text\" id=\"mwExU\"><span class=\"cite-bracket\" id=\"mwExY\">[</span>188<span class=\"cite-bracket\" id=\"mwExc\">]</span></span></a></sup></p>\n\n<p id=\"mwExg\">Sorghum farmer Jamie Davis and data scientist and political consultant Gary Crockett advanced to the Democratic primary runoff, while nonprofit executive Nick Albares placed third.<sup about=\"#mwt3200\" class=\"mw-ref reference\" id=\"cite_ref-213\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-213\"}}'><a href=\"#cite_note-213\" id=\"mwExk\"><span class=\"mw-reflink-text\" id=\"mwExo\"><span class=\"cite-bracket\" id=\"mwExs\">[</span>189<span class=\"cite-bracket\" id=\"mwExw\">]</span></span></a></sup> Davis defeated Crockett in the runoff.<sup about=\"#mwt3203\" class=\"mw-ref reference\" id=\"cite_ref-Primary_214-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Primary\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Primary-214\"}}'><a href=\"#cite_note-Primary-214\" id=\"mwEx0\"><span class=\"mw-reflink-text\" id=\"mwEx4\"><span class=\"cite-bracket\" id=\"mwEx8\">[</span>190<span class=\"cite-bracket\" id=\"mwEyA\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3204\" typeof=\"mw:Transclusion\" id=\"mwEyE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"34\" id=\"mwEyI\" aria-labelledby=\"Maine\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Maine\">Maine</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=34\" title=\"Edit section: Maine\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3205\" typeof=\"mw:Transclusion\" id=\"mwEyM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Maine election\"},\"country\":{\"wt\":\"Maine\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Maine\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Maine\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Susan Collins During Senate Appropriation Homeland Security Subcommittee Hearing 8 May 2025.jpg\"},\"nominee1\":{\"wt\":\"[[Susan Collins]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"File:Senate President Troy Jackson (cropped).png\"},\"nominee2\":{\"wt\":\"[[Troy Jackson]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Susan Collins]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3206\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3207\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3208\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3205\" id=\"mwEyQ\"><caption class=\"infobox-title summary\">Maine election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Maine.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Flag_of_Maine.svg/60px-Flag_of_Maine.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/35/Flag_of_Maine.svg/120px-Flag_of_Maine.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"6336\" data-file-height=\"4992\" data-file-type=\"drawing\" height=\"39\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Maine\" title=\"2020 United States Senate election in Maine\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg/120px-Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c7/Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg/250px-Susan_Collins_During_Senate_Appropriation_Homeland_Security_Subcommittee_Hearing_8_May_2025.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1316\" data-file-height=\"1755\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Senate_President_Troy_Jackson_(cropped).png\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Senate_President_Troy_Jackson_(cropped).png\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Senate_President_Troy_Jackson_%28cropped%29.png/120px-Senate_President_Troy_Jackson_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ec/Senate_President_Troy_Jackson_%28cropped%29.png/250px-Senate_President_Troy_Jackson_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"956\" data-file-height=\"1275\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Susan_Collins\" title=\"Susan Collins\">Susan Collins</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Troy_Jackson\" title=\"Troy Jackson\">Troy Jackson</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Maine\" title=\"List of United States senators from Maine\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Susan_Collins\" title=\"Susan Collins\">Susan Collins</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3209\" typeof=\"mw:Transclusion\" id=\"mwEyU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Maine\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3210\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3209\" id=\"mwEyY\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Maine\" title=\"2026 United States Senate election in Maine\">2026 United States Senate election in Maine</a></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3211\" typeof=\"mw:Transclusion\" id=\"mwEyc\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Maine\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3212\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3211\" id=\"mwEyg\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Maine\" title=\"List of United States senators from Maine\">List of United States senators from Maine</a></div>\n<p id=\"mwEyk\">Incumbent Republican Senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Susan_Collins\" title=\"Susan Collins\" id=\"mwEyo\">Susan Collins</a> was reelected with 51% of the vote to 42% for her Democratic opponent in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Maine\" title=\"2020 United States Senate election in Maine\" id=\"mwEys\">2020</a>. She formally announced her reelection campaign in February 2026.<sup about=\"#mwt3215\" class=\"mw-ref reference\" id=\"cite_ref-Collins_215-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Collins\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Collins-215\"}}'><a href=\"#cite_note-Collins-215\" id=\"mwEyw\"><span class=\"mw-reflink-text\" id=\"mwEy0\"><span class=\"cite-bracket\" id=\"mwEy4\">[</span>191<span class=\"cite-bracket\" id=\"mwEy8\">]</span></span></a></sup> As the only person to submit the necessary number of signatures to appear on the primary ballot, Collins is the Republican nominee.<sup about=\"#mwt3218\" class=\"mw-ref reference\" id=\"cite_ref-216\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-216\"}}'><a href=\"#cite_note-216\" id=\"mwEzA\"><span class=\"mw-reflink-text\" id=\"mwEzE\"><span class=\"cite-bracket\" id=\"mwEzI\">[</span>192<span class=\"cite-bracket\" id=\"mwEzM\">]</span></span></a></sup></p>\n\n<p id=\"mwEzQ\">Throughout 2025, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Maine\" title=\"Governor of Maine\" id=\"mwEzU\">Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Janet_Mills\" title=\"Janet Mills\" id=\"mwEzY\">Janet Mills</a> was seen as a potential Democratic challenger to Collins. She announced her Senate candidacy in October<sup about=\"#mwt3221\" class=\"mw-ref reference\" id=\"cite_ref-MillsME_217-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"MillsME\"},\"body\":{\"id\":\"mw-reference-text-cite_note-MillsME-217\"}}'><a href=\"#cite_note-MillsME-217\" id=\"mwEzc\"><span class=\"mw-reflink-text\" id=\"mwEzg\"><span class=\"cite-bracket\" id=\"mwEzk\">[</span>193<span class=\"cite-bracket\" id=\"mwEzo\">]</span></span></a></sup> and pledged to serve only one term if elected.<sup about=\"#mwt3224\" class=\"mw-ref reference\" id=\"cite_ref-218\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-218\"}}'><a href=\"#cite_note-218\" id=\"mwEzs\"><span class=\"mw-reflink-text\" id=\"mwEzw\"><span class=\"cite-bracket\" id=\"mwEz0\">[</span>194<span class=\"cite-bracket\" id=\"mwEz4\">]</span></span></a></sup> She suspended her campaign on April 30, 2026, due to a lack of financial resources and poor polling numbers.<sup about=\"#mwt3227\" class=\"mw-ref reference\" id=\"cite_ref-219\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-219\"}}'><a href=\"#cite_note-219\" id=\"mwEz8\"><span class=\"mw-reflink-text\" id=\"mwE0A\"><span class=\"cite-bracket\" id=\"mwE0E\">[</span>195<span class=\"cite-bracket\" id=\"mwE0I\">]</span></span></a></sup></p> \n\n<p id=\"mwE0M\">On June 9, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sullivan,_Maine\" title=\"Sullivan, Maine\" id=\"mwE0Q\">Sullivan</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Harbor_master\" title=\"Harbor master\" class=\"mw-redirect\" id=\"mwE0U\">harbor master</a> and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States_Marine_Corps\" title=\"United States Marine Corps\" id=\"mwE0Y\">Marine</a> veteran <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Graham_Platner\" title=\"Graham Platner\" id=\"mwE0c\">Graham Platner</a><sup about=\"#mwt3230\" class=\"mw-ref reference\" id=\"cite_ref-Platner_220-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Platner\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Platner-220\"}}'><a href=\"#cite_note-Platner-220\" id=\"mwE0g\"><span class=\"mw-reflink-text\" id=\"mwE0k\"><span class=\"cite-bracket\" id=\"mwE0o\">[</span>196<span class=\"cite-bracket\" id=\"mwE0s\">]</span></span></a></sup> defeated former deputy secretary of the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Maryland_Department_of_the_Environment\" title=\"Maryland Department of the Environment\" id=\"mwE0w\">Maryland Department of the Environment</a> David Costello<sup about=\"#mwt3233\" class=\"mw-ref reference\" id=\"cite_ref-CostelloME_221-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"CostelloME\"},\"body\":{\"id\":\"mw-reference-text-cite_note-CostelloME-221\"}}'><a href=\"#cite_note-CostelloME-221\" id=\"mwE00\"><span class=\"mw-reflink-text\" id=\"mwE04\"><span class=\"cite-bracket\" id=\"mwE08\">[</span>197<span class=\"cite-bracket\" id=\"mwE1A\">]</span></span></a></sup> for the Democratic nomination with 72% of the vote.<sup about=\"#mwt3236\" class=\"mw-ref reference\" id=\"cite_ref-222\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-222\"}}'><a href=\"#cite_note-222\" id=\"mwE1E\"><span class=\"mw-reflink-text\" id=\"mwE1I\"><span class=\"cite-bracket\" id=\"mwE1M\">[</span>198<span class=\"cite-bracket\" id=\"mwE1Q\">]</span></span></a></sup></p>\n\n<p id=\"mwE1U\">On July 8, Platner announced his withdrawal from the race following allegations of sexual assault, which he denied. The same day, Maine Democrats voted to hold a state convention to select a replacement nominee.<sup about=\"#mwt3239\" class=\"mw-ref reference\" id=\"cite_ref-223\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-223\"}}'><a href=\"#cite_note-223\" id=\"mwE1Y\"><span class=\"mw-reflink-text\" id=\"mwE1c\"><span class=\"cite-bracket\" id=\"mwE1g\">[</span>199<span class=\"cite-bracket\" id=\"mwE1k\">]</span></span></a></sup> Candidates seeking the nomination were required to collect at least 500 signatures, including 50 from each of eight counties.<sup about=\"#mwt3242\" class=\"mw-ref reference\" id=\"cite_ref-224\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-224\"}}'><a href=\"#cite_note-224\" id=\"mwE1o\"><span class=\"mw-reflink-text\" id=\"mwE1s\"><span class=\"cite-bracket\" id=\"mwE1w\">[</span>200<span class=\"cite-bracket\" id=\"mwE10\">]</span></span></a></sup> During county meetings to select convention delegates, approximately 456 delegates pledged their support to former state Senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Troy_Jackson\" title=\"Troy Jackson\" id=\"mwE14\">Troy Jackson</a>.<sup about=\"#mwt3245\" class=\"mw-ref reference\" id=\"cite_ref-BangorDelegateResults_225-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"BangorDelegateResults\"},\"body\":{\"id\":\"mw-reference-text-cite_note-BangorDelegateResults-225\"}}'><a href=\"#cite_note-BangorDelegateResults-225\" id=\"mwE18\"><span class=\"mw-reflink-text\" id=\"mwE2A\"><span class=\"cite-bracket\" id=\"mwE2E\">[</span>201<span class=\"cite-bracket\" id=\"mwE2I\">]</span></span></a></sup><sup about=\"#mwt3248\" class=\"mw-ref reference\" id=\"cite_ref-226\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-226\"}}'><a href=\"#cite_note-226\" id=\"mwE2M\"><span class=\"mw-reflink-text\" id=\"mwE2Q\"><span class=\"cite-bracket\" id=\"mwE2U\">[</span>202<span class=\"cite-bracket\" id=\"mwE2Y\">]</span></span></a></sup><sup about=\"#mwt3251\" class=\"mw-ref reference\" id=\"cite_ref-Pellish_&amp;_Howard_2026_227-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Pellish &amp; Howard 2026\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Pellish_&amp;_Howard_2026-227\"}}'><a href=\"#cite_note-Pellish_&amp;_Howard_2026-227\" id=\"mwE2c\"><span class=\"mw-reflink-text\" id=\"mwE2g\"><span class=\"cite-bracket\" id=\"mwE2k\">[</span>203<span class=\"cite-bracket\" id=\"mwE2o\">]</span></span></a></sup> Jackson subsequently defeated Saundra Pelletier at the convention by a vote of 566–5.<sup about=\"#mwt3254\" class=\"mw-ref reference\" id=\"cite_ref-ConvResultUsaToday_113-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"ConvResultUsaToday\"},\"body\":{\"id\":\"mw-reference-text-cite_note-ConvResultUsaToday-113\"}}'><a href=\"#cite_note-ConvResultUsaToday-113\" id=\"mwE2s\"><span class=\"mw-reflink-text\" id=\"mwE2w\"><span class=\"cite-bracket\" id=\"mwE20\">[</span>90<span class=\"cite-bracket\" id=\"mwE24\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3255\" typeof=\"mw:Transclusion\" id=\"mwE28\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"35\" id=\"mwE3A\" aria-labelledby=\"Massachusetts\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Massachusetts\">Massachusetts</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=35\" title=\"Edit section: Massachusetts\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3256\" typeof=\"mw:Transclusion\" id=\"mwE3E\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Massachusetts election\"},\"country\":{\"wt\":\"Massachusetts\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Massachusetts\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Massachusetts\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Ed Markey in Edgartown (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Ed Markey]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"John Deaton, 2024.jpg\"},\"nominee2\":{\"wt\":\"[[John Deaton]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Ed Markey]]\"},\"before_party\":{\"wt\":\"Democratic Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3257\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3258\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3259\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3256\" id=\"mwE3I\"><caption class=\"infobox-title summary\">Massachusetts election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Massachusetts.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Flag_of_Massachusetts.svg/60px-Flag_of_Massachusetts.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f2/Flag_of_Massachusetts.svg/120px-Flag_of_Massachusetts.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1500\" data-file-height=\"900\" data-file-type=\"drawing\" height=\"30\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Massachusetts\" title=\"2020 United States Senate election in Massachusetts\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Ed_Markey_in_Edgartown_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Ed_Markey_in_Edgartown_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Ed_Markey_in_Edgartown_%28cropped%29.jpg/120px-Ed_Markey_in_Edgartown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/Ed_Markey_in_Edgartown_%28cropped%29.jpg/250px-Ed_Markey_in_Edgartown_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1744\" data-file-height=\"2324\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:John_Deaton,_2024.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:John_Deaton,_2024.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/John_Deaton%2C_2024.jpg/120px-John_Deaton%2C_2024.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/d3/John_Deaton%2C_2024.jpg/250px-John_Deaton%2C_2024.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"657\" data-file-height=\"876\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ed_Markey\" title=\"Ed Markey\">Ed Markey</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/John_Deaton\" title=\"John Deaton\">John Deaton</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Massachusetts\" title=\"List of United States senators from Massachusetts\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ed_Markey\" title=\"Ed Markey\">Ed Markey</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3260\" typeof=\"mw:Transclusion\" id=\"mwE3M\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Massachusetts\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3261\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3260\" id=\"mwE3Q\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Massachusetts\" title=\"2026 United States Senate election in Massachusetts\">2026 United States Senate election in Massachusetts</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3262\" typeof=\"mw:Transclusion\" id=\"mwE3U\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Massachusetts\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3263\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3262\" id=\"mwE3Y\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Massachusetts\" title=\"List of United States senators from Massachusetts\">List of United States senators from Massachusetts</a></div>\n<p id=\"mwE3c\">Two-term Democrat <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ed_Markey\" title=\"Ed Markey\" id=\"mwE3g\">Ed Markey</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Massachusetts\" title=\"2020 United States Senate election in Massachusetts\" id=\"mwE3k\">reelected in 2020</a> with 66.2% of the vote and is seeking a third full term.<sup about=\"#mwt3266\" class=\"mw-ref reference\" id=\"cite_ref-Markey_116-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Markey\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Markey-116\"}}'><a href=\"#cite_note-Markey-116\" id=\"mwE3o\"><span class=\"mw-reflink-text\" id=\"mwE3s\"><span class=\"cite-bracket\" id=\"mwE3w\">[</span>93<span class=\"cite-bracket\" id=\"mwE30\">]</span></span></a></sup> The longest-serving Democrat in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States_Congress\" title=\"United States Congress\" id=\"mwE34\">Congress</a>, Markey will be 80 on <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Election_day\" title=\"Election day\" id=\"mwE38\">Election Day</a> and has faced calls to retire. This also happened during the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Massachusetts\" title=\"2020 United States Senate election in Massachusetts\" id=\"mwE4A\">2020 Democratic primary</a>.<sup about=\"#mwt3269\" class=\"mw-ref reference\" id=\"cite_ref-228\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-228\"}}'><a href=\"#cite_note-228\" id=\"mwE4E\"><span class=\"mw-reflink-text\" id=\"mwE4I\"><span class=\"cite-bracket\" id=\"mwE4M\">[</span>204<span class=\"cite-bracket\" id=\"mwE4Q\">]</span></span></a></sup><sup about=\"#mwt3272\" class=\"mw-ref reference\" id=\"cite_ref-229\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-229\"}}'><a href=\"#cite_note-229\" id=\"mwE4U\"><span class=\"mw-reflink-text\" id=\"mwE4Y\"><span class=\"cite-bracket\" id=\"mwE4c\">[</span>205<span class=\"cite-bracket\" id=\"mwE4g\">]</span></span></a></sup> Markey defeated <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Representative\" title=\"U.S. Representative\" class=\"mw-redirect\" id=\"mwE4k\">U.S. Representative</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Seth_Moulton\" title=\"Seth Moulton\" id=\"mwE4o\">Seth Moulton</a> in the September 1 Democratic primary.<sup about=\"#mwt3275\" class=\"mw-ref reference\" id=\"cite_ref-Moulton_230-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Moulton\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Moulton-230\"}}'><a href=\"#cite_note-Moulton-230\" id=\"mwE4s\"><span class=\"mw-reflink-text\" id=\"mwE4w\"><span class=\"cite-bracket\" id=\"mwE40\">[</span>206<span class=\"cite-bracket\" id=\"mwE44\">]</span></span></a></sup></p>\n\n<p id=\"mwE48\">Attorney John Deaton, who was the Republican nominee against U.S. Senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Elizabeth_Warren\" title=\"Elizabeth Warren\" id=\"mwE5A\">Elizabeth Warren</a> in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_Senate_election_in_Massachusetts\" title=\"2024 United States Senate election in Massachusetts\" id=\"mwE5E\">2024</a>, is again the Republican nominee.<sup about=\"#mwt3278\" class=\"mw-ref reference\" id=\"cite_ref-Deaton_115-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Deaton\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Deaton-115\"}}'><a href=\"#cite_note-Deaton-115\" id=\"mwE5I\"><span class=\"mw-reflink-text\" id=\"mwE5M\"><span class=\"cite-bracket\" id=\"mwE5Q\">[</span>92<span class=\"cite-bracket\" id=\"mwE5U\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3279\" typeof=\"mw:Transclusion\" id=\"mwE5Y\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"36\" id=\"mwE5c\" aria-labelledby=\"Michigan\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Michigan\">Michigan</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=36\" title=\"Edit section: Michigan\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3280\" typeof=\"mw:Transclusion\" id=\"mwE5g\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Michigan election\"},\"country\":{\"wt\":\"Michigan\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Michigan\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Michigan\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"image1\":{\"wt\":\"Abdul El-Sayed meet-and-greet by Conlan Houston 5 (cropped 2).jpg\"},\"nominee1\":{\"wt\":\"[[Abdul El-Sayed]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Mike Rogers in November 2019 (3x4 cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Mike Rogers (Michigan politician)|Mike Rogers]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. senator\"},\"before_election\":{\"wt\":\"[[Gary Peters]]\"},\"before_party\":{\"wt\":\"Democratic Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3281\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3282\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3283\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3280\" id=\"mwE5k\"><caption class=\"infobox-title summary\">Michigan election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Michigan.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Flag_of_Michigan.svg/60px-Flag_of_Michigan.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b5/Flag_of_Michigan.svg/120px-Flag_of_Michigan.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"512\" data-file-height=\"342\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Michigan\" title=\"2020 United States Senate election in Michigan\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_(cropped_2).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_(cropped_2).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg/120px-Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5e/Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg/250px-Abdul_El-Sayed_meet-and-greet_by_Conlan_Houston_5_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"585\" data-file-height=\"780\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Mike_Rogers_in_November_2019_(3x4_cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Mike_Rogers_in_November_2019_(3x4_cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg/120px-Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg/250px-Mike_Rogers_in_November_2019_%283x4_cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"822\" data-file-height=\"1099\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Abdul_El-Sayed\" title=\"Abdul El-Sayed\">Abdul El-Sayed</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Rogers_(Michigan_politician)\" title=\"Mike Rogers (Michigan politician)\">Mike Rogers</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Michigan\" title=\"List of United States senators from Michigan\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Gary_Peters\" title=\"Gary Peters\">Gary Peters</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3284\" typeof=\"mw:Transclusion\" id=\"mwE5o\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Michigan\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3285\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3284\" id=\"mwE5s\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Michigan\" title=\"2026 United States Senate election in Michigan\">2026 United States Senate election in Michigan</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3286\" typeof=\"mw:Transclusion\" id=\"mwE5w\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Michigan\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3287\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3286\" id=\"mwE50\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Michigan\" title=\"List of United States senators from Michigan\">List of United States senators from Michigan</a></div>\n<p id=\"mwE54\">Two-term Democrat <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Gary_Peters_(politician)\" title=\"Gary Peters (politician)\" class=\"mw-redirect\" id=\"mwE58\">Gary Peters</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Michigan\" title=\"2020 United States Senate election in Michigan\" id=\"mwE6A\">narrowly reelected in 2020</a> with 49.9% of the vote. On January 28, 2025, he announced that he would not seek reelection.<sup about=\"#mwt3290\" class=\"mw-ref reference\" id=\"cite_ref-GaryPeters_32-2\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"GaryPeters\"},\"body\":{\"id\":\"mw-reference-text-cite_note-GaryPeters-32\"}}'><a href=\"#cite_note-GaryPeters-32\" id=\"mwE6E\"><span class=\"mw-reflink-text\" id=\"mwE6I\"><span class=\"cite-bracket\" id=\"mwE6M\">[</span>20<span class=\"cite-bracket\" id=\"mwE6Q\">]</span></span></a></sup></p>\n\n<p id=\"mwE6U\">Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Wayne_County,_Michigan\" title=\"Wayne County, Michigan\" id=\"mwE6Y\">Wayne County</a> Health, Human, and Veterans Services Department Director <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Abdul_El-Sayed\" title=\"Abdul El-Sayed\" id=\"mwE6c\">Abdul El-Sayed</a>,<sup about=\"#mwt3293\" class=\"mw-ref reference\" id=\"cite_ref-El_Sayed_78-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"El Sayed\"},\"body\":{\"id\":\"mw-reference-text-cite_note-El_Sayed-78\"}}'><a href=\"#cite_note-El_Sayed-78\" id=\"mwE6g\"><span class=\"mw-reflink-text\" id=\"mwE6k\"><span class=\"cite-bracket\" id=\"mwE6o\">[</span>55<span class=\"cite-bracket\" id=\"mwE6s\">]</span></span></a></sup> U.S. Representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Haley_Stevens\" title=\"Haley Stevens\" id=\"mwE6w\">Haley Stevens</a> of the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Michigan's_11th_congressional_district\" title=\"Michigan's 11th congressional district\" id=\"mwE60\">11th congressional district</a><sup about=\"#mwt3296\" class=\"mw-ref reference\" id=\"cite_ref-:hstevens_231-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\":hstevens\"},\"body\":{\"id\":\"mw-reference-text-cite_note-:hstevens-231\"}}'><a href=\"#cite_note-:hstevens-231\" id=\"mwE64\"><span class=\"mw-reflink-text\" id=\"mwE68\"><span class=\"cite-bracket\" id=\"mwE7A\">[</span>207<span class=\"cite-bracket\" id=\"mwE7E\">]</span></span></a></sup>, and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Michigan_Senate\" title=\"Michigan Senate\" id=\"mwE7I\">State Sentor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mallory_McMorrow\" title=\"Mallory McMorrow\" id=\"mwE7M\">Mallory McMorrow</a> ran in the Democratic primary. El-Sayed narrowly defeated Stevens and is the Democratic nominee.</p>\n\n<p id=\"mwE7Q\">Former U.S. Representative for the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Michigan's_8th_congressional_district\" title=\"Michigan's 8th congressional district\" id=\"mwE7U\">8th congressional district</a> and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_Senate_election_in_Michigan\" title=\"2024 United States Senate election in Michigan\" id=\"mwE7Y\">2024</a> U.S. Senate nominee <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Rogers_(Michigan_politician)\" title=\"Mike Rogers (Michigan politician)\" id=\"mwE7c\">Mike Rogers</a><sup about=\"#mwt3299\" class=\"mw-ref reference\" id=\"cite_ref-MRogers_77-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"MRogers\"},\"body\":{\"id\":\"mw-reference-text-cite_note-MRogers-77\"}}'><a href=\"#cite_note-MRogers-77\" id=\"mwE7g\"><span class=\"mw-reflink-text\" id=\"mwE7k\"><span class=\"cite-bracket\" id=\"mwE7o\">[</span>54<span class=\"cite-bracket\" id=\"mwE7s\">]</span></span></a></sup> is the Republican nominee.</p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3300\" typeof=\"mw:Transclusion\" id=\"mwE7w\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"37\" id=\"mwE70\" aria-labelledby=\"Minnesota\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Minnesota\">Minnesota</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=37\" title=\"Edit section: Minnesota\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3301\" typeof=\"mw:Transclusion\" id=\"mwE74\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Minnesota election\"},\"country\":{\"wt\":\"Minnesota\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Minnesota\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Minnesota\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"image1\":{\"wt\":\"Peggy Flanagan and Premier Kinew (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Peggy Flanagan]]\"},\"party1\":{\"wt\":\"Minnesota Democratic–Farmer–Labor Party\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"MicheleTafoya2023.jpg\"},\"nominee2\":{\"wt\":\"[[Michele Tafoya]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. senator\"},\"before_election\":{\"wt\":\"[[Tina Smith]]\"},\"before_party\":{\"wt\":\"Minnesota Democratic–Farmer–Labor Party\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3302\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3303\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3304\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3301\" id=\"mwE78\"><caption class=\"infobox-title summary\">Minnesota election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Minnesota.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Flag_of_Minnesota.svg/60px-Flag_of_Minnesota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/Flag_of_Minnesota.svg/120px-Flag_of_Minnesota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1000\" data-file-height=\"600\" data-file-type=\"drawing\" height=\"30\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Minnesota\" title=\"2020 United States Senate election in Minnesota\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2032</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0055AA;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Peggy_Flanagan_and_Premier_Kinew_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Peggy_Flanagan_and_Premier_Kinew_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg/120px-Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/38/Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg/250px-Peggy_Flanagan_and_Premier_Kinew_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1422\" data-file-height=\"1897\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:MicheleTafoya2023.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:MicheleTafoya2023.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/68/MicheleTafoya2023.jpg/120px-MicheleTafoya2023.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/68/MicheleTafoya2023.jpg/250px-MicheleTafoya2023.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2686\" data-file-height=\"3584\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Peggy_Flanagan\" title=\"Peggy Flanagan\">Peggy Flanagan</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Michele_Tafoya\" title=\"Michele Tafoya\">Michele Tafoya</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Minnesota_Democratic–Farmer–Labor_Party\" title=\"Minnesota Democratic–Farmer–Labor Party\">Democratic (DFL)</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Minnesota\" title=\"List of United States senators from Minnesota\">U.S. senator</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tina_Smith\" title=\"Tina Smith\">Tina Smith</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Minnesota_Democratic–Farmer–Labor_Party\" title=\"Minnesota Democratic–Farmer–Labor Party\">Democratic (DFL)</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt3305\" typeof=\"mw:Transclusion\" id=\"mwE8A\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 United States Senate election in Minnesota\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3306\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3305\" id=\"mwE8E\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_United_States_Senate_election_in_Minnesota\" title=\"2026 United States Senate election in Minnesota\">2026 United States Senate election in Minnesota</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt3307\" typeof=\"mw:Transclusion\" id=\"mwE8I\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"List of United States senators from Minnesota\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt3308\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt3307\" id=\"mwE8M\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_United_States_senators_from_Minnesota\" title=\"List of United States senators from Minnesota\">List of United States senators from Minnesota</a></div>\n<p id=\"mwE8Q\">One-term Democrat <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tina_Smith\" title=\"Tina Smith\" id=\"mwE8U\">Tina Smith</a> was <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Minnesota\" title=\"2020 United States Senate election in Minnesota\" id=\"mwE8Y\">reelected in 2020</a> with 48.7% of the vote after being appointed by Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mark_Dayton\" title=\"Mark Dayton\" id=\"mwE8c\">Mark Dayton</a> in 2018 following <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Al_Franken\" title=\"Al Franken\" id=\"mwE8g\">Al Franken</a>'s resignation and then winning a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2018_United_States_Senate_special_election_in_Minnesota\" title=\"2018 United States Senate special election in Minnesota\" id=\"mwE8k\">special election</a> that year. On February 13, 2025, she announced she would not seek a second full term in 2026.<sup about=\"#mwt3311\" class=\"mw-ref reference\" id=\"cite_ref-tinasmith_34-2\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"tinasmith\"},\"body\":{\"id\":\"mw-reference-text-cite_note-tinasmith-34\"}}'><a href=\"#cite_note-tinasmith-34\" id=\"mwE8o\"><span class=\"mw-reflink-text\" id=\"mwE8s\"><span class=\"cite-bracket\" id=\"mwE8w\">[</span>21<span class=\"cite-bracket\" id=\"mwE80\">]</span></span></a></sup> Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lieutenant_Governor_of_Minnesota\" title=\"Lieutenant Governor of Minnesota\" id=\"mwE84\">Lieutenant Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Peggy_Flanagan\" title=\"Peggy Flanagan\" id=\"mwE88\">Peggy Flanagan</a> announced her candidacy the same day.<sup about=\"#mwt3314\" class=\"mw-ref reference\" id=\"cite_ref-FlanaganMN_232-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"FlanaganMN\"},\"body\":{\"id\":\"mw-reference-text-cite_note-FlanaganMN-232\"}}'><a href=\"#cite_note-FlanaganMN-232\" id=\"mwE9A\"><span class=\"mw-reflink-text\" id=\"mwE9E\"><span class=\"cite-bracket\" id=\"mwE9I\">[</span>208<span class=\"cite-bracket\" id=\"mwE9M\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Representative\" title=\"U.S. Representative\" class=\"mw-redirect\" id=\"mwE9Q\">U.S. Representative</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Angie_Craig\" title=\"Angie Craig\" id=\"mwE9U\">Angie Craig</a> announced her candidacy on April 29.<sup about=\"#mwt3317\" class=\"mw-ref reference\" id=\"cite_ref-CraigMN_233-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"CraigMN\"},\"body\":{\"id\":\"mw-reference-text-cite_note-CraigMN-233\"}}'><a href=\"#cite_note-CraigMN-233\" id=\"mwE9Y\"><span class=\"mw-reflink-text\" id=\"mwE9c\"><span class=\"cite-bracket\" id=\"mwE9g\">[</span>209<span class=\"cite-bracket\" id=\"mwE9k\">]</span></span></a></sup> Flanagan won the nomination with 59% of the vote.</p>\n\n<p id=\"mwE9o\">Republicans running included <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sportscaster\" title=\"Sportscaster\" class=\"mw-redirect\" id=\"mwE9s\">sportscaster</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Michele_Tafoya\" title=\"Michele Tafoya\" id=\"mwE9w\">Michele Tafoya</a>,<sup about=\"#mwt3320\" class=\"mw-ref reference\" id=\"cite_ref-Tafoya_234-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Tafoya\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Tafoya-234\"}}'><a href=\"#cite_note-Tafoya-234\" id=\"mwE90\"><span class=\"mw-reflink-text\" id=\"mwE94\"><span class=\"cite-bracket\" id=\"mwE98\">[</span>210<span class=\"cite-bracket\" id=\"mwE-A\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_Senate_election_in_Minnesota\" title=\"2024 United States Senate election in Minnesota\" id=\"mwE-E\">2024</a> Republican U.S. Senate nominee and former professional basketball player <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Royce_White\" title=\"Royce White\" id=\"mwE-I\">Royce White</a>,<sup about=\"#mwt3323\" class=\"mw-ref reference\" id=\"cite_ref-RoyceWhiteMN_235-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"RoyceWhiteMN\"},\"body\":{\"id\":\"mw-reference-text-cite_note-RoyceWhiteMN-235\"}}'><a href=\"#cite_note-RoyceWhiteMN-235\" id=\"mwE-M\"><span class=\"mw-reflink-text\" id=\"mwE-Q\"><span class=\"cite-bracket\" id=\"mwE-U\">[</span>211<span class=\"cite-bracket\" id=\"mwE-Y\">]</span></span></a></sup> retired <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Navy\" title=\"U.S. Navy\" class=\"mw-redirect\" id=\"mwE-c\">U.S. Navy</a> officer Tom Weiler,<sup about=\"#mwt3326\" class=\"mw-ref reference\" id=\"cite_ref-rn_236-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"rn\"},\"body\":{\"id\":\"mw-reference-text-cite_note-rn-236\"}}'><a href=\"#cite_note-rn-236\" id=\"mwE-g\"><span class=\"mw-reflink-text\" id=\"mwE-k\"><span class=\"cite-bracket\" id=\"mwE-o\">[</span>212<span class=\"cite-bracket\" id=\"mwE-s\">]</span></span></a></sup> and former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Navy_SEAL\" title=\"Navy SEAL\" class=\"mw-redirect\" id=\"mwE-w\">Navy SEAL</a> Adam Schwarze.<sup about=\"#mwt3329\" class=\"mw-ref reference\" id=\"cite_ref-Schwarze_237-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Schwarze\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Schwarze-237\"}}'><a href=\"#cite_note-Schwarze-237\" id=\"mwE-0\"><span class=\"mw-reflink-text\" id=\"mwE-4\"><span class=\"cite-bracket\" id=\"mwE-8\">[</span>213<span class=\"cite-bracket\" id=\"mwE_A\">]</span></span></a></sup> Tafoya ultimately won the nomination with 52% of the vote.</p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt3330\" typeof=\"mw:Transclusion\" id=\"mwE_E\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"38\" id=\"mwE_I\" aria-labelledby=\"Mississippi\"><div class=\"mw-heading mw-heading3\"><h3 id=\"Mississippi\">Mississippi</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_Senate_elections&amp;action=edit&amp;section=38\" title=\"Edit section: Mississippi\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt3331\" typeof=\"mw:Transclusion\" id=\"mwE_M\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Mississippi election\"},\"country\":{\"wt\":\"Mississippi\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2020 United States Senate election in Mississippi\"},\"previous_year\":{\"wt\":\"2020\"},\"next_election\":{\"wt\":\"2032 United States Senate election in Mississippi\"},\"next_year\":{\"wt\":\"&apos;&apos;2032&apos;&apos;\"},\"election_date\":{\"wt\":\"&lt;!--Don&apos;t need election date in section infoboxes when the date is the same as in the article&apos;s main infobox.-->\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Official headshot of US Senator Cindy Hyde-Smith (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Cindy Hyde-Smith]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"3x4.svg\"},\"nominee2\":{\"wt\":\"[[Scott Colom]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"U.S. Senator\"},\"before_election\":{\"wt\":\"[[Cindy Hyde-Smith]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt3332\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt3333\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt3334\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt3331\" id=\"mwE_Q\"><caption class=\"infobox-title summary\">Mississippi election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Mississippi.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Flag_of_Missis