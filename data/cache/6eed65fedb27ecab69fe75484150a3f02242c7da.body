m_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1800\" data-file-height=\"1200\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_New_Mexico\" title=\"2018 United States Senate election in New Mexico\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_New_Mexico\" class=\"mw-redirect\" title=\"2030 United States Senate election in New Mexico\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Heinrich_Official_Headshot_2019_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Heinrich_Official_Headshot_2019_%28cropped%29.jpg/120px-Heinrich_Official_Headshot_2019_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"107\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6f/Heinrich_Official_Headshot_2019_%28cropped%29.jpg/250px-Heinrich_Official_Headshot_2019_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1440\" data-file-height=\"1824\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span typeof=\"mw:File\"><span><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></span></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Martin_Heinrich\" title=\"Martin Heinrich\">Martin Heinrich</a></b>\n</td>\n<td style=\"width:75px;text-align:center\">Nella Domenici\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>497,333</b>\n</td>\n<td style=\"width:75px;text-align:center\">405,978\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>55.06%</b>\n</td>\n<td style=\"width:75px;text-align:center\">44.94%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_New_Mexico_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/2024_United_States_Senate_election_in_New_Mexico_results_map_by_county.svg/250px-2024_United_States_Senate_election_in_New_Mexico_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"200\" height=\"200\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/2024_United_States_Senate_election_in_New_Mexico_results_map_by_county.svg/500px-2024_United_States_Senate_election_in_New_Mexico_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"810\" /></a></span><div>County results<br /><b>Heinrich:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span><br /><b>Domenici:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_New_Mexico\" title=\"List of United States senators from New Mexico\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Martin_Heinrich\" title=\"Martin Heinrich\">Martin Heinrich</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Martin_Heinrich\" title=\"Martin Heinrich\">Martin Heinrich</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_New_Mexico\" title=\"2024 United States Senate election in New Mexico\">2024 United States Senate election in New Mexico</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_New_Mexico\" title=\"List of United States senators from New Mexico\">List of United States senators from New Mexico</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_New_Mexico\" title=\"2024 United States House of Representatives elections in New Mexico\">2024 United States House of Representatives elections in New Mexico</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Martin_Heinrich\" title=\"Martin Heinrich\">Martin Heinrich</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_New_Mexico\" title=\"2018 United States Senate election in New Mexico\">reelected in 2018</a> with 54.1% of the vote in a three-candidate race. He was re-elected for a third term.<sup id=\"cite&#95;ref-heinrich&#95;189-0\" class=\"reference\"><a href=\"#cite_note-heinrich-189\"><span class=\"cite-bracket\">&#91;</span>165<span class=\"cite-bracket\">&#93;</span></a></sup> Hedge fund executive Nella Domenici, daughter of <a href=\"/wiki/Pete_Domenici\" title=\"Pete Domenici\">Pete Domenici</a>, senator from 1973 to 2009, announced her candidacy for the Republican nomination on January 17, 2024.<sup id=\"cite&#95;ref-190\" class=\"reference\"><a href=\"#cite_note-190\"><span class=\"cite-bracket\">&#91;</span>166<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Henrich won re-election to a third term in office by 10.12%, receiving 55.1% of the statewide vote to Domenici's 44.9%.\n</p>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in New Mexico<sup id=\"cite&#95;ref-Results1&#95;191-0\" class=\"reference\"><a href=\"#cite_note-Results1-191\"><span class=\"cite-bracket\">&#91;</span>167<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Martin_Heinrich\" title=\"Martin Heinrich\">Martin Heinrich</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>497,333 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>55.06% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+0.97% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #E81B23; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Nella Domenici\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">405,978\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">44.94%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+14.41%\n</td></tr>\n\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>903,311 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #0044C9;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"New_York\">New York</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=39\" title=\"Edit section: New York\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">New York election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Flag_of_New_York.svg/60px-Flag_of_New_York.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"25\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1a/Flag_of_New_York.svg/120px-Flag_of_New_York.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"900\" data-file-height=\"450\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_New_York\" title=\"2018 United States Senate election in New York\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_New_York\" class=\"mw-redirect\" title=\"2030 United States Senate election in New York\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Kirsten_Gillibrand,_official_photo,_116th_Congress_(4x5_crop).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Kirsten_Gillibrand%2C_official_photo%2C_116th_Congress_%284x5_crop%29.jpg/120px-Kirsten_Gillibrand%2C_official_photo%2C_116th_Congress_%284x5_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/63/Kirsten_Gillibrand%2C_official_photo%2C_116th_Congress_%284x5_crop%29.jpg/250px-Kirsten_Gillibrand%2C_official_photo%2C_116th_Congress_%284x5_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"453\" data-file-height=\"566\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Kirsten_Gillibrand\" title=\"Kirsten Gillibrand\">Kirsten Gillibrand</a></b>\n</td>\n<td style=\"width:75px;text-align:center\">Mike Sapraicone\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Alliance\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Working_Families_Party\" title=\"Working Families Party\">Working Families</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Conservative_Party_of_New_York_State\" title=\"Conservative Party of New York State\">Conservative</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>4,711,298</b>\n</td>\n<td style=\"width:75px;text-align:center\">3,246,114\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>58.91%</b>\n</td>\n<td style=\"width:75px;text-align:center\">40.59%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_New_York_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/05/2024_United_States_Senate_election_in_New_York_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_New_York_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"230\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/05/2024_United_States_Senate_election_in_New_York_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_New_York_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"621\" /></a></span><div>County results<br /><b>Gillibrand:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#3933e5; color:#3933e5;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>Sapraicone:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_New_York\" title=\"List of United States senators from New York\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Kirsten_Gillibrand\" title=\"Kirsten Gillibrand\">Kirsten Gillibrand</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Kirsten_Gillibrand\" title=\"Kirsten Gillibrand\">Kirsten Gillibrand</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_New_York\" title=\"2024 United States Senate election in New York\">2024 United States Senate election in New York</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_New_York\" title=\"List of United States senators from New York\">List of United States senators from New York</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_New_York\" title=\"2024 United States House of Representatives elections in New York\">2024 United States House of Representatives elections in New York</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Kirsten_Gillibrand\" title=\"Kirsten Gillibrand\">Kirsten Gillibrand</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_New_York\" title=\"2018 United States Senate election in New York\">reelected in 2018</a> with 67.0% of the vote. She was re-elected for a third full term.<sup id=\"cite&#95;ref-192\" class=\"reference\"><a href=\"#cite_note-192\"><span class=\"cite-bracket\">&#91;</span>168<span class=\"cite-bracket\">&#93;</span></a></sup> Former <a href=\"/wiki/New_York_City_Police\" class=\"mw-redirect\" title=\"New York City Police\">New York City Police</a> <a href=\"/wiki/Police_detective\" class=\"mw-redirect\" title=\"Police detective\">detective</a> Mike Sapraicone declared his candidacy as a Republican.<sup id=\"cite&#95;ref-193\" class=\"reference\"><a href=\"#cite_note-193\"><span class=\"cite-bracket\">&#91;</span>169<span class=\"cite-bracket\">&#93;</span></a></sup> Both Gillibrand and Sapraicone won their respective primaries unopposed.\n</p><p>Gillibrand's victory of 18 points was significantly closer than her previous two, and followed <a href=\"/wiki/Chuck_Schumer\" title=\"Chuck Schumer\">Chuck Schumer</a>'s narrower victory in <a href=\"/wiki/2022_United_States_Senate_election_in_New_York\" title=\"2022 United States Senate election in New York\">2022</a>. This was the state's second consecutive Senate election in which the Republican garnered over 40% of the vote.<sup class=\"noprint Inline-Template Template-Fact\" style=\"white-space:nowrap;\">&#91;<i><a href=\"/wiki/Wikipedia:Citation_needed\" title=\"Wikipedia:Citation needed\"><span title=\"This claim needs references to reliable sources. (August 2026)\">citation needed</span></a></i>&#93;</sup>\n</p>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in New York<sup id=\"cite&#95;ref-194\" class=\"reference\"><a href=\"#cite_note-194\"><span class=\"cite-bracket\">&#91;</span>170<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><i>Kirsten Gillibrand</i>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">4,318,903\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">53.91%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−8.07%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #f4563b; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Working_Families_Party\" title=\"Working Families Party\">Working Families</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><i>Kirsten Gillibrand</i>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">392,395\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">4.89%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+2.25%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E9E9E9\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><b>Total</b>\n</td>\n<td class=\"fn\"><b><a href=\"/wiki/Kirsten_Gillibrand\" title=\"Kirsten Gillibrand\">Kirsten Gillibrand</a> (incumbent) </b>\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\"><b>4,711,298 </b>\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\"><b>58.82% </b>\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\"><b>–8.14% </b>\n</td></tr>\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #E81B23; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><i>Mike Sapraicone</i>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">2,917,044\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">36.42%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+7.86%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #FF8C00; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Conservative_Party_of_New_York_State\" title=\"Conservative Party of New York State\">Conservative</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><i>Mike Sapraicone</i>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">329,070\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">4.11%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+0.05%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E9E9E9\">\n</td>\n<td class=\"org\" style=\"width:130px\">Total\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Mike Sapraicone\n</th>\n<td style=\"text-align:right;\">3,246,114\n</td>\n<td style=\"text-align:right;\">40.52%\n</td>\n<td style=\"text-align:right;\">+7.54%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#DCDCDC\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/LaRouche_movement\" title=\"LaRouche movement\">LaRouche</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Diane Sare\n</th>\n<td style=\"text-align:right;\">39,413\n</td>\n<td style=\"text-align:right;\">0.49%\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E9E9E9\">\n</td>\n<td class=\"org\" style=\"width:130px\">Write ins\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Write ins\n</th>\n<td style=\"text-align:right;\">13,492\n</td>\n<td style=\"text-align:right;\">0.17%\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>8,010,317 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n<tr>\n<td style=\"color:inherit;background-color: #0044C9;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> <b>hold</b>\n</th></tr>\n\n</tbody></table>\n<p><br />\n</p>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"North_Dakota\">North Dakota</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=40\" title=\"Edit section: North Dakota\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">North Dakota election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Flag_of_North_Dakota.svg/60px-Flag_of_North_Dakota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"39\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ee/Flag_of_North_Dakota.svg/120px-Flag_of_North_Dakota.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1247\" data-file-height=\"983\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_North_Dakota\" title=\"2018 United States Senate election in North Dakota\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_North_Dakota\" class=\"mw-redirect\" title=\"2030 United States Senate election in North Dakota\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Kevin_Cramer,_official_portrait,_116th_congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Kevin_Cramer%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg/120px-Kevin_Cramer%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"98\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Kevin_Cramer%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg/250px-Kevin_Cramer%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3200\" data-file-height=\"4440\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0055AA;\"><span typeof=\"mw:File\"><span><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></span></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Kevin_Cramer\" title=\"Kevin Cramer\">Kevin Cramer</a></b>\n</td>\n<td style=\"width:75px;text-align:center\">Katrina Christiansen\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/North_Dakota_Democratic%E2%80%93Nonpartisan_League_Party\" title=\"North Dakota Democratic–Nonpartisan League Party\">Democratic–NPL</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>241,569</b>\n</td>\n<td style=\"width:75px;text-align:center\">121,602\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>66.31%</b>\n</td>\n<td style=\"width:75px;text-align:center\">33.38%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_North_Dakota_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/93/2024_United_States_Senate_election_in_North_Dakota_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_North_Dakota_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"181\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/93/2024_United_States_Senate_election_in_North_Dakota_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_North_Dakota_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"488\" /></a></span><div>County results<br /><b>Cramer:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>Christiansen:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_North_Dakota\" title=\"List of United States senators from North Dakota\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Kevin_Cramer\" title=\"Kevin Cramer\">Kevin Cramer</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Kevin_Cramer\" title=\"Kevin Cramer\">Kevin Cramer</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_North_Dakota\" title=\"2024 United States Senate election in North Dakota\">2024 United States Senate election in North Dakota</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_North_Dakota\" title=\"List of United States senators from North Dakota\">List of United States senators from North Dakota</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_election_in_North_Dakota\" title=\"2024 United States House of Representatives election in North Dakota\">2024 United States House of Representatives election in North Dakota</a></div>\n<p>One-term Republican <a href=\"/wiki/Kevin_Cramer\" title=\"Kevin Cramer\">Kevin Cramer</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_North_Dakota\" title=\"2018 United States Senate election in North Dakota\">elected in 2018</a> with 55.1% of the vote. Cramer ran for re-election.<sup id=\"cite&#95;ref-195\" class=\"reference\"><a href=\"#cite_note-195\"><span class=\"cite-bracket\">&#91;</span>171<span class=\"cite-bracket\">&#93;</span></a></sup> Democrat Katrina Christiansen, an engineering professor from the <a href=\"/wiki/University_of_Jamestown\" title=\"University of Jamestown\">University of Jamestown</a> and <a href=\"/wiki/2022_United_States_Senate_election_in_North_Dakota\" title=\"2022 United States Senate election in North Dakota\">candidate for the Senate in 2022</a>, was her party's nominee.<sup id=\"cite&#95;ref-ND2024&#95;196-0\" class=\"reference\"><a href=\"#cite_note-ND2024-196\"><span class=\"cite-bracket\">&#91;</span>172<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Cramer won the election by over 66% of the vote and he more than tripled his margin from 2018 and won 10 counties he lost in 2018.<sup class=\"noprint Inline-Template Template-Fact\" style=\"white-space:nowrap;\">&#91;<i><a href=\"/wiki/Wikipedia:Citation_needed\" title=\"Wikipedia:Citation needed\"><span title=\"This claim needs references to reliable sources. (August 2026)\">citation needed</span></a></i>&#93;</sup>\n</p>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in North Dakota<sup id=\"cite&#95;ref-Results&#95;197-0\" class=\"reference\"><a href=\"#cite_note-Results-197\"><span class=\"cite-bracket\">&#91;</span>173<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Kevin_Cramer\" title=\"Kevin Cramer\">Kevin Cramer</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>241,569 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>66.31% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+11.20% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0055AA; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/North_Dakota_Democratic%E2%80%93Nonpartisan_League_Party\" title=\"North Dakota Democratic–Nonpartisan League Party\">Democratic–NPL</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Katrina Christiansen\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">121,602\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">33.38%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−10.89%\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">1,156\n</td>\n<td style=\"text-align:right;\">0.32%\n</td>\n<td style=\"text-align:right;\">-0.31%\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>364,327 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Ohio\">Ohio</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=41\" title=\"Edit section: Ohio\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Ohio election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Flag_of_Ohio.svg/60px-Flag_of_Ohio.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"31\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4c/Flag_of_Ohio.svg/120px-Flag_of_Ohio.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"520\" data-file-height=\"320\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Ohio\" title=\"2018 United States Senate election in Ohio\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Ohio\" class=\"mw-redirect\" title=\"2030 United States Senate election in Ohio\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Bernie_Moreno_official_photo,_119th_Congress_(HR)_(cropped3).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Sen._Bernie_Moreno_official_photo%2C_119th_Congress_%28HR%29_%28cropped3%29.jpg/120px-Sen._Bernie_Moreno_official_photo%2C_119th_Congress_%28HR%29_%28cropped3%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Sen._Bernie_Moreno_official_photo%2C_119th_Congress_%28HR%29_%28cropped3%29.jpg/250px-Sen._Bernie_Moreno_official_photo%2C_119th_Congress_%28HR%29_%28cropped3%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1768\" data-file-height=\"2204\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sherrod_Brown_117th_Congress_(2)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Sherrod_Brown_117th_Congress_%282%29_%28cropped%29.jpg/120px-Sherrod_Brown_117th_Congress_%282%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/66/Sherrod_Brown_117th_Congress_%282%29_%28cropped%29.jpg/250px-Sherrod_Brown_117th_Congress_%282%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1911\" data-file-height=\"2389\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Bernie_Moreno\" title=\"Bernie Moreno\">Bernie Moreno</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Sherrod_Brown\" title=\"Sherrod Brown\">Sherrod Brown</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>2,857,383</b>\n</td>\n<td style=\"width:75px;text-align:center\">2,650,949\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>50.09%</b>\n</td>\n<td style=\"width:75px;text-align:center\">46.47%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Ohio_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/2024_United_States_Senate_election_in_Ohio_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Ohio_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"300\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/2024_United_States_Senate_election_in_Ohio_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Ohio_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"810\" /></a></span><div>County results<br /><b>Moreno:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#ffb2b2; color:#ffb2b2;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span><br /><b>Brown:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#a5b0ff; color:#a5b0ff;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Ohio\" title=\"List of United States senators from Ohio\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Sherrod_Brown\" title=\"Sherrod Brown\">Sherrod Brown</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Bernie_Moreno\" title=\"Bernie Moreno\">Bernie Moreno</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Ohio\" title=\"2024 United States Senate election in Ohio\">2024 United States Senate election in Ohio</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Ohio\" title=\"List of United States senators from Ohio\">List of United States senators from Ohio</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Ohio\" title=\"2024 United States House of Representatives elections in Ohio\">2024 United States House of Representatives elections in Ohio</a></div>\n<p>Three-term Democrat <a href=\"/wiki/Sherrod_Brown\" title=\"Sherrod Brown\">Sherrod Brown</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Ohio\" title=\"2018 United States Senate election in Ohio\">reelected in 2018</a> with 53.4% of the vote. Brown ran for a fourth term. He was one of two Democratic senators running for reelection who represented states won by Republican <a href=\"/wiki/Donald_Trump\" title=\"Donald Trump\">Donald Trump</a> in both the 2016 and 2020 presidential elections.<sup id=\"cite&#95;ref-SherrodBrown&#95;198-0\" class=\"reference\"><a href=\"#cite_note-SherrodBrown-198\"><span class=\"cite-bracket\">&#91;</span>174<span class=\"cite-bracket\">&#93;</span></a></sup> The Republican nominee was businessman <a href=\"/wiki/Bernie_Moreno\" title=\"Bernie Moreno\">Bernie Moreno</a>, who defeated <a href=\"/wiki/Ohio_Senate\" title=\"Ohio Senate\">state senator</a> <a href=\"/wiki/Matt_Dolan\" title=\"Matt Dolan\">Matt Dolan</a> and <a href=\"/wiki/Ohio_Secretary_of_State\" title=\"Ohio Secretary of State\">secretary of state</a> <a href=\"/wiki/Frank_LaRose\" title=\"Frank LaRose\">Frank LaRose</a> in the primary election.<sup id=\"cite&#95;ref-199\" class=\"reference\"><a href=\"#cite_note-199\"><span class=\"cite-bracket\">&#91;</span>175<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Moreno defeated Brown in the general election 50.1% to 46.5%, flipping the seat for the Republicans.<sup id=\"cite&#95;ref-200\" class=\"reference\"><a href=\"#cite_note-200\"><span class=\"cite-bracket\">&#91;</span>176<span class=\"cite-bracket\">&#93;</span></a></sup> Brown had the second worst performance of a Democratic incumbent in 2024, behind only Montana senator <a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a>.<sup class=\"noprint Inline-Template Template-Fact\" style=\"white-space:nowrap;\">&#91;<i><a href=\"/wiki/Wikipedia:Citation_needed\" title=\"Wikipedia:Citation needed\"><span title=\"This claim needs references to reliable sources. (August 2026)\">citation needed</span></a></i>&#93;</sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-gen1&#95;201-0\" class=\"reference\"><a href=\"#cite_note-gen1-201\"><span class=\"cite-bracket\">&#91;</span>177<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Ohio_Republican_Party\" title=\"Ohio Republican Party\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Bernie_Moreno\" title=\"Bernie Moreno\">Bernie Moreno</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>557,626 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>50.48% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Ohio_Republican_Party\" title=\"Ohio Republican Party\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Matt_Dolan\" title=\"Matt Dolan\">Matt Dolan</a>\n</th>\n<td style=\"text-align:right\">363,013\n</td>\n<td style=\"text-align:right\">32.86%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Ohio_Republican_Party\" title=\"Ohio Republican Party\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Frank_LaRose\" title=\"Frank LaRose\">Frank LaRose</a>\n</th>\n<td style=\"text-align:right\">184,111\n</td>\n<td style=\"text-align:right\">16.67%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>1,104,750 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Ohio<sup id=\"cite&#95;ref-202\" class=\"reference\"><a href=\"#cite_note-202\"><span class=\"cite-bracket\">&#91;</span>178<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Bernie_Moreno\" title=\"Bernie Moreno\">Bernie Moreno</a> </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>2,857,383 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>50.09% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+3.51% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Sherrod_Brown\" title=\"Sherrod Brown\">Sherrod Brown</a> (incumbent)\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">2,650,949\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">46.47%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−6.93%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Don Kissick\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">195,648\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">3.43%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+3.43%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">640\n</td>\n<td style=\"text-align:right;\">0.01%\n</td>\n<td style=\"text-align:right;\">-0.01%\n</td></tr>\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>5,704,620 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n\n<tr>\n<th colspan=\"3\" style=\"text-align: right; margin-right: 0.5em\" scope=\"row\"><a href=\"/wiki/Voter_turnout\" title=\"Voter turnout\">Turnout</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">69.91%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+15.26\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<td colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>gain</b> from <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Pennsylvania\">Pennsylvania</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=42\" title=\"Edit section: Pennsylvania\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Pennsylvania election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Pennsylvania.svg/60px-Flag_of_Pennsylvania.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"36\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Pennsylvania.svg/120px-Flag_of_Pennsylvania.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"740\" data-file-height=\"540\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Pennsylvania\" title=\"2018 United States Senate election in Pennsylvania\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Pennsylvania\" class=\"mw-redirect\" title=\"2030 United States Senate election in Pennsylvania\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:McCormick_Portrait_(HR)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/39/McCormick_Portrait_%28HR%29_%28cropped%29.jpg/120px-McCormick_Portrait_%28HR%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/39/McCormick_Portrait_%28HR%29_%28cropped%29.jpg/250px-McCormick_Portrait_%28HR%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1244\" data-file-height=\"1658\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Bob_Casey_Jr._official_photo_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Bob_Casey_Jr._official_photo_%28cropped%29.jpg/120px-Bob_Casey_Jr._official_photo_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"100\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6d/Bob_Casey_Jr._official_photo_%28cropped%29.jpg/250px-Bob_Casey_Jr._official_photo_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1639\" data-file-height=\"2232\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/David_McCormick\" class=\"mw-redirect\" title=\"David McCormick\">David McCormick</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Bob_Casey_Jr.\" title=\"Bob Casey Jr.\">Bob Casey Jr.</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>3,399,295</b>\n</td>\n<td style=\"width:75px;text-align:center\">3,384,180\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>48.82%</b>\n</td>\n<td style=\"width:75px;text-align:center\">48.60%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Pennsylvania_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/30/2024_United_States_Senate_election_in_Pennsylvania_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Pennsylvania_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"174\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/3/30/2024_United_States_Senate_election_in_Pennsylvania_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Pennsylvania_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"471\" /></a></span><div>County results<br /><b>McCormick:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#FFB2B2; color:#FFB2B2;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>Casey:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#A5B0FF; color:#A5B0FF;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Pennsylvania\" title=\"List of United States senators from Pennsylvania\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Bob_Casey_Jr.\" title=\"Bob Casey Jr.\">Bob Casey Jr.</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/David_McCormick\" class=\"mw-redirect\" title=\"David McCormick\">David McCormick</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Pennsylvania\" title=\"2024 United States Senate election in Pennsylvania\">2024 United States Senate election in Pennsylvania</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Pennsylvania\" title=\"List of United States senators from Pennsylvania\">List of United States senators from Pennsylvania</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Pennsylvania\" title=\"2024 United States House of Representatives elections in Pennsylvania\">2024 United States House of Representatives elections in Pennsylvania</a></div>\n<p>Three-term Democrat <a href=\"/wiki/Bob_Casey_Jr.\" title=\"Bob Casey Jr.\">Bob Casey Jr.</a>, was <a href=\"/wiki/2018_United_States_Senate_election_in_Pennsylvania\" title=\"2018 United States Senate election in Pennsylvania\">reelected in 2018</a> with 55.7% of the vote. Casey was running for a fourth term.<sup id=\"cite&#95;ref-203\" class=\"reference\"><a href=\"#cite_note-203\"><span class=\"cite-bracket\">&#91;</span>179<span class=\"cite-bracket\">&#93;</span></a></sup> He was challenged by engineer Blaine Forkner.<sup id=\"cite&#95;ref-bfpa&#95;204-0\" class=\"reference\"><a href=\"#cite_note-bfpa-204\"><span class=\"cite-bracket\">&#91;</span>180<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p><a href=\"/wiki/2022_United_States_Senate_election_in_Pennsylvania\" title=\"2022 United States Senate election in Pennsylvania\">2022 Senate candidate</a> <a href=\"/wiki/David_McCormick\" class=\"mw-redirect\" title=\"David McCormick\">David McCormick</a> was the Republican nominee.<sup id=\"cite&#95;ref-205\" class=\"reference\"><a href=\"#cite_note-205\"><span class=\"cite-bracket\">&#91;</span>181<span class=\"cite-bracket\">&#93;</span></a></sup> McCormick won from Casey by 48.8% to 48.6% in the general election in a major <a href=\"/wiki/Upset_(competition)\" title=\"Upset (competition)\">upset</a>.<sup id=\"cite&#95;ref-Katie&#95;Glueck-2024&#95;206-0\" class=\"reference\"><a href=\"#cite_note-Katie_Glueck-2024-206\"><span class=\"cite-bracket\">&#91;</span>182<span class=\"cite-bracket\">&#93;</span></a></sup> as most predictions gave Casey a slight advantage, and he led in most polls.<sup id=\"cite&#95;ref-207\" class=\"reference\"><a href=\"#cite_note-207\"><span class=\"cite-bracket\">&#91;</span>183<span class=\"cite-bracket\">&#93;</span></a></sup> Initially, despite the <a href=\"/wiki/Associated_Press\" title=\"Associated Press\">Associated Press</a> calling the race for McCormick, Casey refused to concede the race due to unknown numbers of outstanding provisional ballots in primarily urban areas.<sup id=\"cite&#95;ref-208\" class=\"reference\"><a href=\"#cite_note-208\"><span class=\"cite-bracket\">&#91;</span>184<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Senate_Majority_Leader\" class=\"mw-redirect\" title=\"Senate Majority Leader\">Senate majority leader</a> <a href=\"/wiki/Chuck_Schumer\" title=\"Chuck Schumer\">Chuck Schumer</a> originally did not invite McCormick to the “New Senator Orientation Event,” but Schumer relented after criticism from Republicans and independent Arizona senator <a href=\"/wiki/Kyrsten_Sinema\" title=\"Kyrsten Sinema\">Kyrsten Sinema</a>.<sup id=\"cite&#95;ref-209\" class=\"reference\"><a href=\"#cite_note-209\"><span class=\"cite-bracket\">&#91;</span>185<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-210\" class=\"reference\"><a href=\"#cite_note-210\"><span class=\"cite-bracket\">&#91;</span>186<span class=\"cite-bracket\">&#93;</span></a></sup> Casey eventually conceded on November 21; McCormick was then officially declared the winner.<sup id=\"cite&#95;ref-Emily&#95;Rose&#95;Grassi-2024&#95;211-0\" class=\"reference\"><a href=\"#cite_note-Emily_Rose_Grassi-2024-211\"><span class=\"cite-bracket\">&#91;</span>187<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Pennsylvania<sup id=\"cite&#95;ref-212\" class=\"reference\"><a href=\"#cite_note-212\"><span class=\"cite-bracket\">&#91;</span>188<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Dave_McCormick\" title=\"Dave McCormick\">Dave McCormick</a> </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>3,399,295 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>48.82% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+6.20% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Bob_Casey_Jr.\" title=\"Bob Casey Jr.\">Bob Casey Jr.</a> (incumbent)\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">3,384,180\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">48.60%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−7.14%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">John Thomas\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">89,653\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">1.29%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+0.27%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #17aa5c; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Green_Party_(US)\" class=\"mw-redirect\" title=\"Green Party (US)\">Green</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Leila Hazou\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">66,388\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.95%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+0.33%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #A356DE; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Constitution_Party_(US)\" class=\"mw-redirect\" title=\"Constitution Party (US)\">Constitution</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Marty Selker\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">23,621\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.34%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>6,963,137 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<td colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>gain</b> from <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Rhode_Island\">Rhode Island</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=43\" title=\"Edit section: Rhode Island\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Rhode Island election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_Rhode_Island.svg/60px-Flag_of_Rhode_Island.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"44\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f3/Flag_of_Rhode_Island.svg/120px-Flag_of_Rhode_Island.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"660\" data-file-height=\"580\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Rhode_Island\" title=\"2018 United States Senate election in Rhode Island\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Rhode_Island\" class=\"mw-redirect\" title=\"2030 United States Senate election in Rhode Island\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sheldon_Whitehouse,_official_portrait,_116th_congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Sheldon_Whitehouse%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg/120px-Sheldon_Whitehouse%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"111\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bb/Sheldon_Whitehouse%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg/250px-Sheldon_Whitehouse%2C_official_portrait%2C_116th_congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3015\" data-file-height=\"3680\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span typeof=\"mw:File\"><span><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></span></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Sheldon_Whitehouse\" title=\"Sheldon Whitehouse\">Sheldon Whitehouse</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Patricia_Morgan\" title=\"Patricia Morgan\">Patricia Morgan</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>294,665</b>\n</td>\n<td style=\"width:75px;text-align:center\">196,039\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>59.90%</b>\n</td>\n<td style=\"width:75px;text-align:center\">39.85%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><div class=\"switcher-container\"><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Rhode_Island_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/2024_United_States_Senate_election_in_Rhode_Island_results_map_by_county.svg/250px-2024_United_States_Senate_election_in_Rhode_Island_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"250\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/2024_United_States_Senate_election_in_Rhode_Island_results_map_by_county.svg/500px-2024_United_States_Senate_election_in_Rhode_Island_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"810\" /></a></span>\n<span class=\"switcher-label\" style=\"display:none\">County results</span></div><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Rhode_Island_results_map_by_municipality.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/13/2024_United_States_Senate_election_in_Rhode_Island_results_map_by_municipality.svg/250px-2024_United_States_Senate_election_in_Rhode_Island_results_map_by_municipality.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"250\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/13/2024_United_States_Senate_election_in_Rhode_Island_results_map_by_municipality.svg/500px-2024_United_States_Senate_election_in_Rhode_Island_results_map_by_municipality.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"810\" /></a></span>\n<span class=\"switcher-label\" style=\"display:none\">Municipality results</span></div></div><div><b>Whitehouse:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span><br /><b>Morgan:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Rhode_Island\" title=\"List of United States senators from Rhode Island\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Sheldon_Whitehouse\" title=\"Sheldon Whitehouse\">Sheldon Whitehouse</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Sheldon_Whitehouse\" title=\"Sheldon Whitehouse\">Sheldon Whitehouse</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Rhode_Island\" title=\"2024 United States Senate election in Rhode Island\">2024 United States Senate election in Rhode Island</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Rhode_Island\" title=\"List of United States senators from Rhode Island\">List of United States senators from Rhode Island</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Rhode_Island\" title=\"2024 United States House of Representatives elections in Rhode Island\">2024 United States House of Representatives elections in Rhode Island</a></div>\n<p>Three-term Democrat <a href=\"/wiki/Sheldon_Whitehouse\" title=\"Sheldon Whitehouse\">Sheldon Whitehouse</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Rhode_Island\" title=\"2018 United States Senate election in Rhode Island\">reelected in 2018</a> with 61.4% of the vote. He ran for a fourth term. Republicans who announced their candidacies included <a href=\"/wiki/Rhode_Island_House_of_Representatives\" title=\"Rhode Island House of Representatives\">state representative</a> <a href=\"/wiki/Patricia_Morgan\" title=\"Patricia Morgan\">Patricia Morgan</a><sup id=\"cite&#95;ref-213\" class=\"reference\"><a href=\"#cite_note-213\"><span class=\"cite-bracket\">&#91;</span>189<span class=\"cite-bracket\">&#93;</span></a></sup> and <a href=\"/wiki/IT\" class=\"mw-redirect\" title=\"IT\">IT</a> professional Raymond McKay.<sup id=\"cite&#95;ref-rmkri&#95;214-0\" class=\"reference\"><a href=\"#cite_note-rmkri-214\"><span class=\"cite-bracket\">&#91;</span>190<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Sheldon was easily re-elected with 59.9% of the vote.\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-prim1&#95;215-0\" class=\"reference\"><a href=\"#cite_note-prim1-215\"><span class=\"cite-bracket\">&#91;</span>191<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Sheldon_Whitehouse\" title=\"Sheldon Whitehouse\">Sheldon Whitehouse</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>49,401 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>83.77% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Michael Costa\n</th>\n<td style=\"text-align:right\">9,572\n</td>\n<td style=\"text-align:right\">16.23%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>58,973 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-prim1&#95;215-1\" class=\"reference\"><a href=\"#cite_note-prim1-215\"><span class=\"cite-bracket\">&#91;</span>191<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Patricia_Morgan\" title=\"Patricia Morgan\">Patricia Morgan</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>12,108 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>64.44% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Raymond McKay\n</th>\n<td style=\"text-align:right\">6,681\n</td>\n<td style=\"text-align:right\">35.56%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>18,789 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Rhode Island<sup id=\"cite&#95;ref-216\" class=\"reference\"><a href=\"#cite_note-216\"><span class=\"cite-bracket\">&#91;</span>192<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Sheldon_Whitehouse\" title=\"Sheldon Whitehouse\">Sheldon Whitehouse</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>294,665 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>59.90% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>−1.54% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #E81B23; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Patricia_Morgan\" title=\"Patricia Morgan\">Patricia Morgan</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">196,039\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">39.85%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+1.52%\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">1,244\n</td>\n<td style=\"text-align:right;\">0.25%\n</td>\n<td style=\"text-align:right;\">+0.03%\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>491,948 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #0044C9;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Tennessee\">Tennessee</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=44\" title=\"Edit section: Tennessee\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Tennessee election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Tennessee.svg/60px-Flag_of_Tennessee.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9e/Flag_of_Tennessee.svg/120px-Flag_of_Tennessee.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1000\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Tennessee\" title=\"2018 United States Senate election in Tennessee\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Tennessee\" class=\"mw-redirect\" title=\"2030 United States Senate election in Tennessee\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Marsha_Blackburn_(R-TN)_official_headshot_-_116th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Sen._Marsha_Blackburn_%28R-TN%29_official_headshot_-_116th_Congress_%28cropped%29.jpg/120px-Sen._Marsha_Blackburn_%28R-TN%29_official_headshot_-_116th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5b/Sen._Marsha_Blackburn_%28R-TN%29_official_headshot_-_116th_Congress_%28cropped%29.jpg/250px-Sen._Marsha_Blackburn_%28R-TN%29_official_headshot_-_116th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"803\" data-file-height=\"1097\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Gloria_Johnson(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Gloria_Johnson%28cropped%29.jpg/120px-Gloria_Johnson%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/2/24/Gloria_Johnson%28cropped%29.jpg/250px-Gloria_Johnson%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1166\" data-file-height=\"1600\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Marsha_Blackburn\" title=\"Marsha Blackburn\">Marsha Blackburn</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Gloria_Johnson_(politician)\" title=\"Gloria Johnson (politician)\">Gloria Johnson</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>1,918,743</b>\n</td>\n<td style=\"width:75px;text-align:center\">1,027,461\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>63.80%</b>\n</td>\n<td style=\"width:75px;text-align:center\">34.16%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><div class=\"switcher-container\"><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Tennessee_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/2024_United_States_Senate_election_in_Tennessee_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Tennessee_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"76\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a0/2024_United_States_Senate_election_in_Tennessee_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Tennessee_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"206\" /></a></span> <span class=\"switcher-label\" data-switcher-default=\"\" style=\"display:none\">County results</span></div><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Tennessee_results_map_by_congressional_district.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/2024_United_States_Senate_election_in_Tennessee_results_map_by_congressional_district.svg/330px-2024_United_States_Senate_election_in_Tennessee_results_map_by_congressional_district.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"76\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6b/2024_United_States_Senate_election_in_Tennessee_results_map_by_congressional_district.svg/960px-2024_United_States_Senate_election_in_Tennessee_results_map_by_congressional_district.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"206\" /></a></span> <span class=\"switcher-label\" style=\"display:none\">Congressional district results</span></div><div><span typeof=\"mw:File\"><a href=\"/wiki/File:TN_Senate_2024.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/TN_Senate_2024.svg/330px-TN_Senate_2024.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"76\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a1/TN_Senate_2024.svg/960px-TN_Senate_2024.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1115\" data-file-height=\"283\" /></a></span> <span class=\"switcher-label\" style=\"display:none\">Precinct results</span></div></div><div><b>Blackburn:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#ffb2b2; color:#ffb2b2;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#e27f7f; color:#e27f7f;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d72f30; color:#d72f30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#A80000; color:#A80000;\">&#160;&#160;&#160;&#160;</span>&#160;&gt;90%</span><br /><b>Johnson:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#A5B0FF; color:#A5B0FF;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#3933e5; color:#3933e5;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#0D0596; color:#0D0596;\">&#160;&#160;&#160;&#160;</span>&#160;&gt;90%</span><br /><b>Tie:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#ae8bb1; color:#ae8bb1;\">&#160;&#160;&#160;&#160;</span>&#160;50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#808080; color:#808080;\">&#160;&#160;&#160;&#160;</span>&#160;No data</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Tennessee\" title=\"List of United States senators from Tennessee\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Marsha_Blackburn\" title=\"Marsha Blackburn\">Marsha Blackburn</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Marsha_Blackburn\" title=\"Marsha Blackburn\">Marsha Blackburn</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Tennessee\" title=\"2024 United States Senate election in Tennessee\">2024 United States Senate election in Tennessee</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Tennessee\" title=\"List of United States senators from Tennessee\">List of United States senators from Tennessee</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Tennessee\" title=\"2024 United States House of Representatives elections in Tennessee\">2024 United States House of Representatives elections in Tennessee</a></div>\n<p>One-term Republican <a href=\"/wiki/Marsha_Blackburn\" title=\"Marsha Blackburn\">Marsha Blackburn</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Tennessee\" title=\"2018 United States Senate election in Tennessee\">elected in 2018</a> with 54.7% of the vote. Blackburn filed paperwork to run for reelection. The Democratic nominee was <a href=\"/wiki/Tennessee_House_of_Representatives\" title=\"Tennessee House of Representatives\">state representative</a> <a href=\"/wiki/Gloria_Johnson_(politician)\" title=\"Gloria Johnson (politician)\">Gloria Johnson</a>.<sup id=\"cite&#95;ref-gjohnson&#95;217-0\" class=\"reference\"><a href=\"#cite_note-gjohnson-217\"><span class=\"cite-bracket\">&#91;</span>193<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Blackburn defeated state representative Johnson with 63.8% of the vote. Blackburn improved vastly from her <a href=\"/wiki/2018_United_States_Senate_election_in_Tennessee\" title=\"2018 United States Senate election in Tennessee\">2018 performance</a> by nearly 19 points.<sup id=\"cite&#95;ref-218\" class=\"reference\"><a href=\"#cite_note-218\"><span class=\"cite-bracket\">&#91;</span>194<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-219\" class=\"reference\"><a href=\"#cite_note-219\"><span class=\"cite-bracket\">&#91;</span>195<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Marsha_Blackburn\" title=\"Marsha Blackburn\">Marsha Blackburn</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>367,799 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>89.48% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Tres Wittum\n</th>\n<td style=\"text-align:right\">43,244\n</td>\n<td style=\"text-align:right\">10.52%\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: #FFFFFF; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">2\n</td>\n<td style=\"text-align:right;\">&lt;0.01%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>411,045 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-220\" class=\"reference\"><a href=\"#cite_note-220\"><span class=\"cite-bracket\">&#91;</span>196<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Gloria_Johnson_(politician)\" title=\"Gloria Johnson (politician)\">Gloria Johnson</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>143,962 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>70.20% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Marquita_Bradshaw\" title=\"Marquita Bradshaw\">Marquita Bradshaw</a>\n</th>\n<td style=\"text-align:right\">44,657\n</td>\n<td style=\"text-align:right\">21.78%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Lola Brown\n</th>\n<td style=\"text-align:right\">10,027\n</td>\n<td style=\"text-align:right\">4.89%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Civil Miller-Watkins\n</th>\n<td style=\"text-align:right\">6,420\n</td>\n<td style=\"text-align:right\">3.13%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>205,066 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Tennessee<sup id=\"cite&#95;ref-221\" class=\"reference\"><a href=\"#cite_note-221\"><span class=\"cite-bracket\">&#91;</span>197<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Marsha_Blackburn\" title=\"Marsha Blackburn\">Marsha Blackburn</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>1,918,743 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>63.80% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+9.09% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Gloria_Johnson_(politician)\" title=\"Gloria Johnson (politician)\">Gloria Johnson</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">1,027,461\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">34.16%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−9.76%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DCDCDC; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_politician\" title=\"Independent politician\">Independent</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Tharon Chandler\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">28,444\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.95%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DCDCDC; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_politician\" title=\"Independent politician\">Independent</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Pamela Moses\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">24,682\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.82%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DCDCDC; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_politician\" title=\"Independent politician\">Independent</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Hastina Robinson\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">8,278\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.28%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>3,007,608 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Texas\">Texas</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=45\" title=\"Edit section: Texas\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Texas election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Texas.svg/60px-Flag_of_Texas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Texas.svg/120px-Flag_of_Texas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"900\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Texas\" title=\"2018 United States Senate election in Texas\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Texas\" class=\"mw-redirect\" title=\"2030 United States Senate election in Texas\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Ted_Cruz_official_116th_portrait_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Ted_Cruz_official_116th_portrait_%28cropped%29.jpg/120px-Ted_Cruz_official_116th_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/94/Ted_Cruz_official_116th_portrait_%28cropped%29.jpg/250px-Ted_Cruz_official_116th_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1140\" data-file-height=\"1520\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Colin_Allred,_official_portrait,_117th_Congress_(3x4).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Colin_Allred%2C_official_portrait%2C_117th_Congress_%283x4%29.jpg/120px-Colin_Allred%2C_official_portrait%2C_117th_Congress_%283x4%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/86/Colin_Allred%2C_official_portrait%2C_117th_Congress_%283x4%29.jpg/250px-Colin_Allred%2C_official_portrait%2C_117th_Congress_%283x4%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2239\" data-file-height=\"2984\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Ted_Cruz\" title=\"Ted Cruz\">Ted Cruz</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Colin_Allred\" title=\"Colin Allred\">Colin Allred</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>5,990,741</b>\n</td>\n<td style=\"width:75px;text-align:center\">5,031,249\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>53.07%</b>\n</td>\n<td style=\"width:75px;text-align:center\">44.57%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Texas_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/2024_United_States_Senate_election_in_Texas_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Texas_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"285\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9a/2024_United_States_Senate_election_in_Texas_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Texas_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"769\" /></a></span><div>County results<br /><b>Cruz:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#ffb2b2; color:#ffb2b2;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#e27f7f; color:#e27f7f;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d72f30; color:#d72f30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#c21b18; color:#c21b18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#a80000; color:#a80000;\">&#160;&#160;&#160;&#160;</span>&#160;&gt;90%</span><br /><b>Allred:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#a5b0ff; color:#a5b0ff;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Texas\" title=\"List of United States senators from Texas\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Ted_Cruz\" title=\"Ted Cruz\">Ted Cruz</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Ted_Cruz\" title=\"Ted Cruz\">Ted Cruz</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Texas\" title=\"2024 United States Senate election in Texas\">2024 United States Senate election in Texas</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Texas\" title=\"List of United States senators from Texas\">List of United States senators from Texas</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Texas\" title=\"2024 United States House of Representatives elections in Texas\">2024 United States House of Representatives elections in Texas</a></div>\n<p>Ted Cruz ran for a third Senate term.<sup id=\"cite&#95;ref-222\" class=\"reference\"><a href=\"#cite_note-222\"><span class=\"cite-bracket\">&#91;</span>198<span class=\"cite-bracket\">&#93;</span></a></sup> He faced Democratic nominee <a href=\"/wiki/Colin_Allred\" title=\"Colin Allred\">Colin Allred</a>, a former <a href=\"/wiki/National_Football_League\" title=\"National Football League\">NFL</a> player and congressman, who defeated <a href=\"/wiki/Texas_State_Senator\" class=\"mw-redirect\" title=\"Texas State Senator\">state senator</a> <a href=\"/wiki/Roland_Gutierrez_(politician)\" title=\"Roland Gutierrez (politician)\">Roland Gutierrez</a> and <a href=\"/wiki/Texas_House_of_Representatives\" title=\"Texas House of Representatives\">state representative</a> <a href=\"/wiki/Carl_O._Sherman\" title=\"Carl O. Sherman\">Carl Sherman</a> in the primary election.<sup id=\"cite&#95;ref-Allred&#95;223-0\" class=\"reference\"><a href=\"#cite_note-Allred-223\"><span class=\"cite-bracket\">&#91;</span>199<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-224\" class=\"reference\"><a href=\"#cite_note-224\"><span class=\"cite-bracket\">&#91;</span>200<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-225\" class=\"reference\"><a href=\"#cite_note-225\"><span class=\"cite-bracket\">&#91;</span>201<span class=\"cite-bracket\">&#93;</span></a></sup> Cruz defeated Allred on November 5, 2024, by 53.1% to 44.6%.<sup id=\"cite&#95;ref-226\" class=\"reference\"><a href=\"#cite_note-226\"><span class=\"cite-bracket\">&#91;</span>202<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Early polling showed Cruz as a clear favorite, but polls closer to the election showed a closer race. Cruz ultimately outperformed polling and expectations and won re-election by 8.49%, improving on his 2018 margin by six points and flipping thirteen counties. Cruz won a majority of <a href=\"/wiki/Hispanic_and_Latino_Americans\" title=\"Hispanic and Latino Americans\">Hispanic and Latino</a> voters, particularly those living on the <a href=\"/wiki/Mexico%E2%80%93United_States_border\" title=\"Mexico–United States border\">border with Mexico</a> who had traditionally supported Democratic candidates; the <i><a href=\"/wiki/NBC_News\" title=\"NBC News\">NBC News</a></i> exit poll showed 52% of Latinos supported Cruz, a 17-point increase from 2018.<sup id=\"cite&#95;ref-227\" class=\"reference\"><a href=\"#cite_note-227\"><span class=\"cite-bracket\">&#91;</span>203<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-NYTTexasPrimary&#95;228-0\" class=\"reference\"><a href=\"#cite_note-NYTTexasPrimary-228\"><span class=\"cite-bracket\">&#91;</span>204<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Ted_Cruz\" title=\"Ted Cruz\">Ted Cruz</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>1,977,961 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>88.30% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Holland Gibson\n</th>\n<td style=\"text-align:right\">134,011\n</td>\n<td style=\"text-align:right\">5.98%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Rufus Lopez\n</th>\n<td style=\"text-align:right\">127,986\n</td>\n<td style=\"text-align:right\">5.71%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>2,239,958 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-NYTTexasPrimary&#95;228-1\" class=\"reference\"><a href=\"#cite_note-NYTTexasPrimary-228\"><span class=\"cite-bracket\">&#91;</span>204<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Texas_Democratic_Party\" title=\"Texas Democratic Party\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Colin_Allred\" title=\"Colin Allred\">Colin Allred</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>569,585 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>58.87% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Texas_Democratic_Party\" title=\"Texas Democratic Party\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Roland_Gutierrez_(politician)\" title=\"Roland Gutierrez (politician)\">Roland Gutierrez</a>\n</th>\n<td style=\"text-align:right\">160,978\n</td>\n<td style=\"text-align:right\">16.64%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Texas_Democratic_Party\" title=\"Texas Democratic Party\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Mark Gonzalez\n</th>\n<td style=\"text-align:right\">85,228\n</td>\n<td style=\"text-align:right\">8.81%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\