n: right; margin-right: 0.5em\">40.50%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+4.29%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Rebecca Whiting\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">55,215\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">1.73%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #FFC14E; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independence_Party_of_Minnesota\" class=\"mw-redirect\" title=\"Independence Party of Minnesota\">Independence</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Joyce Lacey\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">46,377\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">1.45%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">3,578\n</td>\n<td style=\"text-align:right;\">0.11%\n</td>\n<td style=\"text-align:right;\">+0.07%\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>3,189,323 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #0055AA;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Minnesota_Democratic-Farmer-Labor_Party\" class=\"mw-redirect\" title=\"Minnesota Democratic-Farmer-Labor Party\">Democratic (DFL)</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Mississippi\">Mississippi</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=30\" title=\"Edit section: Mississippi\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:240px\"><caption class=\"infobox-title summary\">Mississippi election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span typeof=\"mw:File\"><a href=\"/wiki/File:Flag_of_Mississippi.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Flag_of_Mississippi.svg/60px-Flag_of_Mississippi.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/42/Flag_of_Mississippi.svg/120px-Flag_of_Mississippi.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1200\" data-file-height=\"720\" /></a></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: