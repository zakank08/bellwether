\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">19\n</td>\n<td style=\"text-align:right;\">0.00%\n</td>\n<td style=\"text-align:right;\"><span typeof=\"mw:File\"><span title=\"Steady\"><img alt=\"Steady\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Steady2.svg/20px-Steady2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"11\" height=\"11\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Steady2.svg/40px-Steady2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span>\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>2,972,559 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Montana\">Montana</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=32\" title=\"Edit section: Montana\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Montana election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Flag_of_Montana.svg/60px-Flag_of_Montana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/cb/Flag_of_Montana.svg/120px-Flag_of_Montana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"768\" data-file-height=\"512\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Montana\" title=\"2018 United States Senate election in Montana\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Montana\" class=\"mw-redirect\" title=\"2030 United States Senate election in Montana\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Tim_Sheehy_official_Senate_photo,_119th_Congress_(HR)_(wide_crop).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Sen._Tim_Sheehy_official_Senate_photo%2C_119th_Congress_%28HR%29_%28wide_crop%29.jpg/120px-Sen._Tim_Sheehy_official_Senate_photo%2C_119th_Congress_%28HR%29_%28wide_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f8/Sen._Tim_Sheehy_official_Senate_photo%2C_119th_Congress_%28HR%29_%28wide_crop%29.jpg/250px-Sen._Tim_Sheehy_official_Senate_photo%2C_119th_Congress_%28HR%29_%28wide_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3605\" data-file-height=\"4500\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:JonTester_(cropped_2).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/61/JonTester_%28cropped_2%29.jpg/120px-JonTester_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"105\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/61/JonTester_%28cropped_2%29.jpg/250px-JonTester_%28cropped_2%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2064\" data-file-height=\"2661\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Tim_Sheehy\" title=\"Tim Sheehy\">Tim Sheehy</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>319,682</b>\n</td>\n<td style=\"width:75px;text-align:center\">276,305\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>52.64%</b>\n</td>\n<td style=\"width:75px;text-align:center\">45.50%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Montana_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/2024_United_States_Senate_election_in_Montana_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Montana_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"175\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0c/2024_United_States_Senate_election_in_Montana_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Montana_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"473\" /></a></span><div>County results<br /><b>Sheehy:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#a80000; color:#a80000;\">&#160;&#160;&#160;&#160;</span>&#160;&gt;90%</span><br /><b>Tester:</b><span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#584cde; color:#584cde;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Montana\" title=\"List of United States senators from Montana\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Tim_Sheehy\" title=\"Tim Sheehy\">Tim Sheehy</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Montana\" title=\"2024 United States Senate election in Montana\">2024 United States Senate election in Montana</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Montana\" title=\"List of United States senators from Montana\">List of United States senators from Montana</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Montana\" title=\"2024 United States House of Representatives elections in Montana\">2024 United States House of Representatives elections in Montana</a></div>\n<p>Three-term Democrat <a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Montana\" title=\"2018 United States Senate election in Montana\">narrowly reelected in 2018</a> with 50.3% of the vote. On February 22, 2023, he announced he was running for a fourth term. Tester was one of two Democratic senators running for reelection who represented states won by Republican <a href=\"/wiki/Donald_Trump\" title=\"Donald Trump\">Donald Trump</a> in both the 2016 and 2020 presidential elections.<sup id=\"cite&#95;ref-162\" class=\"reference\"><a href=\"#cite_note-162\"><span class=\"cite-bracket\">&#91;</span>138<span class=\"cite-bracket\">&#93;</span></a></sup> Businessman and former <a href=\"/wiki/Navy_Seal\" class=\"mw-redirect\" title=\"Navy Seal\">Navy SEAL officer</a> <a href=\"/wiki/Tim_Sheehy\" title=\"Tim Sheehy\">Tim Sheehy</a> won the Republican nomination.<sup id=\"cite&#95;ref-163\" class=\"reference\"><a href=\"#cite_note-163\"><span class=\"cite-bracket\">&#91;</span>139<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/U.S._Representative\" class=\"mw-redirect\" title=\"U.S. Representative\">U.S. representative</a> <a href=\"/wiki/Matt_Rosendale\" title=\"Matt Rosendale\">Matt Rosendale</a>, also a Republican, initially ran against Sheehy for the nomination, but withdrew from the race within days.<sup id=\"cite&#95;ref-164\" class=\"reference\"><a href=\"#cite_note-164\"><span class=\"cite-bracket\">&#91;</span>140<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Sheehy defeated Tester in the general election by over 7 points, marking the first time since 1911 that the Republican Party controlled both of Montana's senate seats.<sup class=\"noprint Inline-Template Template-Fact\" style=\"white-space:nowrap;\">&#91;<i><a href=\"/wiki/Wikipedia:Citation_needed\" title=\"Wikipedia:Citation needed\"><span title=\"This claim needs references to reliable sources. (August 2026)\">citation needed</span></a></i>&#93;</sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-mt&#95;165-0\" class=\"reference\"><a href=\"#cite_note-mt-165\"><span class=\"cite-bracket\">&#91;</span>141<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>104,279 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>96.96% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Michael Hummert\n</th>\n<td style=\"text-align:right\">3,272\n</td>\n<td style=\"text-align:right\">3.04%\n</td></tr>\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>107,551 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n</tbody></table>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-mt&#95;165-1\" class=\"reference\"><a href=\"#cite_note-mt-165\"><span class=\"cite-bracket\">&#91;</span>141<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Tim_Sheehy\" title=\"Tim Sheehy\">Tim Sheehy</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>139,857 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>73.60% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Brad_Johnson_(Montana_politician)\" title=\"Brad Johnson (Montana politician)\">Brad Johnson</a>\n</th>\n<td style=\"text-align:right\">36,926\n</td>\n<td style=\"text-align:right\">19.43%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Charles Walkingchild Sr.\n</th>\n<td style=\"text-align:right\">13,229\n</td>\n<td style=\"text-align:right\">6.96%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>190,012 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Montana<sup id=\"cite&#95;ref-gc115&#95;81-1\" class=\"reference\"><a href=\"#cite_note-gc115-81\"><span class=\"cite-bracket\">&#91;</span>58<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Tim_Sheehy\" title=\"Tim Sheehy\">Tim Sheehy</a> </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>319,682 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>52.64% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+5.86% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Jon_Tester\" title=\"Jon Tester\">Jon Tester</a> (incumbent)\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">276,305\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">45.50%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−4.83%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Sid Daoud\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">7,272\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">1.20%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−1.68%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #17aa5c; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Green_Party_(United_States)\" class=\"mw-redirect\" title=\"Green Party (United States)\">Green</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Robert Barb\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">4,003\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.66%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>607,262 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<td colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>gain</b> from <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Nebraska\">Nebraska</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=33\" title=\"Edit section: Nebraska\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Nebraska\" title=\"List of United States senators from Nebraska\">List of United States senators from Nebraska</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Nebraska\" title=\"2024 United States House of Representatives elections in Nebraska\">2024 United States House of Representatives elections in Nebraska</a></div>\n<p>There were two elections in Nebraska, due to the resignation of <a href=\"/wiki/Ben_Sasse\" title=\"Ben Sasse\">Ben Sasse</a>.\n</p>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Nebraska_(regular)\"><span id=\"Nebraska_.28regular.29\"></span>Nebraska (regular)</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=34\" title=\"Edit section: Nebraska (regular)\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Nebraska general election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Flag_of_Nebraska.svg/60px-Flag_of_Nebraska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Flag_of_Nebraska.svg/120px-Flag_of_Nebraska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"750\" data-file-height=\"450\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Nebraska\" title=\"2018 United States Senate election in Nebraska\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Nebraska\" class=\"mw-redirect\" title=\"2030 United States Senate election in Nebraska\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Deb_Fischer_(R-NE),_official_portrait,_118th_United_States_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Sen._Deb_Fischer_%28R-NE%29%2C_official_portrait%2C_118th_United_States_Congress_%28cropped%29.jpg/120px-Sen._Deb_Fischer_%28R-NE%29%2C_official_portrait%2C_118th_United_States_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"112\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/19/Sen._Deb_Fischer_%28R-NE%29%2C_official_portrait%2C_118th_United_States_Congress_%28cropped%29.jpg/250px-Sen._Deb_Fischer_%28R-NE%29%2C_official_portrait%2C_118th_United_States_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"792\" data-file-height=\"964\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #DCDCDC;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Osborn_Headshot_2_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Osborn_Headshot_2_%28cropped%29.jpg/120px-Osborn_Headshot_2_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"114\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/95/Osborn_Headshot_2_%28cropped%29.jpg/250px-Osborn_Headshot_2_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2194\" data-file-height=\"2614\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Dan_Osborn\" title=\"Dan Osborn\">Dan Osborn</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Independent_politician\" title=\"Independent politician\">Independent</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>499,124</b>\n</td>\n<td style=\"width:75px;text-align:center\">436,493\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>53.19%</b>\n</td>\n<td style=\"width:75px;text-align:center\">46.52%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Nebraska_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/2024_United_States_Senate_election_in_Nebraska_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Nebraska_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"140\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/2024_United_States_Senate_election_in_Nebraska_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Nebraska_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"379\" /></a></span><div>County results<br /><b>Fischer:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>Osborn:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#BDBDBD; color:#BDBDBD;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Nebraska\" title=\"List of United States senators from Nebraska\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Nebraska\" title=\"2024 United States Senate election in Nebraska\">2024 United States Senate election in Nebraska</a></div>\n<p>Two-term Republican <a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Nebraska\" title=\"2018 United States Senate election in Nebraska\">reelected in 2018</a> with 57.7% of the vote. On May 14, 2021, Fischer announced she was seeking reelection, despite previously declaring an intention to retire.<sup id=\"cite&#95;ref-166\" class=\"reference\"><a href=\"#cite_note-166\"><span class=\"cite-bracket\">&#91;</span>142<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Dan_Osborn\" title=\"Dan Osborn\">Dan Osborn</a>, a union leader and <a href=\"/wiki/Steamfitter\" class=\"mw-redirect\" title=\"Steamfitter\">steamfitter</a>, ran as an independent. Since Osborn declared, the Democratic Party fielded no candidates in order to endorse him, but he stated he would accept the help of no parties.<sup id=\"cite&#95;ref-167\" class=\"reference\"><a href=\"#cite_note-167\"><span class=\"cite-bracket\">&#91;</span>143<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Deb comfortably won re-election defeating Osborn.<sup id=\"cite&#95;ref-R115&#95;168-0\" class=\"reference\"><a href=\"#cite_note-R115-168\"><span class=\"cite-bracket\">&#91;</span>144<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-primary&#95;results&#95;169-0\" class=\"reference\"><a href=\"#cite_note-primary_results-169\"><span class=\"cite-bracket\">&#91;</span>145<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n  \n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>174,820 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>79.76% </b>\n</td></tr>\n  \n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Arron Kowalski\n</th>\n<td style=\"text-align:right\">44,334\n</td>\n<td style=\"text-align:right\">20.24%\n</td></tr>\n  \n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>219,154 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Nebraska<sup id=\"cite&#95;ref-R115&#95;168-1\" class=\"reference\"><a href=\"#cite_note-R115-168\"><span class=\"cite-bracket\">&#91;</span>144<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Deb_Fischer\" title=\"Deb Fischer\">Deb Fischer</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>499,124 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>53.19% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>−4.50% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DCDCDC; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_(politician)\" class=\"mw-redirect\" title=\"Independent (politician)\">Independent</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Dan_Osborn\" title=\"Dan Osborn\">Dan Osborn</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">436,493\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">46.52%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">—\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">2,719\n</td>\n<td style=\"text-align:right;\">0.29%\n</td>\n<td style=\"text-align:right;\">—\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>938,336 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading3\"><h3 id=\"Nebraska_(special)\"><span id=\"Nebraska_.28special.29\"></span>Nebraska (special)</h3><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=35\" title=\"Edit section: Nebraska (special)\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Nebraska special election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Flag_of_Nebraska.svg/60px-Flag_of_Nebraska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"30\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Flag_of_Nebraska.svg/120px-Flag_of_Nebraska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"750\" data-file-height=\"450\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2020_United_States_Senate_election_in_Nebraska\" title=\"2020 United States Senate election in Nebraska\">2020</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2026_United_States_Senate_election_in_Nebraska\" title=\"2026 United States Senate election in Nebraska\">2026</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Pete_Ricketts_official_portrait,_118th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg/120px-Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9c/Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg/250px-Sen._Pete_Ricketts_official_portrait%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1173\" data-file-height=\"1614\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Preston_Love_Jr.,_2020.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Preston_Love_Jr.%2C_2020.jpg/120px-Preston_Love_Jr.%2C_2020.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/5c/Preston_Love_Jr.%2C_2020.jpg/250px-Preston_Love_Jr.%2C_2020.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"454\" data-file-height=\"606\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Preston_Love_Jr.\" title=\"Preston Love Jr.\">Preston Love Jr.</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>585,103</b>\n</td>\n<td style=\"width:75px;text-align:center\">349,902\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>62.6%</b>\n</td>\n<td style=\"width:75px;text-align:center\">37.4%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_special_election_in_Nebraska_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/2024_United_States_Senate_special_election_in_Nebraska_results_map_by_county.svg/330px-2024_United_States_Senate_special_election_in_Nebraska_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"140\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/fe/2024_United_States_Senate_special_election_in_Nebraska_results_map_by_county.svg/960px-2024_United_States_Senate_special_election_in_Nebraska_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"379\" /></a></span><div>County results<br /><b>Ricketts:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#A80000; color:#A80000;\">&#160;&#160;&#160;&#160;</span>&#160;&gt;90%</span><br /><b>Love:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Nebraska\" title=\"List of United States senators from Nebraska\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_special_election_in_Nebraska\" title=\"2024 United States Senate special election in Nebraska\">2024 United States Senate special election in Nebraska</a></div>\n<p>Two-term Republican <a href=\"/wiki/Ben_Sasse\" title=\"Ben Sasse\">Ben Sasse</a> resigned his seat on January 8, 2023, to become president of the <a href=\"/wiki/University_of_Florida\" title=\"University of Florida\">University of Florida</a>.<sup id=\"cite&#95;ref-170\" class=\"reference\"><a href=\"#cite_note-170\"><span class=\"cite-bracket\">&#91;</span>146<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-SasseResig&#95;20-1\" class=\"reference\"><a href=\"#cite_note-SasseResig-20\"><span class=\"cite-bracket\">&#91;</span>15<span class=\"cite-bracket\">&#93;</span></a></sup> Former <a href=\"/wiki/Governor_of_Nebraska\" class=\"mw-redirect\" title=\"Governor of Nebraska\">governor</a> and <a href=\"/wiki/2006_United_States_Senate_election_in_Nebraska\" title=\"2006 United States Senate election in Nebraska\">2006 Senate nominee</a> <a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a> was appointed by Governor <a href=\"/wiki/Jim_Pillen\" title=\"Jim Pillen\">Jim Pillen</a>, and a special election for the seat would take place concurrently with the 2024 regular Senate elections. Ricketts defeated Air Force veteran John Glen Weaver for the Republican nomination.<sup id=\"cite&#95;ref-171\" class=\"reference\"><a href=\"#cite_note-171\"><span class=\"cite-bracket\">&#91;</span>147<span class=\"cite-bracket\">&#93;</span></a></sup> Former <a href=\"/wiki/University_of_Nebraska_Omaha\" title=\"University of Nebraska Omaha\">University of Nebraska Omaha</a> professor <a href=\"/wiki/Preston_Love_Jr.\" title=\"Preston Love Jr.\">Preston Love Jr.</a> ran as a Democrat.<sup id=\"cite&#95;ref-172\" class=\"reference\"><a href=\"#cite_note-172\"><span class=\"cite-bracket\">&#91;</span>148<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Rickets won the election, securing over 62% of the vote.\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-primary&#95;results&#95;169-1\" class=\"reference\"><a href=\"#cite_note-primary_results-169\"><span class=\"cite-bracket\">&#91;</span>145<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n  \n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b>Pete Ricketts (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>173,118 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>78.16% </b>\n</td></tr>\n  \n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">John Glen Weaver\n</th>\n<td style=\"text-align:right\">32,529\n</td>\n<td style=\"text-align:right\">14.69%\n</td></tr>\n  \n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Mac Stevens\n</th>\n<td style=\"text-align:right\">13,669\n</td>\n<td style=\"text-align:right\">6.17%\n</td></tr>\n  \n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>219,316 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate special election in Nebraska<sup id=\"cite&#95;ref-173\" class=\"reference\"><a href=\"#cite_note-173\"><span class=\"cite-bracket\">&#91;</span>149<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Pete_Ricketts\" title=\"Pete Ricketts\">Pete Ricketts</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>585,103 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>62.58% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>−0.16% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Preston_Love_Jr.\" title=\"Preston Love Jr.\">Preston Love Jr.</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">349,902\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">37.42%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+12.99%\n</td></tr>\n\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>935,005 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Nevada\">Nevada</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=36\" title=\"Edit section: Nevada\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:250px\"><caption class=\"infobox-title summary\">Nevada election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span clas