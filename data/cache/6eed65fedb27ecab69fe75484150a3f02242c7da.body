mons/thumb/b/b0/Increase2.svg/20px-Increase2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"11\" height=\"11\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Increase2.svg/40px-Increase2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span> 0.35\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E9E9E9\">\n</td>\n<td class=\"org\" style=\"width:130px\">Cheaper Gas Groceries\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Robert_F._Hyde\" title=\"Robert F. Hyde\">Robert F. Hyde</a>\n</th>\n<td style=\"text-align:right;\">14,879\n</td>\n<td style=\"text-align:right;\">0.87\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #17aa5c; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Green_Party_(United_States)\" class=\"mw-redirect\" title=\"Green Party (United States)\">Green</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Justin Paglino\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">14,422\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.84\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\"><span typeof=\"mw:File\"><span title=\"Increase\"><img alt=\"Increase\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Increase2.svg/20px-Increase2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"11\" height=\"11\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b0/Increase2.svg/40px-Increase2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span> 0.36\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">7\n</td>\n<td style=\"text-align:right;\">0.00\n</td>\n<td style=\"text-align:right;\"><span typeof=\"mw:File\"><span title=\"Steady\"><img alt=\"Steady\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Steady2.svg/20px-Steady2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"11\" height=\"11\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Steady2.svg/40px-Steady2.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"300\" data-file-height=\"300\" /></span></span>\n</td></tr>\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>1,708,259 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00 </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #0044C9;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Delaware\">Delaware</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=21\" title=\"Edit section: Delaware\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:110px\"><caption class=\"infobox-title summary\">Delaware election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Flag_of_Delaware.svg/60px-Flag_of_Delaware.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/c/c6/Flag_of_Delaware.svg/120px-Flag_of_Delaware.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"600\" data-file-height=\"400\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Delaware\" title=\"2018 United States Senate election in Delaware\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Delaware\" class=\"mw-redirect\" title=\"2030 United States Senate election in Delaware\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Senator_Blunt_Rochester_Official_Portrait_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Senator_Blunt_Rochester_Official_Portrait_%28cropped%29.jpg/120px-Senator_Blunt_Rochester_Official_Portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"105\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Senator_Blunt_Rochester_Official_Portrait_%28cropped%29.jpg/250px-Senator_Blunt_Rochester_Official_Portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1430\" data-file-height=\"1850\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:3x4.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Lisa_Blunt_Rochester\" title=\"Lisa Blunt Rochester\">Lisa Blunt Rochester</a></b>\n</td>\n<td style=\"width:75px;text-align:center\">Eric Hansen\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>283,298</b>\n</td>\n<td style=\"width:75px;text-align:center\">197,753\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>56.59%</b>\n</td>\n<td style=\"width:75px;text-align:center\">39.5%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:Delaware_state_election_results.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Delaware_state_election_results.svg/120px-Delaware_state_election_results.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"110\" height=\"223\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Delaware_state_election_results.svg/250px-Delaware_state_election_results.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"400\" data-file-height=\"810\" /></a></span><div>County results<br /><b>Blunt Rochester:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span><br /><b>Hansen:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Delaware\" title=\"List of United States senators from Delaware\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Tom_Carper\" title=\"Tom Carper\">Tom Carper</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Lisa_Blunt_Rochester\" title=\"Lisa Blunt Rochester\">Lisa Blunt Rochester</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Delaware\" title=\"2024 United States Senate election in Delaware\">2024 United States Senate election in Delaware</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Delaware\" title=\"List of United States senators from Delaware\">List of United States senators from Delaware</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_election_in_Delaware\" title=\"2024 United States House of Representatives election in Delaware\">2024 United States House of Representatives election in Delaware</a></div>\n<p>Four-term Democrat <a href=\"/wiki/Tom_Carper\" title=\"Tom Carper\">Tom Carper</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Delaware\" title=\"2018 United States Senate election in Delaware\">reelected in 2018</a> with 60.0% of the vote. He announced on May 22, 2023, that he would be retiring, and would not run for a fifth term.<sup id=\"cite&#95;ref-tc&#95;100-0\" class=\"reference\"><a href=\"#cite_note-tc-100\"><span class=\"cite-bracket\">&#91;</span>76<span class=\"cite-bracket\">&#93;</span></a></sup> Delaware's at-large U.S. representative <a href=\"/wiki/Lisa_Blunt_Rochester\" title=\"Lisa Blunt Rochester\">Lisa Blunt Rochester</a> ran for the Democratic nomination to succeed Carper, who endorsed her when he announced his retirement.<sup id=\"cite&#95;ref-Politico-June-1&#95;101-0\" class=\"reference\"><a href=\"#cite_note-Politico-June-1-101\"><span class=\"cite-bracket\">&#91;</span>77<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-LBR&#95;102-0\" class=\"reference\"><a href=\"#cite_note-LBR-102\"><span class=\"cite-bracket\">&#91;</span>78<span class=\"cite-bracket\">&#93;</span></a></sup> Term-limited <a href=\"/wiki/Governor_of_Delaware\" class=\"mw-redirect\" title=\"Governor of Delaware\">governor</a> <a href=\"/wiki/John_Carney_(Delaware_politician)\" title=\"John Carney (Delaware politician)\">John Carney</a> was also considered a possible Democratic candidate.<sup id=\"cite&#95;ref-tc&#95;100-1\" class=\"reference\"><a href=\"#cite_note-tc-100\"><span class=\"cite-bracket\">&#91;</span>76<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-103\" class=\"reference\"><a href=\"#cite_note-103\"><span class=\"cite-bracket\">&#91;</span>79<span class=\"cite-bracket\">&#93;</span></a></sup> Eric Hanson ran for the Republican nomination.<sup id=\"cite&#95;ref-104\" class=\"reference\"><a href=\"#cite_note-104\"><span class=\"cite-bracket\">&#91;</span>80<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Both Blunt Rochester and Hansen won their primaries unopposed. In the general election, Blunt Rochester defeated Hansen by a 14-point margin. \n</p>\n<table class=\"wikitable plainrowheaders\">\n<caption>United States Senate election in Delaware, 2024<sup id=\"cite&#95;ref-105\" class=\"reference\"><a href=\"#cite_note-105\"><span class=\"cite-bracket\">&#91;</span>81<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Lisa_Blunt_Rochester\" title=\"Lisa Blunt Rochester\">Lisa Blunt Rochester</a> </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>283,298 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>56.59% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>−3.36% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #E81B23; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Eric Hansen\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">197,753\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">39.50%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+1.69%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #98d8e9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_Party_of_Delaware\" title=\"Independent Party of Delaware\">Independent Party</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Michael_Katz_(politician)\" title=\"Michael Katz (politician)\">Michael Katz</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">19,555\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">3.91%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>500,606 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #0044C9;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Florida\">Florida</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=22\" title=\"Edit section: Florida\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Florida election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Florida.svg/60px-Flag_of_Florida.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Florida.svg/120px-Flag_of_Florida.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"4500\" data-file-height=\"3000\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Florida\" title=\"2018 United States Senate election in Florida\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Florida\" class=\"mw-redirect\" title=\"2030 United States Senate election in Florida\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Official_Portrait_of_Senator_Rick_Scott_(R-FL).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Official_Portrait_of_Senator_Rick_Scott_%28R-FL%29.jpg/120px-Official_Portrait_of_Senator_Rick_Scott_%28R-FL%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1d/Official_Portrait_of_Senator_Rick_Scott_%28R-FL%29.jpg/250px-Official_Portrait_of_Senator_Rick_Scott_%28R-FL%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2937\" data-file-height=\"3673\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Debbie_Mucarsel-Powell,_official_portrait,_116h_Congress.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Debbie_Mucarsel-Powell%2C_official_portrait%2C_116h_Congress.jpg/120px-Debbie_Mucarsel-Powell%2C_official_portrait%2C_116h_Congress.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"109\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e7/Debbie_Mucarsel-Powell%2C_official_portrait%2C_116h_Congress.jpg/250px-Debbie_Mucarsel-Powell%2C_official_portrait%2C_116h_Congress.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3600\" data-file-height=\"4500\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Rick_Scott\" title=\"Rick Scott\">Rick Scott</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Debbie_Mucarsel-Powell\" title=\"Debbie Mucarsel-Powell\">Debbie Mucarsel-Powell</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>5,977,706</b>\n</td>\n<td style=\"width:75px;text-align:center\">4,603,077\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>55.57%</b>\n</td>\n<td style=\"width:75px;text-align:center\">42.79%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Florida_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/2024_United_States_Senate_election_in_Florida_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Florida_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"298\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/2024_United_States_Senate_election_in_Florida_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Florida_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"810\" data-file-height=\"805\" /></a></span><div>County results<br /><b>Scott:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#FFB2B2; color:#FFB2B2;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>Mucarsel-Powell:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Florida\" title=\"List of United States senators from Florida\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Rick_Scott\" title=\"Rick Scott\">Rick Scott</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Rick_Scott\" title=\"Rick Scott\">Rick Scott</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Florida\" title=\"2024 United States Senate election in Florida\">2024 United States Senate election in Florida</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Florida\" title=\"List of United States senators from Florida\">List of United States senators from Florida</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Florida\" title=\"2024 United States House of Representatives elections in Florida\">2024 United States House of Representatives elections in Florida</a></div>\n<p>Former <a href=\"/wiki/List_of_governors_of_Florida\" title=\"List of governors of Florida\">governor</a> and incumbent one-term Republican <a href=\"/wiki/Rick_Scott\" title=\"Rick Scott\">Rick Scott</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Florida\" title=\"2018 United States Senate election in Florida\">narrowly elected in 2018</a> with 50.06% of the vote. He ran for reelection to a second term.<sup id=\"cite&#95;ref-ScottRunning&#95;106-0\" class=\"reference\"><a href=\"#cite_note-ScottRunning-106\"><span class=\"cite-bracket\">&#91;</span>82<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/Brevard_County\" class=\"mw-redirect\" title=\"Brevard County\">Brevard County</a> <a href=\"/wiki/Assistant_District_Attorney\" class=\"mw-redirect\" title=\"Assistant District Attorney\">assistant district attorney</a> Keith Gross and actor John Columbus challenged Scott for the Republican nomination.<sup id=\"cite&#95;ref-107\" class=\"reference\"><a href=\"#cite_note-107\"><span class=\"cite-bracket\">&#91;</span>83<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-108\" class=\"reference\"><a href=\"#cite_note-108\"><span class=\"cite-bracket\">&#91;</span>84<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Scott won a second term, defeating <a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> former congresswoman <a href=\"/wiki/Debbie_Mucarsel-Powell\" title=\"Debbie Mucarsel-Powell\">Debbie Mucarsel-Powell</a>.<sup id=\"cite&#95;ref-Scott&#95;wins&#95;109-0\" class=\"reference\"><a href=\"#cite_note-Scott_wins-109\"><span class=\"cite-bracket\">&#91;</span>85<span class=\"cite-bracket\">&#93;</span></a></sup> With the benefit of incumbency and the state's rightward trend, most political pundits considered the race to be favoring Scott to win re-election. On Election Day, Scott won by 12.78 percentage points, a significantly larger margin than most pre-election polls had suggested.<sup class=\"noprint Inline-Template Template-Fact\" style=\"white-space:nowrap;\">&#91;<i><a href=\"/wiki/Wikipedia:Citation_needed\" title=\"Wikipedia:Citation needed\"><span title=\"This claim needs references to reliable sources. (August 2026)\">citation needed</span></a></i>&#93;</sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-p820&#95;110-0\" class=\"reference\"><a href=\"#cite_note-p820-110\"><span class=\"cite-bracket\">&#91;</span>86<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Rick_Scott\" title=\"Rick Scott\">Rick Scott</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>1,283,904 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>84.38% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Keith Gross\n</th>\n<td style=\"text-align:right\">142,392\n</td>\n<td style=\"text-align:right\">9.36%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">John Columbus\n</th>\n<td style=\"text-align:right\">95,342\n</td>\n<td style=\"text-align:right\">6.26%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>1,521,638 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n</tbody></table>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-p820&#95;110-1\" class=\"reference\"><a href=\"#cite_note-p820-110\"><span class=\"cite-bracket\">&#91;</span>86<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Debbie_Mucarsel-Powell\" title=\"Debbie Mucarsel-Powell\">Debbie Mucarsel-Powell</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>747,397 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>68.50% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Stanley Campbell\n</th>\n<td style=\"text-align:right\">213,777\n</td>\n<td style=\"text-align:right\">19.59%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Brian_Rush\" title=\"Brian Rush\">Brian Rush</a>\n</th>\n<td style=\"text-align:right\">73,013\n</td>\n<td style=\"text-align:right\">6.69%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Rod Joseph\n</th>\n<td style=\"text-align:right\">56,961\n</td>\n<td style=\"text-align:right\">5.22%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>1,091,148 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Florida<sup id=\"cite&#95;ref-111\" class=\"reference\"><a href=\"#cite_note-111\"><span class=\"cite-bracket\">&#91;</span>87<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Rick_Scott\" title=\"Rick Scott\">Rick Scott</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>5,977,706 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>55.57% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+5.52% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Debbie_Mucarsel-Powell\" title=\"Debbie Mucarsel-Powell\">Debbie Mucarsel-Powell</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">4,603,077\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">42.79%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−7.14%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DCDCDC; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_politician\" title=\"Independent politician\">Independent</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Ben Everidge\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">62,683\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.58%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_of_Florida\" title=\"Libertarian Party of Florida\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Feena Bonoan\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">57,363\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.53%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DCDCDC; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Independent_politician\" title=\"Independent politician\">Independent</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Tuan TQ Nguyen\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">56,586\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">0.53%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">13\n</td>\n<td style=\"text-align:right;\">0.00%\n</td>\n<td style=\"text-align:right;\">-0.01%\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>10,757,428 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Hawaii\">Hawaii</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=23\" title=\"Edit section: Hawaii\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Hawaii election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Flag_of_Hawaii.svg/60px-Flag_of_Hawaii.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"25\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Flag_of_Hawaii.svg/120px-Flag_of_Hawaii.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1200\" data-file-height=\"600\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Hawaii\" title=\"2018 United States Senate election in Hawaii\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Hawaii\" class=\"mw-redirect\" title=\"2030 United States Senate election in Hawaii\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Mazie_Hirono,_official_portrait,_113th_Congress_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Mazie_Hirono%2C_official_portrait%2C_113th_Congress_%28cropped%29.jpg/120px-Mazie_Hirono%2C_official_portrait%2C_113th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"99\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/8/85/Mazie_Hirono%2C_official_portrait%2C_113th_Congress_%28cropped%29.jpg/250px-Mazie_Hirono%2C_official_portrait%2C_113th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1801\" data-file-height=\"2477\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Bob_McDermott.jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Bob_McDermott.jpg/120px-Bob_McDermott.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/72/Bob_McDermott.jpg/250px-Bob_McDermott.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"454\" data-file-height=\"602\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Mazie_Hirono\" title=\"Mazie Hirono\">Mazie Hirono</a></b>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Bob_McDermott\" title=\"Bob McDermott\">Bob McDermott</a>\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>324,194</b>\n</td>\n<td style=\"width:75px;text-align:center\">160,075\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>64.61%</b>\n</td>\n<td style=\"width:75px;text-align:center\">31.90%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Hawaii_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/71/2024_United_States_Senate_election_in_Hawaii_results_map_by_county.svg/330px-2024_United_States_Senate_election_in_Hawaii_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"175\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/71/2024_United_States_Senate_election_in_Hawaii_results_map_by_county.svg/960px-2024_United_States_Senate_election_in_Hawaii_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1122\" data-file-height=\"655\" /></a></span><div>County results<br /><b>Hirono:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Hawaii\" title=\"List of United States senators from Hawaii\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Mazie_Hirono\" title=\"Mazie Hirono\">Mazie Hirono</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Mazie_Hirono\" title=\"Mazie Hirono\">Mazie Hirono</a><br />\n<a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Hawaii\" title=\"2024 United States Senate election in Hawaii\">2024 United States Senate election in Hawaii</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Hawaii\" title=\"List of United States senators from Hawaii\">List of United States senators from Hawaii</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Hawaii\" title=\"2024 United States House of Representatives elections in Hawaii\">2024 United States House of Representatives elections in Hawaii</a></div>\n<p>Two-term Democrat <a href=\"/wiki/Mazie_Hirono\" title=\"Mazie Hirono\">Mazie Hirono</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Hawaii\" title=\"2018 United States Senate election in Hawaii\">reelected in 2018</a> with 71.2% of the vote. Hirono ran for a third term.<sup id=\"cite&#95;ref-Politico&#95;2024&#95;112-0\" class=\"reference\"><a href=\"#cite_note-Politico_2024-112\"><span class=\"cite-bracket\">&#91;</span>88<span class=\"cite-bracket\">&#93;</span></a></sup>  Former <a href=\"/wiki/Hawaii_House_of_Representatives\" title=\"Hawaii House of Representatives\">state representative</a> <a href=\"/wiki/Bob_McDermott\" title=\"Bob McDermott\">Bob McDermott</a> won a 6-candidate race to be the Republican nominee.<sup id=\"cite&#95;ref-113\" class=\"reference\"><a href=\"#cite_note-113\"><span class=\"cite-bracket\">&#91;</span>89<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-hsaresults&#95;114-0\" class=\"reference\"><a href=\"#cite_note-hsaresults-114\"><span class=\"cite-bracket\">&#91;</span>90<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Mazie_Hirono\" title=\"Mazie Hirono\">Mazie Hirono</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>176,131 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>90.47% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Ron Curtis\n</th>\n<td style=\"text-align:right\">14,271\n</td>\n<td style=\"text-align:right\">7.33%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Clyde Lewman\n</th>\n<td style=\"text-align:right\">4,287\n</td>\n<td style=\"text-align:right\">2.2%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>194,689 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable\" style=\";\">\n<caption>Republican primary results<sup id=\"cite&#95;ref-hsaresults&#95;114-1\" class=\"reference\"><a href=\"#cite_note-hsaresults-114\"><span class=\"cite-bracket\">&#91;</span>90<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Bob_McDermott\" title=\"Bob McDermott\">Bob McDermott</a> </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>27,961 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>51.87% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Adriel Lam\n</th>\n<td style=\"text-align:right\">8,913\n</td>\n<td style=\"text-align:right\">16.54%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Melba Amaral\n</th>\n<td style=\"text-align:right\">7,627\n</td>\n<td style=\"text-align:right\">14.15%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Paul Dolan\n</th>\n<td style=\"text-align:right\">4,006\n</td>\n<td style=\"text-align:right\">7.43%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Arturo Reyes\n</th>\n<td style=\"text-align:right\">3,319\n</td>\n<td style=\"text-align:right\">6.16%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Emmanuel Tipon\n</th>\n<td style=\"text-align:right\">2,075\n</td>\n<td style=\"text-align:right\">3.85%\n</td></tr>\n\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>53,901 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Hawaii<sup id=\"cite&#95;ref-generalresults&#95;115-0\" class=\"reference\"><a href=\"#cite_note-generalresults-115\"><span class=\"cite-bracket\">&#91;</span>91<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(US)\" class=\"mw-redirect\" title=\"Democratic Party (US)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Mazie_Hirono\" title=\"Mazie Hirono\">Mazie Hirono</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>324,194 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>64.61% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>−6.54% </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #E81B23; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Republican_Party_(US)\" class=\"mw-redirect\" title=\"Republican Party (US)\">Republican</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Bob_McDermott\" title=\"Bob McDermott\">Bob McDermott</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">160,075\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">31.90%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">+3.05%\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #DDDDBB; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/We_the_People_Party\" title=\"We the People Party\">We the People</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Shelby Billionaire\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">9,224\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">1.84%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #17aa5c; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Green_Party_(US)\" class=\"mw-redirect\" title=\"Green Party (US)\">Green</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Emma Pohlman\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">8,270\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">1.65%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>501,763 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td>\n<td style=\"text-align:right;\">N/A\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #0044C9;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Indiana\">Indiana</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=24\" title=\"Edit section: Indiana\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:250px\"><caption class=\"infobox-title summary\">Indiana election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Flag_of_Indiana.svg/60px-Flag_of_Indiana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"33\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/ac/Flag_of_Indiana.svg/120px-Flag_of_Indiana.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"750\" data-file-height=\"500\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2018_United_States_Senate_election_in_Indiana\" title=\"2018 United States Senate election in Indiana\">2018</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2030_United_States_Senate_election_in_Indiana\" class=\"mw-redirect\" title=\"2030 United States Senate election in Indiana\">2030</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Sen._Jim_Banks_official_Senate_photo,_119th_Congress_(HR)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Sen._Jim_Banks_official_Senate_photo%2C_119th_Congress_%28HR%29_%28cropped%29.jpg/120px-Sen._Jim_Banks_official_Senate_photo%2C_119th_Congress_%28HR%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Sen._Jim_Banks_official_Senate_photo%2C_119th_Congress_%28HR%29_%28cropped%29.jpg/250px-Sen._Jim_Banks_official_Senate_photo%2C_119th_Congress_%28HR%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"630\" data-file-height=\"840\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span typeof=\"mw:File\"><span><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"102\" height=\"136\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" /></span></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Jim_Banks\" title=\"Jim Banks\">Jim Banks</a></b>\n</td>\n<td style=\"width:75px;text-align:center\">Valerie McCray\n</td>\n<td style=\"text-align:center\">\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Popular&#160;vote\n</th>\n<td style=\"width:75px;text-align:center\"><b>1,659,416</b>\n</td>\n<td style=\"width:75px;text-align:center\">1,097,061\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Percentage\n</th>\n<td style=\"width:75px;text-align:center\"><b>58.64%</b>\n</td>\n<td style=\"width:75px;text-align:center\">38.77%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><span typeof=\"mw:File\"><a href=\"/wiki/File:2024_United_States_Senate_election_in_Indiana_results_map_by_county.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/2024_United_States_Senate_election_in_Indiana_results_map_by_county.svg/250px-2024_United_States_Senate_election_in_Indiana_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"250\" height=\"382\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f4/2024_United_States_Senate_election_in_Indiana_results_map_by_county.svg/500px-2024_United_States_Senate_election_in_Indiana_results_map_by_county.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"530\" data-file-height=\"810\" /></a></span><div>County results<br /><b>Banks:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#FFB2B2; color:#FFB2B2;\">&#160;&#160;&#160;&#160;</span>&#160;40–50%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#d75d5d; color:#d75d5d;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>McCray:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#7996e2; color:#7996e2;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#6674de; color:#6674de;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Indiana\" title=\"List of United States senators from Indiana\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Mike_Braun\" title=\"Mike Braun\">Mike Braun</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. Senator</b> <br />\n<p><a href=\"/wiki/Jim_Banks\" title=\"Jim Banks\">Jim Banks</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2024_United_States_Senate_election_in_Indiana\" title=\"2024 United States Senate election in Indiana\">2024 United States Senate election in Indiana</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Indiana\" title=\"List of United States senators from Indiana\">List of United States senators from Indiana</a> and <a href=\"/wiki/2024_United_States_House_of_Representatives_elections_in_Indiana\" title=\"2024 United States House of Representatives elections in Indiana\">2024 United States House of Representatives elections in Indiana</a></div>\n<p>One-term Republican <a href=\"/wiki/Mike_Braun\" title=\"Mike Braun\">Mike Braun</a> was <a href=\"/wiki/2018_United_States_Senate_election_in_Indiana\" title=\"2018 United States Senate election in Indiana\">elected in 2018</a> with 50.8% of the vote. Braun was retiring to prepare to <a href=\"/wiki/2024_Indiana_gubernatorial_election\" title=\"2024 Indiana gubernatorial election\">run</a> for <a href=\"/wiki/Governor_of_Indiana\" title=\"Governor of Indiana\">governor of Indiana</a>.<sup id=\"cite&#95;ref-Braun&#95;64-2\" class=\"reference\"><a href=\"#cite_note-Braun-64\"><span class=\"cite-bracket\">&#91;</span>44<span class=\"cite-bracket\">&#93;</span></a></sup> <a href=\"/wiki/United_States_House_of_Representatives\" title=\"United States House of Representatives\">U.S. representative</a> <a href=\"/wiki/Jim_Banks\" title=\"Jim Banks\">Jim Banks</a> ran unopposed in the primary after his only competition, businessman John Rust, was disqualified.<sup id=\"cite&#95;ref-116\" class=\"reference\"><a href=\"#cite_note-116\"><span class=\"cite-bracket\">&#91;</span>92<span class=\"cite-bracket\">&#93;</span></a></sup> Psychologist Valerie McCray defeated former <a href=\"/wiki/Indiana_House_of_Representatives\" title=\"Indiana House of Representatives\">state representative</a> <a href=\"/wiki/Marc_Carmichael\" title=\"Marc Carmichael\">Marc Carmichael</a> for the Democratic nomination.<sup id=\"cite&#95;ref-117\" class=\"reference\"><a href=\"#cite_note-117\"><span class=\"cite-bracket\">&#91;</span>93<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>On election day, Banks defeated McCray by nearly a 20-percentage-point margin, winning all but three counties.<sup id=\"cite&#95;ref-118\" class=\"reference\"><a href=\"#cite_note-118\"><span class=\"cite-bracket\">&#91;</span>94<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Democratic primary results<sup id=\"cite&#95;ref-NYTINPrimary&#95;119-0\" class=\"reference\"><a href=\"#cite_note-NYTINPrimary-119\"><span class=\"cite-bracket\">&#91;</span>95<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b>Valerie McCray </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>121,734 </b>\n</td>\n<td style=\"text-align:right;margin-right:0.5em\"><b>68.01% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#0044C9;width:2px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align: left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Marc_Carmichael\" title=\"Marc Carmichael\">Marc Carmichael</a>\n</th>\n<td style=\"text-align:right\">57,256\n</td>\n<td style=\"text-align:right\">31.99%\n</td></tr>\n\n<tr>\n<th scope=\"row\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>178,990 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00% </b>\n</td></tr>\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>2024 United States Senate election in Indiana<sup id=\"cite&#95;ref-120\" class=\"reference\"><a href=\"#cite_note-120\"><span class=\"cite-bracket\">&#91;</span>96<span class=\"cite-bracket\">&#93;</span></a></sup><sup id=\"cite&#95;ref-g130&#95;121-0\" class=\"reference\"><a href=\"#cite_note-g130-121\"><span class=\"cite-bracket\">&#91;</span>97<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1038841319\" /><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Jim_Banks\" title=\"Jim Banks\">Jim Banks</a> </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>1,659,416 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>58.64% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+7.91% </b>\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Valerie McCray\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">1,097,061\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">38.77%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−6.07%\n</td></tr>\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\">Andrew Horning\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">73,233\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">2.59%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−1.83%\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">187\n</td>\n<td style=\"text-align:right;\">0.00%\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>2,829,897 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Maine\">Maine</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2024_United_States_Senate_elections&amp;action=edit&amp;section=25\" title=\"Edit section: Maine\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inli