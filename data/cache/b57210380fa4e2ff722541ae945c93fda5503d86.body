lign:right;\"><b>168,853 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.00 </b>\n</td></tr>\n\n</tbody></table>\n<table class=\"wikitable plainrowheaders\">\n<caption>Alabama general election<sup id=\"cite&#95;ref-90\" class=\"reference\"><a href=\"#cite_note-90\"><span class=\"cite-bracket\">&#91;</span>65<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 130px\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th>\n<th scope=\"col\" style=\"width: 3.5em\"><style data-mw-deduplicate=\"TemplateStyles:r1038841319\">.mw-parser-output .tooltip-dotted{border-bottom:1px dotted;cursor:help}</style><span class=\"rt-commentedText tooltip tooltip-dotted\" title=\"Change in percentage value since previous election\">±%</span>\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23; width:5px;\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Katie_Britt\" title=\"Katie Britt\">Katie Britt</a> </b>\n</th>\n<td style=\"text-align:right; margin-right:0.5em\"><b>942,154 </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>66.62% </b>\n</td>\n<td style=\"text-align:right; margin-right:0.5em\"><b>+2.66 </b>\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #0044C9; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/Will_Boyd\" title=\"Will Boyd\">Will Boyd</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">436,746\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">30.88%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">−4.99\n</td></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit; background-color: #fed000; width: 5px;\">\n</td>\n<td class=\"org\" style=\"width: 130px\"><a href=\"/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><a href=\"/wiki/John_Sophocleus\" title=\"John Sophocleus\">John Sophocleus</a>\n</th>\n<td style=\"text-align: right; margin-right: 0.5em\">32,879\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">2.32%\n</td>\n<td style=\"text-align: right; margin-right: 0.5em\">N/A\n</td></tr>\n\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color: white; width: 2px;\">\n</td>\n<td class=\"org\" colspan=\"2\"><a href=\"/wiki/Write-in_candidate\" title=\"Write-in candidate\">Write-in</a>\n</td>\n<td style=\"text-align:right;\">2,459\n</td>\n<td style=\"text-align:right;\">0.17%\n</td>\n<td style=\"text-align:right;\">±0.00\n</td></tr>\n\n<tr>\n<th scope=\"col\" colspan=\"3\" style=\"text-align:right;\">Total votes\n</th>\n<td style=\"text-align:right;\"><b>1,414,238 </b>\n</td>\n<td style=\"text-align:right;\"><b>100.0% </b>\n</td>\n<td style=\"text-align:right;\">\n</td></tr>\n\n\n<tr>\n<td style=\"color:inherit;background-color: #E81B23;\">\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" colspan=\"5\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a> <b>hold</b>\n</th></tr>\n\n\n</tbody></table>\n<div style=\"clear:both;\" class=\"\"></div>\n<div class=\"mw-heading mw-heading2\"><h2 id=\"Alaska\">Alaska</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2022_United_States_Senate_elections&amp;action=edit&amp;section=19\" title=\"Edit section: Alaska\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" /><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" /><table class=\"infobox ib-election infobox-table\" style=\"width:300px\"><caption class=\"infobox-title summary\">Alaska election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Flag_of_Alaska.svg/60px-Flag_of_Alaska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"50\" height=\"35\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Flag_of_Alaska.svg/120px-Flag_of_Alaska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1416\" data-file-height=\"1000\" /></span></span></span><hr /></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\">&#8592;&#160;<a href=\"/wiki/2016_United_States_Senate_election_in_Alaska\" title=\"2016 United States Senate election in Alaska\">2016</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><a href=\"/wiki/2028_United_States_Senate_election_in_Alaska\" class=\"mw-redirect\" title=\"2028 United States Senate election in Alaska\">2028</a>&#160;&#8594;</div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n\n\n\n\n<tbody><tr>\n<td>&#160;\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Lisa_Murkowski_in_2020_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Lisa_Murkowski_in_2020_%28cropped%29.jpg/120px-Lisa_Murkowski_in_2020_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"112\" height=\"150\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Lisa_Murkowski_in_2020_%28cropped%29.jpg/250px-Lisa_Murkowski_in_2020_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1099\" data-file-height=\"1465\" /></a></span>\n</td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"/wiki/File:Kelly_Tshibaka_(53423158403)_(cropped).jpg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Kelly_Tshibaka_%2853423158403%29_%28cropped%29.jpg/120px-Kelly_Tshibaka_%2853423158403%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"112\" height=\"150\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/aa/Kelly_Tshibaka_%2853423158403%29_%28cropped%29.jpg/250px-Kelly_Tshibaka_%2853423158403%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2438\" data-file-height=\"3250\" /></a></span>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Candidate\n</th>\n<td style=\"width:75px;text-align:center\"><b><a href=\"/wiki/Lisa_Murkowski\" title=\"Lisa Murkowski\">Lisa Murkowski</a></b>\n</td>\n<td style=\"width:75px;text-align:center\">Kelly Tshibaka\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party\n</th>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td>\n<td style=\"width:75px;text-align:center\"><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">First round\n</th>\n<td style=\"width:75px;text-align:center\"><b>113,495<br />43.4%</b>\n</td>\n<td style=\"width:75px;text-align:center\"><b>111,480<br />42.6%</b>\n</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\"><a href=\"/wiki/Instant-runoff_voting\" title=\"Instant-runoff voting\">Final round</a>\n</th>\n<td style=\"width:75px;text-align:center\"><b>136,330<br />53.7%</b>\n</td>\n<td style=\"width:75px;text-align:center\">117,534<br />46.3%\n</td></tr>\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr /><div class=\"switcher-container\"><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2022_United_States_Senate_general_election_in_Alaska_by_State_House_district.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/2022_United_States_Senate_general_election_in_Alaska_by_State_House_district.svg/330px-2022_United_States_Senate_general_election_in_Alaska_by_State_House_district.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"233\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6a/2022_United_States_Senate_general_election_in_Alaska_by_State_House_district.svg/960px-2022_United_States_Senate_general_election_in_Alaska_by_State_House_district.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"850\" data-file-height=\"660\" /></a></span>\n<span class=\"switcher-label\" style=\"display:none\">First round results by <a href=\"/wiki/Alaska_House_of_Representatives\" title=\"Alaska House of Representatives\">State House</a> district</span></div><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2022_United_States_Senate_general_election_final_round_in_Alaska_results_map_by_State_House_district.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/64/2022_United_States_Senate_general_election_final_round_in_Alaska_results_map_by_State_House_district.svg/330px-2022_United_States_Senate_general_election_final_round_in_Alaska_results_map_by_State_House_district.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"233\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/64/2022_United_States_Senate_general_election_final_round_in_Alaska_results_map_by_State_House_district.svg/960px-2022_United_States_Senate_general_election_final_round_in_Alaska_results_map_by_State_House_district.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"850\" data-file-height=\"660\" /></a></span>\n<span class=\"switcher-label\" style=\"display:none\">Maximum round results by <a href=\"/wiki/Alaska_House_of_Representatives\" title=\"Alaska House of Representatives\">State House</a> district</span></div><div><span typeof=\"mw:File\"><a href=\"/wiki/File:2022_United_States_Senate_election_in_Alaska_results_map_by_borough_and_census_area.svg\" class=\"mw-file-description\"><img src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/2022_United_States_Senate_election_in_Alaska_results_map_by_borough_and_census_area.svg/330px-2022_United_States_Senate_election_in_Alaska_results_map_by_borough_and_census_area.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"300\" height=\"183\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/b9/2022_United_States_Senate_election_in_Alaska_results_map_by_borough_and_census_area.svg/960px-2022_United_States_Senate_election_in_Alaska_results_map_by_borough_and_census_area.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"800\" data-file-height=\"488\" /></a></span>\n<span class=\"switcher-label\" data-switcher-default=\"\" style=\"display:none\">Maximum round results by borough and census area</span></div></div><div><b>Murkowski:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#E27F7F; color:#E27F7F;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D75D5D; color:#D75D5D;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D72F30; color:#D72F30;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#C21B18; color:#C21B18;\">&#160;&#160;&#160;&#160;</span>&#160;80–90%</span><br /><b>Tshibaka:</b> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#FF9A50; color:#FF9A50;\">&#160;&#160;&#160;&#160;</span>&#160;50–60%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#EE8E50; color:#EE8E50;\">&#160;&#160;&#160;&#160;</span>&#160;60–70%</span> <span style=\"margin:0px; font-size:90%;\"><span style=\"border:none; background-color:#D69850; color:#D69850;\">&#160;&#160;&#160;&#160;</span>&#160;70–80%</span></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr />\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr>\n<td style=\"width:50%; text-align:left;\"><b><a href=\"/wiki/List_of_United_States_senators_from_Alaska\" title=\"List of United States senators from Alaska\">U.S. senator</a> before election</b><br />\n<p><a href=\"/wiki/Lisa_Murkowski\" title=\"Lisa Murkowski\">Lisa Murkowski</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td>\n<td style=\"width:50%; text-align:right;\"><b>Elected U.S. senator</b> <br />\n<p><a href=\"/wiki/Lisa_Murkowski\" title=\"Lisa Murkowski\">Lisa Murkowski</a><br />\n<a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a>\n</p>\n</td></tr></tbody></table></td></tr></tbody></table><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">Main article: <a href=\"/wiki/2022_United_States_Senate_election_in_Alaska\" title=\"2022 United States Senate election in Alaska\">2022 United States Senate election in Alaska</a></div>\n<link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" /><div role=\"note\" class=\"hatnote navigation-not-searchable\">See also: <a href=\"/wiki/List_of_United_States_senators_from_Alaska\" title=\"List of United States senators from Alaska\">List of United States senators from Alaska</a> and <a href=\"/wiki/2022_United_States_House_of_Representatives_election_in_Alaska\" title=\"2022 United States House of Representatives election in Alaska\">2022 United States House of Representatives election in Alaska</a></div>\n<p>Three-term Republican <a href=\"/wiki/Lisa_Murkowski\" title=\"Lisa Murkowski\">Lisa Murkowski</a> was <a href=\"/wiki/2016_United_States_Senate_election_in_Alaska\" title=\"2016 United States Senate election in Alaska\">re-elected in 2016</a> with 44.4% of the vote. Alaska voters passed a <a href=\"/wiki/2020_Alaska_Measure_2\" title=\"2020 Alaska Measure 2\">ballot initiative</a> in 2020 that adopted a new <a href=\"/wiki/Top-four_primary\" title=\"Top-four primary\">top-four ranked-choice voting</a> system: all candidates compete in a <a href=\"/wiki/Nonpartisan_blanket_primary\" class=\"mw-redirect\" title=\"Nonpartisan blanket primary\">nonpartisan blanket primary</a>, the top four candidates advance to the general election, and the winner is determined by <a href=\"/wiki/Instant-runoff_voting\" title=\"Instant-runoff voting\">instant-runoff voting</a> using <a href=\"/wiki/Ranked-choice_voting_in_the_United_States\" title=\"Ranked-choice voting in the United States\">ranked-choice ballots</a>. On March 30, following the Alaska Republican Party's decision to censure senator Murkowski, former <a href=\"/wiki/Alaska_Department_of_Administration\" title=\"Alaska Department of Administration\">Alaska Department of Administration</a> commissioner Kelly Tshibaka announced her campaign against Murkowski, later receiving <a href=\"/wiki/Donald_Trump\" title=\"Donald Trump\">Donald Trump</a>'s endorsement.<sup id=\"cite&#95;ref-91\" class=\"reference\"><a href=\"#cite_note-91\"><span class=\"cite-bracket\">&#91;</span>66<span class=\"cite-bracket\">&#93;</span></a></sup> Republican <a href=\"/wiki/Governor_of_Alaska\" class=\"mw-redirect\" title=\"Governor of Alaska\">governor</a> <a href=\"/wiki/Mike_Dunleavy_(politician)\" title=\"Mike Dunleavy (politician)\">Mike Dunleavy</a>, who was considered another potential challenger to Murkowski, instead <a href=\"/wiki/2022_Alaska_gubernatorial_election\" title=\"2022 Alaska gubernatorial election\">ran for re-election</a>.<sup id=\"cite&#95;ref-92\" class=\"reference\"><a href=\"#cite_note-92\"><span class=\"cite-bracket\">&#91;</span>67<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Murkowski, Tshibaka, Republican Buzz Kelley, and Democrat Pat Chesbro advanced to the general election.<sup id=\"cite&#95;ref-93\" class=\"reference\"><a href=\"#cite_note-93\"><span class=\"cite-bracket\">&#91;</span>68<span class=\"cite-bracket\">&#93;</span></a></sup> Kelley suspended his campaign in September and endorsed Tshibaka, although his name remained on the ballot.<sup id=\"cite&#95;ref-94\" class=\"reference\"><a href=\"#cite_note-94\"><span class=\"cite-bracket\">&#91;</span>69<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p><p>Murkowski received a slight plurality of the first-choice votes and a majority of all votes following the ranked choice tabulation, winning re-election to a fourth full term.<sup id=\"cite&#95;ref-NYTIMES&#95;73-2\" class=\"reference\"><a href=\"#cite_note-NYTIMES-73\"><span class=\"cite-bracket\">&#91;</span>50<span class=\"cite-bracket\">&#93;</span></a></sup>\n</p>\n<table class=\"wikitable\" style=\";\">\n<caption>Alaska blanket primary<sup id=\"cite&#95;ref-95\" class=\"reference\"><a href=\"#cite_note-95\"><span class=\"cite-bracket\">&#91;</span>70<span class=\"cite-bracket\">&#93;</span></a></sup>\n</caption>\n<tbody><tr>\n<th scope=\"col\" colspan=\"2\" style=\"width: 15em\">Party\n</th>\n<th scope=\"col\" style=\"width: 17em\">Candidate\n</th>\n<th scope=\"col\" style=\"width: 5em\">Votes\n</th>\n<th scope=\"col\" style=\"width: 3.5em\">%\n</th></tr>\n\n\n<tr class=\"vcard\">\n<td style=\"color:inherit;background-color:#E81B23;width:5px\">\n</td>\n<td class=\"org\" style=\"width:130px\"><b><a href=\"/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></b>\n</td>\n<th scope=\"row\" style=\"text-align:left; font-weight:normal; color:inherit; background:inherit;\" class=\"fn\"><b><a href=\"/wiki/Lisa_Murkowski\" title=\"Lisa Murkowski\">Lisa Murkowski</a> (incumbent) </b>\n</th>\n<td style=\"text-align:right;margin-right:0.5em\"><b>