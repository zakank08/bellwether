=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/ba/Tommy_Tuberville%2C_official_portrait%2C_118th_Congress_%28cropped%29.jpg/250px-Tommy_Tuberville%2C_official_portrait%2C_118th_Congress_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1015\" data-file-height=\"1407\" data-file-type=\"bitmap\" height=\"150\" width=\"108\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Senator_Doug_Jones_official_photo_(cropped)_2.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Senator_Doug_Jones_official_photo_(cropped)_2.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0d/Senator_Doug_Jones_official_photo_%28cropped%29_2.jpg/250px-Senator_Doug_Jones_official_photo_%28cropped%29_2.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" data-file-width=\"2347\" data-file-height=\"2847\" data-file-type=\"bitmap\" height=\"150\" width=\"124\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tommy_Tuberville\" title=\"Tommy Tuberville\">Tommy Tuberville</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Doug_Jones_(politician)\" title=\"Doug Jones (politician)\">Doug Jones</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Alabama\" title=\"Governor of Alabama\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kay_Ivey\" title=\"Kay Ivey\">Kay Ivey</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1452\" typeof=\"mw:Transclusion\" id=\"mwCL4\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 Alabama gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1453\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1452\" id=\"mwCL8\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Alabama_gubernatorial_election\" title=\"2026 Alabama gubernatorial election\">2026 Alabama gubernatorial election</a></div>\n\n<span class=\"mw-empty-elt\" about=\"#mwt1454\" typeof=\"mw:Transclusion\" id=\"mwCMA\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"2026 Alabama lieutenant gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1455\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1454\" id=\"mwCME\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Alabama_lieutenant_gubernatorial_election\" title=\"2026 Alabama lieutenant gubernatorial election\">2026 Alabama lieutenant gubernatorial election</a></div>\n<p id=\"mwCMI\">Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kay_Ivey\" title=\"Kay Ivey\" id=\"mwCMM\">Kay Ivey</a>, a Republican, was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Alabama_gubernatorial_election\" title=\"2022 Alabama gubernatorial election\" id=\"mwCMQ\">2022</a> with 67.4% of the vote. She will be term-limited by the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_of_Alabama\" title=\"Constitution of Alabama\" id=\"mwCMU\">Constitution of Alabama</a> in 2026 and cannot seek re-election to a third consecutive full term. Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/US_Senator\" title=\"US Senator\" class=\"mw-redirect\" id=\"mwCMY\">U.S. Senator</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tommy_Tuberville\" title=\"Tommy Tuberville\" id=\"mwCMc\">Tommy Tuberville</a> entered the gubernatorial race in May 2025, joined by former candidate for <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Alabama's_6th_congressional_district\" title=\"Alabama's 6th congressional district\" id=\"mwCMg\">Alabama's 6th congressional district</a> in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_House_of_Representatives_elections_in_Alabama#District_6\" title=\"2024 United States House of Representatives elections in Alabama\" id=\"mwCMk\">2024</a> Ken McFeeters<sup about=\"#mwt1456\" class=\"mw-ref reference\" id=\"cite_ref-AL2026R_19-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"AL2026R\"}}'><a href=\"#cite_note-AL2026R-19\" id=\"mwCMo\"><span class=\"mw-reflink-text\" id=\"mwCMs\"><span class=\"cite-bracket\" id=\"mwCMw\">[</span>16<span class=\"cite-bracket\" id=\"mwCM0\">]</span></span></a></sup> and event center operations manager Will Santivasci.<sup about=\"#mwt1459\" class=\"mw-ref reference\" id=\"cite_ref-ALcom_92-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"ALcom\"},\"body\":{\"id\":\"mw-reference-text-cite_note-ALcom-92\"}}'><a href=\"#cite_note-ALcom-92\" id=\"mwCM4\"><span class=\"mw-reflink-text\" id=\"mwCM8\"><span class=\"cite-bracket\" id=\"mwCNA\">[</span>82<span class=\"cite-bracket\" id=\"mwCNE\">]</span></span></a></sup></p>\n\n<p id=\"mwCNI\">Democratic candidates include former U.S. Senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Doug_Jones_(politician)\" title=\"Doug Jones (politician)\" id=\"mwCNM\">Doug Jones</a>; the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Alabama_gubernatorial_election\" title=\"2022 Alabama gubernatorial election\" id=\"mwCNQ\">2022</a> gubernatorial nominee Yolanda Flowers; <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Will_Boyd\" title=\"Will Boyd\" id=\"mwCNU\">Will Boyd</a>, a former city councilor of <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Greenville,_Illinois\" title=\"Greenville, Illinois\" id=\"mwCNY\">Greenville, Illinois</a>, and the nominee for Alabama Lieutenant Governor in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2018_Alabama_lieutenant_gubernatorial_election\" title=\"2018 Alabama lieutenant gubernatorial election\" id=\"mwCNc\">2018</a> and for U.S. Senate in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_United_States_Senate_election_in_Alabama\" title=\"2022 United States Senate election in Alabama\" id=\"mwCNg\">2022</a>; pastor Ja'Mel Brown; candidate for governor in 2022 Chad Chig Martin;<sup about=\"#mwt1460\" class=\"mw-ref reference\" id=\"cite_ref-AL2026D_18-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"AL2026D\"}}'><a href=\"#cite_note-AL2026D-18\" id=\"mwCNk\"><span class=\"mw-reflink-text\" id=\"mwCNo\"><span class=\"cite-bracket\" id=\"mwCNs\">[</span>15<span class=\"cite-bracket\" id=\"mwCNw\">]</span></span></a></sup> and former state representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Nathan_Mathis\" title=\"Nathan Mathis\" id=\"mwCN0\">Nathan Mathis</a>.<sup about=\"#mwt1461\" class=\"mw-ref reference\" id=\"cite_ref-ALcom_92-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"ALcom\"}}'><a href=\"#cite_note-ALcom-92\" id=\"mwCN4\"><span class=\"mw-reflink-text\" id=\"mwCN8\"><span class=\"cite-bracket\" id=\"mwCOA\">[</span>82<span class=\"cite-bracket\" id=\"mwCOE\">]</span></span></a></sup></p>\n\n<p id=\"mwCOI\">As Jones and Tuberville won their respective primaries, the gubernatorial election will be a rematch of the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_Senate_election_in_Alabama\" title=\"2020 United States Senate election in Alabama\" id=\"mwCOM\">2020 United States Senate election</a>, which saw Tuberville defeat Jones. Tuberville has faced several <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Alabama_gubernatorial_election#Challenges_to_Tuberville's_eligibility\" title=\"2026 Alabama gubernatorial election\" id=\"mwCOQ\">challenges to his eligibility for the governorship</a>.</p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1462\" typeof=\"mw:Transclusion\" id=\"mwCOU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"14\" id=\"mwCOY\" aria-labelledby=\"Alaska\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Alaska\">Alaska</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=14\" title=\"Edit section: Alaska\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1463\" typeof=\"mw:Transclusion\" id=\"mwCOc\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Alaska gubernatorial election\"},\"country\":{\"wt\":\"Alaska\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Alaska gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Alaska gubernatorial election\"},\"next_year\":{\"wt\":\"2030\"},\"image1\":{\"wt\":\"JKTphoto (cropped).jpg\"},\"candidate1\":{\"wt\":\"[[Jonathan Kreiss-Tomkins]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"running_mate1\":{\"wt\":\"Zac Johnson\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Bernadette Wilson at Chris Birch memorial service.jpg\"},\"candidate2\":{\"wt\":\"Bernadette Wilson\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"running_mate2\":{\"wt\":\"[[Mike Shower]]\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"image4\":{\"wt\":\"Dave Bronson March 2022.jpg\"},\"candidate4\":{\"wt\":\"[[Dave Bronson]]\"},\"party4\":{\"wt\":\"Republican Party (United States)\"},\"running_mate4\":{\"wt\":\"Josh Church\"},\"popular_vote4\":{\"wt\":\"\"},\"percentage4\":{\"wt\":\"\"},\"image5\":{\"wt\":\"3x4.svg\"},\"candidate5\":{\"wt\":\"[[Treg Taylor]]\"},\"party5\":{\"wt\":\"Republican Party (United States)\"},\"running_mate5\":{\"wt\":\"Candice English\"},\"popular_vote5\":{\"wt\":\"\"},\"percentage5\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of Alaska|Governor]]\"},\"before_election\":{\"wt\":\"[[Mike Dunleavy (politician)|Mike Dunleavy]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1464\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1465\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1466\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1463\" id=\"mwCOg\"><caption class=\"infobox-title summary\">Alaska gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Alaska.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Flag_of_Alaska.svg/60px-Flag_of_Alaska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/e6/Flag_of_Alaska.svg/120px-Flag_of_Alaska.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1416\" data-file-height=\"1000\" data-file-type=\"drawing\" height=\"35\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Alaska_gubernatorial_election\" title=\"2022 Alaska gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\">2030<span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:JKTphoto_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:JKTphoto_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/JKTphoto_%28cropped%29.jpg/120px-JKTphoto_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/7e/JKTphoto_%28cropped%29.jpg/250px-JKTphoto_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1340\" data-file-height=\"1786\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Bernadette_Wilson_at_Chris_Birch_memorial_service.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Bernadette_Wilson_at_Chris_Birch_memorial_service.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Bernadette_Wilson_at_Chris_Birch_memorial_service.jpg/120px-Bernadette_Wilson_at_Chris_Birch_memorial_service.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/4d/Bernadette_Wilson_at_Chris_Birch_memorial_service.jpg/250px-Bernadette_Wilson_at_Chris_Birch_memorial_service.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"715\" data-file-height=\"954\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Candidate</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jonathan_Kreiss-Tomkins\" title=\"Jonathan Kreiss-Tomkins\">Jonathan Kreiss-Tomkins</a></td>\n<td style=\"width:75px;text-align:center\">Bernadette Wilson</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Running<span typeof=\"mw:Entity\"> </span>mate</th>\n<td style=\"width:75px;text-align:center\">Zac Johnson</td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Shower\" title=\"Mike Shower\">Mike Shower</a></td></tr>\n\n<tr>\n<td colspan=\"4\"><hr/></td></tr>\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Dave_Bronson_March_2022.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Dave_Bronson_March_2022.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Dave_Bronson_March_2022.jpg/120px-Dave_Bronson_March_2022.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/60/Dave_Bronson_March_2022.jpg/250px-Dave_Bronson_March_2022.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"729\" data-file-height=\"973\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:3x4.svg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:3x4.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" data-file-type=\"drawing\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Candidate</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Dave_Bronson\" title=\"Dave Bronson\">Dave Bronson</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Treg_Taylor\" title=\"Treg Taylor\">Treg Taylor</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Running<span typeof=\"mw:Entity\"> </span>mate</th>\n<td style=\"width:75px;text-align:center\">Josh Church</td>\n<td style=\"width:75px;text-align:center\">Candice English</td></tr>\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Alaska\" title=\"Governor of Alaska\" class=\"mw-redirect\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Dunleavy_(politician)\" title=\"Mike Dunleavy (politician)\">Mike Dunleavy</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1467\" typeof=\"mw:Transclusion\" id=\"mwCOk\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 Alaska gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1468\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1467\" id=\"mwCOo\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Alaska_gubernatorial_election\" title=\"2026 Alaska gubernatorial election\">2026 Alaska gubernatorial election</a></div>\n\n<p id=\"mwCOs\">Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Dunleavy_(politician)\" title=\"Mike Dunleavy (politician)\" id=\"mwCOw\">Mike Dunleavy</a>, a Republican, was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Alaska_gubernatorial_election\" title=\"2022 Alaska gubernatorial election\" id=\"mwCO0\">2022</a> with 50.3% of the vote. He will be term-limited by the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_of_Alaska\" title=\"Constitution of Alaska\" id=\"mwCO4\">Constitution of Alaska</a> in 2026 and cannot seek re-election to a third consecutive term. </p>\n\n<p id=\"mwCO8\">A <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Nonpartisan_primary\" title=\"Nonpartisan primary\" id=\"mwCPA\">nonpartisan primary</a> was held on August 18, 2026, with the top four candidates advancing to the general election, which will be conducted using <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ranked-choice_voting_in_the_United_States\" title=\"Ranked-choice voting in the United States\" id=\"mwCPE\">ranked-choice voting</a>. The advancing candidates are Republicans former state Attorney General <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Treg_Taylor\" title=\"Treg Taylor\" id=\"mwCPI\">Treg Taylor</a>,<sup about=\"#mwt1471\" class=\"mw-ref reference\" id=\"cite_ref-TaylorAK_93-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"TaylorAK\"},\"body\":{\"id\":\"mw-reference-text-cite_note-TaylorAK-93\"}}'><a href=\"#cite_note-TaylorAK-93\" id=\"mwCPM\"><span class=\"mw-reflink-text\" id=\"mwCPQ\"><span class=\"cite-bracket\" id=\"mwCPU\">[</span>83<span class=\"cite-bracket\" id=\"mwCPY\">]</span></span></a></sup> businesswoman Bernadette Wilson;<sup about=\"#mwt1474\" class=\"mw-ref reference\" id=\"cite_ref-AKGOP_94-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"AKGOP\"},\"body\":{\"id\":\"mw-reference-text-cite_note-AKGOP-94\"}}'><a href=\"#cite_note-AKGOP-94\" id=\"mwCPc\"><span class=\"mw-reflink-text\" id=\"mwCPg\"><span class=\"cite-bracket\" id=\"mwCPk\">[</span>84<span class=\"cite-bracket\" id=\"mwCPo\">]</span></span></a></sup> former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Anchorage,_Alaska\" title=\"Anchorage, Alaska\" id=\"mwCPs\">Anchorage</a> mayor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Dave_Bronson\" title=\"Dave Bronson\" id=\"mwCPw\">Dave Bronson</a>;<sup about=\"#mwt1477\" class=\"mw-ref reference\" id=\"cite_ref-BronsonAK_95-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"BronsonAK\"},\"body\":{\"id\":\"mw-reference-text-cite_note-BronsonAK-95\"}}'><a href=\"#cite_note-BronsonAK-95\" id=\"mwCP0\"><span class=\"mw-reflink-text\" id=\"mwCP4\"><span class=\"cite-bracket\" id=\"mwCP8\">[</span>85<span class=\"cite-bracket\" id=\"mwCQA\">]</span></span></a></sup> and Democrat former state representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jonathan_Kreiss-Tomkins\" title=\"Jonathan Kreiss-Tomkins\" id=\"mwCQE\">Jonathan Kreiss-Tomkins</a>.<sup about=\"#mwt1480\" class=\"mw-ref reference\" id=\"cite_ref-Claman_96-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Claman\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Claman-96\"}}'><a href=\"#cite_note-Claman-96\" id=\"mwCQI\"><span class=\"mw-reflink-text\" id=\"mwCQM\"><span class=\"cite-bracket\" id=\"mwCQQ\">[</span>86<span class=\"cite-bracket\" id=\"mwCQU\">]</span></span></a></sup></p>\n\n<p id=\"mwCQY\">After initially finishing second in the primary, former state senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tom_Begich\" title=\"Tom Begich\" id=\"mwCQc\">Tom Begich</a> withdrew and endorsed Kreiss-Tomkins, allowing fifth-place finisher Taylor to advance to the general election.<sup about=\"#mwt1483\" class=\"mw-ref reference\" id=\"cite_ref-97\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-97\"}}'><a href=\"#cite_note-97\" id=\"mwCQg\"><span class=\"mw-reflink-text\" id=\"mwCQk\"><span class=\"cite-bracket\" id=\"mwCQo\">[</span>87<span class=\"cite-bracket\" id=\"mwCQs\">]</span></span></a></sup> However, the Alaska Public Offices Commission recommended against certifying Taylor's candidacy after finding that his financial disclosure did not substantially comply with state law.<sup about=\"#mwt1486\" class=\"mw-ref reference\" id=\"cite_ref-98\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-98\"}}'><a href=\"#cite_note-98\" id=\"mwCQw\"><span class=\"mw-reflink-text\" id=\"mwCQ0\"><span class=\"cite-bracket\" id=\"mwCQ4\">[</span>88<span class=\"cite-bracket\" id=\"mwCQ8\">]</span></span></a></sup> On August 31, <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lieutenant_Governor_of_Alaska\" title=\"Lieutenant Governor of Alaska\" id=\"mwCRA\">Lieutenant Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Nancy_Dahlstrom\" title=\"Nancy Dahlstrom\" id=\"mwCRE\">Nancy Dahlstrom</a> declined to certify Taylor, temporarily elevating his running mate, Candice English, to the gubernatorial nomination; English subsequently selected Taylor's wife, Jodi Taylor, as her running mate.<sup about=\"#mwt1489\" class=\"mw-ref reference\" id=\"cite_ref-Taylor_99-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Taylor\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Taylor-99\"}}'><a href=\"#cite_note-Taylor-99\" id=\"mwCRI\"><span class=\"mw-reflink-text\" id=\"mwCRM\"><span class=\"cite-bracket\" id=\"mwCRQ\">[</span>89<span class=\"cite-bracket\" id=\"mwCRU\">]</span></span></a></sup>  On September 4, Dahlstrom reversed her decision and announced that Taylor would be certified after a preliminary review by the Alaska Department of Law raised questions about whether the financial-disclosure requirements had been applied consistently.<sup about=\"#mwt1492\" class=\"mw-ref reference\" id=\"cite_ref-100\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-100\"}}'><a href=\"#cite_note-100\" id=\"mwCRY\"><span class=\"mw-reflink-text\" id=\"mwCRc\"><span class=\"cite-bracket\" id=\"mwCRg\">[</span>90<span class=\"cite-bracket\" id=\"mwCRk\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1493\" typeof=\"mw:Transclusion\" id=\"mwCRo\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"15\" id=\"mwCRs\" aria-labelledby=\"Arizona\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Arizona\">Arizona</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=15\" title=\"Edit section: Arizona\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1494\" typeof=\"mw:Transclusion\" id=\"mwCRw\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Arizona gubernatorial election\"},\"country\":{\"wt\":\"Arizona\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Arizona gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Arizona gubernatorial election\"},\"next_year\":{\"wt\":\"&apos;&apos;2030&apos;&apos;\"},\"image1\":{\"wt\":\"Katie Hobbs 2026.jpg\"},\"nominee1\":{\"wt\":\"[[Katie Hobbs]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Andy Biggs 2025.jpg\"},\"nominee2\":{\"wt\":\"[[Andy Biggs]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of Arizona|Governor]]\"},\"before_election\":{\"wt\":\"[[Katie Hobbs]]\"},\"before_party\":{\"wt\":\"Democratic Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"},\"running_mate2\":{\"wt\":\"[[Sine Kerr]]\"},\"running_mate1\":{\"wt\":\"[[John Giles (mayor)|John Giles]]\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1495\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1496\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1497\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1494\" id=\"mwCR0\"><caption class=\"infobox-title summary\">Arizona gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Arizona.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Flag_of_Arizona.svg/60px-Flag_of_Arizona.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Flag_of_Arizona.svg/120px-Flag_of_Arizona.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"900\" data-file-height=\"600\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Arizona_gubernatorial_election\" title=\"2022 Arizona gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2030</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Katie_Hobbs_2026.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Katie_Hobbs_2026.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Katie_Hobbs_2026.jpg/120px-Katie_Hobbs_2026.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/02/Katie_Hobbs_2026.jpg/250px-Katie_Hobbs_2026.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2037\" data-file-height=\"2714\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Andy_Biggs_2025.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Andy_Biggs_2025.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Andy_Biggs_2025.jpg/120px-Andy_Biggs_2025.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/d/da/Andy_Biggs_2025.jpg/250px-Andy_Biggs_2025.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1190\" data-file-height=\"1585\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Katie_Hobbs\" title=\"Katie Hobbs\">Katie Hobbs</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Andy_Biggs\" title=\"Andy Biggs\">Andy Biggs</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Running<span typeof=\"mw:Entity\"> </span>mate</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/John_Giles_(mayor)\" title=\"John Giles (mayor)\" class=\"mw-redirect\">John Giles</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sine_Kerr\" title=\"Sine Kerr\">Sine Kerr</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Arizona\" title=\"Governor of Arizona\" class=\"mw-redirect\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Katie_Hobbs\" title=\"Katie Hobbs\">Katie Hobbs</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1498\" typeof=\"mw:Transclusion\" id=\"mwCR4\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Ifexist not redirect\",\"href\":\"./Template:Ifexist_not_redirect\"},\"params\":{\"1\":{\"wt\":\"2026 Arizona gubernatorial election\"},\"2\":{\"wt\":\"{{Main|2026 Arizona gubernatorial election}}\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1499\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1498\" id=\"mwCR8\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Arizona_gubernatorial_election\" title=\"2026 Arizona gubernatorial election\">2026 Arizona gubernatorial election</a></div>\n<p id=\"mwCSA\">Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Katie_Hobbs\" title=\"Katie Hobbs\" id=\"mwCSE\">Katie Hobbs</a>, a Democrat, was elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Arizona_gubernatorial_election\" title=\"2022 Arizona gubernatorial election\" id=\"mwCSI\">2022</a> with 50.3% of the vote. Starting with this election cycle, gubernatorial candidates will be required to nominate a running mate for the newly established office of <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lieutenant_Governor_of_Arizona\" title=\"Lieutenant Governor of Arizona\" id=\"mwCSM\">Lieutenant Governor</a>. Hobbs is running for re-election to a second term<sup about=\"#mwt1502\" class=\"mw-ref reference\" id=\"cite_ref-Hobbs_101-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Hobbs\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Hobbs-101\"}}'><a href=\"#cite_note-Hobbs-101\" id=\"mwCSQ\"><span class=\"mw-reflink-text\" id=\"mwCSU\"><span class=\"cite-bracket\" id=\"mwCSY\">[</span>91<span class=\"cite-bracket\" id=\"mwCSc\">]</span></span></a></sup> and is the nominee, as no other candidates successfully filed for the Democratic primary.<sup about=\"#mwt1505\" class=\"mw-ref reference\" id=\"cite_ref-:1_102-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\":1\"},\"body\":{\"id\":\"mw-reference-text-cite_note-:1-102\"}}'><a href=\"#cite_note-:1-102\" id=\"mwCSg\"><span class=\"mw-reflink-text\" id=\"mwCSk\"><span class=\"cite-bracket\" id=\"mwCSo\">[</span>92<span class=\"cite-bracket\" id=\"mwCSs\">]</span></span></a></sup></p> \n\n<p id=\"mwCSw\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States_Representative\" title=\"United States Representative\" class=\"mw-redirect\" id=\"mwCS0\">U.S. Representative</a> from Arizona's 5th congressional district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Andy_Biggs\" title=\"Andy Biggs\" id=\"mwCS4\">Andy Biggs</a><sup about=\"#mwt1508\" class=\"mw-ref reference\" id=\"cite_ref-Biggs_103-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Biggs\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Biggs-103\"}}'><a href=\"#cite_note-Biggs-103\" id=\"mwCS8\"><span class=\"mw-reflink-text\" id=\"mwCTA\"><span class=\"cite-bracket\" id=\"mwCTE\">[</span>93<span class=\"cite-bracket\" id=\"mwCTI\">]</span></span></a></sup> defeated U.S. Representative from Arizona's 1st congressional district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/David_Schweikert\" title=\"David Schweikert\" id=\"mwCTM\">David Schweikert</a>,<sup about=\"#mwt1511\" class=\"mw-ref reference\" id=\"cite_ref-Schweikert_104-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Schweikert\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Schweikert-104\"}}'><a href=\"#cite_note-Schweikert-104\" id=\"mwCTQ\"><span class=\"mw-reflink-text\" id=\"mwCTU\"><span class=\"cite-bracket\" id=\"mwCTY\">[</span>94<span class=\"cite-bracket\" id=\"mwCTc\">]</span></span></a></sup> as well as business owner Ken Miceli<sup about=\"#mwt1512\" class=\"mw-ref reference\" id=\"cite_ref-:1_102-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\":1\"}}'><a href=\"#cite_note-:1-102\" id=\"mwCTg\"><span class=\"mw-reflink-text\" id=\"mwCTk\"><span class=\"cite-bracket\" id=\"mwCTo\">[</span>92<span class=\"cite-bracket\" id=\"mwCTs\">]</span></span></a></sup> and concrete plumbing contractor Scott Neely<sup about=\"#mwt1515\" class=\"mw-ref reference\" id=\"cite_ref-signals_105-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"signals\"},\"body\":{\"id\":\"mw-reference-text-cite_note-signals-105\"}}'><a href=\"#cite_note-signals-105\" id=\"mwCTw\"><span class=\"mw-reflink-text\" id=\"mwCT0\"><span class=\"cite-bracket\" id=\"mwCT4\">[</span>95<span class=\"cite-bracket\" id=\"mwCT8\">]</span></span></a></sup> with 74% of the vote in the Republican primary. </p>\n\n<p id=\"mwCUA\">Healthcare entrepreneur Hugh Lytle and Teri Hourihan are running in the No Labels/<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Arizona_Independent_Party\" title=\"Arizona Independent Party\" id=\"mwCUE\">Arizona Independent Party</a> primary. Former Democratic state representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Leezah_Sun\" title=\"Leezah Sun\" id=\"mwCUI\">Leezah Sun</a> has announced a campaign as an independent, but will not appear on the ballot.<sup about=\"#mwt1518\" class=\"mw-ref reference\" id=\"cite_ref-LeezahSun_106-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"LeezahSun\"},\"body\":{\"id\":\"mw-reference-text-cite_note-LeezahSun-106\"}}'><a href=\"#cite_note-LeezahSun-106\" id=\"mwCUM\"><span class=\"mw-reflink-text\" id=\"mwCUQ\"><span class=\"cite-bracket\" id=\"mwCUU\">[</span>96<span class=\"cite-bracket\" id=\"mwCUY\">]</span></span></a></sup><sup about=\"#mwt1521\" class=\"mw-ref reference\" id=\"cite_ref-107\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-107\"}}'><a href=\"#cite_note-107\" id=\"mwCUc\"><span class=\"mw-reflink-text\" id=\"mwCUg\"><span class=\"cite-bracket\" id=\"mwCUk\">[</span>97<span class=\"cite-bracket\" id=\"mwCUo\">]</span></span></a></sup></p>\n\n<p id=\"mwCUs\">This will be the first gubernatorial election in which a candidate is required to select a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Running_mate\" title=\"Running mate\" id=\"mwCUw\">running mate</a>, following the passage of Proposition 131 in the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Arizona_elections\" title=\"2022 Arizona elections\" id=\"mwCU0\">2022 elections</a>.<sup about=\"#mwt1524\" class=\"mw-ref reference\" id=\"cite_ref-108\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-108\"}}'><a href=\"#cite_note-108\" id=\"mwCU4\"><span class=\"mw-reflink-text\" id=\"mwCU8\"><span class=\"cite-bracket\" id=\"mwCVA\">[</span>98<span class=\"cite-bracket\" id=\"mwCVE\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1525\" typeof=\"mw:Transclusion\" id=\"mwCVI\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"16\" id=\"mwCVM\" aria-labelledby=\"Arkansas\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Arkansas\">Arkansas</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=16\" title=\"Edit section: Arkansas\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1526\" typeof=\"mw:Transclusion\" id=\"mwCVQ\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Arkansas gubernatorial election\"},\"country\":{\"wt\":\"Arkansas\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Arkansas gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Arkansas gubernatorial election\"},\"next_year\":{\"wt\":\"&apos;&apos;2030&apos;&apos;\"},\"image1\":{\"wt\":\"Governor Sarah Huckabee Sanders 2026.jpg\"},\"nominee1\":{\"wt\":\"[[Sarah Huckabee Sanders]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Rep Fredrick J Love (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Fredrick Love]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"image3\":{\"wt\":\"3x4.svg\"},\"nominee3\":{\"wt\":\"Colt Shelby\"},\"party3\":{\"wt\":\"Libertarian Party (United States)\"},\"popular_vote3\":{\"wt\":\"\"},\"percentage3\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"County results\"},\"title\":{\"wt\":\"[[Governor of Arkansas|Governor]]\"},\"before_election\":{\"wt\":\"{{nowrap|[[Sarah Huckabee Sanders]]}}\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1527\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1528\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1529\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1526\" id=\"mwCVU\"><caption class=\"infobox-title summary\">Arkansas gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Arkansas.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Flag_of_Arkansas.svg/60px-Flag_of_Arkansas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/9d/Flag_of_Arkansas.svg/120px-Flag_of_Arkansas.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"450\" data-file-height=\"300\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Arkansas_gubernatorial_election\" title=\"2022 Arkansas gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2030</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Governor_Sarah_Huckabee_Sanders_2026.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Governor_Sarah_Huckabee_Sanders_2026.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Governor_Sarah_Huckabee_Sanders_2026.jpg/120px-Governor_Sarah_Huckabee_Sanders_2026.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/Governor_Sarah_Huckabee_Sanders_2026.jpg/250px-Governor_Sarah_Huckabee_Sanders_2026.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2250\" data-file-height=\"2889\" data-file-type=\"bitmap\" height=\"150\" width=\"117\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Rep_Fredrick_J_Love_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Rep_Fredrick_J_Love_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/53/Rep_Fredrick_J_Love_%28cropped%29.jpg/120px-Rep_Fredrick_J_Love_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/5/53/Rep_Fredrick_J_Love_%28cropped%29.jpg/250px-Rep_Fredrick_J_Love_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"855\" data-file-height=\"1206\" data-file-type=\"bitmap\" height=\"150\" width=\"106\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #fed000;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:3x4.svg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:3x4.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/120px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/b/bd/3x4.svg/250px-3x4.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"3\" data-file-height=\"4\" data-file-type=\"drawing\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sarah_Huckabee_Sanders\" title=\"Sarah Huckabee Sanders\">Sarah Huckabee Sanders</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Fredrick_Love\" title=\"Fredrick Love\">Fredrick Love</a></td>\n<td style=\"width:75px;text-align:center\">Colt Shelby</td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\">Libertarian</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Arkansas\" title=\"Governor of Arkansas\">Governor</a></b><br/>\n<p><span class=\"nowrap\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sarah_Huckabee_Sanders\" title=\"Sarah Huckabee Sanders\">Sarah Huckabee Sanders</a></span><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1530\" typeof=\"mw:Transclusion\" id=\"mwCVY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Ifexist not redirect\",\"href\":\"./Template:Ifexist_not_redirect\"},\"params\":{\"1\":{\"wt\":\"2026 Arkansas gubernatorial election\"},\"2\":{\"wt\":\"{{Main|2026 Arkansas gubernatorial election}}\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1531\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1530\" id=\"mwCVc\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Arkansas_gubernatorial_election\" title=\"2026 Arkansas gubernatorial election\">2026 Arkansas gubernatorial election</a></div>\n<p id=\"mwCVg\">Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Sarah_Huckabee_Sanders\" title=\"Sarah Huckabee Sanders\" id=\"mwCVk\">Sarah Huckabee Sanders</a>, a Republican, was elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Arkansas_gubernatorial_election\" title=\"2022 Arkansas gubernatorial election\" id=\"mwCVo\">2022</a> with 63.1% of the vote. She is seeking re-election to a second term and ran unopposed for the Republican nomination.<sup about=\"#mwt1534\" class=\"mw-ref reference\" id=\"cite_ref-SHS2026_109-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"SHS2026\"},\"body\":{\"id\":\"mw-reference-text-cite_note-SHS2026-109\"}}'><a href=\"#cite_note-SHS2026-109\" id=\"mwCVs\"><span class=\"mw-reflink-text\" id=\"mwCVw\"><span class=\"cite-bracket\" id=\"mwCV0\">[</span>99<span class=\"cite-bracket\" id=\"mwCV4\">]</span></span></a></sup></p> \n\n<p id=\"mwCV8\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Arkansas_Senate\" title=\"Arkansas Senate\" id=\"mwCWA\">State senator</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Fredrick_Love\" title=\"Fredrick Love\" id=\"mwCWE\">Fredrick Love</a><sup about=\"#mwt1537\" class=\"mw-ref reference\" id=\"cite_ref-LoveAR_110-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"LoveAR\"},\"body\":{\"id\":\"mw-reference-text-cite_note-LoveAR-110\"}}'><a href=\"#cite_note-LoveAR-110\" id=\"mwCWI\"><span class=\"mw-reflink-text\" id=\"mwCWM\"><span class=\"cite-bracket\" id=\"mwCWQ\">[</span>100<span class=\"cite-bracket\" id=\"mwCWU\">]</span></span></a></sup> defeated former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Walmart\" title=\"Walmart\" id=\"mwCWY\">Walmart</a> executive Supha Xayprasith Mays<sup about=\"#mwt1540\" class=\"mw-ref reference\" id=\"cite_ref-111\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-111\"}}'><a href=\"#cite_note-111\" id=\"mwCWc\"><span class=\"mw-reflink-text\" id=\"mwCWg\"><span class=\"cite-bracket\" id=\"mwCWk\">[</span>101<span class=\"cite-bracket\" id=\"mwCWo\">]</span></span></a></sup> in the Democratic primary on March 3, 2026.<sup about=\"#mwt1543\" class=\"mw-ref reference\" id=\"cite_ref-112\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-112\"}}'><a href=\"#cite_note-112\" id=\"mwCWs\"><span class=\"mw-reflink-text\" id=\"mwCWw\"><span class=\"cite-bracket\" id=\"mwCW0\">[</span>102<span class=\"cite-bracket\" id=\"mwCW4\">]</span></span></a></sup></p>\n\n<p id=\"mwCW8\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Farmer\" title=\"Farmer\" id=\"mwCXA\">Farmer</a> Colt Shelby is running in the general election as a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Libertarian_Party_(United_States)\" title=\"Libertarian Party (United States)\" id=\"mwCXE\">Libertarian</a>.<sup about=\"#mwt1546\" class=\"mw-ref reference\" id=\"cite_ref-113\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-113\"}}'><a href=\"#cite_note-113\" id=\"mwCXI\"><span class=\"mw-reflink-text\" id=\"mwCXM\"><span class=\"cite-bracket\" id=\"mwCXQ\">[</span>103<span class=\"cite-bracket\" id=\"mwCXU\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1547\" typeof=\"mw:Transclusion\" id=\"mwCXY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"17\" id=\"mwCXc\" aria-labelledby=\"California\"><div class=\"mw-heading mw-heading2\"><h2 id=\"California\">California</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=17\" title=\"Edit section: California\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1548\" typeof=\"mw:Transclusion\" id=\"mwCXg\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"California gubernatorial election\"},\"country\":{\"wt\":\"California\"},\"type\":{\"wt\":\"presidential\"},\"previous_election\":{\"wt\":\"2022 California gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 California gubernatorial election\"},\"next_year\":{\"wt\":\"2030\"},\"ongoing\":{\"wt\":\"yes &lt;!-- Ongoing until the general election in November -->\"},\"image1\":{\"wt\":\"HHS Xavier Becerra (cropped1).jpg\"},\"candidate1\":{\"wt\":\"[[Xavier Becerra]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Steve Hilton (54233445987 crop).jpg\"},\"candidate2\":{\"wt\":\"[[Steve Hilton]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of California|Governor]]\"},\"before_election\":{\"wt\":\"[[Gavin Newsom]]\"},\"before_party\":{\"wt\":\"Democratic Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1549\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1550\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1551\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1548\" id=\"mwCXk\"><caption class=\"infobox-title summary\">California gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_California.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Flag_of_California.svg/60px-Flag_of_California.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/01/Flag_of_California.svg/120px-Flag_of_California.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"900\" data-file-height=\"600\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_California_gubernatorial_election\" title=\"2022 California gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\">2030<span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:HHS_Xavier_Becerra_(cropped1).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:HHS_Xavier_Becerra_(cropped1).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/01/HHS_Xavier_Becerra_%28cropped1%29.jpg/120px-HHS_Xavier_Becerra_%28cropped1%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/01/HHS_Xavier_Becerra_%28cropped1%29.jpg/250px-HHS_Xavier_Becerra_%28cropped1%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1350\" data-file-height=\"1800\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Steve_Hilton_(54233445987_crop).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Steve_Hilton_(54233445987_crop).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Steve_Hilton_%2854233445987_crop%29.jpg/120px-Steve_Hilton_%2854233445987_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Steve_Hilton_%2854233445987_crop%29.jpg/250px-Steve_Hilton_%2854233445987_crop%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2645\" data-file-height=\"3467\" data-file-type=\"bitmap\" height=\"150\" width=\"114\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Candidate</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Xavier_Becerra\" title=\"Xavier Becerra\">Xavier Becerra</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Steve_Hilton\" title=\"Steve Hilton\">Steve Hilton</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_California\" title=\"Governor of California\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Gavin_Newsom\" title=\"Gavin Newsom\">Gavin Newsom</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1552\" typeof=\"mw:Transclusion\" id=\"mwCXo\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 California gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1553\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1552\" id=\"mwCXs\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_California_gubernatorial_election\" title=\"2026 California gubernatorial election\">2026 California gubernatorial election</a></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1554\" typeof=\"mw:Transclusion\" id=\"mwCXw\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"2026 California lieutenant gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1555\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1554\" id=\"mwCX0\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_California_lieutenant_gubernatorial_election\" title=\"2026 California lieutenant gubernatorial election\">2026 California lieutenant gubernatorial election</a></div>\n<p id=\"mwCX4\">Democratic Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Gavin_Newsom\" title=\"Gavin Newsom\" id=\"mwCX8\">Gavin Newsom</a> was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_California_gubernatorial_election\" title=\"2022 California gubernatorial election\" id=\"mwCYA\">2022</a> with 59.2% of the vote. He is term-limited by the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_of_California\" title=\"Constitution of California\" id=\"mwCYE\">California Constitution</a> in 2026, and cannot seek re-election to a third term. More than sixty candidates appeared on the June 2026 primary ballot. Democrat <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Xavier_Becerra\" title=\"Xavier Becerra\" id=\"mwCYI\">Xavier Becerra</a>,<sup about=\"#mwt1558\" class=\"mw-ref reference\" id=\"cite_ref-beccera_114-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"beccera\"},\"body\":{\"id\":\"mw-reference-text-cite_note-beccera-114\"}}'><a href=\"#cite_note-beccera-114\" id=\"mwCYM\"><span class=\"mw-reflink-text\" id=\"mwCYQ\"><span class=\"cite-bracket\" id=\"mwCYU\">[</span>104<span class=\"cite-bracket\" id=\"mwCYY\">]</span></span></a></sup> former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Secretary_of_Health_and_Human_Services\" title=\"U.S. Secretary of Health and Human Services\" class=\"mw-redirect\" id=\"mwCYc\">U.S. Secretary of Health and Human Services</a> and former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/California_Attorney_General\" title=\"California Attorney General\" id=\"mwCYg\">California Attorney General</a>, and Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Pundit\" title=\"Pundit\" id=\"mwCYk\">political commentator</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Steve_Hilton\" title=\"Steve Hilton\" id=\"mwCYo\">Steve Hilton</a><sup about=\"#mwt1561\" class=\"mw-ref reference\" id=\"cite_ref-HiltonCA_115-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"HiltonCA\"},\"body\":{\"id\":\"mw-reference-text-cite_note-HiltonCA-115\"}}'><a href=\"#cite_note-HiltonCA-115\" id=\"mwCYs\"><span class=\"mw-reflink-text\" id=\"mwCYw\"><span class=\"cite-bracket\" id=\"mwCY0\">[</span>105<span class=\"cite-bracket\" id=\"mwCY4\">]</span></span></a></sup> advanced to the general election.<sup about=\"#mwt1564\" class=\"mw-ref reference\" id=\"cite_ref-:02_116-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\":02\"},\"body\":{\"id\":\"mw-reference-text-cite_note-:02-116\"}}'><a href=\"#cite_note-:02-116\" id=\"mwCY8\"><span class=\"mw-reflink-text\" id=\"mwCZA\"><span class=\"cite-bracket\" id=\"mwCZE\">[</span>106<span class=\"cite-bracket\" id=\"mwCZI\">]</span></span></a></sup></p> \n\n<p id=\"mwCZM\">Other Democratic candidates included <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/San_Jose,_California\" title=\"San Jose, California\" id=\"mwCZQ\">San Jose</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mayor_of_San_Jose,_California\" title=\"Mayor of San Jose, California\" id=\"mwCZU\">mayor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Matt_Mahan\" title=\"Matt Mahan\" id=\"mwCZY\">Matt Mahan</a>;<sup about=\"#mwt1567\" class=\"mw-ref reference\" id=\"cite_ref-Mahan_117-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Mahan\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Mahan-117\"}}'><a href=\"#cite_note-Mahan-117\" id=\"mwCZc\"><span class=\"mw-reflink-text\" id=\"mwCZg\"><span class=\"cite-bracket\" id=\"mwCZk\">[</span>107<span class=\"cite-bracket\" id=\"mwCZo\">]</span></span></a></sup> former congresswoman for California's 47th congressional district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Katie_Porter\" title=\"Katie Porter\" id=\"mwCZs\">Katie Porter</a>;<sup about=\"#mwt1570\" class=\"mw-ref reference\" id=\"cite_ref-porterCA_118-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"porterCA\"},\"body\":{\"id\":\"mw-reference-text-cite_note-porterCA-118\"}}'><a href=\"#cite_note-porterCA-118\" id=\"mwCZw\"><span class=\"mw-reflink-text\" id=\"mwCZ0\"><span class=\"cite-bracket\" id=\"mwCZ4\">[</span>108<span class=\"cite-bracket\" id=\"mwCZ8\">]</span></span></a></sup> businessman and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2020_United_States_presidential_election\" title=\"2020 United States presidential election\" id=\"mwCaA\">2020</a> presidential candidate <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tom_Steyer\" title=\"Tom Steyer\" id=\"mwCaE\">Tom Steyer</a>;<sup about=\"#mwt1573\" class=\"mw-ref reference\" id=\"cite_ref-steyer_119-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"steyer\"},\"body\":{\"id\":\"mw-reference-text-cite_note-steyer-119\"}}'><a href=\"#cite_note-steyer-119\" id=\"mwCaI\"><span class=\"mw-reflink-text\" id=\"mwCaM\"><span class=\"cite-bracket\" id=\"mwCaQ\">[</span>109<span class=\"cite-bracket\" id=\"mwCaU\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/California_State_Superintendent_of_Public_Instruction\" title=\"California State Superintendent of Public Instruction\" id=\"mwCaY\">State Superintendent of Public Instruction</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Tony_Thurmond\" title=\"Tony Thurmond\" id=\"mwCac\">Tony Thurmond</a>;<sup about=\"#mwt1576\" class=\"mw-ref reference\" id=\"cite_ref-thurmondca_120-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"thurmondca\"},\"body\":{\"id\":\"mw-reference-text-cite_note-thurmondca-120\"}}'><a href=\"#cite_note-thurmondca-120\" id=\"mwCag\"><span class=\"mw-reflink-text\" id=\"mwCak\"><span class=\"cite-bracket\" id=\"mwCao\">[</span>110<span class=\"cite-bracket\" id=\"mwCas\">]</span></span></a></sup> and former Los Angeles Mayor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Antonio_Villaraigosa\" title=\"Antonio Villaraigosa\" id=\"mwCaw\">Antonio Villaraigosa</a>.<sup about=\"#mwt1579\" class=\"mw-ref reference\" id=\"cite_ref-avca_121-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"avca\"},\"body\":{\"id\":\"mw-reference-text-cite_note-avca-121\"}}'><a href=\"#cite_note-avca-121\" id=\"mwCa0\"><span class=\"mw-reflink-text\" id=\"mwCa4\"><span class=\"cite-bracket\" id=\"mwCa8\">[</span>111<span class=\"cite-bracket\" id=\"mwCbA\">]</span></span></a></sup></p>\n\n<p id=\"mwCbE\">U.S. representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Eric_Swalwell\" title=\"Eric Swalwell\" id=\"mwCbI\">Eric Swalwell</a> initially announced a campaign in November 2025, but withdrew and resigned from Congress in April 2026 amid sexual assault allegations, with his name still on the ballot.<sup about=\"#mwt1582\" class=\"mw-ref reference\" id=\"cite_ref-swalwellca_122-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"swalwellca\"},\"body\":{\"id\":\"mw-reference-text-cite_note-swalwellca-122\"}}'><a href=\"#cite_note-swalwellca-122\" id=\"mwCbM\"><span class=\"mw-reflink-text\" id=\"mwCbQ\"><span class=\"cite-bracket\" id=\"mwCbU\">[</span>112<span class=\"cite-bracket\" id=\"mwCbY\">]</span></span></a></sup><sup about=\"#mwt1585\" class=\"mw-ref reference\" id=\"cite_ref-123\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-123\"}}'><a href=\"#cite_note-123\" id=\"mwCbc\"><span class=\"mw-reflink-text\" id=\"mwCbg\"><span class=\"cite-bracket\" id=\"mwCbk\">[</span>113<span class=\"cite-bracket\" id=\"mwCbo\">]</span></span></a></sup> Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/California_State_Controller\" title=\"California State Controller\" id=\"mwCbs\">state Controller</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Betty_Yee\" title=\"Betty Yee\" id=\"mwCbw\">Betty Yee</a> also withdrew from the race in April 2026 and will remain on the ballot.<sup about=\"#mwt1588\" class=\"mw-ref reference\" id=\"cite_ref-Yee_124-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Yee\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Yee-124\"}}'><a href=\"#cite_note-Yee-124\" id=\"mwCb0\"><span class=\"mw-reflink-text\" id=\"mwCb4\"><span class=\"cite-bracket\" id=\"mwCb8\">[</span>114<span class=\"cite-bracket\" id=\"mwCcA\">]</span></span></a></sup><sup about=\"#mwt1591\" class=\"mw-ref reference\" id=\"cite_ref-125\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-125\"}}'><a href=\"#cite_note-125\" id=\"mwCcE\"><span class=\"mw-reflink-text\" id=\"mwCcI\"><span class=\"cite-bracket\" id=\"mwCcM\">[</span>115<span class=\"cite-bracket\" id=\"mwCcQ\">]</span></span></a></sup></p>\n\n<p id=\"mwCcU\">Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Vice_President_of_the_United_States\" title=\"Vice President of the United States\" id=\"mwCcY\">Vice President</a> of the United States and <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_presidential_election\" title=\"2024 United States presidential election\" id=\"mwCcc\">2024</a> Democratic nominee for President <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Kamala_Harris\" title=\"Kamala Harris\" id=\"mwCcg\">Kamala Harris</a> had considered running,<sup about=\"#mwt1594\" class=\"mw-ref reference\" id=\"cite_ref-126\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-126\"}}'><a href=\"#cite_note-126\" id=\"mwCck\"><span class=\"mw-reflink-text\" id=\"mwCco\"><span class=\"cite-bracket\" id=\"mwCcs\">[</span>116<span class=\"cite-bracket\" id=\"mwCcw\">]</span></span></a></sup> but ultimately decided not to enter the race.<sup about=\"#mwt1597\" class=\"mw-ref reference\" id=\"cite_ref-127\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-127\"}}'><a href=\"#cite_note-127\" id=\"mwCc0\"><span class=\"mw-reflink-text\" id=\"mwCc4\"><span class=\"cite-bracket\" id=\"mwCc8\">[</span>117<span class=\"cite-bracket\" id=\"mwCdA\">]</span></span></a></sup></p>\n\n<p id=\"mwCdE\">Other Republican candidates included <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Riverside_County,_California\" title=\"Riverside County, California\" id=\"mwCdI\">Riverside County</a> Sheriff <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Chad_Bianco\" title=\"Chad Bianco\" id=\"mwCdM\">Chad Bianco</a>,<sup about=\"#mwt1600\" class=\"mw-ref reference\" id=\"cite_ref-Bianco_128-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Bianco\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Bianco-128\"}}'><a href=\"#cite_note-Bianco-128\" id=\"mwCdQ\"><span class=\"mw-reflink-text\" id=\"mwCdU\"><span class=\"cite-bracket\" id=\"mwCdY\">[</span>118<span class=\"cite-bracket\" id=\"mwCdc\">]</span></span></a></sup> diplomat Tim Nelson and businessman Leo Zacky.<sup about=\"#mwt1603\" class=\"mw-ref reference\" id=\"cite_ref-129\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-129\"}}'><a href=\"#cite_note-129\" id=\"mwCdg\"><span class=\"mw-reflink-text\" id=\"mwCdk\"><span class=\"cite-bracket\" id=\"mwCdo\">[</span>119<span class=\"cite-bracket\" id=\"mwCds\">]</span></span></a></sup></p>\n\n<p id=\"mwCdw\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Butch_Ware\" title=\"Butch Ware\" id=\"mwCd0\">Butch Ware</a>, the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Green_Party_of_the_United_States\" title=\"Green Party of the United States\" id=\"mwCd4\">Green Party</a>'s <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2024_United_States_presidential_election\" title=\"2024 United States presidential election\" id=\"mwCd8\">2024</a> vice presidential nominee, announced his candidacy but did not meet the requirements to appear on the primary ballot and instead ran as a <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Write-in_candidate\" title=\"Write-in candidate\" id=\"mwCeA\">write-in candidate</a>.<sup about=\"#mwt1606\" class=\"mw-ref reference\" id=\"cite_ref-Ware_130-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Ware\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Ware-130\"}}'><a href=\"#cite_note-Ware-130\" id=\"mwCeE\"><span class=\"mw-reflink-text\" id=\"mwCeI\"><span class=\"cite-bracket\" id=\"mwCeM\">[</span>120<span class=\"cite-bracket\" id=\"mwCeQ\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1607\" typeof=\"mw:Transclusion\" id=\"mwCeU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"18\" id=\"mwCeY\" aria-labelledby=\"Colorado\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Colorado\">Colorado</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=18\" title=\"Edit section: Colorado\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1608\" typeof=\"mw:Transclusion\" id=\"mwCec\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Colorado gubernatorial election\"},\"country\":{\"wt\":\"Colorado\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Colorado gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Colorado gubernatorial election\"},\"next_year\":{\"wt\":\"&apos;&apos;2030&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"image1\":{\"wt\":\"AG Phil Weiser.jpg\"},\"nominee1\":{\"wt\":\"[[Phil Weiser]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"running_mate1\":{\"wt\":\"Lesley Dahlkemper\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Victor Marx (52125665777) (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Victor Marx]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"running_mate2\":{\"wt\":\"George Markert\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of Colorado|Governor]]\"},\"before_election\":{\"wt\":\"[[Jared Polis]]\"},\"before_party\":{\"wt\":\"Democratic Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1609\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1610\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1611\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1608\" id=\"mwCeg\"><caption class=\"infobox-title summary\">Colorado gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Colorado.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Flag_of_Colorado.svg/60px-Flag_of_Colorado.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/46/Flag_of_Colorado.svg/120px-Flag_of_Colorado.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"1800\" data-file-height=\"1200\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Colorado_gubernatorial_election\" title=\"2022 Colorado gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2030</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:AG_Phil_Weiser.jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:AG_Phil_Weiser.jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/AG_Phil_Weiser.jpg/120px-AG_Phil_Weiser.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/6c/AG_Phil_Weiser.jpg/250px-AG_Phil_Weiser.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"942\" data-file-height=\"1234\" data-file-type=\"bitmap\" height=\"136\" width=\"104\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Victor_Marx_(52125665777)_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Victor_Marx_(52125665777)_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Victor_Marx_%2852125665777%29_%28cropped%29.jpg/120px-Victor_Marx_%2852125665777%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/7/79/Victor_Marx_%2852125665777%29_%28cropped%29.jpg/250px-Victor_Marx_%2852125665777%29_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1145\" data-file-height=\"1514\" data-file-type=\"bitmap\" height=\"136\" width=\"103\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Phil_Weiser\" title=\"Phil Weiser\">Phil Weiser</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Victor_Marx\" title=\"Victor Marx\">Victor Marx</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Running<span typeof=\"mw:Entity\"> </span>mate</th>\n<td style=\"width:75px;text-align:center\">Lesley Dahlkemper</td>\n<td style=\"width:75px;text-align:center\">George Markert</td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Colorado\" title=\"Governor of Colorado\" class=\"mw-redirect\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jared_Polis\" title=\"Jared Polis\">Jared Polis</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1612\" typeof=\"mw:Transclusion\" id=\"mwCek\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 Colorado gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1613\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1612\" id=\"mwCeo\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Colorado_gubernatorial_election\" title=\"2026 Colorado gubernatorial election\">2026 Colorado gubernatorial election</a></div>\n\n<p id=\"mwCes\">Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jared_Polis\" title=\"Jared Polis\" id=\"mwCew\">Jared Polis</a>, a Democrat, was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Colorado_gubernatorial_election\" title=\"2022 Colorado gubernatorial election\" id=\"mwCe0\">2022</a> with 58.5% of the vote. He will be term-limited by the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Colorado_Constitution\" title=\"Colorado Constitution\" class=\"mw-redirect\" id=\"mwCe4\">Colorado Constitution</a> in 2026 and cannot seek re-election to a third consecutive term. </p>\n\n<p id=\"mwCe8\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Attorney_General_of_Colorado\" title=\"Attorney General of Colorado\" class=\"mw-redirect\" id=\"mwCfA\">State Attorney General</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Phil_Weiser\" title=\"Phil Weiser\" id=\"mwCfE\">Phil Weiser</a><sup about=\"#mwt1616\" class=\"mw-ref reference\" id=\"cite_ref-Weiser_131-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Weiser\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Weiser-131\"}}'><a href=\"#cite_note-Weiser-131\" id=\"mwCfI\"><span class=\"mw-reflink-text\" id=\"mwCfM\"><span class=\"cite-bracket\" id=\"mwCfQ\">[</span>121<span class=\"cite-bracket\" id=\"mwCfU\">]</span></span></a></sup> defeated <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/United_States_Senate\" title=\"United States Senate\" id=\"mwCfY\">U.S. Senator</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Michael_Bennet\" title=\"Michael Bennet\" id=\"mwCfc\">Michael Bennet</a><sup about=\"#mwt1619\" class=\"mw-ref reference\" id=\"cite_ref-Bennet_Announcement_132-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Bennet Announcement\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Bennet_Announcement-132\"}}'><a href=\"#cite_note-Bennet_Announcement-132\" id=\"mwCfg\"><span class=\"mw-reflink-text\" id=\"mwCfk\"><span class=\"cite-bracket\" id=\"mwCfo\">[</span>122<span class=\"cite-bracket\" id=\"mwCfs\">]</span></span></a></sup> for the Democratic nomination. </p>\n\n<p id=\"mwCfw\">On the Republican side, ministry leader <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Victor_Marx\" title=\"Victor Marx\" id=\"mwCf0\">Victor Marx</a> defeated state representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Scott_Bottoms\" title=\"Scott Bottoms\" id=\"mwCf4\">Scott Bottoms</a> and state senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Barbara_Kirkmeyer\" title=\"Barbara Kirkmeyer\" id=\"mwCf8\">Barbara Kirkmeyer</a> for the nomination.<sup about=\"#mwt1622\" class=\"mw-ref reference\" id=\"cite_ref-BottomsCO_133-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"BottomsCO\"},\"body\":{\"id\":\"mw-reference-text-cite_note-BottomsCO-133\"}}'><a href=\"#cite_note-BottomsCO-133\" id=\"mwCgA\"><span class=\"mw-reflink-text\" id=\"mwCgE\"><span class=\"cite-bracket\" id=\"mwCgI\">[</span>123<span class=\"cite-bracket\" id=\"mwCgM\">]</span></span></a></sup><sup about=\"#mwt1625\" class=\"mw-ref reference\" id=\"cite_ref-KirkmeyerCO_134-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"KirkmeyerCO\"},\"body\":{\"id\":\"mw-reference-text-cite_note-KirkmeyerCO-134\"}}'><a href=\"#cite_note-KirkmeyerCO-134\" id=\"mwCgQ\"><span class=\"mw-reflink-text\" id=\"mwCgU\"><span class=\"cite-bracket\" id=\"mwCgY\">[</span>124<span class=\"cite-bracket\" id=\"mwCgc\">]</span></span></a></sup></p>\n\n<p id=\"mwCgg\">Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._Representative\" title=\"U.S. Representative\" class=\"mw-redirect\" id=\"mwCgk\">U.S. Representative</a> for Colorado's 4th congressional district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Greg_Lopez\" title=\"Greg Lopez\" id=\"mwCgo\">Greg Lopez</a> initially announced his campaign as a Republican but later left the party in January 2026 and is continuing his campaign as an independent.<sup about=\"#mwt1628\" class=\"mw-ref reference\" id=\"cite_ref-LopezCO_135-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"LopezCO\"},\"body\":{\"id\":\"mw-reference-text-cite_note-LopezCO-135\"}}'><a href=\"#cite_note-LopezCO-135\" id=\"mwCgs\"><span class=\"mw-reflink-text\" id=\"mwCgw\"><span class=\"cite-bracket\" id=\"mwCg0\">[</span>125<span class=\"cite-bracket\" id=\"mwCg4\">]</span></span></a></sup><sup about=\"#mwt1631\" class=\"mw-ref reference\" id=\"cite_ref-LopezInd_26-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"LopezInd\"},\"body\":{\"id\":\"mw-reference-text-cite_note-LopezInd-26\"}}'><a href=\"#cite_note-LopezInd-26\" id=\"mwCg8\"><span class=\"mw-reflink-text\" id=\"mwChA\"><span class=\"cite-bracket\" id=\"mwChE\">[</span>23<span class=\"cite-bracket\" id=\"mwChI\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1632\" typeof=\"mw:Transclusion\" id=\"mwChM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"19\" id=\"mwChQ\" aria-labelledby=\"Connecticut\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Connecticut\">Connecticut</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=19\" title=\"Edit section: Connecticut\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1633\" typeof=\"mw:Transclusion\" id=\"mwChU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Connecticut gubernatorial election\"},\"country\":{\"wt\":\"Connecticut\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Connecticut gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Connecticut gubernatorial election\"},\"next_year\":{\"wt\":\"&apos;&apos;2030&apos;&apos;\"},\"image_size\":{\"wt\":\"125x136px\"},\"image1\":{\"wt\":\"File:Governor Ned Lamont of Connecticut, official portrait (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Ned Lamont]]\"},\"party1\":{\"wt\":\"Democratic Party (United States)\"},\"running_mate1\":{\"wt\":\"[[Susan Bysiewicz]]\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Ryan Fazio, 2026 (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Ryan Fazio]]\"},\"party2\":{\"wt\":\"Republican Party (United States)\"},\"running_mate2\":{\"wt\":\"Matthew Corey\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of Connecticut|Governor]]\"},\"before_election\":{\"wt\":\"[[Ned Lamont]]\"},\"before_party\":{\"wt\":\"Democratic Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1634\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1635\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1636\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1633\" id=\"mwChY\"><caption class=\"infobox-title summary\">Connecticut gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Connecticut.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Flag_of_Connecticut.svg/60px-Flag_of_Connecticut.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/9/96/Flag_of_Connecticut.svg/120px-Flag_of_Connecticut.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"330\" data-file-height=\"260\" data-file-type=\"drawing\" height=\"39\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Connecticut_gubernatorial_election\" title=\"2022 Connecticut gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2030</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Governor_Ned_Lamont_of_Connecticut,_official_portrait_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Governor_Ned_Lamont_of_Connecticut,_official_portrait_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Governor_Ned_Lamont_of_Connecticut%2C_official_portrait_%28cropped%29.jpg/120px-Governor_Ned_Lamont_of_Connecticut%2C_official_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/1c/Governor_Ned_Lamont_of_Connecticut%2C_official_portrait_%28cropped%29.jpg/250px-Governor_Ned_Lamont_of_Connecticut%2C_official_portrait_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"985\" data-file-height=\"1341\" data-file-type=\"bitmap\" height=\"136\" width=\"100\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Ryan_Fazio,_2026_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Ryan_Fazio,_2026_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Ryan_Fazio%2C_2026_%28cropped%29.jpg/120px-Ryan_Fazio%2C_2026_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/1/13/Ryan_Fazio%2C_2026_%28cropped%29.jpg/250px-Ryan_Fazio%2C_2026_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2814\" data-file-height=\"3754\" data-file-type=\"bitmap\" height=\"136\" width=\"102\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ned_Lamont\" title=\"Ned Lamont\">Ned Lamont</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ryan_Fazio\" title=\"Ryan Fazio\">Ryan Fazio</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Running<span typeof=\"mw:Entity\"> </span>mate</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Susan_Bysiewicz\" title=\"Susan Bysiewicz\">Susan Bysiewicz</a></td>\n<td style=\"width:75px;text-align:center\">Matthew Corey</td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Connecticut\" title=\"Governor of Connecticut\" class=\"mw-redirect\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ned_Lamont\" title=\"Ned Lamont\">Ned Lamont</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1637\" typeof=\"mw:Transclusion\" id=\"mwChc\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Main\",\"href\":\"./Template:Main\"},\"params\":{\"1\":{\"wt\":\"2026 Connecticut gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1638\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1637\" id=\"mwChg\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Connecticut_gubernatorial_election\" title=\"2026 Connecticut gubernatorial election\">2026 Connecticut gubernatorial election</a></div>\n\n<p id=\"mwChk\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_governors_of_Connecticut\" title=\"List of governors of Connecticut\" id=\"mwCho\">Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ned_Lamont\" title=\"Ned Lamont\" id=\"mwChs\">Ned Lamont</a>, a Democrat, was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Connecticut_gubernatorial_election\" title=\"2022 Connecticut gubernatorial election\" id=\"mwChw\">2022</a> with 56% of the vote. Because <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Connecticut\" title=\"Connecticut\" id=\"mwCh0\">Connecticut</a> does not have gubernatorial term limits in its <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_of_Connecticut\" title=\"Constitution of Connecticut\" id=\"mwCh4\">Constitution</a>, Lamont has announced that he is running for a third term.<sup about=\"#mwt1641\" class=\"mw-ref reference\" id=\"cite_ref-Lamont_29-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Lamont\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Lamont-29\"}}'><a href=\"#cite_note-Lamont-29\" id=\"mwCh8\"><span class=\"mw-reflink-text\" id=\"mwCiA\"><span class=\"cite-bracket\" id=\"mwCiE\">[</span>26<span class=\"cite-bracket\" id=\"mwCiI\">]</span></span></a></sup> Lamont fended off a primary challenge from <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Connecticut_House_of_Representatives\" title=\"Connecticut House of Representatives\" id=\"mwCiM\">State representative</a> for the 88th district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Josh_Elliott_(politician)\" title=\"Josh Elliott (politician)\" id=\"mwCiQ\">Josh Elliott</a>.<sup about=\"#mwt1644\" class=\"mw-ref reference\" id=\"cite_ref-Pazniokas_136-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Pazniokas\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Pazniokas-136\"}}'><a href=\"#cite_note-Pazniokas-136\" id=\"mwCiU\"><span class=\"mw-reflink-text\" id=\"mwCiY\"><span class=\"cite-bracket\" id=\"mwCic\">[</span>126<span class=\"cite-bracket\" id=\"mwCig\">]</span></span></a></sup></p>\n\n<p id=\"mwCik\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Connecticut_State_Senate\" title=\"Connecticut State Senate\" id=\"mwCio\">State senator</a> for the 36th district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ryan_Fazio\" title=\"Ryan Fazio\" id=\"mwCis\">Ryan Fazio</a> is the Republican nominee.<sup about=\"#mwt1647\" class=\"mw-ref reference\" id=\"cite_ref-Fazio_28-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Fazio\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Fazio-28\"}}'><a href=\"#cite_note-Fazio-28\" id=\"mwCiw\"><span class=\"mw-reflink-text\" id=\"mwCi0\"><span class=\"cite-bracket\" id=\"mwCi4\">[</span>25<span class=\"cite-bracket\" id=\"mwCi8\">]</span></span></a></sup> Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lieutenant_governor_of_New_York\" title=\"Lieutenant governor of New York\" class=\"mw-redirect\" id=\"mwCjA\">lieutenant governor of New York</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Betsy_McCaughey\" title=\"Betsy McCaughey\" id=\"mwCjE\">Betsy McCaughey</a><sup about=\"#mwt1650\" class=\"mw-ref reference\" id=\"cite_ref-137\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-137\"}}'><a href=\"#cite_note-137\" id=\"mwCjI\"><span class=\"mw-reflink-text\" id=\"mwCjM\"><span class=\"cite-bracket\" id=\"mwCjQ\">[</span>127<span class=\"cite-bracket\" id=\"mwCjU\">]</span></span></a></sup>initially announced her candidacy for the Republican nomination in March 2026 but withdrew after not receiving 15% of the convention vote in May. New Britain mayor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Erin_Stewart\" title=\"Erin Stewart\" id=\"mwCjY\">Erin Stewart</a> initially ran but dropped out of the race in May 2026, after allegations of misconduct during her tenure as mayor.<sup about=\"#mwt1653\" class=\"mw-ref reference\" id=\"cite_ref-StewartCT_138-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"StewartCT\"},\"body\":{\"id\":\"mw-reference-text-cite_note-StewartCT-138\"}}'><a href=\"#cite_note-StewartCT-138\" id=\"mwCjc\"><span class=\"mw-reflink-text\" id=\"mwCjg\"><span class=\"cite-bracket\" id=\"mwCjk\">[</span>128<span class=\"cite-bracket\" id=\"mwCjo\">]</span></span></a></sup><sup about=\"#mwt1656\" class=\"mw-ref reference\" id=\"cite_ref-139\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-139\"}}'><a href=\"#cite_note-139\" id=\"mwCjs\"><span class=\"mw-reflink-text\" id=\"mwCjw\"><span class=\"cite-bracket\" id=\"mwCj0\">[</span>129<span class=\"cite-bracket\" id=\"mwCj4\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1657\" typeof=\"mw:Transclusion\" id=\"mwCj8\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"20\" id=\"mwCkA\" aria-labelledby=\"Florida\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Florida\">Florida</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=20\" title=\"Edit section: Florida\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1658\" typeof=\"mw:Transclusion\" id=\"mwCkE\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Florida gubernatorial election\"},\"country\":{\"wt\":\"Florida\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Florida gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Florida gubernatorial election\"},\"next_year\":{\"wt\":\"&apos;&apos;2030&apos;&apos;\"},\"election_date\":{\"wt\":\"&lt;!--Don&apos;t need election date in section infoboxes when the date is the same as in the article&apos;s main infobox.-->\"},\"image_size\":{\"wt\":\"125x136px\"},\"turnout\":{\"wt\":\"\"},\"image1\":{\"wt\":\"Byron Donalds 2023 (cropped).jpg\"},\"nominee1\":{\"wt\":\"[[Byron Donalds]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"running_mate1\":{\"wt\":\"[[Bryan Avila]]\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"File:David Jolly (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[David Jolly]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"running_mate2\":{\"wt\":\"[[Gwen Graham]]\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"map_image\":{\"wt\":\"\"},\"map_size\":{\"wt\":\"\"},\"map_caption\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of Florida|Governor]]\"},\"before_election\":{\"wt\":\"[[Ron DeSantis]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1659\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1660\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1661\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1658\" id=\"mwCkI\"><caption class=\"infobox-title summary\">Florida gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Florida.svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Florida.svg/60px-Flag_of_Florida.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/f/f7/Flag_of_Florida.svg/120px-Flag_of_Florida.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"4500\" data-file-height=\"3000\" data-file-type=\"drawing\" height=\"33\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Florida_gubernatorial_election\" title=\"2022 Florida gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2030</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Byron_Donalds_2023_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Byron_Donalds_2023_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0b/Byron_Donalds_2023_%28cropped%29.jpg/120px-Byron_Donalds_2023_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/0b/Byron_Donalds_2023_%28cropped%29.jpg/250px-Byron_Donalds_2023_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"2788\" data-file-height=\"3534\" data-file-type=\"bitmap\" height=\"136\" width=\"107\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:David_Jolly_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:David_Jolly_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/46/David_Jolly_%28cropped%29.jpg/120px-David_Jolly_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/4/46/David_Jolly_%28cropped%29.jpg/250px-David_Jolly_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"345\" data-file-height=\"431\" data-file-type=\"bitmap\" height=\"136\" width=\"109\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Byron_Donalds\" title=\"Byron Donalds\">Byron Donalds</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/David_Jolly\" title=\"David Jolly\">David Jolly</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Running<span typeof=\"mw:Entity\"> </span>mate</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Bryan_Avila\" title=\"Bryan Avila\">Bryan Avila</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Gwen_Graham\" title=\"Gwen Graham\">Gwen Graham</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Florida\" title=\"Governor of Florida\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ron_DeSantis\" title=\"Ron DeSantis\">Ron DeSantis</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1662\" typeof=\"mw:Transclusion\" id=\"mwCkM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Ifexist not redirect\",\"href\":\"./Template:Ifexist_not_redirect\"},\"params\":{\"1\":{\"wt\":\"2026 Florida gubernatorial election\"},\"2\":{\"wt\":\"{{Main|2026 Florida gubernatorial election}}\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1663\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1662\" id=\"mwCkQ\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Florida_gubernatorial_election\" title=\"2026 Florida gubernatorial election\">2026 Florida gubernatorial election</a></div>\n<p id=\"mwCkU\">Republican Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Ron_DeSantis\" title=\"Ron DeSantis\" id=\"mwCkY\">Ron DeSantis</a> was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Florida_gubernatorial_election\" title=\"2022 Florida gubernatorial election\" id=\"mwCkc\">2022</a> with 59.4% of the vote. He is term-limited by the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_of_Florida\" title=\"Constitution of Florida\" id=\"mwCkg\">Florida Constitution</a> in 2026 and cannot seek re-election to a third consecutive term.</p>\n\n<p id=\"mwCkk\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/U.S._representative\" title=\"U.S. representative\" class=\"mw-redirect\" id=\"mwCko\">U.S. representative</a> for Florida's 19th congressional district <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Byron_Donalds\" title=\"Byron Donalds\" id=\"mwCks\">Byron Donalds</a> announced his candidacy on February 25, 2025, becoming the first major Republican to enter the race.<sup about=\"#mwt1666\" class=\"mw-ref reference\" id=\"cite_ref-Burkett_140-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Burkett\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Burkett-140\"}}'><a href=\"#cite_note-Burkett-140\" id=\"mwCkw\"><span class=\"mw-reflink-text\" id=\"mwCk0\"><span class=\"cite-bracket\" id=\"mwCk4\">[</span>130<span class=\"cite-bracket\" id=\"mwCk8\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Paul_Renner_(politician)\" title=\"Paul Renner (politician)\" id=\"mwClA\">Paul Renner</a>, former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/List_of_speakers_of_the_Florida_House_of_Representatives\" title=\"List of speakers of the Florida House of Representatives\" id=\"mwClE\">Speaker of the Florida House of Representatives</a>, announced his candidacy in September 2025, and Lieutenant Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jay_Collins\" title=\"Jay Collins\" id=\"mwClI\">Jay Collins</a> joined the race in January 2026.<sup about=\"#mwt1669\" class=\"mw-ref reference\" id=\"cite_ref-Renner_141-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Renner\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Renner-141\"}}'><a href=\"#cite_note-Renner-141\" id=\"mwClM\"><span class=\"mw-reflink-text\" id=\"mwClQ\"><span class=\"cite-bracket\" id=\"mwClU\">[</span>131<span class=\"cite-bracket\" id=\"mwClY\">]</span></span></a></sup><sup about=\"#mwt1672\" class=\"mw-ref reference\" id=\"cite_ref-CollinsFL_142-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"CollinsFL\"},\"body\":{\"id\":\"mw-reference-text-cite_note-CollinsFL-142\"}}'><a href=\"#cite_note-CollinsFL-142\" id=\"mwClc\"><span class=\"mw-reflink-text\" id=\"mwClg\"><span class=\"cite-bracket\" id=\"mwClk\">[</span>132<span class=\"cite-bracket\" id=\"mwClo\">]</span></span></a></sup> Other Republican candidates include <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Surfside,_Florida\" title=\"Surfside, Florida\" id=\"mwCls\">Surfside</a> mayor Charles Burkett and entrepreneur <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/James_Fishback\" title=\"James Fishback\" id=\"mwClw\">James Fishback</a>.<sup about=\"#mwt1673\" class=\"mw-ref reference\" id=\"cite_ref-Burkett_140-1\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Burkett\"}}'><a href=\"#cite_note-Burkett-140\" id=\"mwCl0\"><span class=\"mw-reflink-text\" id=\"mwCl4\"><span class=\"cite-bracket\" id=\"mwCl8\">[</span>130<span class=\"cite-bracket\" id=\"mwCmA\">]</span></span></a></sup><sup about=\"#mwt1676\" class=\"mw-ref reference\" id=\"cite_ref-Fishback_143-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Fishback\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Fishback-143\"}}'><a href=\"#cite_note-Fishback-143\" id=\"mwCmE\"><span class=\"mw-reflink-text\" id=\"mwCmI\"><span class=\"cite-bracket\" id=\"mwCmM\">[</span>133<span class=\"cite-bracket\" id=\"mwCmQ\">]</span></span></a></sup></p> \n\n<p id=\"mwCmU\">Former Republican U.S. representative for <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Florida's_13th_congressional_district\" title=\"Florida's 13th congressional district\" id=\"mwCmY\">Florida's 13th congressional district</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/David_Jolly\" title=\"David Jolly\" id=\"mwCmc\">David Jolly</a>, a staunch critic of Trump, joined the Democratic Party in 2025 and announced his candidacy June 2025.<sup about=\"#mwt1679\" class=\"mw-ref reference\" id=\"cite_ref-Jolly_144-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Jolly\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Jolly-144\"}}'><a href=\"#cite_note-Jolly-144\" id=\"mwCmg\"><span class=\"mw-reflink-text\" id=\"mwCmk\"><span class=\"cite-bracket\" id=\"mwCmo\">[</span>134<span class=\"cite-bracket\" id=\"mwCms\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Orange_County,_Florida\" title=\"Orange County, Florida\" id=\"mwCmw\">Orange County</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mayor_of_Orange_County\" title=\"Mayor of Orange County\" id=\"mwCm0\">Mayor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jerry_Demings\" title=\"Jerry Demings\" id=\"mwCm4\">Jerry Demings</a> is also running for the Democratic nomination.<sup about=\"#mwt1682\" class=\"mw-ref reference\" id=\"cite_ref-Demings_145-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Demings\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Demings-145\"}}'><a href=\"#cite_note-Demings-145\" id=\"mwCm8\"><span class=\"mw-reflink-text\" id=\"mwCnA\"><span class=\"cite-bracket\" id=\"mwCnE\">[</span>135<span class=\"cite-bracket\" id=\"mwCnI\">]</span></span></a></sup></p>\n\n<p id=\"mwCnM\">Former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Florida_Senate\" title=\"Florida Senate\" id=\"mwCnQ\">State Senate Minority Leader</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jason_Pizzo\" title=\"Jason Pizzo\" id=\"mwCnU\">Jason Pizzo</a> launched an independent bid for governor in May 2025,<sup about=\"#mwt1685\" class=\"mw-ref reference\" id=\"cite_ref-Pizzo_146-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Pizzo\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Pizzo-146\"}}'><a href=\"#cite_note-Pizzo-146\" id=\"mwCnY\"><span class=\"mw-reflink-text\" id=\"mwCnc\"><span class=\"cite-bracket\" id=\"mwCng\">[</span>136<span class=\"cite-bracket\" id=\"mwCnk\">]</span></span></a></sup> while <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Moliere_Dimanche\" title=\"Moliere Dimanche\" id=\"mwCno\">Moliere Dimanche</a> announced his own independent campaign in July 2024, becoming the first <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Haiti\" title=\"Haiti\" id=\"mwCns\">Haitian</a> candidate for governor in Florida's history.<sup about=\"#mwt1688\" class=\"mw-ref reference\" id=\"cite_ref-auto_147-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"auto\"},\"body\":{\"id\":\"mw-reference-text-cite_note-auto-147\"}}'><a href=\"#cite_note-auto-147\" id=\"mwCnw\"><span class=\"mw-reflink-text\" id=\"mwCn0\"><span class=\"cite-bracket\" id=\"mwCn4\">[</span>137<span class=\"cite-bracket\" id=\"mwCn8\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1689\" typeof=\"mw:Transclusion\" id=\"mwCoA\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"21\" id=\"mwCoE\" aria-labelledby=\"Georgia\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Georgia\">Georgia</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=21\" title=\"Edit section: Georgia\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1690\" typeof=\"mw:Transclusion\" id=\"mwCoI\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Georgia gubernatorial election\"},\"country\":{\"wt\":\"Georgia (U.S. state)\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previous_election\":{\"wt\":\"2022 Georgia gubernatorial election\"},\"previous_year\":{\"wt\":\"2022\"},\"next_election\":{\"wt\":\"2030 Georgia gubernatorial election\"},\"next_year\":{\"wt\":\"&apos;&apos;2030&apos;&apos;\"},\"image1\":{\"wt\":\"Rick Jackson (cropped).png\"},\"image_size\":{\"wt\":\"150x150px\"},\"nominee1\":{\"wt\":\"[[Rick Jackson (businessman)|Rick Jackson]]\"},\"party1\":{\"wt\":\"Republican Party (United States)\"},\"popular_vote1\":{\"wt\":\"\"},\"percentage1\":{\"wt\":\"\"},\"image2\":{\"wt\":\"Keisha Lance Bottoms (cropped).jpg\"},\"nominee2\":{\"wt\":\"[[Keisha Lance Bottoms]]\"},\"party2\":{\"wt\":\"Democratic Party (United States)\"},\"popular_vote2\":{\"wt\":\"\"},\"percentage2\":{\"wt\":\"\"},\"title\":{\"wt\":\"[[Governor of Georgia|Governor]]\"},\"before_election\":{\"wt\":\"[[Brian Kemp]]\"},\"before_party\":{\"wt\":\"Republican Party (United States)\"},\"after_election\":{\"wt\":\"\"},\"after_party\":{\"wt\":\"\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1358620234\" about=\"#mwt1691\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Infobox/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1315121714\" about=\"#mwt1692\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Infobox election/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1152813436\" about=\"#mwt1693\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Screen reader-only/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><table class=\"infobox ib-election infobox-table\" about=\"#mwt1690\" id=\"mwCoM\"><caption class=\"infobox-title summary\">Georgia gubernatorial election</caption><tbody><tr><td colspan=\"2\" class=\"infobox-subheader\"><span class=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img resource=\"https://en.wikipedia.org/wiki/File:Flag_of_Georgia_(U.S._state).svg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Flag_of_the_State_of_Georgia.svg/60px-Flag_of_the_State_of_Georgia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Flag_of_the_State_of_Georgia.svg/120px-Flag_of_the_State_of_Georgia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" alt=\"\" data-file-width=\"960\" data-file-height=\"600\" data-file-type=\"drawing\" height=\"31\" width=\"50\" class=\"mw-file-element\"/></span></span></span><hr/></td></tr><tr><td colspan=\"2\" class=\"infobox-subheader\"><div style=\"width:100%\"><div style=\"float: left; text-align:left;padding-right:0.5em;width:20%;\" class=\"noprint\"><span typeof=\"mw:Entity\">←</span><span typeof=\"mw:Entity\"> </span><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Georgia_gubernatorial_election\" title=\"2022 Georgia gubernatorial election\">2022</a></div><div style=\"float: right; text-align:right;padding-left:0.5em;width:20%;\" class=\"noprint\"><i>2030</i><span typeof=\"mw:Entity\"> </span><span typeof=\"mw:Entity\">→</span></div></div></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\">\n<table style=\"background:transparent; color: inherit; width:100%;\">\n<tbody>\n\n\n<tr>\n<td><span typeof=\"mw:Entity\"> </span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #E81B23;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Rick_Jackson_(cropped).png\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Rick_Jackson_(cropped).png\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Rick_Jackson_%28cropped%29.png/120px-Rick_Jackson_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/a/a9/Rick_Jackson_%28cropped%29.png/250px-Rick_Jackson_%28cropped%29.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"512\" data-file-height=\"682\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td>\n<td class=\"notheme\" style=\"text-align:center;border-bottom: 6px solid #0044C9;\"><span class=\"notpageimage noresize\" typeof=\"mw:File\"><a href=\"https://en.wikipedia.org/wiki/File:Keisha_Lance_Bottoms_(cropped).jpg\" class=\"mw-file-description\"><img resource=\"https://en.wikipedia.org/wiki/File:Keisha_Lance_Bottoms_(cropped).jpg\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Keisha_Lance_Bottoms_%28cropped%29.jpg/120px-Keisha_Lance_Bottoms_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/6/61/Keisha_Lance_Bottoms_%28cropped%29.jpg/250px-Keisha_Lance_Bottoms_%28cropped%29.jpg?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"609\" data-file-height=\"812\" data-file-type=\"bitmap\" height=\"150\" width=\"112\" class=\"mw-file-element\"/></a></span></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Nominee</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Rick_Jackson_(businessman)\" title=\"Rick Jackson (businessman)\">Rick Jackson</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Keisha_Lance_Bottoms\" title=\"Keisha Lance Bottoms\">Keisha Lance Bottoms</a></td>\n<td style=\"text-align:center\"></td></tr>\n<tr>\n<th style=\"width:75px;text-align:left\">Party</th>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></td>\n<td style=\"width:75px;text-align:center\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Democratic_Party_(United_States)\" title=\"Democratic Party (United States)\">Democratic</a></td></tr>\n\n\n\n\n\n\n\n\n</tbody></table></td></tr><tr><td colspan=\"2\" class=\"infobox-full-data\"><hr/>\n<table role=\"presentation\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:transparent; color: inherit; width:100%;\">\n<tbody><tr><td style=\"width:50%; text-align:left;\"><b>Incumbent <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Georgia\" title=\"Governor of Georgia\">Governor</a></b><br/>\n<p><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Brian_Kemp\" title=\"Brian Kemp\">Brian Kemp</a><br/>\n<a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Republican_Party_(United_States)\" title=\"Republican Party (United States)\">Republican</a></p></td>\n<td style=\"width:50%; text-align:right;\"><br/>\n<p>\n<br/></p></td></tr>\n</tbody></table></td></tr></tbody></table>\n<span class=\"mw-empty-elt\" about=\"#mwt1694\" typeof=\"mw:Transclusion\" id=\"mwCoQ\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Ifexist not redirect\",\"href\":\"./Template:Ifexist_not_redirect\"},\"params\":{\"1\":{\"wt\":\"2026 Georgia gubernatorial election\"},\"2\":{\"wt\":\"{{Main|2026 Georgia gubernatorial election}}\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1695\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1694\" id=\"mwCoU\">Main article: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Georgia_gubernatorial_election\" title=\"2026 Georgia gubernatorial election\">2026 Georgia gubernatorial election</a></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1696\" typeof=\"mw:Transclusion\" id=\"mwCoY\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"See also\",\"href\":\"./Template:See_also\"},\"params\":{\"1\":{\"wt\":\"2026 Georgia lieutenant gubernatorial election\"}},\"i\":0}}]}'><link rel=\"mw-deduplicated-inline-style\" href=\"mw-data:TemplateStyles:r1368532237\" about=\"#mwt1697\" typeof=\"mw:Extension/templatestyles\" data-mw='{\"name\":\"templatestyles\",\"attrs\":{\"src\":\"Module:Hatnote/styles.css\"},\"body\":{\"extsrc\":\"\"}}'/></span><div role=\"note\" class=\"hatnote navigation-not-searchable\" about=\"#mwt1696\" id=\"mwCoc\">See also: <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2026_Georgia_lieutenant_gubernatorial_election\" title=\"2026 Georgia lieutenant gubernatorial election\">2026 Georgia lieutenant gubernatorial election</a></div>\n<p id=\"mwCog\">Republican <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Governor_of_Georgia\" title=\"Governor of Georgia\" id=\"mwCok\">Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Brian_Kemp\" title=\"Brian Kemp\" id=\"mwCoo\">Brian Kemp</a> was re-elected in <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2022_Georgia_gubernatorial_election\" title=\"2022 Georgia gubernatorial election\" id=\"mwCos\">2022</a> with 53.4% of the vote. He is term-limited by the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Constitution_of_Georgia_(U.S._state)\" title=\"Constitution of Georgia (U.S. state)\" id=\"mwCow\">Georgia Constitution</a> in 2026 and cannot seek re-election to a third consecutive term. </p>\n\n<p id=\"mwCo0\"><a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Georgia_Attorney_General\" title=\"Georgia Attorney General\" id=\"mwCo4\">Attorney General</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Chris_Carr_(politician)\" title=\"Chris Carr (politician)\" id=\"mwCo8\">Chris Carr</a>,<sup about=\"#mwt1700\" class=\"mw-ref reference\" id=\"cite_ref-CARR2026_148-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"CARR2026\"},\"body\":{\"id\":\"mw-reference-text-cite_note-CARR2026-148\"}}'><a href=\"#cite_note-CARR2026-148\" id=\"mwCpA\"><span class=\"mw-reflink-text\" id=\"mwCpE\"><span class=\"cite-bracket\" id=\"mwCpI\">[</span>138<span class=\"cite-bracket\" id=\"mwCpM\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Lieutenant_Governor_of_Georgia\" title=\"Lieutenant Governor of Georgia\" id=\"mwCpQ\">Lieutenant Governor</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Burt_Jones\" title=\"Burt Jones\" id=\"mwCpU\">Burt Jones</a>,<sup about=\"#mwt1703\" class=\"mw-ref reference\" id=\"cite_ref-JonesGA_149-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"JonesGA\"},\"body\":{\"id\":\"mw-reference-text-cite_note-JonesGA-149\"}}'><a href=\"#cite_note-JonesGA-149\" id=\"mwCpY\"><span class=\"mw-reflink-text\" id=\"mwCpc\"><span class=\"cite-bracket\" id=\"mwCpg\">[</span>139<span class=\"cite-bracket\" id=\"mwCpk\">]</span></span></a></sup> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Georgia_Secretary_of_State\" title=\"Georgia Secretary of State\" id=\"mwCpo\">Secretary of State</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Brad_Raffensperger\" title=\"Brad Raffensperger\" id=\"mwCps\">Brad Raffensperger</a>,<sup about=\"#mwt1706\" class=\"mw-ref reference\" id=\"cite_ref-Raffensperger_150-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Raffensperger\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Raffensperger-150\"}}'><a href=\"#cite_note-Raffensperger-150\" id=\"mwCpw\"><span class=\"mw-reflink-text\" id=\"mwCp0\"><span class=\"cite-bracket\" id=\"mwCp4\">[</span>140<span class=\"cite-bracket\" id=\"mwCp8\">]</span></span></a></sup> and healthcare executive <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Rick_Jackson_(businessman)\" title=\"Rick Jackson (businessman)\" id=\"mwCqA\">Rick Jackson</a><sup about=\"#mwt1709\" class=\"mw-ref reference\" id=\"cite_ref-151\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{},\"body\":{\"id\":\"mw-reference-text-cite_note-151\"}}'><a href=\"#cite_note-151\" id=\"mwCqE\"><span class=\"mw-reflink-text\" id=\"mwCqI\"><span class=\"cite-bracket\" id=\"mwCqM\">[</span>141<span class=\"cite-bracket\" id=\"mwCqQ\">]</span></span></a></sup> all announced bids for the Republican nomination. Jackson and Jones advanced to a runoff that took place on June 16, which Jackson won, thus becoming the Republican nominee.</p>\n\n<p id=\"mwCqU\">On the Democratic side, former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mayor_of_Atlanta\" title=\"Mayor of Atlanta\" class=\"mw-redirect\" id=\"mwCqY\">Mayor of Atlanta</a> and former director of the <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/White_House_Office_of_Public_Engagement\" title=\"White House Office of Public Engagement\" class=\"mw-redirect\" id=\"mwCqc\">White House Office of Public Engagement</a> <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Keisha_Lance_Bottoms\" title=\"Keisha Lance Bottoms\" id=\"mwCqg\">Keisha Lance Bottoms</a><sup about=\"#mwt1712\" class=\"mw-ref reference\" id=\"cite_ref-Bottoms_152-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Bottoms\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Bottoms-152\"}}'><a href=\"#cite_note-Bottoms-152\" id=\"mwCqk\"><span class=\"mw-reflink-text\" id=\"mwCqo\"><span class=\"cite-bracket\" id=\"mwCqs\">[</span>142<span class=\"cite-bracket\" id=\"mwCqw\">]</span></span></a></sup> became the nominee on May 19 and defeated a crowded field, which included former state senator <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Jason_Esteves\" title=\"Jason Esteves\" id=\"mwCq0\">Jason Esteves</a>,<sup about=\"#mwt1715\" class=\"mw-ref reference\" id=\"cite_ref-Esteves_153-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Esteves\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Esteves-153\"}}'><a href=\"#cite_note-Esteves-153\" id=\"mwCq4\"><span class=\"mw-reflink-text\" id=\"mwCq8\"><span class=\"cite-bracket\" id=\"mwCrA\">[</span>143<span class=\"cite-bracket\" id=\"mwCrE\">]</span></span></a></sup> former <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/DeKalb_County,_Georgia\" title=\"DeKalb County, Georgia\" id=\"mwCrI\">DeKalb County</a> Chief Executive Officer and  <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/2010_United_States_Senate_election_in_Georgia\" title=\"2010 United States Senate election in Georgia\" id=\"mwCrM\">2010</a> nominee for U.S. Senate <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Mike_Thurmond\" title=\"Mike Thurmond\" id=\"mwCrQ\">Mike Thurmond</a>,<sup about=\"#mwt1718\" class=\"mw-ref reference\" id=\"cite_ref-ThurmondGA_154-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"ThurmondGA\"},\"body\":{\"id\":\"mw-reference-text-cite_note-ThurmondGA-154\"}}'><a href=\"#cite_note-ThurmondGA-154\" id=\"mwCrU\"><span class=\"mw-reflink-text\" id=\"mwCrY\"><span class=\"cite-bracket\" id=\"mwCrc\">[</span>144<span class=\"cite-bracket\" id=\"mwCrg\">]</span></span></a></sup> and state representative <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Derrick_Jackson_(politician)\" title=\"Derrick Jackson (politician)\" id=\"mwCrk\">Derrick Jackson</a>.<sup about=\"#mwt1721\" class=\"mw-ref reference\" id=\"cite_ref-DerrickJackson_155-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"DerrickJackson\"},\"body\":{\"id\":\"mw-reference-text-cite_note-DerrickJackson-155\"}}'><a href=\"#cite_note-DerrickJackson-155\" id=\"mwCro\"><span class=\"mw-reflink-text\" id=\"mwCrs\"><span class=\"cite-bracket\" id=\"mwCrw\">[</span>145<span class=\"cite-bracket\" id=\"mwCr0\">]</span></span></a></sup> Former Lieutenant Governor <a rel=\"mw:WikiLink\" href=\"https://en.wikipedia.org/wiki/Geoff_Duncan\" title=\"Geoff Duncan\" id=\"mwCr4\">Geoff Duncan</a>, a Republican critic of Donald Trump, switched to the Democratic Party and ran for governor.<sup about=\"#mwt1724\" class=\"mw-ref reference\" id=\"cite_ref-Duncan_156-0\" rel=\"dc:references\" typeof=\"mw:Extension/ref\" data-mw='{\"name\":\"ref\",\"attrs\":{\"name\":\"Duncan\"},\"body\":{\"id\":\"mw-reference-text-cite_note-Duncan-156\"}}'><a href=\"#cite_note-Duncan-156\" id=\"mwCr8\"><span class=\"mw-reflink-text\" id=\"mwCsA\"><span class=\"cite-bracket\" id=\"mwCsE\">[</span>146<span class=\"cite-bracket\" id=\"mwCsI\">]</span></span></a></sup></p>\n<div style=\"clear:both;\" class=\"\" about=\"#mwt1725\" typeof=\"mw:Transclusion\" id=\"mwCsM\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"clear\",\"href\":\"./Template:Clear\"},\"params\":{},\"i\":0}}]}'></div>\n\n</section><section data-mw-section-id=\"22\" id=\"mwCsQ\" aria-labelledby=\"Hawaii\"><div class=\"mw-heading mw-heading2\"><h2 id=\"Hawaii\">Hawaii</h2><span class=\"mw-editsection\"><span class=\"mw-editsection-bracket\">[</span><a href=\"/w/index.php?title=2026_United_States_gubernatorial_elections&amp;action=edit&amp;section=22\" title=\"Edit section: Hawaii\"><span>edit</span></a><span class=\"mw-editsection-bracket\">]</span></span></div>\n<span class=\"mw-empty-elt\" about=\"#mwt1726\" typeof=\"mw:Transclusion\" id=\"mwCsU\" data-mw='{\"parts\":[{\"template\":{\"target\":{\"wt\":\"Infobox election\\n\",\"href\":\"./Template:Infobox_election\"},\"params\":{\"election_name\":{\"wt\":\"Hawaii gubernatorial election\"},\"country\":{\"wt\":\"Hawaii\"},\"type\":{\"wt\":\"presidential\"},\"ongoing\":{\"wt\":\"yes\"},\"previou