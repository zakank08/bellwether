lass=\"flagicon\"><span class=\"mw-image-border\" typeof=\"mw:File\"><a href=\"/wiki/Georgia_(U.S._state)\" title=\"Georgia (U.S. state)\"><img alt=\"Georgia (U.S. state)\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Flag_of_the_State_of_Georgia.svg/40px-Flag_of_the_State_of_Georgia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"23\" height=\"14\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/0/08/Flag_of_the_State_of_Georgia.svg/60px-Flag_of_the_State_of_Georgia.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"960\" data-file-height=\"600\" /></a></span></span> <a href=\"/wiki/Georgia_(U.S._state)\" title=\"Georgia (U.S. state)\">Georgia</a>\n</td>\n<td>1,123,457\n</td>\n<td>10.5%</td>\n<td align=\"right\">570,149</td>\n<td align=\"right\">5.3%\n</td>\n<td>109,009\n</td>\n<td>1.0%\n</td></tr>\n<tr>\n<td><span class=\"flagicon nowrap\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Flag_of_Hawaii.svg/40px-Flag_of_Hawaii.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"23\" height=\"12\" class=\"mw-file-element\" srcset=\"//thumb.wikimedia.org/wikipedia/commons/thumb/e/ef/Flag_of_Hawaii.svg/60px-Flag_of_Hawaii.svg.png?utm_source=en.wikipedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"1200\" data-file-height=\"600\" /></span></span> </span><a href=\"/wiki/Hawaii\" title=\"Hawaii\">Hawaii</a>\n</td>\n<td>138,923\n</td>\n<td>9.5%</td>\n<td align=\"right\">42,941</td>\n<td align=\"right\">2.9%\n</td>\n<td>46,229\n</td>\n<td>3.1%\n</td></tr>\n<tr>\n<td><span class=\"flagicon nowrap\"><span class=\"mw-image-border\" typeof=\"mw:File\"><span><img alt=\"\" src=\"//thumb.wikimedia.org/wikiped